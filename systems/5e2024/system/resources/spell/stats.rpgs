base string name(name = "Name") = "";

base string source(name = "Source") = "";

base string level(name = "Level") = "spell_level_0";

base string school(name = "School") = "spell_school_abjuration";

base bool ritual(name = "Ritual") = false;

base string casting_time(name = "Casting time") = "";

calc string display_casting_time(name = "Display casting time") =
  if ritual then concat([casting_time, " or ritual"]) else casting_time;

base string range(name = "Range") = "";

base string duration(name = "Duration") = "";

base bool verbal(name = "Verbal") = false;

base bool somatic(name = "Somatic") = false;

base bool material(name = "Material") = false;

base string components(name = "Components") = "";

base string description(name = "Description") = "";

base string higher_level_description(name = "Higher level description") = "";

base string[] classes(name = "Classes") = [];

base resource<levelled_damage_dice>[] dice(name = "Dice") = [];

base resource<effect>[] effects(name = "Effects") = [];

base bool prepared(name = "Prepared") = false;

base integer cast_level(name = "Cast level") = 1;

base string selected_spellcasting_class_id(name = "Selected spellcasting class id") =
  "";

calc bool is_cantrip(name = "Is cantrip") = level == "spell_level_0";

calc integer num_level(name = "Numerical level") =
  toNum(replace(string = level, occurrence = "spell_level_", replace = ""));

calc bool has_higher_level_description(name = "Has higher level description") =
  length(higher_level_description) > 0;

calc bool has_damage_dice(name = "Has damage dice") = !isEmpty(dice);

calc bool has_active_effects(name = "Has active effects") =
  !isEmpty(filter(effects, filter = ($filterValue) => $filterValue.is_active));

calc bool should_show_damage_or_effects_button(name = "Should show damage/effects button") =
  has_damage_dice || has_active_effects;

calc string damage_or_effects_button_text(name = "Damage/effects button text") =
  if has_damage_dice then "DAMAGE" else "TRIGGER EFFECTS";

calc string display_type(name = "Type") =
  concat(
    [
      enumeratedName(enumerated_type = "spell_level", id = level),
      " ",
      enumeratedName(enumerated_type = "spell_school", id = school),
    ],
  );

calc string string_components(name = "Stringified components VSM") =
  joinToString(
    flatAppend(
      [
        (if true == verbal then ["V"] else []),
        (if true == somatic then ["S"] else []),
        (if true == material then ["M"] else []),
      ],
    ),
    separator = ", ",
  );

calc bool has_components(name = "Has components VSM") =
  verbal || somatic || material;

calc string display_requirements(name = "Requirements") =
  concat(
    [
      casting_time,
      (if has_components then concat([" (", string_components, ")"]) else ""),
    ],
  );

calc string full_components(name = "Full components") =
  if material
    then concat([string_components, " (", components, ")"])
    else string_components;

calc resource<class_details>[] character_spellcasting_classes(name = "Character spellcasting classes") =
  if defined(stat = "$character")
    then filter(
        $character.classes,
        filter = ($filterValue) => $filterValue.show_spellcasting_details,
      )
    else [];

calc resource<class_details>[] spell_matching_class_sources(name = "Spell matching class sources") =
  filter(
    character_spellcasting_classes,
    filter = ($filterValue) => notNull(
      findFirst(
        filter(
          $filterValue.class.all_spells,
          filter = ($filterValue2) => ($filterValue2.level <= ($character?.level? ?? 1)),
        ),
        filter = ($findFirstValue) => ($findFirstValue.spell.id == id),
      ),
    ),
  );

calc resource<levelled_spell>[] character_race_levelled_spells(name = "Character race levelled spells") =
  if defined(stat = "$character")
    then flatAppend(
        [
          ($character.race?.spells ?? []),
          ($character.race?.selected_subrace?.spells ?? []),
        ],
      )
    else [];

calc bool spell_has_specific_race_source(name = "Spell has specific race source") =
  !isEmpty(character_race_levelled_spells)
    && isEmpty(spell_matching_class_sources)
    && notNull(
      findFirst(
        filter(
          character_race_levelled_spells,
          filter = ($filterValue) => ($filterValue.level <= ($character?.level ?? 1)),
        ),
        filter = ($findFirstValue) => ($findFirstValue.spell.id == id),
      ),
    );

calc bool spell_has_specific_class_source(name = "Spell has specific class source") =
  !spell_has_specific_race_source && length(spell_matching_class_sources) == 1;

calc resource<class_details>[] selectable_spellcasting_class_sources(name = "Selectable spellcasting class sources") =
  if !isEmpty(spell_matching_class_sources)
    then spell_matching_class_sources
    else character_spellcasting_classes;

calc string resolved_spellcasting_class_source_id(name = "Resolved spellcasting class source id") =
  if spell_has_specific_class_source
    then findFirst(
        map(spell_matching_class_sources, mapper = ($mapValue) => $mapValue.id),
        filter = ($findFirstValue) => true,
      )
    else if contains(
      haystack = map(selectable_spellcasting_class_sources, mapper = ($mapValue) => $mapValue.id),
      needle = ($view?.spell_display_spellcasting_source_select? ?? selected_spellcasting_class_id),
    )
    then ($view?.spell_display_spellcasting_source_select? ?? selected_spellcasting_class_id)
    else (findFirst(
          map(selectable_spellcasting_class_sources, mapper = ($mapValue) => $mapValue.id),
          filter = ($findFirstValue) => true,
        ) ?? "");

calc resource<class_details> selected_spellcasting_class_source(name = "Selected spellcasting class source") =
  findFirst(
    selectable_spellcasting_class_sources,
    filter = ($findFirstValue) => ($findFirstValue.id == resolved_spellcasting_class_source_id),
  );

calc string race_spellcasting_ability(name = "Race spellcasting ability") =
  $character?.race?.actual_spellcasting_ability ?? "intelligence";

calc string selected_spellcasting_source_name(name = "Selected spellcasting source name") =
  when {
    spell_has_specific_race_source -> concat(
      [
        "Race (",
        enumeratedAbbreviation(
          enumerated_type = "ability",
          id = race_spellcasting_ability,
        ),
        ")",
      ],
    ),
    notNull(selected_spellcasting_class_source) -> selected_spellcasting_class_source.class_name_with_spellcasting_ability,
    else -> "",
  };

calc bool should_show_spellcasting_source_select(name = "Should show spellcasting source select") =
  defined(stat = "$character")
    && !spell_has_specific_race_source
    && !spell_has_specific_class_source
    && length(selectable_spellcasting_class_sources) > 1;

calc bool should_show_spellcasting_source_text(name = "Should show spellcasting source text") =
  defined(stat = "$character")
    && !isEmpty(selected_spellcasting_source_name)
    && !should_show_spellcasting_source_select;

calc bool character_spell_slots_defined(name = "Character and spell slots defined") =
  defined(stat = "$character")
    && defined(stat = "$character.spell_slots_1")
    && defined(stat = "$character.spell_slots_2")
    && defined(stat = "$character.spell_slots_3")
    && defined(stat = "$character.spell_slots_4")
    && defined(stat = "$character.spell_slots_5")
    && defined(stat = "$character.spell_slots_6")
    && defined(stat = "$character.spell_slots_7")
    && defined(stat = "$character.spell_slots_8")
    && defined(stat = "$character.spell_slots_9");

calc bool in_combat(name = "In combat") =
  ($parent?.in_combat? ?? false) || defined(stat = "$combatants");

calc bool use_combat_free_casting(name = "Use combat free casting mode") =
  in_combat && !defined(stat = "$character");

calc bool should_display_cast_controls(name = "Should display cast controls") =
  defined(stat = "$character") || use_combat_free_casting;

calc string prepare_button_text(name = "Prepare button text") =
  if prepared then "UNPREPARE" else "PREPARE";

calc integer[] available_slots_for_use(name = "Available slots for use") =
  if use_combat_free_casting
    then filter(
        [1, 2, 3, 4, 5, 6, 7, 8, 9],
        filter = ($filterValue) => ($filterValue >= (if num_level <= 1 then 1 else num_level)),
      )
    else if character_spell_slots_defined
    then filter(
        [1, 2, 3, 4, 5, 6, 7, 8, 9],
        filter = ($filterValue) => ($filterValue >= num_level
          && metaStat(meta_stat = concat(["$character.spell_slots_", $filterValue])) > 0),
      )
    else [1];

calc string selected_spell_slots_stat_name(name = "Selected spell slots stat name") =
  concat(
    [
      "$character.spell_slots_",
      ($view?.spell_display_cast_composite_ticker? ?? "0"),
    ],
  );

calc integer selected_cast_level(name = "Selected cast level") =
  if is_cantrip && defined(stat = "$character")
    then $character.level
    else ($view?.spell_display_cast_composite_ticker? ?? (findFirst(
          available_slots_for_use,
          filter = ($findFirstValue) => true,
        ) ?? 1));

calc integer available_selected_slots(name = "Available selected spell slots") =
  if character_spell_slots_defined
    && selected_spell_slots_stat_name != "$character.spell_slots_0"
    then metaStat(meta_stat = selected_spell_slots_stat_name)
    else 0;

calc bool should_select_spell_slot_to_cast(name = "Should select a spell slot to cast") =
  should_display_cast_controls
    && !is_cantrip
    && !isEmpty(available_slots_for_use);

calc string selected_spellcasting_ability(name = "Selected spellcasting ability") =
  when {
    spell_has_specific_race_source -> race_spellcasting_ability,
    notNull(selected_spellcasting_class_source) -> selected_spellcasting_class_source.class.actual_spellcasting_ability,
    defined(stat = "$parent.spellcasting_ability") -> $parent.spellcasting_ability,
    else -> "intelligence",
  };

calc integer spellcasting_modifier(name = "Spellcasting modifier") =
  when {
    selected_spellcasting_ability == "strength" -> ($character?.strength_modifier ?? $parent?.strength_modifier ?? 0),
    selected_spellcasting_ability == "dexterity" -> ($character?.dexterity_modifier ?? $parent?.dexterity_modifier ?? 0),
    selected_spellcasting_ability == "constitution" -> ($character?.constitution_modifier ?? $parent?.constitution_modifier ?? 0),
    selected_spellcasting_ability == "wisdom" -> ($character?.wisdom_modifier ?? $parent?.wisdom_modifier ?? 0),
    selected_spellcasting_ability == "charisma" -> ($character?.charisma_modifier ?? $parent?.charisma_modifier ?? 0),
    else -> ($character?.intelligence_modifier ?? $parent?.intelligence_modifier ?? 0),
  };

calc string spell_attack_roll_formula(name = "Spell attack roll formula") =
  concat(["1d20", toSignedString(spellcasting_modifier)]);

calc bool character_is_not_wearing_inproficient_armor(name = "Character is not currently wear a piece of armor its not proficient with") =
  $character?.is_not_wearing_inproficient_armor ?? true;

calc bool has_required_spell_slots_to_cast(name = "Has required spell slots to cast") =
  use_combat_free_casting || is_cantrip || !isEmpty(available_slots_for_use);

calc bool can_cast(name = "Can cast spell") =
  character_is_not_wearing_inproficient_armor && has_required_spell_slots_to_cast;
