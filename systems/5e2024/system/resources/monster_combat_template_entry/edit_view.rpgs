view monster_combat_template_entry_edit() =
  composite(
    subviews = [
      selectResources(
        id = "monster_combat_template_entry_edit_spell_select",
        stat = "combatant",
        resource_id = "monster",
        preserve_ids = true,
        validation_message = if ($view.monster_combat_template_entry_edit_spell_select == null)
          then "There's an empty monster. Please select a monster or remove it"
          else null,
        margin_right = 8,
      ),
      text(
        id = "monster_combat_template_entry_edit_min",
        edit_stat = "min",
        style = "text",
        hint = "Min",
        max_length = 2,
        margin_right = 8,
      ),
      text(
        id = "monster_combat_template_entry_edit_max",
        edit_stat = "max",
        style = "text",
        hint = "Max",
        max_length = 3,
        margin_right = 8,
      ),
      text(
        id = "monster_combat_template_entry_edit_weight",
        edit_stat = "weight",
        style = "text",
        hint = "Weight",
        max_length = 3,
      ),
    ],
  );
