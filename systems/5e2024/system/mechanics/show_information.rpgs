import "../macros/system_common.rpgs";

mechanic show_information(event_names = "show_information") =
  showCharacterInformationPopUp(
    extra_label_id = "information_tool_proficiencies_label",
    extra_label_text = "Tools:",
    extra_value_id = "information_tool_proficiencies",
    extra_value_text = joinToString(tool_proficiencies, separator = ", "),
  );
