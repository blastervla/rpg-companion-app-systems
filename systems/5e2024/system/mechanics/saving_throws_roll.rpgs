import "../macros/system_common.rpgs";

mechanic saving_throws_roll(event_names = "death_saves_roll") =
  roll(
    rolls = [rollable(formulas = ["1d20"], text = "death save")],
    on_result_effect = when {
      $event.result == 20 -> fireEventName(event_name = "death_saves_stabilize"),
      $event.result == 1 -> when {
        !death_saving_throws_failure_1 -> sequence(
          effects = [
            setStatTrue(stat_id = "death_saving_throws_failure_1"),
            setStatTrue(stat_id = "death_saving_throws_failure_2"),
          ],
        ),
        !death_saving_throws_failure_2 -> sequence(
          effects = [
            setStatTrue(stat_id = "death_saving_throws_failure_2"),
            setStatTrue(stat_id = "death_saving_throws_failure_3"),
          ],
        ),
        !death_saving_throws_failure_3 -> sequence(
          effects = [setStatTrue(stat_id = "death_saving_throws_failure_3")],
        ),
      },
      $event.result >= 10 -> when {
        !death_saving_throws_success_1 -> setStatTrue(stat_id = "death_saving_throws_success_1"),
        !death_saving_throws_success_2 -> setStatTrue(stat_id = "death_saving_throws_success_2"),
        !death_saving_throws_success_3 -> sequence(
          effects = [
            setStatTrue(stat_id = "death_saving_throws_success_3"),
            fireEventName(event_name = "death_saves_stabilize"),
          ],
        ),
      },
      $event.result < 10 -> when {
        !death_saving_throws_failure_1 -> setStatTrue(stat_id = "death_saving_throws_failure_1"),
        !death_saving_throws_failure_2 -> setStatTrue(stat_id = "death_saving_throws_failure_2"),
        !death_saving_throws_failure_3 -> setStatTrue(stat_id = "death_saving_throws_failure_3"),
      },
    },
  );
