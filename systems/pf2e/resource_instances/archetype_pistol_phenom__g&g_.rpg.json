            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_a6280cc68f25",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "You catch an opponent off-guard by spinning your weapon.\n\nYou gain the Pistol Twirl gunslinger feat, enabling you to Feint against creatures within your weapon's first range increment.\n\nThis otherwise serves as Pistol Twirl for the purpose of meeting prerequisites, although as normal, it doesn't count as another pistol phenom feat for the purpose of meeting Pistol Phenom Dedication's special entry and taking another archetype. Whenever you Feint with a one-handed firearm, you can choose to attempt a Performance check instead of a Deception check."
                  }
                }
              }
            ]
