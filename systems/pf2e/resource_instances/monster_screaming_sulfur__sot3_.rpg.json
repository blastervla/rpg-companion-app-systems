    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Agonizing Cries"
            },
            "trait_description": {
              "value": "(auditory, aura, emotion, mental)\n\n30 feet. The screaming sulfur constantly shrieks with the pained wails of countless spirits. A living creature that enters or starts its turn in the aura must succeed at a 26 Will save or become frightened 1 as long as it remains in the aura (frightened 2 on a critical failure). A creature that succeeds is temporarily immune for 1 hour."
            },
            "id": "7fa4e757-0056-44ca-95eb-555903330ae2",
            "updated_at": {
              "value": "2026-03-29T00:33:30.506906"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rejuvenation"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nBlessing the site where the screaming sulfur was formed and burying whatever dead remain allows the spirits within the screaming sulfur to move on to the afterlife, rendering it inert."
            },
            "id": "2d3f7e30-227b-4d43-8c0d-db853492a10d",
            "updated_at": {
              "value": "2026-03-29T00:33:30.506906"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Site Bound"
            },
            "trait_description": {
              "value": "A screaming sulfur becomes bound to the location where the people whose souls make up its form died.\n\nIt can stray up to 1,000 feet from this site of death, or up to 100 feet from the edges of any waterway associated with its death, whichever distance is shorter."
            },
            "id": "890ee543-22c9-410e-8829-7896cba8386d",
            "updated_at": {
              "value": "2026-03-29T00:33:30.506906"
            }
          }
        }
