        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Easy to Influence"
            },
            "trait_description": {
              "value": "Any mental spell can affect a carbuncle, regardless of creature type limitations. Against a suggestion spell, a carbuncle always gets an outcome one degree of success worse than it rolled on its saving throw."
            },
