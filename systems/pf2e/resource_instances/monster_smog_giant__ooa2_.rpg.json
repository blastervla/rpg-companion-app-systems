        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Shrapnel"
            },
            "trait_description": {
              "value": "A smog giant has a dozen implanted knives, rocks, chunks of metal, spikes, and other adornments that they can fire from their body with great force to make ranged shrapnel Strikes. Once a smog giant has used all 12 shots, they must replace them one at a time using a 1-minute Interact activity."
            },
