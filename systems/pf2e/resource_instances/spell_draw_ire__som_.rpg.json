    "description": {
      "value": "You cause mental distress to a creature, goading it to strike back at you. You deal 1d10 mental damage to the creature and cause it to take a \u20131 status penalty to attack rolls against creatures other than you. The creature must attempt a Will saving throw.\n\n- **Critical Success:** The target is unaffected.\n- **Success:** The target takes half damage and the penalty. The spell ends at the end of the target's next turn.\n- **Failure:** The target takes full damage and the penalty.\n- **Critical Failure:** The target takes double damage, and the status penalty is \u20132."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d10."
    },
