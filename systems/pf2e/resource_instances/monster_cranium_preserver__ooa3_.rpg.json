    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Undead Crafter"
            },
            "trait_description": {
              "value": "The cranium preserver knows one version of the create undead ritual for every four heads it has preserved (a typical cranium preserver has 12 preserved heads). The cranium preserver can use its heads to make separate rolls as both the primary and secondary casters of the ritual."
            },
            "id": "6e13433e-0e4f-44af-83d8-623f9c4f831c",
            "updated_at": {
              "value": "2026-03-19T22:59:07.581035"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Slosh"
            },
            "trait_description": {
              "value": "Whenever the cranium preserver ends a Stride, the movement causes necrotic embalming fluid and preserved body parts to slosh about and spill from its central vat. Each creature adjacent to the cranium preserver when it finishes its Stride must attempt a 26 Will save.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature takes 1d8 mental damage and 1d8 negative damage.\n- **Failure:** The creature takes 2d8 mental damage and 2d8 negative damage.\n- **Critical Failure:** The creature takes 4d8 mental and 4d8 negative damage. If the creature is alive, the preserved body parts sense the presence of a living creature and cling to it, causing the creature to become clumsy 2 for 1 round."
            },
            "id": "b1a2dda9-d2c1-4885-9747-0b04640dd6aa",
            "updated_at": {
              "value": "2026-03-19T22:59:07.581035"
            }
          }
        }
      ]
