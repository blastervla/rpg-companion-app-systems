    "description": {
      "value": "Freezing sleet and heavy snowfall collect on the target's feet and legs, dealing 1d4 cold damage and other effects depending on its Reflex save.\n\nCritical Success: The target is unaffected.\nSuccess: The target takes half damage.\nFailure: The target takes full damage and a -5-foot circumstance penalty to its Speeds until the spell ends.\nCritical Failure: The target takes double damage and a -10-foot circumstance penalty to its Speeds until the spell ends."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d4."
    },
