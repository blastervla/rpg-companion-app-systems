        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Poison Stock"
            },
            "trait_description": {
              "value": "When the cabinet hits a creature with its poison bottle Strike, roll 1d4 to determine what kind of poison splashes onto the struck creature: 1 nerve poison (clumsy 1); 2 weakening poison (enfeebled 1); 3 noxious poison (sickened 1); 4 clouded mind poison (stupefied 1). The target must attempt a DC 24 Fortitude save.\n\nCritical Success: \nSuccess: \nFailure: \nCritical Failure: "
            },
