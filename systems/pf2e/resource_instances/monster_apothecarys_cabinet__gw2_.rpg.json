        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Construct Armor"
            },
            "trait_description": {
              "value": "Like normal objects, an apothecary's cabinet has Hardness. This Hardness reduces any damage it takes by an amount equal to the Hardness. Once an apothecary's cabinet is reduced to fewer than half its Hit Points, or immediately upon being damaged by a critical hit, its construct armor breaks and its Armor Class is reduced to 20."
            },
            "id": "01e34f19-8fe6-42ab-ac41-9bc19ec57b5b",
            "updated_at": {
              "value": "2026-03-19T22:59:01.341654"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Poison Stock"
            },
            "trait_description": {
              "value": "When the cabinet hits a creature with its poison bottle Strike, roll 1d4 to determine what kind of poison splashes onto the struck creature: **1** nerve poison (clumsy 1); **2** weakening poison (enfeebled 1); **3** noxious poison (sickened 1); **4** clouded mind poison (stupefied 1). The target must attempt a DC 24 Fortitude save.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature takes 1d6 poison damage.\n- **Failure:** The creature takes 2d6 poison damage and is afflicted with the rolled poison's associated condition until the end of its next turn.\n- **Critical Failure:** The creature takes 2d6 poison damage and is afflicted with the rolled poison's associated condition for 1d4+1 rounds."
            },
            "id": "fc8b1a6c-36dd-4a87-a5f0-18f32827d6d2",
            "updated_at": {
              "value": "2026-03-19T22:59:01.341654"
            }
          }
        }
      ]
