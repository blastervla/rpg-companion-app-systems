            "level": {
              "value": 17
            },
            "description": {
              "value": "You create a copy of a foe by calling them forth from a nearby reflection, clonally growing them in an instant from one of your hairs or otherwise creating them in a way that matches your own nature as a reflection. You can cast duplicate foe once per day as an innate occult spell."
            }
          }
