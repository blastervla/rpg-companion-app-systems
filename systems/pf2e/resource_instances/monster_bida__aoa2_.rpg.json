            "trait_name": {
              "value": "Eight Coils"
            },
            "trait_description": {
              "value": "A bida can Strike with its tail even while Grabbing creatures with it. The bida can have up to eight Medium or smaller creatures grabbed with its tail at a time; it can also grab Large creatures, but they count as four Medium creatures for this purpose."
            },
            "id": "d3fc71b8-9c5b-4e69-8390-22a0ddbcc7d8",
