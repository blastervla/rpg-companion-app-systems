            },
            "trait_description": {
              "value": "Dreamscrapers never sleep or dream themselves. They gain the benefits of an 8-hour rest after 1 hour of minimal activity."
            },
            "id": "30c73706-b6a3-4e9c-8548-00caefda6622",
