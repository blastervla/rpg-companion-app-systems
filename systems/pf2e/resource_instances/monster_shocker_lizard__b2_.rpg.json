    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Greater Electrolocation"
            },
            "trait_description": {
              "value": "A shocker lizard can sense minute electrical charges in living creatures, which it can use as a precise sense at a range of 20 feet. This distance increases to 100 feet against any creature that has used an electricity effect within the last minute."
            },
            "id": "95f6ba6f-94a3-4dda-865d-d42f869ae8c0",
            "updated_at": {
              "value": "2026-03-17T12:41:26.736825"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Shocking"
            },
            "trait_description": {
              "value": "Burst again for 1 minute.\n\nUp to four shocker lizards can combine their Shocking Bursts. In this case, the lizards can delay the release of their electricity until any other shocker lizard within 30 feet completes its Shocking Burst. The combined Shocking Bursts create an emanation with the combined area from all participating shocker lizards. For each additional shocker lizard that joins the burst, the damage increases by 3d8 and the save DC increases by 1 (to a maximum of four lizards dealing 12d8 damage with a DC 21 save)."
            },
            "id": "a883ebc4-0222-45af-91d6-bcace93b6567",
            "updated_at": {
              "value": "2026-03-17T12:41:26.736825"
            }
          }
        }
