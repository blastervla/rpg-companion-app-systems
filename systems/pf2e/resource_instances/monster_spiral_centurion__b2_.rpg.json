        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Top-Heavy"
            },
            "trait_description": {
              "value": "A spiral centurion's top-like design makes it susceptible to effects that would cause it to fall prone. The DC of any attempt to knock the spiral centurion prone is reduced by 5. If the spiral centurion attempts a check or saving throw to resist being knocked prone, it takes a \u20135 status penalty. A spiral centurion that has been knocked prone can't use any actions other than to attempt to Stand, but it must succeed at a 30 Acrobatics check to do so."
            },
