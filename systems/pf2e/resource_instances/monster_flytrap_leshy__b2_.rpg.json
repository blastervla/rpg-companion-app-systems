        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Change Shape"
            },
            "action_description": {
              "value": "(concentrate, polymorph, primal, transmutation)\n\nThe flytrap leshy transforms into a Small flytrap. This ability otherwise uses the effects of tree shape."
