        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Flay"
            },
            "action_description": {
              "value": "Requirements: The Skinsaw seamer dealt damage with a melee weapon other than its war razor with their last action\n\nThe seamer makes a war razor Strike against the same creature that they just damaged. On a hit, the seamer slices a strip of flesh from the target and deals 1d6 persistent bleed damage in addition to the war razor's usual damage."
            },
