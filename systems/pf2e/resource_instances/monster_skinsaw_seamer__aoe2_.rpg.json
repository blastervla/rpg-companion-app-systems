        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Quick Stitch"
            },
            "action_description": {
              "value": "The seamer stitches a piece of cloth to the creature's arm, face, or leg, potentially hindering it. The creature must attempt a DC 26 Reflex saving throw; if the seamer has already successfully used their Flay ability against the creature within the past minute, the creature's save result is one degree of success worse.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature takes 1d4 piercing damage.\nFailure: The creature is clumsy 1, dazzled, enfeebled 1, or flat-footed (seamer's choice). This effect lasts until the creature spends a single action to tear out the stitching, which deals 1d6 piercing damage to it.\nCritical Failure: The creature is clumsy 2, blinded, enfeebled 2, or flat-footed (seamer's choice). This effect lasts until the creature spends 2 actions to tear out the stitching, which deals 2d6 piercing damage to it."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
