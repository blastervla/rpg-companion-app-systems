          "special": {
            "value": "You can't select another dedication feat until you have gained two other feats from the weapon improviser archetype.\nLeads to: Improvised Critical|APG, Improvised Pummel|APG, Shattering Strike|APG, Makeshift Strike|APG, Surprise Strike|APG"
          },
          "descriptions": {
            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_95161b22ab7c",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "You don't take the normal –2 penalty to attack rolls with improvised weapons. Additionally, whenever you gain a class feature that grants you expert or greater proficiency with any weapon, you also gain that proficiency with improvised weapons."
                  }
                }
              }
            ]
