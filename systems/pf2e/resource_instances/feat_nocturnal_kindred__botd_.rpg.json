    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_3cf5be26b879",
            "level": {
              "value": 4
            },
            "description": {
              "value": "You have an innate connection with other creatures of the night and understand some of them. You can ask questions of, receive answers from, and use Diplomacy with bats, rats, and wolves. You also gain a +1 circumstance bonus to Make an Impression on such animals.\n\nOnce per day, you can cast animal allies (Pathfinder Secrets of Magic 89) as a divine innate spell, using your class DC or spell DC, whichever is higher. The creatures it summons are bats, rats, and wolves."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_830902c8505c",
            "level": {
              "value": 5
            },
            "description": {
              "value": "And every 2 levels thereafter, the spell is heightened by an additional level, to a maximum of a 9th-level animal allies when you are 19th level."
            }
          }
        }
      ]
    },
