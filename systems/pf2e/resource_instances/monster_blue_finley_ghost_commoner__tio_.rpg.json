          "stats": {
            "trait_name": {
              "value": "Incorporeal"
            },
            "trait_description": {
              "value": "A ghost has no body and can pass through physical objects, though it can't end its turn inside one. Most checks that use Strength and require a body, such as Grapple and Shove, don't work against a ghost, and a ghost can't use them against other creatures."
            },
