            "level": {
              "value": 1
            },
            "description": {
              "value": "You're at home in the wilderness and easily disappear into it. You gain a +1 circumstance bonus to Hide and Sneak in natural terrain, and a +1 circumstance bonus to Sense Direction in natural terrain. While in natural terrain, you're always considered to be Covering Tracks, even if you chose a different activity in exploration mode."
            }
          }
        }
