        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Unbalancing Blow"
            },
            "trait_description": {
              "value": "Creatures hit by the clockwork assassin's rapier hand Strike are flat-footed until the start of the clockwork assassin's next turn."
            },
