              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_af77fb3833ca",
                    "level": {
                      "value": 2
                    },
                    "description": {
                      "value": "Your limbs tense as you deliver a mighty swing. Make a melee Strike. If it hits, you deal an extra die of weapon damage and push the target back by 5 feet. If you're at least 10th level, increase this to two extra dice and push the target by 10 feet, and if you're at least 18th level, increase it to three extra dice and push the target by 15 feet.\n\n**Awakening** On a critical hit, you push the target back double the normal distance and knock it prone.\n\n**Awakening** On a hit, you deal 1d6 persistent bleed damage. This increases to 2d6 at 10th level and 3d6 at 18th level."
                    }
                  }
                }
              ]
            },
