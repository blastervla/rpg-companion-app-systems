    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Susceptible to Death"
            },
            "trait_description": {
              "value": "Though phantoms aren't alive, neither are they undead, and they are uniquely vulnerable to the effects of death. A phantom whose Hit Points are reduced to 0 as a result of a death effect (such as from a spell like finger of death) is immediately whisked away to the River of Souls, where their soul resumes the usual path to the afterlife."
            },
            "id": "052f15ea-bb63-4a60-8b47-5aab5c9a9ac8",
            "updated_at": {
              "value": "2026-03-29T00:33:27.983033"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerable to Kindness"
            },
            "trait_description": {
              "value": "Any creature within 30 feet that the phantom can see and hear can issue a calm and friendly greeting to it as a two-action activity with the auditory, concentrate, linguistic, and mental traits. A creature greeting the phantom in this manner must attempt a DC 17 Diplomacy check.\n\n- **Critical Success:** The phantom takes 4d8 mental damage and is stunned 1.\n- **Success:** The phantom takes 2d8 mental damage.\n- **Failure:** The phantom takes 1d8 mental damage.\n- **Critical Failure:** The phantom is unaffected, and is not affected by this weakness for 1 round."
            },
            "id": "f9d4bf1f-b266-4884-bb99-0b5c00f39fd6",
            "updated_at": {
              "value": "2026-03-29T00:33:27.983033"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Pack Attack"
            },
            "trait_description": {
              "value": "The phantom wolf's Strikes deal an additional 1d4 damage to creatures within reach of at least one of its allies."
            },
            "id": "17a9b281-8e3b-4cc6-b243-7d6b797b9924",
