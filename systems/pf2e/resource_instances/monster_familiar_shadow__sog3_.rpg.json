        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Light Vulnerability"
            },
            "trait_description": {
              "value": "An object shedding magical light (such as from the light spell) is treated as magical when used to attack the shadow."
            },
            "id": "747f5052-7231-4b67-9fc1-d7cec0909808",
