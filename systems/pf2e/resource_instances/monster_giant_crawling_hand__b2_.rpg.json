          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mark Quarry"
            },
            "trait_description": {
              "value": "A crawling hand can be assigned a quarry by anointing the hand with a drop of the intended quarry's blood. If the hand ever has no quarry, it automatically gains the next creature it damages as its quarry. The hand gains a +1 circumstance bonus to Perception checks when it Seeks its quarry, to Survival checks when it Tracks its quarry, and damage rolls when it Strikes its quarry."
            },
