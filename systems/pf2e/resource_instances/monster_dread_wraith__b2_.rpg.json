            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sunlight Powerlessness"
            },
            "trait_description": {
              "value": "A dread wraith caught in sunlight is stunned 2 and clumsy 2."
            },
            "id": "e2a15c7f-c135-4487-b7e3-c62467c4c49e",
            "updated_at": {
              "value": "2026-03-29T00:33:08.154488"
            }
