        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Draining Presence"
            },
            "trait_description": {
              "value": "(aura, negative)\n\n10 feet. A creature entering the aura must succeed at a 26 Fortitude save or become drained 1. It recovers after it has been out of the aura for 1 minute. This drained condition value is cumulative with the drained value caused by drain life, but not with multiple draining presence auras. A creature that succeeds at its save is temporarily immune to draining presence for 24 hours."
            },
            "id": "95c049f7-e617-4e4b-9fd5-c8ee2cc6f7b9",
