        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Conformance"
            },
            "action_description": {
              "value": "(concentrate, occult, polymorph, transmutation)\n\nThe conformer contorts and reshapes their body into a desired form. The conformer takes on the specific appearance of any Small, Medium, or Large humanoid or animal that they've observed and whose appearance they remember. This doesn't change the conformer's Speed or their attack and damage bonus with their Strikes, but might change the damage type their Strikes deal."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
