              "value": "2026-04-15T14:13:06.633415"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Tissue Siphon"
            },
            "action_description": {
              "value": "(manipulate, occult, transmutation)\n\nRequirements: The conformer is within reach of an unconscious or willing creature, or a creature taking persistent bleed damage\n\nThe conformer touches and absorbs some of the creature's flesh. The target must attempt a 26 Fortitude save; on a failure, they become drained 1 and take damage from their persistent bleed damage, even though it isn't the end of their turn."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "043c142e-f7ba-4ffb-8a7e-b60fa76feb84",
            "updated_at": {
              "value": "2026-04-15T14:13:06.633415"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Wear Flesh"
            },
            "action_description": {
              "value": "(transmutation, occult)\n\nRequirements: The conformer has used Tissue Siphon to absorb flesh within the last hour\n\nThe conformer expends the flesh they've absorbed to transform their body, reproducing the effects of one of the following spells: adapt self (Gods & Magic 112), enlarge, shifting form (Core Rulebook 407), tentacular limbs (Core Rulebook 405), or unusual anatomy (Core Rulebook 405). The Wear Flesh action gains the traits of the spell it's reproducing, and the conformer can Sustain a Spell on these effects."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
