        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vermin Empathy"
            },
            "trait_description": {
              "value": "Mitflits can use Diplomacy to Make an Impression on and Request things of arthropods (insects, spiders, scorpions, crabs, and similar invertebrate animals). Most arthropods have a starting attitude of indifferent to mitflits."
            },
            "id": "83191e12-62f6-4bb1-8658-be8503ad1667",
            "updated_at": {
              "value": "2026-03-17T12:41:25.944969"
            }
