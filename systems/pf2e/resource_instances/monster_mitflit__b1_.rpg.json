            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vermin Empathy"
            },
            "trait_description": {
              "value": "Mitflits can use Diplomacy to Make an Impression on and Request things of arthropods (insects, spiders, scorpions, crabs, and similar invertebrate animals). Most arthropods have a starting attitude of indifferent to mitflits."
            },
            "id": "a766870d-2b61-4029-bc29-a08b0ba81c7e",
            "updated_at": {
              "value": "2026-03-23T01:11:48.023497"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vengeful Anger"
            },
            "trait_description": {
              "value": "(emotion, mental)\n\nAs long as it isn't frightened, a mitflit gains a +2 status bonus to damage rolls against a creature that has previously damaged or tormented it."
            },
