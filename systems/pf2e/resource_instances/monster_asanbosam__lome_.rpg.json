        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Attack From Above"
            },
            "action_description": {
              "value": "Requirements: The asanbosam is positioned above a creature\n\nThe asanbosam makes a claw Strike with its reach increased to 15 feet. On a hit, the Strike deals an additional 1d6 slashing damage and the asanbosam immediately Grabs the target and pulls it to a space adjacent to the asanbosam. This counts as two attacks for the asanbosam's multiple attack penalty."
            },
