    "description": {
      "value": "You exhale a shimmering cloud of toxic breath at an enemy's face. The target takes 1d4 poison damage and 1d4 persistent poison damage, depending on its Fortitude save.\n\nCritical Success: The creature is unaffected.\nSuccess: The target takes half initial damage and no persistent damage.\nFailure: The target takes full initial and persistent damage.\nCritical Failure: The target takes double initial and persistent damage."
    },
    "higher_level_description": {
      "value": "Heightened (+2): The initial poison damage increases by 1d4, and the persistent poison damage increases by 1d4."
    },
