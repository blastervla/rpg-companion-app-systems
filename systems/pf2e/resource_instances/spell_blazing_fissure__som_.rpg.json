    "description": {
      "value": "A thin crack rips through the earth, erupting with magma, then swiftly seals up. Each creature along the line and on solid ground takes 4d6 bludgeoning damage and 6d6 fire damage with a Reflex save.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature takes half damage.\nFailure: The creature takes full damage, and it falls prone.\nCritical Failure: The target takes double damage, and it falls prone."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d6 bludgeoning and 1d6 fire."
    },
