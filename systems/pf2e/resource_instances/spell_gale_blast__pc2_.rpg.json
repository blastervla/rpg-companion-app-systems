    "description": {
      "value": "Wind flows from your outstretched hands and whirls around you in a 5-foot emanation. Each creature in the area takes 1d6 bludgeoning damage, with a Fortitude save.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature takes half damage.\nFailure: The creature takes full damage and is pushed 5 feet away from you.\nCritical Failure: The creature takes double damage and is pushed 10 feet away from you."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d6."
