        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sneak Attack"
            },
            "trait_description": {
              "value": "The babau's Strikes deal an extra 2d6 precision damage to flat-footed creatures.\n\nRituals like planar ally or planar binding are typical for long-term ends, and summon fiend for combat applications. For planar ally, demons."
