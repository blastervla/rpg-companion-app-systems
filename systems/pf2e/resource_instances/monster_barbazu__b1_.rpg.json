        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Infernal Wound"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nA bearded devil's glaive Strike also deals 1d6 persistent bleed damage that resists attempts to heal it. The flat check to stop the bleeding starts at 20. The DC is reduced to 15 only if the bleeding creature or an ally successfully assists with the recovery.\n\nThe DC to Administer First Aid to a creature with an infernal wound is increased by 5. A spellcaster or item attempting to use healing magic on a creature suffering from an infernal wound must succeed at a 21 counteract check or the magic fails to heal the creature."
            },
            "id": "bcaa1b4c-30d0-42b5-948e-8c5e9749bb29",
            "updated_at": {
              "value": "2026-03-29T00:33:07.115375"
            }
          }
        }
