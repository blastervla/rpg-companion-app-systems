            "trait_name": {
              "value": "Avernal Fever"
            },
            "trait_description": {
              "value": "**Avernal Fever**\nDC: 23\nSaving Throw: Fortitude\n- Stage 1: carrier with no ill effect (1 day)\n- Stage 2: enfeebled 1 (1 day)\n- Stage 3: enfeebled 2 (1 day)"
            },
            "id": "c6acf464-a07f-473b-ba96-cd5695e3351d",
