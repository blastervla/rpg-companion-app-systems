            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Inhale Vitality"
            },
            "action_description": {
              "value": "(necromancy, occult)\n\nFrequency once per day; The augnagar inhales sharply, drawing life force out of creatures in a 50-foot cone. Creatures in the area take 14d6 negative damage (34 basic Fortitude save, and the creature is fatigued on a failure). The augnagar becomes quickened for 1 round on its next turn, and it can use the extra action only to Stride or Strike."
            },
