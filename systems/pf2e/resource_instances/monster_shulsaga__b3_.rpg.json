        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Disk Rider"
            },
            "trait_description": {
              "value": "A shulsaga can ride atop any floating disk they create. While mounted on a floating disk, a shulsaga gains a +10-foot enhancement bonus to their fly Speed, and the shulsaga can use their feet to wield the disk as a heavy shield (Hardness 5, HP 20, BT 10)\n\nA broken disk grants no bonus to Speed, and the spell ends if the disk is destroyed."
            },
            "id": "0229c598-e0ea-4c96-834d-334802705f30",
            "updated_at": {
