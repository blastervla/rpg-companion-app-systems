        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Astral Shock"
            },
            "trait_description": {
              "value": "An astrally projected creature whose astral form is slain by a shulsaga takes a \u20132 circumstance penalty to the subsequent Fortitude saving throw to resist the strain."
            },
            "id": "a309234f-e307-4887-82c6-1dffe2af06be",
            "updated_at": {
              "value": "2026-03-19T22:58:52.486333"
