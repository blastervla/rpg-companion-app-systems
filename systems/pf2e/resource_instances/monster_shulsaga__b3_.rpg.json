            "trait_name": {
              "value": "Rift Sense"
            },
            "trait_description": {
              "value": "A shulsaga can sense any planar rift within 1 mile, including natural portals, ongoing planar spells like gate, and other tears in reality. By concentrating for 1 minute, a shulsaga can increase this sense's range to 25 miles."
            },
            "id": "114e596a-6a12-4464-b783-e9f332298f56",
