                "stats": {
                  "id": "levelled_description_10c3025f7bd2",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "Your lion blade spy training helps you conceal yourself and your identity. You become trained in your choice of Deception or Stealth and in Espionage Lore; if you were already trained, you become an expert instead. You never take circumstance penalties for attempting to take a disguise of a different ancestry, age, and so on, as long as the disguised form is appropriate for your size."
                  }
                }
              }
            ]
