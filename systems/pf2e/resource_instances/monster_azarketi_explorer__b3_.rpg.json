            "trait_name": {
              "value": "Hydration"
            },
            "trait_description": {
              "value": "An azarketi must regularly submerge themself in water to rehydrate their water-acclimated skin. After the first 24 hours outside of water, they take a \u20131 status penalty to Fortitude saves as their skin cracks and their gills become painful. After 48 hours, they struggle to breathe air and begin to suffocate until returned to water."
            },
            "id": "88694898-04b0-4a1d-a098-ebb82f20370a",
            "updated_at": {
              "value": "2026-03-19T22:58:52.486333"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Surface Skimmer"
            },
            "trait_description": {
              "value": "While the azarketi explorer is submerged just below the water's surface, they have cover from attacks made by creatures out of the water."
            },
