            "spell": {
              "value": {
                "resource_id": "spell",
                "stats": {
                  "id": "insect_form__pc1_",
                  "name": {
                    "value": "Insect Form"
                  },
                  "source": {
                    "value": "pc1"
                  },
                  "level": {
                    "value": "spell_level_3"
                  },
                  "school": {
                    "value": "none"
                  },
                  "traditions": {
