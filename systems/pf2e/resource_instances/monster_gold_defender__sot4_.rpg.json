    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Death Throes"
            },
            "trait_description": {
              "value": "When the gold defender is destroyed, it melts into worthless slag. As it melts, it releases a 10-foot radius cloud of fumes and a 10-foot radius puddle of molten metal.\n\nCreatures that breathe fumes are exposed to gold defender poison. Creatures that move through the puddle take 10d6 fire damage. The fumes dissipate after 1 round and the puddle cools after 1 minute."
            },
            "id": "ad350811-dc4f-4d34-af2e-1a9757f2900e",
            "updated_at": {
              "value": "2026-03-17T12:41:41.569744"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Golem"
            },
            "trait_description": {
              "value": "Antimagic harmed by cold (6d10, 2d8 from areas and persistent damage); healed by fire (area 2d8 HP); slowed by acid"
            },
            "id": "2eec6746-226d-4622-b9d4-7b6c2af58a5e",
            "updated_at": {
              "value": "2026-03-17T12:41:41.569744"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Malleable Shape"
            },
            "trait_description": {
              "value": "The gold defender's body is made from soft gold, which is particularly pliable. If the gold defender is critically hit with an attack that deals bludgeoning damage, the attack partially bends and reshapes the gold defender. The gold defender becomes clumsy 2 until it spends an Interact action to bend itself back into shape."
            },
            "id": "c1ec98a8-8271-4570-9eca-15ff638818d8",
            "updated_at": {
              "value": "2026-03-17T12:41:41.569744"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerable to Telekinetic Haul"
            },
            "trait_description": {
              "value": "Casting telekinetic haul on the gold defender squeezes its form, compressing it into a smaller and much more awkward shape. The gold defender becomes clumsy 3 and can't use Light Reflection.\n\nThe gold defender must take a 1-minute activity, which has the manipulate trait, to restore its shape, removing the clumsy condition and restoring its Light Reflection."
            },
            "id": "1418eec9-c54d-48bd-9e95-3ee333e8875c",
            "updated_at": {
              "value": "2026-03-17T12:41:41.569744"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Gold Defender Poison"
            },
            "trait_description": {
              "value": "(poison)\n\nAny drained value from this poison is reduced by 1 every hour;\n\nDC 33 Fortitude; Maximum Duration 4 rounds; Stage 1: 2d6 poison and drained 1 (1 round); Stage 2: 4d6 poison and drained 2 (1 round); Stage 3: 8d6 poison and drained 3 (1 round)"
            },
            "id": "a4e9faf4-72be-47a9-86b4-449cb839c1ca",
