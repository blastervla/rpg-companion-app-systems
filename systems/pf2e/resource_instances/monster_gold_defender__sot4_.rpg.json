        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Inexorable March"
            },
            "action_description": {
              "value": "The gold defender Strides up to its Speed, pushing back each creature whose space it moves into and damaging them if they try to stop its movement.\n\nA creature can attempt to bar the way by succeeding at a 37 Fortitude save. On a critical success, the resisting creature takes no damage; otherwise, it is damaged as if hit by the defender's fist Strike."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
