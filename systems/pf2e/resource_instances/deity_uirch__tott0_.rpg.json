    "description": {
      "value": "Uirch promotes using one's strength to defend the weak and employing systems to benefit the people. His teachings are antithetical to many traditional orc beliefs, making his edicts a challenge to accept."
    },
    "areas_of_concern": {
      "value": ""
    },
    "edicts": {
      "value": "protect the weak and innocent, keep your word, do not throw your life away needlessly"
    },
    "anathema": {
      "value": "allow tyranny to stand uncontested, put your own safety before those in need of defending, make a promise with the intent to break it"
