    "special": {
      "value": "You can't select another dedication feat until you have gained two other feats from the marshal archetype.\nLeads to: Back to Back|APG, Cadence Call|APG, Tactical Cadence|APG, Coordinated Charge|APG, Dread Marshal Stance|APG, Inspiring Marshal Stance|APG, Rallying Charge|APG, Snap Out of It!|APG, Steel Yourself!|APG, Target of Opportunity|APG, To Battle!|APG, Topple Foe|APG, Push Back the Dead!|LOKL"
    },
    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_00a63eda49a6",
            "level": {
              "value": 2
            },
            "description": {
              "value": "You've combined your social skills and combat training to become a talented combat leader. Choose Diplomacy or Intimidation. You become trained in that skill or become an expert if you were already trained in it.\n\nIn addition, you're surrounded by a marshal's aura in a 10-foot emanation. Your aura has the emotion, mental, and visual traits and grants you and allies within the aura a +1 status bonus to saving throws against fear."
            }
          }
        }
      ]
    },
