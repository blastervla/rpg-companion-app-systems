          "stats": {
            "trait_name": {
              "value": "Undetectable"
            },
            "trait_description": {
              "value": "(abjuration, primal)\n\nA water orm automatically tries to counteract any detection, revelation, or scrying divination attempted against it, using its Stealth modifier for the counteract check."
