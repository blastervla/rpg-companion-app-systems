              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_f037f4cf29c5",
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "You have exceptional talent with one type of performance. You gain a +1 circumstance bonus when making a certain type of performance. If you are a master in Performance, this bonus increases to +2. Select one of the following specialties and apply the bonus when attempting Performance checks of that type. If it's unclear whether the specialty applies, the GM decides.\n\n| Specialty | Examples |\n| --- | --- |\n| Acting | Drama, pantomime, puppetry |\n| Comedy | Buffoonery, joke telling, limericks |\n| Dance | Ballet, huara, jig, macru |\n| Keyboards | Harpsichord, organ, piano |\n| Oratory | Epic, ode, poetry, storytelling |\n| Percussion | Chimes, drum, gong, xylophone |\n| Singing | Ballad, chant, melody, rhyming |\n| Strings | Fiddle, harp, lute, viol |\n| Winds | Bagpipe, flute, recorder, trumpet |"
                    }
                  }
                }
              ]
