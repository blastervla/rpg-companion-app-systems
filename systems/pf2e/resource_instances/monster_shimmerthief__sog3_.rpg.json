          "stats": {
            "trait_name": {
              "value": "Echolocation"
            },
            "trait_description": {
              "value": "A shimmerthief can use their hearing as a precise sense at the listed range."
            },
            "id": "91372fb9-6974-4061-9d13-2503a68af9c7",
