        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Shimmervision"
            },
            "trait_description": {
              "value": "A shimmerthief's sight allows them to sense sources of light from the same distance as creatures with standard vision but doesn't allow them to make out details. They can't detect anything other than light sources using this vision."
            },
            "id": "cba4c295-87dc-4116-8a52-4a3ca2ce97e3",
