          "stats": {
            "trait_name": {
              "value": "Echolocation"
            },
            "trait_description": {
              "value": "A shimmerthief can use their hearing as a precise sense at the listed range."
            },
            "id": "dc32918a-7107-443e-bdaf-487a25ba5286",
