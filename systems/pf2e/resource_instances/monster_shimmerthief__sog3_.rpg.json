        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Gleam Theft"
            },
            "trait_description": {
              "value": "(aura, darkness, primal)\n\n10 feet. A shimmerthief constantly absorbs ambient light. Bright light in their aura becomes dim light, and dim light becomes darkness. A shimmerthief can suppress or activate this aura as a single action with the concentrate trait."
            },
            "id": "40554b6d-12b2-482b-85fe-373414ee0f9f",
