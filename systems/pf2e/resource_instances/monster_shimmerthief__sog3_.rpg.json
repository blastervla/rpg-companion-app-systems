            "action_name": {
              "value": "Drain Light"
            },
            "action_description": {
              "value": "(abjuration, darkness, primal)\n\nThe shimmerthief targets a light source within 30 feet, then attempts to counteract it with a spell attack roll. If they succeed, the shimmerthief regains 2d8+10 Hit Points (4d8+20 Hit Points on a critical success)."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
