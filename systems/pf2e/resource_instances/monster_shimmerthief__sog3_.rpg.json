          "stats": {
            "trait_name": {
              "value": "Echolocation"
            },
            "trait_description": {
              "value": "A shimmerthief can use their hearing as a precise sense at the listed range."
            },
            "id": "81165e15-9418-430d-9a79-1a4e76d4cc7a",
