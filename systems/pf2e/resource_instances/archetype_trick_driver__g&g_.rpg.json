          "descriptions": {
            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_2354b3a7c2dc",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "You are equally at home piloting any vehicle, adapting yourself instantly to varied controls, movements, and handling.\n\nWhenever piloting a vehicle requires a Piloting Lore or Sailing Lore check, you can use your Driving Lore proficiency instead.\n\nYou can use Dexterity in place of Intelligence when attempting piloting checks with Driving Lore. You become an expert in Driving Lore."
                  }
                }
              },
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_2c3046ba9d07",
                  "level": {
                    "value": 7
                  },
                  "description": {
                    "value": "You become a master in Driving Lore, and at 15th level, you become legendary in Driving Lore."
                  }
                }
              }
            ]
