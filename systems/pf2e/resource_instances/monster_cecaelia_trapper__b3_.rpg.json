        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Ink Cloud"
            },
            "action_description": {
              "value": "The cecaelia emits a cloud of black ink in a 10-foot emanation. This ink cloud has no effect outside of water. Creatures inside the cloud are undetected by creatures using sight or smell, and they can't see or smell while inside the cloud.\n\nThe cloud dissipates after 1 minute. The cecaelia can't use Ink Cloud again for 2d6 rounds."
            },
