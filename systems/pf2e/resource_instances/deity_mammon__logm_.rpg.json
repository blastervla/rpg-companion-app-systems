            "spell": {
              "value": {
                "resource_id": "spell",
                "stats": {
                  "id": "magnificent_mansion__crb_",
                  "name": {
                    "value": "Magnificent Mansion"
                  },
                  "source": {
                    "value": "crb"
                  },
                  "level": {
                    "value": "spell_level_7"
                  },
                  "school": {
                    "value": "spell_school_conjuration"
