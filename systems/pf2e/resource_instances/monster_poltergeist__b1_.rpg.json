        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rejuvenation"
            },
            "trait_description": {
              "value": "(necromancy, occult)\n\nWhen a poltergeist is destroyed, it re-forms, fully healed, where it was destroyed after 2d4 days. A poltergeist can be permanently destroyed only if someone determines the reason for its existence and sets right whatever prevents the spirit from resting."
            },
            "id": "90810b36-e07f-4f37-811d-4a5abee33b76",
            "updated_at": {
              "value": "2026-03-17T12:41:25.944969"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Site Bound"
            },
            "trait_description": {
              "value": "A poltergeist is tied to a location and can't travel more than 120 feet from the place where it was created or formed. Some poltergeists are instead bound to a specific room, building, or similar area."
            },
            "id": "e64f3203-445f-4965-a540-75ee80e30463",
