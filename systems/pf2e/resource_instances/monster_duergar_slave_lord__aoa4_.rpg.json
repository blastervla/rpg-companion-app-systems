              "value": []
            },
            "id": "9880ab38-e3a6-4285-bea8-5305589502e0",
            "updated_at": {
              "value": "2026-03-17T12:41:22.444580"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Hunter's Flurry"
            },
            "action_description": {
              "value": "Frequency: 1/round\n\nThe slave lord makes two bow Strikes or two melee Strikes, each using a different weapon. These Strikes must target the slave lord's prey. If both Strikes hit, combine their damage for the purpose of resistances and weaknesses."
            },
