        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ensnare"
            },
            "trait_description": {
              "value": "When the gourd leshy damages a creature with a fist or seed Strike, vines lash out from the leshy (or seed) and wrap around the target's limbs. The target must attempt a DC 17 Reflex save. On a failure, the target takes a \u201310-foot status penalty to its Speed for 1 round; on a critical failure, the target is immobilized for 1 round and the penalty to Speed lasts for 1 minute."
            },
            "id": "734fbf00-ad6c-43a6-8581-e6fff39bdcc1",
            "updated_at": {
