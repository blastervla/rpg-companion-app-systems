        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ensnare"
            },
            "trait_description": {
              "value": "When the gourd leshy damages a creature with a fist or seed Strike, vines lash out from the leshy (or seed) and wrap around the target's limbs. The target must attempt a 17 Reflex save. On a failure, the target takes a \u201310-foot status penalty to its Speed for 1 round; on a critical failure, the target is immobilized for 1 round and the penalty to Speed lasts for 1 minute."
            },
            "id": "77d34ad0-dce5-46cd-b78e-c4912349069f",
            "updated_at": {
