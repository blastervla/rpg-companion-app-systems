    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Corrupted Touch"
            },
            "trait_description": {
              "value": "An esobok ghoul's Strikes deal 1d6 negative damage to living creatures. A creature critically hit by an esobok ghoul's Strike must attempt a DC 18 Fortitude save or become drained 1 (drained 2 on a critical failure) as rot spreads throughout their flesh."
            },
            "id": "72df1f67-369e-4fdf-88ef-5caac4e5c7d0",
            "updated_at": {
              "value": "2026-03-19T22:59:05.770337"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ghoul Fever"
            },
            "trait_description": {
              "value": "**Ghoul Fever**\nDC: 22\nSaving Throw: Fortitude\n- Stage 1: carrier with no ill effect (1 day)\n- Stage 2: 2d6 negative damage and regains half as many Hit Points from all healing (1 day)\n- Stage 3: as stage 2 (1 day)\n- Stage 4: 2d6 negative damage and gains no benefit from healing (1 day)\n- Stage 5: as stage 4 (1 day)\n- Stage 6: dead, and rises as a ghoul the next midnight"
            },
            "id": "c45e7b79-d46f-4092-b079-f36a2654bffa",
            "updated_at": {
              "value": "2026-03-19T22:59:05.770337"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation, occult, necromancy)\n\nAny living, non-elf creature hit by a ghoul's attack must succeed at a 22 Fortitude save or become paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
            },
            "id": "293c69a2-0b1e-4495-bbba-05a04a24f590",
            "updated_at": {
              "value": "2026-03-19T22:59:05.770337"
            }
          }
        }
