            },
            "description": {
              "value": "Your studies into the supernatural have resulted in an especially strong knowledge of rituals. You gain a +2 circumstance bonus to all primary checks to perform a ritual. You learn two uncommon rituals with a level no higher than half your level; you must meet all prerequisites for casting the ritual to choose it. You can cast these as the primary caster, but you can't teach them to anyone else or allow someone else to serve as primary caster unless they know the ritual as well."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_14d40e683927",
            "level": {
              "value": 8
            },
            "description": {
              "value": "Every 4 levels thereafter, you learn another uncommon ritual with a level no higher than half your level and for which you meet the prerequisites."
            }
          }
        }
