      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Restrain"
            },
            "trait_description": {
              "value": "When the jailer makes a successful mancatcher Strike, their target must succeed at a 27 Reflex save or become grabbed until the end of the jailer's next turn.\n\nEach time the target fails an attempt to Escape the jailer, it takes 2d6 piercing damage."
            },
            "id": "56dd0b8f-4ff7-4bea-a242-146e4a3573c4",
            "updated_at": {
              "value": "2026-04-15T14:13:11.195325"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Subduing Attack"
            },
            "trait_description": {
              "value": "Abendego jailers deal an additional 3d6 precision damage to creatures that are frightened or within reach of at least one of their allies. The jailer can make an attack with this additional damage as a nonlethal attack, if they choose."
            },
            "id": "50459fc8-36a7-4f8a-abb7-f007aaef2c91",
            "updated_at": {
              "value": "2026-04-15T14:13:11.195325"
