            "trait_name": {
              "value": "Subduing Attack"
            },
            "trait_description": {
              "value": "Abendego jailers deal an additional 3d6 precision damage to creatures that are frightened or within reach of at least one of their allies. The jailer can make an attack with this additional damage as a nonlethal attack, if they choose."
            },
