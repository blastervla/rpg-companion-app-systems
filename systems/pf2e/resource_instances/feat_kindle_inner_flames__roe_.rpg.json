      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_a1f79cdb56fb",
            "level": {
              "value": 8
            },
            "description": {
              "value": "As a candle can light another, you awaken the latent potential to channel fire in other creatures. You shed faint, glowing embers, as do your allies while they're in your kinetic aura. Anyone shedding these embers gains a +1 status bonus to Reflex saves and Acrobatics checks and can Step as a free action once per round. When an affected creature takes a move action, its Strikes deal an extra 2 fire damage until the end of its turn."
            }
          }
        }
      ]
    },
