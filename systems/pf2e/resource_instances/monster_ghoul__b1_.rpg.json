        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ghoul Fever"
            },
            "trait_description": {
              "value": "**Ghoul Fever**\nDC: 15\nSaving Throw: Fortitude\n- Stage 1: carrier with no ill effect (1 day)\n- Stage 2: 2d6 negative damage and regains half as many Hit Points from all healing (1 day)\n- Stage 3: as stage 2 (1 day)\n- Stage 4: 2d6 negative damage and gains no benefit from healing (1 day)\n- Stage 5: as stage 4 (1 day)\n- Stage 6: dead, and rises as a ghoul the next midnight"
            },
            "id": "593ae1ea-35f3-4f1b-bf18-686e25779154",
            "updated_at": {
              "value": "2026-03-19T22:58:50.064440"
            }
