        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation, occult, necromancy)\n\nAny living, non-elf creature hit by a ghoul's attack must succeed at a 15 Fortitude save or become paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
            },
