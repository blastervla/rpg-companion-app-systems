      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_20368a9b1e9f",
            "level": {
              "value": 1
            },
            "description": {
              "value": "You enter a stance of fluid grace as small amounts of water flow with your movements and attacks. You can make flowing wave attacks that deal 1d6 bludgeoning damage. They are in the brawling group and have the agile, disarm, finesse, nonlethal, trip, unarmed, and water traits.\n\nWhile in Reflective Ripple Stance, you gain a +1 circumstance bonus to Athletics checks to Disarm, Swim, or Trip, and you gain a +2 circumstance bonus to your Reflex DC to avoid being Disarmed and Tripped."
            }
          }
        }
      ]
