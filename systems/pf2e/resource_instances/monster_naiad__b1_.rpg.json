        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Water Dependent"
            },
            "trait_description": {
              "value": "A naiad bonds to a spring, pool, pond, or similar-sized water feature. While within 300 feet of her bonded body of water, she can use her innate tidal surge at will. She doesn't recover Hit Points or reduce the drained condition when resting beyond that range. Unlike most other nymphs, she doesn't suffer penalties from being apart from her bonded body of water. A naiad can perform a 24-hour ritual to bond herself to a new body of water."
            },
            "id": "83832f62-0d78-4018-86dd-5ca1f4f328dc",
            "updated_at": {
              "value": "2026-04-15T14:13:00.984060"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Wild Empathy"
            },
            "trait_description": {
              "value": "The naiad can use Diplomacy to Make an Impression on and make very simple Requests of animals."
