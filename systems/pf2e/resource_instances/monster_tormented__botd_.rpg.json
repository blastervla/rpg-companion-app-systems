    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Endless Suffering"
            },
            "trait_description": {
              "value": "The type of torture that killed a tormented determines the effect of their Tortured Gaze, as listed below. The damage type listed in parentheses deactivates their regeneration and is their damage weakness. The most common tortured deaths are as follows."
            },
            "id": "9ece2e83-a5e9-4a27-9d61-ec43e01753eb",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Burning"
            },
            "trait_description": {
              "value": "(fire)\n\nThe tormented perished by fire and brand. The target takes 6d6 fire damage and is wreathed in ghostly flames for 1 minute, negating its concealed condition and rendering it concealed if it would be invisible."
            },
            "id": "2d2ec269-4405-45e8-b186-26a7bf9fa80b",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Crushing"
            },
            "trait_description": {
              "value": "(bludgeoning)\n\nThe tormented was crushed or broken on the wheel. The target takes 4d8 bludgeoning damage and is knocked prone."
            },
            "id": "48ff54e7-f9ab-4b2f-ad24-55f7e7f3a6e5",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Dislocation"
            },
            "trait_description": {
              "value": "(bludgeoning)\n\nThe tormented had their limbs repeatedly broken or dislocated. For 1d4 rounds, the target is clumsy 2 and slowed 1."
            },
            "id": "a3c88eb0-2326-45d0-a560-00270a2cf11d",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Drowning"
            },
            "trait_description": {
              "value": "(cold)\n\nThe tormented was repeatedly drowned, held underwater and pulled back at the last instant. The target takes 4d6 cold damage and is sickened 2."
            },
            "id": "ce01d423-20b5-4eeb-a88e-121f33d07cc8",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Impalement"
            },
            "trait_description": {
              "value": "(piercing)\n\nThe tormented was pierced with spears or blades and left to slowly die. The target takes 8d4 persistent bleed damage. (The creature doesn't take the persistent damage this turn, nor does it get its flat check to end the damage.)"
            },
            "id": "74e00946-3b1e-4595-94b4-01d771cef713",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Starvation"
            },
            "trait_description": {
              "value": "(cold)\n\nThe tormented starved to death, denied food until the end. For 1 minute, the target is enfeebled 2 and fatigued."
            },
            "id": "120f4a60-37ac-4997-82ff-a60be506282e",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Tortured Gaze"
            },
            "trait_description": {
              "value": "(aura, divine, illusion, mental)\n\n30 feet, or 60 feet if the tormented is at 125 HP or lower. The psychic agony of a tormented spills into the world around them, inflicting murderous hallucinations replicating the tormented's last moments. A non-undead creature that ends its turn in the aura must succeed at a 32 Will save or take the effect listed under Endless Suffering. While it has a condition from Tortured Gaze, a creature can't gain a new condition from the aura but can take damage from it again."
            },
            "id": "07b3be7b-48e2-453a-9014-ecb6dc8eaaee",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        }
      ]
