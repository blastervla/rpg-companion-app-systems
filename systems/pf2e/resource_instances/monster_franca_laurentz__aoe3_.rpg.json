        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Bloody Rebel"
            },
            "action_description": {
              "value": "Franca quickly slashes at nearby foes, aiming to maim rather than disable. She makes up to three melee Strikes, each against a different creature within reach. These Strikes count toward Franca's multiple attack penalty, but the penalty doesn't increase until after all three Strikes are made. On a hit, the Strike deals 3 persistent bleed damage instead of its normal damage. On a critical hit, the creature is flat-footed until the beginning of Franca's next turn or until they spend an action to remove the condition, whichever comes first."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "6ae17d9a-cbfa-47f3-9082-0f6f6ea666e0",
            "updated_at": {
              "value": "2026-04-15T14:12:59.597806"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Hamstring"
            },
            "action_description": {
              "value": "Requirements: Franca's last action was a melee Strike that dealt sneak attack damage to a flat-footed target\n\nFranca deals 6 persistent bleed damage to the target creature, and the target is slowed 1."
            },
