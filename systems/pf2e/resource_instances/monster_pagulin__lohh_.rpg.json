    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Blinding Spittle"
            },
            "trait_description": {
              "value": "A creature hit by a pagulin's spit must attempt a 22 Fortitude save.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature is dazzled for 1 round. It can use an Interact action to wipe away the spittle and remove the dazzled condition.\n- **Failure:** As success, except the creature is blinded for 1 round instead of dazzled.\n- **Critical Failure:** As failure, but the creature is blinded for 1 minute. The creature needs 2 total Interact actions to wipe away the spittle."
            },
            "id": "989f04a7-c5e3-4abd-a0c6-d98670d2265f",
            "updated_at": {
              "value": "2026-03-29T00:33:20.448097"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Tail Impalement"
            },
            "trait_description": {
              "value": "A creature hit by a pagulin's tail becomes impaled on one of the tail's spikes. The creature becomes grabbed. If the pagulin moves, it brings the grabbed creature along with it. The pagulin doesn't need to use additional actions to keep the creature grabbed; the creature remains grabbed as long as it's impaled. The grabbed creature can attempt to Escape as normal. Large and larger creatures are immune to a pagulin's Tail Impalement."
            },
            "id": "2c3b851f-c95f-46ce-88a3-2680079de906",
            "updated_at": {
              "value": "2026-03-29T00:33:20.448097"
            }
          }
        }
      ]
