    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Blinding Spittle"
            },
            "trait_description": {
              "value": "A creature hit by a pagulin's spit must attempt a DC 22 Fortitude save.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature is dazzled for 1 round. It can use an Interact action to wipe away the spittle and remove the dazzled condition.\nFailure: As success, except the creature is blinded for 1 round instead of dazzled.\nCritical Failure: As failure, but the creature is blinded for 1 minute. The creature needs 2 total Interact actions to wipe away the spittle."
            },
            "id": "e88b0d99-a4a0-4699-8a51-ffe648d0b4e4",
            "updated_at": {
              "value": "2026-03-17T12:41:34.430005"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Tail Impalement"
            },
            "trait_description": {
              "value": "A creature hit by a pagulin's tail becomes impaled on one of the tail's spikes. The creature becomes grabbed. If the pagulin moves, it brings the grabbed creature along with it. The pagulin doesn't need to use additional actions to keep the creature grabbed; the creature remains grabbed as long as it's impaled. The grabbed creature can attempt to Escape as normal. Large and larger creatures are immune to a pagulin's Tail Impalement."
            },
            "id": "87134955-2e94-45f8-8cc4-3341a349dde6",
            "updated_at": {
              "value": "2026-03-17T12:41:34.430005"
            }
          }
        }
      ]
