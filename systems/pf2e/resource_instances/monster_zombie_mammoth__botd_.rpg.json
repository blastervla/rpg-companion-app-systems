          "stats": {
            "trait_name": {
              "value": "Strikes, or Shambling Trample."
            },
            "trait_description": {
              "value": "It has all the stats of the mammoth, except its AC is reduced to 23, it has only 50 Hit Points, and its Speed is 10 feet. Damage dealt to the severed trunk has no effect on the zombie mammoth."
