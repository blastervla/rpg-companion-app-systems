          "stats": {
            "trait_name": {
              "value": "Living Machine"
            },
            "trait_description": {
              "value": "Though their body is an organic construct, a wyrwood is a living creature. They're not immediately destroyed when reduced to 0 HP, but rather fall unconscious and eventually die. They don't need to eat or drink. They can be targeted by effects that target living creatures or that target constructs."
            },
