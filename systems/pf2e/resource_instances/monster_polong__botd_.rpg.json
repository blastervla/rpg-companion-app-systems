        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Regenerating Bond"
            },
            "trait_description": {
              "value": "(necromancy, occult)\n\nWhen a polong possesses a creature, the polong's master gains temporary Hit Points equal to the victim's level \u00d7 the victim's drained value caused by the possession. These temporary Hit Points last as long as the possession lasts."
            },
            "id": "bfcfdeb3-e91d-407e-a40f-0c3be55b4161",
            "updated_at": {
              "value": "2026-04-15T14:13:02.505956"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Bottle Bound"
            },
            "trait_description": {
              "value": "A polong is bound to the bottle from which they spawned. They can leave the bottle only at the will of their master and must return to it once every 24 hours to feed on their creator's blood. Otherwise, the polong withers and dies."
            },
            "id": "7773a62d-e9bf-4eff-941b-f159bc72c3ad",
            "updated_at": {
