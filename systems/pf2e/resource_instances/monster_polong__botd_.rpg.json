            "trait_name": {
              "value": "Natural Invisibility"
            },
            "trait_description": {
              "value": "A polong is naturally invisible outside of their bottle. They become visible only when forced out of a possessed creature against their will.\n\nShattering the polong's bottle also forces them to assume a visible form."
            },
            "id": "706e0a0d-dadb-4e4e-bf78-dd423be8fd7a",
