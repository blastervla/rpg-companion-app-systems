    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_37f16f3a3ca7",
            "level": {
              "value": 20
            },
            "description": {
              "value": "You either performed in or stood witness to the dance used to invoke the Celestial Dragon and can harness a sliver of their power. You Stride in a dance up to half your Speed, attempting a DC 35 Performance check. You can perform this dance up to three times per day. The second time you do so in the same day, use the degree of success one worse than your actual roll on the Performance check. The third time in a day, use the degree of success two lower than your actual roll.\n\nCritical Success: You perform the movements of the Dance of Intercession so gracefully that you evoke a glimmer of the memory of the Celestial Dragon's awesome power. You cast the 3-action version of either 9th-level harm or heal at any point during your Stride. This does not use any spell slots.\nSuccess: As critical success, but the spell is 7th level instead of 9th as you stumble through the movements.\nFailure: As critical success, but the spell is 5th level instead of 9th as you stumble through the movements.\nCritical Failure: You fail to remember the steps of the dance. You gain no additional effect beyond Striding half your Speed, and you can't attempt the Dance of Intercession again until your next daily preparations."
            }
          }
        }
      ]
    },
