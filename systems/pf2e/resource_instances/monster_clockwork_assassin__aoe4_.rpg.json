            "trait_name": {
              "value": "Smoke Vision"
            },
            "trait_description": {
              "value": "The clockwork assassin ignores the concealed condition from smoke."
            },
            "id": "afd847b1-d15e-4dce-bcd3-00e89b06b08d",
