          "stats": {
            "trait_name": {
              "value": "Integrated Launcher"
            },
            "trait_description": {
              "value": "A projectile launcher is integrated into a clockwork assassin's systems, containing 10 spinning blades and five smoke bombs. When the assassin is destroyed, the launcher and its ammunition are also destroyed."
            },
            "id": "1d34f2cc-c647-4c7b-ad88-f1557f785cba",
