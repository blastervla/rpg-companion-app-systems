    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_30ea11655576",
            "level": {
              "value": 6
            },
            "description": {
              "value": "You might be a novice in the temporal arts now, but in the future, you'll hold time in the palm of your hand.\n\nAs some of your future knowledge leaks back to your present self, you gain the delay consequence domain spell. It costs 1 Focus Point to cast a focus spell. This feat grants a focus pool of 1 Focus Point that you can recover by using the Refocus activity to revisit moments from your past and contemplate futures yet to come. If you already knew delay consequence from a feat or ability that allows you to gain your choice of domain spell, such as Domain Initiate, then when you take this feat, you can retrain that option to gain a different domain spell instead as your personal timeline rearranges itself. You also gain time sense as an innate cantrip usable at will. This innate spell and your focus spells from the time mage archetype are of the same tradition as the spells you used to meet the archetype's prerequisites."
            }
          }
        }
      ]
    },
