            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Hunted Shot"
            },
            "action_description": {
              "value": "Frequency: 1/round\n\nThe duskwalker makes two longbow Strikes against its hunted prey. If both Strikes hit, combine their damage for the purpose of resistances and weaknesses."
            },
