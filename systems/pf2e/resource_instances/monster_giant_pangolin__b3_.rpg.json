        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Emit Musk"
            },
            "action_description": {
              "value": "(olfactory)\n\nThe giant pangolin releases a disorienting and repulsive musk within a 5-foot emanation. Each creature in the area must attempt a DC 20 Fortitude save. The pangolin can't Emit Musk again for 1d4 rounds.\n\nCritical Success: The creature becomes temporarily immune to pangolin musk for 1 minute.\nSuccess: The creature is unaffected.\nFailure: The creature is sickened 1.\nCritical Failure: The creature becomes sickened 1 and is flat-footed until no longer sickened."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
