          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerability to Exorcism"
            },
            "trait_description": {
              "value": "When a soulbound ruin fails a saving throw against a spell that would banish tormented spirits or manipulate souls, such as banishment or bind soul, instead of experiencing the listed effects, it takes 10 damage per spell level."
            },
