        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Self-Repair"
            },
            "trait_description": {
              "value": "The ruin can spend 10 minutes repairing itself to regain up to 30 Hit Points. If the ruin is interrupted during this time, it loses its focus and the repair fails. This ability functions even if the ruin is reduced to 0 HP, unless a consecrate ritual has been performed to purify the building, in which case the soulbound ruin is destroyed. This ritual must be dedicated to a good deity or a deity with a strong opposition to undead, such as Pharasma."
            },
            "id": "ad32653e-1db1-4541-9c76-9e294f611ab5",
