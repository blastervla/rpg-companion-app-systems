          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Stunning Screech"
            },
            "action_description": {
              "value": "(auditory, divine, incapacitation, sonic)\n\nFrequency: 1/minute\n\nThe vrock emits a shrill screech. Each non-demon creature within a 30-foot burst must attempt a 28 Fortitude save. On a failure, the creature is stunned 2, and on a critical failure, it's stunned 3."
            },
            "action_type": {
