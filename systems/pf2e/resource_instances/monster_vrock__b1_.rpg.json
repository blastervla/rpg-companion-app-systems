        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Spore Cloud"
            },
            "action_description": {
              "value": "(disease, poison)\n\nThe vrock emits a cloud of spores from their body, dealing 2d8 poison damage to all adjacent creatures. Each creature damaged this way must succeed at a 28 Fortitude save or take 2d8 persistent piercing damage as the spores penetrate its skin and grow into thick, green vines. The vines cease growing after 10 rounds, and they wither away in 1d4 days if not shaved off before then. The vines can be destroyed if the creature is affected by a good spell or if holy water is applied to the vines (with an Interact action). Once the vrock uses Spore Cloud, the ability can't be used for 1d6 rounds."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
