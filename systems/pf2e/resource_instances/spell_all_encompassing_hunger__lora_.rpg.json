    "description": {
      "value": "You reach out to devour a life, regardless of whether you need it for sustenance. The target takes 1d6 void damage, with a basic Fortitude save. If the creature is reduced to 0 Hit Points, it dies, and you gain temporary Hit Points equal to the damage dealt. These temporary Hit Points last for 1 minute."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d6."
