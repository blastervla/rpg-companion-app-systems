            "level": {
              "value": 4
            },
            "description": {
              "value": "Against humanoids, you gain a +1 circumstance bonus to Deception checks to Lie, and to Diplomacy checks to Gather Information and Make an Impression.\n\nOnce per day, you can cast charm as a divine innate spell using your class DC or spell DC, whichever is higher. Casting it requires staring into the target's eyes, giving the spell the visual trait."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_7551e96ca314",
            "level": {
              "value": 5
            },
            "description": {
              "value": "Every 2 levels thereafter, the spell is heightened by an additional level, to a maximum of a 9th-level charm when you are 19th level."
            }
          }
        }
      ]
