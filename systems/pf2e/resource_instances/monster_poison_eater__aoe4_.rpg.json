        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Consume Poison"
            },
            "action_description": {
              "value": "(manipulate)\n\nThe poison eater uses an Interact action to draw a dose of poison and eats it, gaining strength. The poison-eater's Strikes deal two weapon dice of damage rather than one. The poison eater is affected by the consumed poison normally and, therefore, usually chooses poisons mitigated by their poison resistance and toxin-inured ability. At the end of each of their turns, the poison eater attempts a DC 17 flat check; on a success, this ability ends."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "fa720dad-0235-45cd-877f-234e7aa7e4ce",
            "updated_at": {
              "value": "2026-03-29T00:33:04.508564"
            }
          }
        }
