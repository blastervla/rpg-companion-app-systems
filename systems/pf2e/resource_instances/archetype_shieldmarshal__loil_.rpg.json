                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_2359f6b08df7",
                    "level": {
                      "value": 18
                    },
                    "description": {
                      "value": "This additional damage increases to 3d6, and you can choose to instead treat the ammunition as orichalcum."
                    }
                  }
                }
              ]
