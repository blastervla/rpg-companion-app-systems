        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Witness"
            },
            "trait_description": {
              "value": "The eyelet records whatever it perceives, storing it in an embedded, marble-sized sensor. The eyelet can record up to 1 hour of events, starting and stopping across a longer period. Removing the sensor erases its records.\n\nAn eyelet can transfer everything it has recorded up to 10 miles to its linked scrying station, where the recordings are collected and can be viewed. Doing so empties the sensor so it can be used again. An eyelet can link, or sever its link, to a scrying station as a 10-minute activity with the concentrate trait."
            },
            "id": "cdad50eb-ee86-41cb-b676-15a92339acb4",
