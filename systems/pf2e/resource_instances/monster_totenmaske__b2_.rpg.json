        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Drink Flesh"
            },
            "action_description": {
              "value": "(divine, necromancy)\n\nRequirements: The totenmaske hit the same enemy with two claw Strikes this turn and is still adjacent to it\n\nThe totenmaske drains flesh from the creature's body. The creature becomes sickened 2 and drained 1 unless it succeeds at a 25 Fortitude save (sickened 2 and drained 2 on a critical failure)."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
