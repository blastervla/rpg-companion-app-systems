            "trait_name": {
              "value": "Paired Reconstruction"
            },
            "trait_description": {
              "value": "When reduced to 0 HP, the Quantium golem is destroyed; however, it magically reforms 24 hours later at full HP and free of all conditions and afflictions unless its twin golem is also destroyed."
            },
            "id": "45fa5e25-5019-4150-b02c-c2503fb95e5b",
