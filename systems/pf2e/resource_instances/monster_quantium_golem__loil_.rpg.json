        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paired Reconstruction"
            },
            "trait_description": {
              "value": "When reduced to 0 HP, the Quantium golem is destroyed; however, it magically reforms 24 hours later at full HP and free of all conditions and afflictions unless its twin golem is also destroyed."
            },
            "id": "4cb9958d-16a6-4620-bdb6-8ddcf393a7a0",
            "updated_at": {
              "value": "2026-03-29T00:33:20.829964"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerable to Banishment"
            },
            "trait_description": {
              "value": "Casting a banishment spell on a Quantium golem disrupts its connection to the Crux of Nex. If targeted by such a spell, the golem is enfeebled 1 and slowed 1 for 1d4 rounds."
            },
            "id": "e3152a11-ba81-4b7f-a722-64b39d53f7d7",
            "updated_at": {
              "value": "2026-03-29T00:33:20.829964"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Defender's Link Each"
            },
            "trait_description": {
              "value": "Quantium golem automatically knows the Hit Points, conditions, afflictions, and location of the other."
            },
            "id": "dfab18fd-f5f8-4f30-abfa-aa2aef59232d",
            "updated_at": {
              "value": "2026-03-29T00:33:20.829964"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Twin Defenders"
            },
            "trait_description": {
              "value": "The Quantium golems were created by Nex as a matched set: one of crimson and one of emerald, each a unique entity. The crimson golem is imbued with blazing fire and crackling lightning; its eye beam and Lambent Beam abilities deal fire and electricity damage. The emerald golem is charged with caustic power and flame; its eye beam and Lambent Beam abilities deal acid and fire damage."
            },
            "id": "195f23ef-91fd-4a7d-866f-fc5ea9f97db2",
            "updated_at": {
              "value": "2026-03-29T00:33:20.829964"
