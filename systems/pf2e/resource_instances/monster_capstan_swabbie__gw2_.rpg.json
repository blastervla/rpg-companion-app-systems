    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Attached Anchor"
            },
            "trait_description": {
              "value": "A capstan swabbie is attached to its anchor by a 100-foot-long rope, most of which it keeps coiled around its body. If the capstan swabbie tries to move more than 100 feet from its attached anchor, its Speed is reduced to 10 feet as it drags the anchor along with it. If this rope is severed (AC 12 when uncoiled, Hardness 4, HP 16), the capstan swabbie can move freely, but its ranged anchor Strike loses the tethered trait."
            },
            "id": "a41c3656-7419-470f-9f91-c25f505f1f6d",
            "updated_at": {
              "value": "2026-03-19T22:59:01.341654"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mate's Expertise"
            },
            "trait_description": {
              "value": "The capstan swabbie can use Athletics to Aid an ally's Sailing Lore check (to hoist or lower sails or the anchor, for instance). On a success or critical success, the capstan swabbie grants its ally a +2 circumstance bonus to the triggering check."
            },
            "id": "71d733d3-8c09-491f-8ad1-cc14021f52ba",
            "updated_at": {
