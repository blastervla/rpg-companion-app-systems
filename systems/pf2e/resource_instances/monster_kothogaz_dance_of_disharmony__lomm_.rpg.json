        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Disharmonic Door"
            },
            "trait_description": {
              "value": "(auditory, teleportation)\n\nKothogaz disappears, then bursts as a cacophonous sound from the throat of a creature within 240 feet. Kothogaz appears within reach of the creature and makes a melee Strike against it. The Strike deals an additional 2d12 sonic damage."
            },
            "id": "2f2dd9a9-e046-49a8-a17a-5f3b96192324",
            "updated_at": {
