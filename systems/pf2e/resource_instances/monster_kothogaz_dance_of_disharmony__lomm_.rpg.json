          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Many-Eyed Blight"
            },
            "trait_description": {
              "value": "**Many-Eyed Blight**\nDC: 44\nSaving Throw: Fortitude\n- Stage 1: stupefied 2\n- Stage 2: stupefied 2 and dazzled\n- Stage 3: stupefied 3, confused and blinded\n- Stage 4: if you die, at the next new moon, your body splits, and your viscera become an undead under Kothogaz's control."
            },
