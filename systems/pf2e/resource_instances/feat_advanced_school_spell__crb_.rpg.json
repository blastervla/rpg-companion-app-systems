        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_966ff2068cae",
            "level": {
              "value": 8
            },
            "description": {
              "value": "You gain access to a powerful new school spell depending on your arcane school. If you're an abjurer, you gain energy absorption; if you're a conjurer, you gain dimensional steps; if you're a diviner, you gain vigilant eye; if you're an enchanter, you gain dread aura; if you're an evoker, you gain elemental tempest; if you're an illusionist, you gain invisibility cloak; if you're a necromancer, you gain life siphon; and if you're a transmuter, you gain shifting form. Increase the number of Focus Points in your focus pool by 1."
            }
          }
        }
      ]
