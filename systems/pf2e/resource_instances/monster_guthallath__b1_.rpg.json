    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Erosion Aura"
            },
            "trait_description": {
              "value": "(aura, primal)\n\n120 feet. The guthallath erodes away the physical integrity of all around it. Creatures and objects in the emanation other than the guthallath have their hardness and resistances reduced by 10. At the start of its turn, a creature in the erosion aura's area takes 6d6 bludgeoning damage (basic Fortitude DC 39)."
            },
            "id": "1668b4dd-fa03-431f-aeb4-9d454484c3ec",
            "updated_at": {
              "value": "2026-03-17T12:41:25.944969"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Immunity to Magic"
            },
            "trait_description": {
              "value": "The guthallath is immune to spells of lower than 7th level and the activated effects of magic items of lower than 14th level."
            },
            "id": "2e7a7172-5d0b-423d-9155-e064fc4c6d81",
            "updated_at": {
