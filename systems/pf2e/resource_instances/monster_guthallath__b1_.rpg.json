    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Erosion Aura"
            },
            "trait_description": {
              "value": "(aura, primal)\n\n120 feet. The guthallath erodes away the physical integrity of all around it. Creatures and objects in the emanation other than the guthallath have their hardness and resistances reduced by 10. At the start of its turn, a creature in the erosion aura's area takes 6d6 bludgeoning damage (basic Fortitude 39)."
            },
            "id": "2abbc60a-cdd7-411b-ba17-b12ed2455a73",
            "updated_at": {
              "value": "2026-03-29T00:33:07.115375"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Immunity to Magic"
            },
            "trait_description": {
              "value": "The guthallath is immune to spells of lower than 7th level and the activated effects of magic items of lower than 14th level."
            },
            "id": "e5258272-8c1e-483b-9acb-0dca4f0767b1",
