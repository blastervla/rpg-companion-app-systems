        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Annihilation Beams"
            },
            "action_description": {
              "value": "A guthallath releases two beams of destruction from its eyes. Each beam is a 120-foot line. Everything in either line takes the effect of a hit from a 10th-level disintegrate spell (41 Fortitude). There is no additional effect on creatures in any area where the beams overlap. The guthallath can't use this ability again for 1d4 rounds."
            },
