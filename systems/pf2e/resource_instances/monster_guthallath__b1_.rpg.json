        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Deadly Throw"
            },
            "action_description": {
              "value": "Requirements: The guthallath has a creature grabbed.\n\nThe guthallath throws the creature into the air, 100 feet high and 50 feet away. If the flung creature lands on another creature, the creature it lands on takes the same amount of bludgeoning damage. The creature being landed on can attempt a 41 basic Reflex save."
            },
