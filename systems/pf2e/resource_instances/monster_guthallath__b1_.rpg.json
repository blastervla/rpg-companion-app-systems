        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Powerful Blows"
            },
            "trait_description": {
              "value": "If a guthallath hits with an attack and rolls a natural 19 on the d20 roll, the attack is a critical hit. This has no effect if the 19 would be a failure."
            },
