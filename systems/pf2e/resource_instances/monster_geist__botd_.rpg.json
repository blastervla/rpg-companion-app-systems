          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Power of the Haunt"
            },
            "trait_description": {
              "value": "If a geist is within 100 feet of a haunt that isn't disabled or destroyed, they gain a +2 status bonus to AC and saving throws and deal an additional 1d6 negative damage with bite Strikes. A creature that succeeds at a DC 20 check to Seek or Recall Knowledge about the geist sees that the tendrils from the geist's cloak grow thicker and more agitated the closer it gets to the haunt."
            },
