      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_d48d0231b4bd",
            "level": {
              "value": 2
            },
            "description": {
              "value": "You are a consummate student of dignity, etiquette, and fashion. You can use the Diplomacy skill to perform the special downtime activity Influence Rumor, spending at least one day of downtime to manipulate the course, tone, or content of a rumor to your benefit. The difficulty of Influencing a Rumor is determined by the GM based on the size of the community, the relative perceptiveness of the inhabitants, and the agency of other rumormongers, but it typically starts with at least DC 15 for a small village and increases to at least DC 20 for a town, at least DC 30 for a city, and at least DC 40 for a metropolis.\n\nYou become trained in Deception and Society; if you were already trained, you become an expert instead."
            }
          }
        }
      ]
    },
