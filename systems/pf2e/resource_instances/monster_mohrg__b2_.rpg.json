        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(occult, incapacitation, necromancy)\n\nA living creature hit by a mohrg's tongue Strike must succeed at a 26 Fortitude save or become paralyzed. The creature can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each attempt."
            },
