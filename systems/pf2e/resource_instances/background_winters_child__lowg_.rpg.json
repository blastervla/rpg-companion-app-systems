                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_4654a3f1b253",
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "Your study of magic allows you to instinctively sense its presence. You can cast 1st-rank detect magic at will as an arcane innate spell. If you're a master in Arcana, the spell is heightened to 3rd rank; if you're legendary, it is heightened to 4th rank."
                    }
