    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Stench"
            },
            "trait_description": {
              "value": "(aura, olfactory)\n\n30 feet. A creature that enters the area must attempt a 16 Fortitude save. On a failure, the creature is sickened 1, and on a critical failure, the creature also takes a \u20135-foot status penalty to its Speeds for 1 round. While within the aura, the creature takes a \u20132 circumstance penalty to saves to recover from the sickened condition. A creature that succeeds at its save is temporarily immune to all xulgaths' stenches for 1 minute."
            },
            "id": "9fef4a64-08ba-4359-a8e4-69ad78231ed3",
            "updated_at": {
              "value": "2026-04-15T14:13:00.984060"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Hidden Movement"
            },
            "trait_description": {
              "value": "If a xulgath skulker starts its turn undetected by a creature or merely hidden from it, that creature is flat-footed against the skulker's attacks until the end of the skulker's turn."
            },
            "id": "06c74457-f46c-435b-86d3-e09c7d25fe14",
            "updated_at": {
              "value": "2026-04-15T14:13:00.984060"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sneak Attack"
            },
            "trait_description": {
              "value": "A xulgath skulker deals an additional 1d6 precision damage to flat-footed creatures."
            },
