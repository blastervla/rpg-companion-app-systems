                "stats": {
                  "id": "levelled_description_020bab8597e2",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "You become trained in Athletics; if you were already trained in Athletics, you instead become trained in a skill of your choice. You become trained in barbarian class DC.\n\nYou can use the Rage action.\n\nChoose an instinct as you would if you were a barbarian. You have that instinct for all purposes and become bound by its anathema, but you don't gain any of the other abilities it grants."
                  }
                }
              }
            ]
