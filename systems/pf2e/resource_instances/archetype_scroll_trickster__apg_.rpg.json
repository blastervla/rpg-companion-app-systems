              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_4e5a1b3fcdae",
                    "level": {
                      "value": 6
                    },
                    "description": {
                      "value": "You have a vast and overflowing collection of scroll scraps, riddled with errors and misspellings and leaking energy like a sieve. With enough care, you can coax these scroll scraps into functioning\u2014briefly.\n\nEach day during your daily preparations, you can create a single temporary scroll containing a 1st-level spell. The spell must be a common spell from the Core Rulebook, or another spell you learned via Learn a Spell, and it must come from a tradition in which you have the corresponding skill trained.\n\nThis scroll is an unstable, temporary item and loses its magic the next time you make your daily preparations if you haven't already used it. It can't be used to Learn the Spell."
                    }
                  }
                },
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_2926e1157430",
                    "level": {
                      "value": 8
                    },
                    "description": {
                      "value": "Add a second temporary scroll containing a 2nd-level spell."
                    }
                  }
                }
              ]
