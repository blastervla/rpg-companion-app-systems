        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Change Shape"
            },
            "action_description": {
              "value": "(concentrate, polymorph, primal, transmutation)\n\nThe baobhan sith can transform into a large raven, with the effects from the bird option in the aerial form spell (Core Rulebook 316)."
            },
