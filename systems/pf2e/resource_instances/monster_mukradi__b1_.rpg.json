        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Partitioned Anatomy"
            },
            "action_description": {
              "value": "Trigger: The mukradi would be confused, paralyzed, slowed, or stunned.\n\nThe mukradi confines the debilitating effect to a certain portion of its nervous system, ignoring the effect but causing a maw of its choice to go dormant for the effect's duration. That maw can't be used for a Strike or Breath Weapon during that time. This ability can't be used if all the mukradi's heads are dormant."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "free_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
