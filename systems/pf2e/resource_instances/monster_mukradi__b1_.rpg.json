          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Pull Apart"
            },
            "action_description": {
              "value": "The mukradi makes two Strikes with different maws against the same target. If both hit, the target takes an extra 2d12+13 slashing damage, with a DC 36 basic Fortitude save. On a critical failure, the creature is torn to pieces and dies. The mukradi's multiple attack penalty increases only after all the attacks are made."
            },
