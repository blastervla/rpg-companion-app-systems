            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_bd211d28ec9b",
                  "level": {
                    "value": 10
                  },
                  "description": {
                    "value": "For you, fighting is as much about style as skill. You become trained in simple weapons, martial weapons, and one advanced weapon of your choice. When you critically succeed at an attack roll using your chosen advanced weapon, you also apply the critical specialization of that weapon. You become an expert in Performance and your choice of either Acrobatics or Athletics. If you were an expert in all three of these skills, you instead become an expert in a skill of your choice."
                  }
                }
              }
            ]
