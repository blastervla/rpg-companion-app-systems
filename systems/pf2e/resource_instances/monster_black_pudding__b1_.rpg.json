    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Corrosive Mass"
            },
            "trait_description": {
              "value": "A creature that hits the pudding with a metal or wooden weapon must succeed at a 22 Reflex save or the weapon takes 2d6 acid damage (after dealing damage to the black pudding as normal). Thrown weapons and ammunition take this damage automatically with no save."
            },
            "id": "b4164774-14f3-4074-8bea-d2670a69b953",
            "updated_at": {
              "value": "2026-04-15T14:13:00.984060"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Split"
            },
            "trait_description": {
              "value": "When the black pudding is hit by an attack that would deal slashing or piercing damage and has 10 or more HP, it splits into two identical puddings, each with half the original's HP. One pudding is in the same space as the original, and the other appears in an adjacent unoccupied space. If no adjacent space is unoccupied, it automatically pushes creatures and objects out of the way to fill a space (the GM decides if an object or creature is too big or sturdy to push)."
            },
            "id": "124e492d-91ea-4734-9708-61be021aad97",
            "updated_at": {
              "value": "2026-04-15T14:13:00.984060"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Motion Sense"
            },
            "trait_description": {
              "value": "A sewer ooze can sense nearby motion through vibration and air movement."
            },
            "id": "2e0542c8-21b3-45a2-ba40-db24a1734296",
            "updated_at": {
              "value": "2026-04-15T14:13:00.984060"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Corrosive Touch"
            },
            "trait_description": {
              "value": "When the pudding hits a creature with its pseudopod, any acid damage is dealt to the creature's armor or clothing as well as the creature."
            },
            "id": "4b1432f8-0178-4fc1-8751-3120ffd499c8",
            "updated_at": {
              "value": "2026-04-15T14:13:00.984060"
            }
