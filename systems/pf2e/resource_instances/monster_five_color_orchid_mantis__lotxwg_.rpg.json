            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Barbed Limbs"
            },
            "action_description": {
              "value": "The mantis makes two leg attacks. If both attacks hit, the mantis gains 10 temporary Hit Points, and the target must succeed at a 27 Fortitude saving throw or become drained 1 (drained 2 on a critical failure). The drained condition ends when the mantis is reduced to 0 Hit Points."
            },
