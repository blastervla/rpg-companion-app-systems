        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Rolling Thunder"
            },
            "action_description": {
              "value": "The bison kicks up dust and shakes the ground as it charges. The stampeding bison Strides up to twice its Speed in a straight line, dealing 4d6+6 bludgeoning damage (21 basic Reflex save) to any Medium or smaller creature in its path.\n\nMultiple bison can participate in Rolling Thunder by spending this ability's actions and waiting to charge until the herd is ready. Before the beginning of their next turn, they can then charge as a reaction triggered by an adjacent bison beginning its Rolling Thunder charge.\n\nAll bison in the combined charge must charge in parallel lines, so the areas can't overlap. The combined charge deals an additional 3d6 bludgeoning damage to creatures in the area, and a creature that fails the Reflex saving throw is also knocked prone."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "three_actions"
            },
