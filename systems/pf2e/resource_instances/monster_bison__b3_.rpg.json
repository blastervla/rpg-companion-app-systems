          "stats": {
            "action_name": {
              "value": "Pointed Charge"
            },
            "action_description": {
              "value": "The bison surges forward at its foe, horns lowered. It Strides twice. If the bison ends its movement within melee range of an enemy, it makes a horn Strike against that enemy. This Strike gains the fatal d12 trait."
            },
            "action_type": {
