        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "No Face"
            },
            "trait_description": {
              "value": "Noppera-bos have no sense of vision, but their sense of hearing is precise. They don't breathe and are immune to effects that require breathing. They gain sustenance by absorbing fluids through their skin\u2014traditionally by immersing their hands or faceless head into the fluid to \"drink\" through osmosis; they can also benefit from consumables, such as potions or elixirs, in this way."
            },
            "id": "3dcb8122-4d6b-412b-a52a-bd60b0b12686",
            "updated_at": {
              "value": "2026-04-15T14:13:10.102725"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sneak Attack"
            },
            "trait_description": {
              "value": "The noppera-bo trickster deals an additional 1d4 precision damage to creatures that are flat-footed."
