        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Impersonate Shape"
            },
            "action_description": {
              "value": "(concentrate, occult, polymorph, transmutation)\n\nThe noppera-bo changes into a Small or Medium humanoid they've touched during the last 24 hours and gains the target creature's face and voice. While transformed and their face is covered, the noppera-bo gains a +2 circumstance bonus to Impersonate that creature. The noppera-bo can change back by using this ability again. As long as the noppera-bo has a face, it loses its no face ability and its listed immunities."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "c97c0db5-11d8-453d-b73d-1e01ff94f3a6",
            "updated_at": {
              "value": "2026-04-15T14:13:10.102725"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Remove Face"
            },
            "action_description": {
              "value": "(emotion, enchantment, fear, mental, occult, visual)\n\nRequirements: The noppera-bo trickster is Impersonating a creature with a face.\n\nThe noppera-bo trickster's facial features melt into nothingness, and they menace a creature within 30 feet. The creature becomes frightened 1 on a failed DC 17 Will save (frightened 2 on a critical failure)."
            },
            "action_type": {
              "value": "none"
            },
