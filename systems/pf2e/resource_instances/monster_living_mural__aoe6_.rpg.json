            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Surface-Bound"
            },
            "trait_description": {
              "value": "A living mural can move only along flat surfaces such as floors and walls. This allows it to end its movement wrapped around corners when on a continuous surface. If the surface it's on is destroyed (such as a portrait hit by a fireball spell or a puddle being splashed), the mural takes 10d6 damage and is shunted to the nearest flat surface. If there is no flat surface within 5 feet, the living mural is destroyed."
            },
            "id": "48bcec2e-6d04-467d-aad6-347e9c8a0996",
            "updated_at": {
              "value": "2026-04-15T14:13:00.154606"
