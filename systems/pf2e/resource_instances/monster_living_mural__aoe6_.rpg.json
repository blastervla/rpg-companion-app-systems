    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Backdrop"
            },
            "trait_description": {
              "value": "When a creature attempts to Strike a living mural and critically misses, the attacker hits the surface (a wall, canvas, or so on) behind the living mural. This can damage or break the weapon or surface."
            },
            "id": "5c348c6b-8ba8-4682-9081-09a9dfcf93fb",
            "updated_at": {
              "value": "2026-03-19T22:58:48.270975"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Surface-Bound"
            },
            "trait_description": {
              "value": "A living mural can move only along flat surfaces such as floors and walls. This allows it to end its movement wrapped around corners when on a continuous surface. If the surface it's on is destroyed (such as a portrait hit by a fireball spell or a puddle being splashed), the mural takes 10d6 damage and is shunted to the nearest flat surface. If there is no flat surface within 5 feet, the living mural is destroyed."
            },
            "id": "b173d60a-ecd7-4e85-9eab-145423e5795e",
            "updated_at": {
              "value": "2026-03-19T22:58:48.270975"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Splash of Color"
            },
            "trait_description": {
              "value": "When the living mural hits with a splatter attack, the target is also blinded for 1 round."
            },
