        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Backdrop"
            },
            "trait_description": {
              "value": "When a creature attempts to Strike a living mural and critically misses, the attacker hits the surface (a wall, canvas, or so on) behind the living mural. This can damage or break the weapon or surface."
            },
            "id": "d65df562-7565-4c70-8cff-e292b73a9de7",
