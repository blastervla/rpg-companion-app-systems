            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_f873ef7d4e6d",
                    "level": {
                      "value": 6
                    },
                    "description": {
                      "value": "You spend 1 hour building a campfire in a single unoccupied square and whispering the stories of those you've met on your journeys. The campfire sheds bright light in a 30-foot radius (and dim light for the next 30 feet). The campfire can't be put out or get larger through mundane means; it instead burns out after your next daily preparations or when you use this ability again.\n\nThe first time each round a creature within the campfire's bright light performs an action with the attack trait, they must then attempt a Will save against your class DC or spell DC (whichever is higher). This is a divine curse effect, and you are aware of any attempt, although other creatures in the area are not.\n\n- **Critical Success:** The creature is aware of the effect and can choose to disrupt their action. If they don't disrupt it, the campfire goes out.\n- **Success:** The creature is aware of the effect and can choose to disrupt their action. If they don't disrupt it, they become temporarily immune to the campfire's effects for 24 hours.\n- **Failure:** The creature takes a –2 status penalty to the action's attack roll and to all other attack rolls until the beginning of their next turn.\n- **Critical Failure:** The action is disrupted, and the creature takes a –2 status penalty to attack rolls until the beginning of their next turn."
                    }
                  }
                }
              ]
            },
