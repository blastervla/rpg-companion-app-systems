            "id": "levelled_description_eeed2a76fb64",
            "level": {
              "value": 14
            },
            "description": {
              "value": "You gain an appropriate ki spell for your School of Perfection: unblinking flame emblem for Unblinking Flame, unbreaking wave barrier for Unbreaking Waves, unfolding wind blitz for Unfolding Wind, or untwisting iron augmentation for Untwisting Iron. Increase the number of Focus Points in your focus pool by 1. You become an expert in occult spell DCs and occult spell attack rolls."
            }
          }
        }
