            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Gnaw"
            },
            "action_description": {
              "value": "Requirements: The owlbear has a creature grabbed with its talons.\n\nThe owlbear attempts to disembowel the creature with a beak Strike. If the Strike hits, the target must attempt a 22 Will save.\n\n- **Critical Success:** The target is unaffected.\n- **Success:** The target is sickened 1.\n- **Failure:** The target is sickened 1 and slowed 1 as long as it remains sickened."
            },
            "action_type": {
