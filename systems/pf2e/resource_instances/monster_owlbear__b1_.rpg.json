          "stats": {
            "action_name": {
              "value": "Bloodcurdling Screech"
            },
            "action_description": {
              "value": "(auditory, emotion, fear, mental)\n\nThe owlbear unleashes a loud screech that terrifies its prey. Each creature in an 80-foot emanation must attempt a DC 20 Will save. Regardless of the result, creatures are temporarily immune for 1 minute.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature is frightened 1.\nFailure: The creature is frightened 2.\nCritical Failure: The creature is fleeing for 1 round and frightened 3."
            },
            "action_type": {
              "value": "none"
            },
