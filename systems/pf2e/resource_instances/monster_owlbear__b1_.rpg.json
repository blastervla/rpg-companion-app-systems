        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Bloodcurdling Screech"
            },
            "action_description": {
              "value": "(auditory, emotion, fear, mental)\n\nThe owlbear unleashes a loud screech that terrifies its prey. Each creature in an 80-foot emanation must attempt a 20 Will save. Regardless of the result, creatures are temporarily immune for 1 minute.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature is frightened 1.\n- **Failure:** The creature is frightened 2.\n- **Critical Failure:** The creature is fleeing for 1 round and frightened 3."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
