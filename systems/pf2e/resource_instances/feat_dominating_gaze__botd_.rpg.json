            "description": {
              "value": "The dominate is heightened to 8th level"
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_10326d2d3029",
            "level": {
              "value": 20
            },
            "description": {
              "value": "It's heightened to 9th level. A creature that succeeds at its save is temporarily immune to your domination for 24 hours, though in most cases, you can't Cast the Spell again within 24 hours. If you are destroyed, all your dominate spells from Dominating Gaze immediately end."
            }
          }
        }
