            "level": {
              "value": 16
            },
            "description": {
              "value": "You stare into your target's eyes and enthrall them, shattering their free will. Once per day, you can cast 7th-level dominate as a divine innate spell, using your class DC or spell DC, whichever is higher. It gains the visual trait."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_38f00cfae101",
            "level": {
              "value": 18
