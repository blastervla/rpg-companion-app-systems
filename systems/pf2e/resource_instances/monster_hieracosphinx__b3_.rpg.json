        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Shriek"
            },
            "action_description": {
              "value": "(auditory, incapacitation)\n\nThe hieracosphinx emits a shrill, ear-piercing shriek.\n\nEach non-sphinx in a 60-foot emanation must attempt a 22 Fortitude save. Any creature that attempts a save is temporarily immune for 24 hours.\n\n- **Critical Success:** The creature is temporarily immune to that hieracosphinx's shriek for 24 hours.\n- **Success:** The creature is deafened for 1 round.\n- **Failure:** The creature is deafened for 1 minute and stunned 1."
            },
