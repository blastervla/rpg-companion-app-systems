        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Carnivorous Blob Acid"
            },
            "trait_description": {
              "value": "A carnivorous blob's acid damages only flesh\u2014not bone, stone, wood, or other materials\u2014but is nonetheless devastating. Whenever a creature takes damage from this acid, it must succeed at a DC 33 Fortitude save or become drained 1 (drained 2 on a critical failure). On each subsequent failure, the drained condition value increases by 1 (or by 2 on a critical failure), to a maximum of drained 4."
            },
            "id": "d5eab1e5-ad67-42e1-82d9-934778ebf7d8",
            "updated_at": {
              "value": "2026-03-17T12:41:26.736825"
