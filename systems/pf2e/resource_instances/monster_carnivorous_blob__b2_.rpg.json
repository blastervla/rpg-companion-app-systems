        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Carnivorous Blob Acid"
            },
            "trait_description": {
              "value": "A carnivorous blob's acid damages only flesh\u2014not bone, stone, wood, or other materials\u2014but is nonetheless devastating. Whenever a creature takes damage from this acid, it must succeed at a 33 Fortitude save or become drained 1 (drained 2 on a critical failure). On each subsequent failure, the drained condition value increases by 1 (or by 2 on a critical failure), to a maximum of drained 4."
            },
            "id": "6f2d3228-caeb-42e1-9752-360abc34fdd8",
            "updated_at": {
              "value": "2026-03-19T22:58:51.312291"
            }
