    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Adhesive"
            },
            "trait_description": {
              "value": "The mimic is coated in an adhesive slime. Any creature that hits the mimic, is hit by the mimic, or otherwise touches the mimic must succeed at a 23 Reflex save or become grabbed (Escape 23). A weapon that hits the mimic is stuck to the mimic and can be removed with a successful 23 Athletics check (made as a single action). A mimic can have any number of objects or creatures stuck to it at a time. The mimic can release a stuck creature or object by using a single action, and the adhesive dissolves 1 minute after the mimic dies, releasing all stuck objects and creatures."
            },
            "id": "bbea6ec9-65bd-474c-995b-53eacca47718",
