            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_70a209a3d5af",
                    "level": {
                      "value": 4
                    },
                    "description": {
                      "value": "You know how to maintain a good impression and manage your image, even while keeping uncouth company.\n\nMake a Deception check against the target's Will DC. Regardless of your result, the target is temporarily immune to your Distracting Flattery for 10 minutes.\n\n- **Success:** The target's attitude doesn't decrease as a result of your ally's social blunder.\n- **Failure:** The target's attitude decreases, as normal.\n- **Critical Failure:** Your attempt makes matters worse, decreasing the target's attitude toward you by one step, in addition to any changes from the behavior that triggered this reaction."
                    }
                  }
                }
              ]
            },
