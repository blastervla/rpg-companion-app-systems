          "special": {
            "value": "You can't select another dedication feat until you have gained two other feats from the snarecrafter or trapsmith archetypes.\nLeads to: Finessed Features|G&G, Gear Gnash|G&G, Propeller Attachment|G&G, Recycled Cogwheels|G&G, Repurposed Parts|G&G"
          },
          "descriptions": {
            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_55031ac6d401",
                  "level": {
                    "value": 4
                  },
                  "description": {
                    "value": "You use glimmering gears and gnashing mechanisms to manufacture snares using specialized parts. Your snares include clockwork and steam-powered cogwheels and gears, and their gush of steam can hinder those you ensnare. If you choose to construct a snare using gears and a creature fails their saving throw against the snare, all creatures are concealed to that creature for 1 round, as a burst of steam obscures its vision."
                  }
                }
              }
            ]
          },
