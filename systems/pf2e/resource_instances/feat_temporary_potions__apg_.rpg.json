        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_88486eca78d9",
            "level": {
              "value": 10
            },
            "description": {
              "value": "During your daily preparations, you can create a batch of two temporary oils or potions using a formula you know. These items follow the normal rules to Craft them, except for the time they take, with some additional restrictions. They must both be the same type of oil or potion, and their level must be 6 or more levels lower than your level. Any items you create this way become inert bottles of liquid the next time you make your daily preparations, and any remaining effects of the temporary items end. A temporary oil or potion has no value.\n\nIf you have master proficiency in your tradition's spell DCs, you can create a batch of three temporary oils or potions during your daily preparations, and if you have legendary proficiency, you can create a batch of four."
            }
          }
        }
