        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Troop Movement"
            },
            "trait_description": {
              "value": "Whenever the troop Strides, they first Form Up as a free action to condense into a 20-foot-by-20-foot area (minus any missing segments), then move up to their Speed. This works just like a Gargantuan creature moving."
            },
            "id": "f3cd8d0b-3bf8-4cc2-9901-f4d9a6e38cbf",
