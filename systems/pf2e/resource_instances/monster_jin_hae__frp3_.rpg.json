        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Link Swords"
            },
            "action_description": {
              "value": "(flourish, stance)\n\nJin-Hae either links her swords together or unlinks them. If the swords are linked, she can make linked hook sword Strikes; if the swords are unlinked, she can make hook sword Strikes."
            },
