          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_ff4803fbe9bc",
            "level": {
              "value": 4
            },
            "description": {
              "value": "The harm you deal with your corrupting touch saps the strength from your enemy's body. If your next action is to cast touch of corruption on a living creature, the target is also enfeebled 1 for 1 minute if it fails its save (enfeebled 2 if it critically fails)."
            }
          }
