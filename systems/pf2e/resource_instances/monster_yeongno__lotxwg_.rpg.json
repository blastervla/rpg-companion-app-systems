            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Money is Pain"
            },
            "action_description": {
              "value": "(divine, mental)\n\nThe yeongno crushes a creature it can see with the weight of their wealth. Apparitions of gold coins approximating the wealth of the target materialize and pummel the target from all sides. The target attempts a DC 25 Will save.\n\nCritical Success: The target is unaffected.\nSuccess: The target is slowed 1 for 1 round.\nFailure: The target takes 3d6 persistent mental damage and is slowed 1 as long as the damage continues. The effect immediately ends if they're carrying less than 100 gp worth of precious metals.\nCritical Failure: As failure, except any flat checks to remove the persistent damage automatically fail."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
