        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Inflate Bellows"
            },
            "action_description": {
              "value": "Requirements: The forgespurned has used Forge Breath.\n\nThe forge-spurned draws a massive breath to refill its emptied lungs, enabling it to use Forge Breath again."
            },
            "action_type": {
