        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_1fe185f48922",
            "level": {
              "value": 12
            },
            "description": {
              "value": "The combination of your passion for both life and the battle against evil makes you graceful and unpredictable. Stride up to your Speed. A creature that attempts a reaction triggered by this movement must first attempt a Will save against your class DC or spell DC, whichever is higher.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature is fascinated by you until the end of your next turn.\n- **Failure:** The creature is fascinated by you until the end of your next turn, but your movements might be too hard to follow; if the reaction requires an attack roll, you gain a +2 circumstance bonus to AC against that attack roll.\n- **Critical Failure:** The creature is fascinated by you until the end of your next turn, and it loses its reaction."
            }
          }
        }
      ]
    },
