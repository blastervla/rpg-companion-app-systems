          "stats": {
            "trait_name": {
              "value": "Golem Antimagic"
            },
            "trait_description": {
              "value": "harmed by acid (9d10, 2d10 from areas or persistent damage); healed by fire (area 2d10 HP); slowed by electricity."
            },
