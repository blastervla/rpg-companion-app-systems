    "description": {
      "value": "You create a powerful blast of air and a loud peal of thunder, dealing 2d6 bludgeoning damage and 2d6 sonic damage.\n\nEach creature in the area must attempt a Fortitude save.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature takes half damage.\nFailure: The creature takes full damage and is deafened for 1 minute.\nCritical Failure: The creature takes double damage and is deafened for 1 hour."
    },
    "higher_level_description": {
      "value": "Heightened (+2): Increase each type of damage by 2d6 and the area by 5 feet."
