            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Punishing Strike"
            },
            "action_description": {
              "value": "The skelm unleashes his constant rage in a reckless attack that makes him flat-footed until the start of his next turn. He Strikes; if he hits, he increases the number of damage dice by one and adds Push to the effect. This counts as two attacks for his multiple attack penalty."
            },
            "action_type": {
