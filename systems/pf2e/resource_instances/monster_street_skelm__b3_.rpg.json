        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Frightening Rant"
            },
            "action_description": {
              "value": "(auditory, concentrate, emotion, enchantment, fear, linguistic, mental, occult)\n\nThe skelm rants angrily, filling nearby creatures with shame, fear, and anger. Each creature within 30 feet must succeed at a 20 Will save or become frightened 1 (frightened 2 on a critical failure). While frightened by this rant, creatures take a \u20132 status penalty to Strength-based damage rolls against the skelm, but gain a +2 status bonus to those rolls against other creatures."
            },
            "action_type": {
              "value": "none"
            },
