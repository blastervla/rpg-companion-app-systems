        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Change Shape"
            },
            "action_description": {
              "value": "(concentrate, occult, polymorph, transmutation)\n\nThe street skelm can take on the appearance of any Medium male humanoid (page 304). This doesn't change his Speed or his attack and damage bonuses with his Strikes but might change the damage type his Strikes deal."
            },
