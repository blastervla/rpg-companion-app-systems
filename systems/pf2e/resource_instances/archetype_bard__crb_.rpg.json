          "access": {
            "value": ""
          },
          "special": {
            "value": "You cannot select another dedication feat until you have gained two other feats from the bard archetype.\nLeads to: Basic Bard Spellcasting, Expert Bard Spellcasting, Master Bard Spellcasting, Occult Breadth, Basic Muse's Whispers, Advanced Muse's Whispers, Counter Perform, Inspirational Performance"
          },
          "descriptions": {
            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_9ae62dbeb02e",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "You cast spells like a bard and gain the Cast a Spell activity. You gain a spell repertoire with two common cantrips from the occult spell list, or any other cantrips you learn or discover. You're trained in spell attack rolls and spell DCs for occult spells. Your key spellcasting ability for bard archetype spells is Charisma, and they are occult bard spells. You become trained in Occultism and Performance; for each of these skills in which you were already trained, you instead become trained in a skill of your choice.\n\nChoose a muse as you would if you were a bard. You have that muse for all purposes, allowing you to take that muse's feats, but you don't gain any of the other abilities it grants."
                  }
                }
              }
            ]
          },
