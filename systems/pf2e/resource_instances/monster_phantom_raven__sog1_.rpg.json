    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Susceptible to Death"
            },
            "trait_description": {
              "value": "Though phantoms aren't alive, neither are they undead, and they are uniquely vulnerable to the effects of death. A phantom whose Hit Points are reduced to 0 as a result of a death effect (such as from a spell like finger of death) is immediately whisked away to the River of Souls, where their soul resumes the usual path to the afterlife."
            },
            "id": "d91d50fb-7d58-4a82-9fa0-99461990f60f",
            "updated_at": {
              "value": "2026-03-29T00:33:27.983033"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerable to Kindness"
            },
            "trait_description": {
              "value": "Any creature within 30 feet that the phantom can see and hear can issue a calm and friendly greeting to it as a two-action activity with the auditory, concentrate, linguistic, and mental traits. A creature greeting the phantom in this manner must attempt a DC 15 Diplomacy check.\n\n- **Critical Success:** The phantom takes 4d8 mental damage and is stunned 1.\n- **Success:** The phantom takes 2d8 mental damage.\n- **Failure:** The phantom takes 1d8 mental damage.\n- **Critical Failure:** The phantom is unaffected, and is not affected by this weakness for 1 round."
            },
            "id": "f3a8d8a8-c163-49b6-a099-662d9612af57",
            "updated_at": {
              "value": "2026-03-29T00:33:27.983033"
            }
          }
        }
