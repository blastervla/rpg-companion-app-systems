    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Pulse of Rage"
            },
            "trait_description": {
              "value": "(aura, emotion, enchantment, mental, occult)\n\n20 feet. This aura emanates from any creature possessed by the seething spirit, and it's inactive while the spirit isn't possessing anyone. Any creature in the aura, including a creature possessed by the spirit, takes a \u20131 status penalty to AC, can't perform actions with the concentrate trait except for the Seek action and actions with the rage trait, and gains a +2 status bonus to melee damage rolls against the spirit's enemies.\n\nA creature can attempt a DC 30 Will save when it enters the aura to avoid the effect.\n\nIf the creature would need to attempt a save against the aura again within 24 hours, it automatically uses the same save result rather than attempting a new save."
            },
            "id": "7987b505-8f92-4b2a-9783-ba779c75d31f",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerable to Calm Emotions"
            },
            "trait_description": {
              "value": "A seething spirit can't attempt to possess a creature affected by calm emotions. If creature possessed by a seething spirit fails a saving throw against calm emotions, the spirit is forced out. If the spirit isn't possessing a creature and is targeted with calm emotions, the spirit takes 12 mental damage per level of the spell instead of the normal spell effects."
            },
            "id": "88e6042b-76e5-4aff-9fd2-0d2239d54de4",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Taste Anger"
            },
            "trait_description": {
              "value": "(detection, divination, occult)\n\nThe spirit can taste anger and hatred from creatures experiencing those emotions within 1 mile (imprecise)."
            },
            "id": "df0f6f3b-e423-4f57-8edb-05ba539fb1f4",
            "updated_at": {
