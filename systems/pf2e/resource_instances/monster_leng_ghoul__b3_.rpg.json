            "trait_name": {
              "value": "Leng Ghoul Fever"
            },
            "trait_description": {
              "value": "**Leng Ghoul Fever**\nDC: 28\nSaving Throw: Fortitude\n- Stage 1: carrier with no ill effect (1 day)\n- Stage 2: 4d8 negative damage and regains half as many Hit Points from all healing (1 day)\n- Stage 3: as stage 2 (1 day)\n- Stage 4: 4d8 negative damage and gains no benefit from healing (1 day)\n- Stage 5: as stage 4 (1 day)"
            },
            "id": "aa4ee0d6-643a-4823-ab8d-803e20789e34",
