        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation, occult, necromancy)\n\nAny living creature hit by a Leng ghoul's attack must succeed at a 28 Fortitude save or become paralyzed.\n\nIt can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
            },
            "id": "5add6bd4-a91b-4156-8afd-b37dc19499d3",
            "updated_at": {
