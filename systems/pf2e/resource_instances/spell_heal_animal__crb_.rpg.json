    "description": {
      "value": "You heal an animal's wounds, restoring 1d8 Hit Points to the target. The number of actions spent Casting this Spell determines its effect.\n\n- 1A somatic The spell has a range of touch.\n- 2A somatic, verbal The spell has a range of 30 feet and restores an additional 8 Hit Points to the target."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The amount of healing increases by 1d8, and the additional healing for the 2-action version increases by 8."
