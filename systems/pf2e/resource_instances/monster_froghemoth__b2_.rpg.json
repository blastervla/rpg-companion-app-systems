        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Electric Torpor"
            },
            "trait_description": {
              "value": "Though a froghemoth is immune to electricity damage, it is slowed 1 for 1 round whenever it would have otherwise taken electricity damage."
            },
            "id": "3b2bed23-9257-4130-a85d-0d9c0e5f248d",
            "updated_at": {
              "value": "2026-03-19T22:58:51.312291"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Otherworldly Vision"
            },
            "trait_description": {
              "value": "A froghemoth's alien eyes allow it to perceive creatures within 30 feet, even if they are invisible or ethereal. It can still be fooled by successful Stealth checks to Hide, but it has Perception 38 in such cases. It also sees through and is unaffected by illusions with the visual trait if they are within 30 feet."
            },
            "id": "6e122c32-8082-40ba-b182-970f7c95e237",
            "updated_at": {
              "value": "2026-03-19T22:58:51.312291"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Barbed Tongue"
            },
            "trait_description": {
              "value": "A creature hit by the froghemoth's tongue becomes grabbed by the froghemoth. The creature isn't immobilized, but it can't move beyond the reach of the froghemoth's tongue. A creature can sever the tongue with a successful Strike against AC 31 that deals at least 15 slashing damage. This deals no damage to the froghemoth but prevents it from using its tongue Strike until it regrows its tongue, which takes 1 minute."
            },
            "id": "c87224d1-d32c-4f01-b382-db3012507212",
            "updated_at": {
              "value": "2026-03-19T22:58:51.312291"
            }
          }
        }
      ]
