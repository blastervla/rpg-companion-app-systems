        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Painful Harmonics"
            },
            "action_description": {
              "value": "(auditory, evocation, incapacitation, occult)\n\nThe destrachan emits a sonic cry in either a 60-foot cone or a 30-foot burst. This discordant ululation resonates along the nerves and bones of living creatures in the area, manifesting as waves of incapacitating pain washing over the victims. Each living creature in the area must attempt a DC 26 Fortitude save. The destrachan can't use Painful Harmonics again for 1d4 rounds.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature is sickened 1 for 1 round.\nFailure: The creature is deafened for 3 rounds and stunned 2.\nCritical Failure: The creature is deafened for 1 minute and stunned 3."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
