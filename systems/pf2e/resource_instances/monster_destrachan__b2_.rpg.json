            "updated_at": {
              "value": "2026-03-17T12:41:26.736825"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Shattering Harmonics"
            },
            "action_description": {
              "value": "(evocation, occult, sonic)\n\nThe destrachan focuses its harmonics against a single item within 60 feet that is made of crystal, metal, stone, or wood. The target object takes 7d8 sonic damage. If the item is attended, its bearer can attempt a DC 26 basic Reflex save for the item. The destrachan can't use Shattering Harmonics again for 1d4 rounds."
            },
