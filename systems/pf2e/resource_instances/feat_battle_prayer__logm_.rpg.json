    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_318880664171",
            "level": {
              "value": 7
            },
            "description": {
              "value": "Calling out to your deity, you recite scripture to harm a foe.\n\nWhen you select this feat, choose chaos, evil, good, or law. Your choice must match one of your deity's alignment components.\n\nThis action has the trait corresponding to the chosen alignment.\n\nAttempt a Religion check against the Will DC of a foe within 30 feet. The foe is then temporarily immune to Battle Prayers from your deity for 1 day.\n\n- **Critical Success:** You deal 2d6 damage of the chosen alignment type, or 6d6 damage if you have legendary proficiency in Religion.\n- **Success:** You deal 1d6 damage of the chosen alignment type, or 3d6 damage if you have legendary proficiency in Religion.\n- **Failure:** There is no effect.\n- **Critical Failure:** The backlash of your foe's will against your prayer prevents you from using Battle Prayer again for 10 minutes."
            }
          }
        }
      ]
    },
