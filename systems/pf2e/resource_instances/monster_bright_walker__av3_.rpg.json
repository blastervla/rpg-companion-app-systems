        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Landbound"
            },
            "trait_description": {
              "value": "A bright walker can't fly higher than 1 foot above the ground. If they fly higher than this distance, they fall but don't take any damage from falling."
            },
