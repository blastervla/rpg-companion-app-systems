    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Charming Liar"
            },
            "trait_description": {
              "value": "When Gage gets a critical success using the Lie action, the target's attitude toward him improves by one step, as though he'd succeeded at using Diplomacy to Make an Impression. This works only once per conversation, and if he critically succeeds against multiple targets using the same result, he chooses one creature's attitude to improve. To use this ability, Gage must be lying to impart seemingly important information, inflate his status, or ingratiate himself, which trivial or irrelevant lies can't achieve."
            },
            "id": "47a0244b-9670-4aea-a12a-f8c3448c084e",
            "updated_at": {
              "value": "2026-03-29T00:33:04.083519"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Smooth Operator"
            },
            "trait_description": {
              "value": "When Gage meets a group of up to five people, he can immediately attempt a Diplomacy check to Make an Impression, comparing the result to the Will DC of each target. He takes a \u20133 penalty on this check, and it is possible to get different degrees of success for each target. If he fails or critically fails, he can engage in 1 minute of conversation and attempt a new check at the end of that time rather than accepting the failure or critical failure result."
            },
            "id": "2382126a-5d0d-4352-a3e6-8c0cb64e2a18",
            "updated_at": {
              "value": "2026-03-29T00:33:04.083519"
            }
          }
        }
      ]
