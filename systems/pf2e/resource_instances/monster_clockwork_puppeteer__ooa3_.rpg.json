        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Clockwork String"
            },
            "trait_description": {
              "value": "Any creature hit by the puppeteer's string is grabbed. The puppeteer can move while it has a creature grabbed with its string, but it automatically releases the creature if the puppeteer moves beyond the string's 60-foot length. The puppeteer can use up to six strings at a time. It can release any creature grabbed by a string as a free action. Each string has AC 30, and its Escape DC is 32.\n\nA string can be severed by a Strike that deals at least 20 slashing damage to it. This doesn't deal any damage to the clockwork puppeteer."
            },
            "id": "24f9d6b4-13e6-4457-890e-d4b1c8be6b51",
            "updated_at": {
              "value": "2026-04-15T14:13:08.593851"
            }
          }
        },
        {
