            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_30a28b476778",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "You cast spells like a bard and gain the Cast a Spell activity.\n\nYou gain a spell repertoire with two common cantrips from the occult spell list or any other occult cantrips you've learned or discovered. You're trained in the spell attack modifier and spell DC statistics. Your key spellcasting attribute for bard archetype spells is Charisma, and they are occult bard spells.\n\nYou become trained in Occultism and Performance; for each of these skills in which you were already trained, you instead become trained in a skill of your choice.\n\nChoose a muse as you would if you were a bard. You can take that muse's feats, but you don't gain the starting feat, spell or any other abilities the choice of muse grants."
                  }
                }
              }
            ]
          },
