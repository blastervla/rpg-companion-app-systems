    "description": {
      "value": "A spray of heavy rocks flies through the air in front of you. The rubble deals 2d4 bludgeoning damage to each creature in the area. Each creature must attempt a Reflex save.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature takes half damage.\n- **Failure:** The creature takes full damage and is pushed 5 feet away from you.\n- **Critical Failure:** The creature takes double damage and is pushed 10 feet away from you."
    },
    "higher_level_description": {
      "value": "Heightened (+1): Increase the damage by 2d4."
    },
