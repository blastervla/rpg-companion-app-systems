        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Burrowing Concealment"
            },
            "action_description": {
              "value": "The aigamuxa quickly digs into the surface and Hides. They leave their feet partially exposed, allowing them to see out from the surface. The aigamuxa can hold their breath for up to 10 minutes while hiding in this way."
