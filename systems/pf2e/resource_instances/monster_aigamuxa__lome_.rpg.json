    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Limited Vision"
            },
            "trait_description": {
              "value": "An aigamuxa's eyes are located on the bottom of their feet, making it difficult for them to see.\n\nAn aigamuxa is typically blind. If they Seek, they can see normally until the end of their turn."
            },
            "id": "06349a7b-122b-44ba-b848-e0b93a6cfb30",
            "updated_at": {
              "value": "2026-03-19T22:59:04.010973"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Weak Feet"
            },
            "trait_description": {
              "value": "If an aigamuxa takes damage from Striding or Stepping into hazardous terrain or a square with similar grounded hazards (such as caltrops), they can't Seek until the end of their next turn."
            },
            "id": "5046c9e4-3b25-4ae2-8401-f339c774e312",
            "updated_at": {
              "value": "2026-03-19T22:59:04.010973"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "The First Aigamuxas"
            },
            "trait_description": {
              "value": "Stories say aigamuxas were once giants who entered into a wager with Lamashtu, claiming they could stand on their hands longer than any other creature. Lamashtu produced a simple chimpanzee, pointed to its feet and called them hands. The giants could not hold their positions and fell. Lamashtu moved their eyes to their feet and told them, \"If you wish to boast of your ability, let this be your blessing.\""
            },
            "id": "fd7cb33b-7984-44ae-bcbf-2b606b11e622",
            "updated_at": {
              "value": "2026-03-19T22:59:04.010973"
            }
          }
        }
      ]
