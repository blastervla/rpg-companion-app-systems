            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Strangle"
            },
            "action_description": {
              "value": "Requirements: The little man in the woods has a creature grabbed or restrained\n\nThe little man in the woods tightens his grip around the creature's neck, extending the Grab, dealing 2d6+3 bludgeoning damage with a 24 basic Fortitude save, and strangling the creature for as long as it remains grabbed or restrained. A strangled creature can't speak, which prevents it from casting spells with a verbal component or activating items with a command component. The strangled creature must hold its breath or start suffocating (Core Rulebook 478)."
            },
