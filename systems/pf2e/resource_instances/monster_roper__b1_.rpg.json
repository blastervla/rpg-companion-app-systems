        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Pull the Strands"
            },
            "action_description": {
              "value": "The roper pulls every creature grabbed by its strands toward itself. The roper rolls a single Athletics check and compares the result to each immobilized creature's Fortitude DC. The roper pulls each creature it succeeds against up to 25 feet closer and each creature it critically succeeds against up to 50 feet closer."
            },
