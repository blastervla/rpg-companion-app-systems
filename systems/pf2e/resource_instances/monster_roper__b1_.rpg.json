        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Flurry of Strands"
            },
            "action_description": {
              "value": "The roper makes a strand Strike with each of its strands (except those that are immobilizing creatures). Each attack must be against a different target. These attacks count toward the roper's multiple attack penalty, but its multiple attack penalty doesn't increase until after all the attacks."
            },
