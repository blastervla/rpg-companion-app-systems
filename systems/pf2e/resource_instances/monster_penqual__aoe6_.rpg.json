        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Crush of Hundreds"
            },
            "trait_description": {
              "value": "A creature frightened by the sahkil's mask of terror feels the press of a suffocating crowd. The creature is slowed 1 and takes a \u201310-foot penalty to all Speeds for as long as it is frightened."
            },
