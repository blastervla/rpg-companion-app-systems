            "trait_name": {
              "value": "Crowded Mob"
            },
            "trait_description": {
              "value": "The penqual is a swarm of Medium figures that can squeeze supernaturally close to other creatures. Though its component creatures are larger than those of a typical swarm, a penqual can nevertheless share the spaces of other creatures."
            },
            "id": "4ed81f5e-150a-43c1-a421-e31df12cca72",
