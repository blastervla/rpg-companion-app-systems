            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Invigorating Feast"
            },
            "action_description": {
              "value": "(manipulate)\n\nThe angheuvore feasts upon the creature, dealing their jaws Strike damage (basic Fortitude save); a corpse automatically critically fails with no save. If the target takes damage, the angheuvore gains 5 temporary Hit Points and a +10-foot circumstance bonus to their Speeds for 1 minute."
            },
