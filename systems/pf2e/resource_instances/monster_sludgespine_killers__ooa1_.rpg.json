        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Weeping Wounds"
            },
            "trait_description": {
              "value": "The fluid in a Sludgespine's pustules is harmful to other creatures. Whenever a creature hits a Sludgespine killer with a melee attack, the attacker must succeed at a DC 14 Reflex save or take 1 acid damage (2 acid damage on a critical failure)."
            },
            "id": "e4007032-81d1-47b4-b922-3b042a8363f7",
