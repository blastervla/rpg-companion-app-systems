    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Weeping Wounds"
            },
            "trait_description": {
              "value": "The fluid in a Sludgespine's pustules is harmful to other creatures. Whenever a creature hits a Sludgespine killer with a melee attack, the attacker must succeed at a 14 Reflex save or take 1 acid damage (2 acid damage on a critical failure)."
            },
            "id": "481f440e-8203-48d3-8e1b-e4a6d7b37175",
            "updated_at": {
              "value": "2026-03-29T00:33:24.070924"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Pack Attack"
            },
            "trait_description": {
              "value": "A gnoll deals 1d4 extra damage to any creature that's within reach of at least two of the gnoll's allies."
            },
            "id": "e6cce3d9-706b-48c9-acf9-08f6f5b3782b",
            "updated_at": {
              "value": "2026-03-29T00:33:24.070924"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Stealthy Abduction"
            },
            "trait_description": {
              "value": "When a Sludgespine killer successfully Grapples a creature, that creature makes no sound; other creatures can't notice the grapple by hearing alone. As long as it's grappled, the creature can't use actions with the auditory trait or cast spells with a verbal component."
            },
            "id": "9963c09c-ab13-46e0-9814-25b5fcc00df2",
            "updated_at": {
              "value": "2026-03-29T00:33:24.070924"
            }
          }
        }
