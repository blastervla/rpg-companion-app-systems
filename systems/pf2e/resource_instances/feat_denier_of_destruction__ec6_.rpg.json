    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_ea1e7b72147d",
            "level": {
              "value": 20
            },
            "description": {
              "value": "You can manipulate the same energies that the aeon orbs use to sustain life. You cast heal on the triggering target.\n\nInstead of its normal effects, the heal spell reduces the triggering damage by an amount equal to the Hit Points a 1-action heal spell of that level would have recovered.\n\nAs usual, if this reduces the damage to 0, it might also remove additional effects of the triggering attack, such as injury poisons."
            }
          }
        }
      ]
    },
