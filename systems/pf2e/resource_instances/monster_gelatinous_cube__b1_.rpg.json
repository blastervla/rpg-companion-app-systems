            "trait_name": {
              "value": "Transparent"
            },
            "trait_description": {
              "value": "A gelatinous cube is so clear that it's difficult to spot. A successful 23 Perception check is required to notice a stationary cube, and a creature must be Searching to attempt this check. A creature that walks into the cube is automatically Engulfed (this usually causes the GM to call for initiative)."
            },
            "id": "06f2320a-a7cf-4a3c-a234-b2cab07b2831",
