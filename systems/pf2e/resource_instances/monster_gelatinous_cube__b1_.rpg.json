          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation)\n\nA creature Engulfed by the cube or hit by its attack is paralyzed unless it succeeds at a 20 Fortitude save. A victim can attempt a new save to recover at the end of each of its turns."
            },
            "id": "6c7defea-c5a0-4fe6-b3c7-7a749aedaad0",
