            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation)\n\nA creature Engulfed by the cube or hit by its attack is paralyzed unless it succeeds at a DC 20 Fortitude save. A victim can attempt a new save to recover at the end of each of its turns."
            },
            "id": "57882de1-c214-4a18-82cb-19ba52d949ed",
