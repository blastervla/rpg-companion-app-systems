        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Root Rot Poison"
            },
            "trait_description": {
              "value": "**Root Rot Poison**\nDC: 26\nSaving Throw: Fortitude\nMaximum Duration: 8 rounds\n- Stage 1: 3d6 poison damage and off-guard (1 round)\n- Stage 2: 3d6 poison damage and slowed 1 (1 round)\n- Stage 3: 4d6 poison damage and slowed 2 (1 round)\n- Stage 4: 4d6 poison damage and paralyzed (1 round)"
            },
