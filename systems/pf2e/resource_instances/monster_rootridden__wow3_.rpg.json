    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Root Spawn"
            },
            "trait_description": {
              "value": "(primal, unholy)\n\nA living creature slain by a rootridden that had a lower level than the rootridden rises as a new rootridden after 1d10 rounds, on its turn. This new rootridden is under the command of the rootridden that created it. If the creator is destroyed, any rootridden it created in the past 24 hours are destroyed as well, immediately collapsing into inert plant matter."
            },
            "id": "c4ff1e5e-eb2f-4e04-8f99-9139df8dc2bb",
            "updated_at": {
              "value": "2026-03-29T00:33:34.780357"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rooted"
            },
            "trait_description": {
              "value": "A rootridden is bonded to a specific root network. If it's more than 300 feet from this network for at least 1 minute, it becomes sickened 2 until it's again within 300 feet of the root network for at least 1 minute."
            },
            "id": "5c7434a4-0545-41ec-8b5b-e8f4463c5007",
            "updated_at": {
              "value": "2026-03-29T00:33:34.780357"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Walk the Roots"
            },
            "trait_description": {
              "value": "The rootridden ignores the effects of difficult terrain caused by plants and fungi."
            },
            "id": "35b3736d-cab3-4751-8a47-50b6a50166f3",
            "updated_at": {
              "value": "2026-03-29T00:33:34.780357"
            }
