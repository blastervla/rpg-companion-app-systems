            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Warbling Song"
            },
            "action_description": {
              "value": "(auditory, incapacitation, mental, primal)\n\nThe cauthooj gives a strange, ululating cry that causes nearby creatures to lash out violently and without control. Each creature within a 120-foot emanation that can hear the cauthooj must attempt a 32 Will save to resist the effect.\n\n- **Critical Success:** The target is unaffected and is temporarily immune for 1 minute.\n- **Success:** The target is unaffected.\n- **Failure:** The target is confused for 1 round.\n- **Critical Failure:** The target is confused for 1 round and immediately attacks itself (in the normal fashion for attacking oneself while confused). This Strike doesn't give the creature a flat check to recover from the confusion."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
