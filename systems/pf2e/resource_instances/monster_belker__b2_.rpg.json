            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Smoke Slash"
            },
            "action_description": {
              "value": "Requirements: The belker is partially inhaled by a creature\n\nThe belker automatically deals its claw damage to the inhaling creature by forming a claw to slash and scrape the creature from within."
