        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Noxious Fumes"
            },
            "action_description": {
              "value": "Requirements: The belker occupies the same space as a Medium or smaller creature\n\nThe belker attempts to flow into the creature's lungs; the creature must attempt a 23 Fortitude save. On a failure, the creature partially inhales the belker and is immobilized by the pain of the smoke rasping in its throat and lungs. The creature can attempt to exhale the belker by spending an action coughing and succeeding at a 23 Fortitude save. Most of the belker remains outside the creature, so the belker can still act normally. If the belker moves out of the creature's space or uses Noxious Fumes again, the creature automatically exhales it."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
