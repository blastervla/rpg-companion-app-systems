    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_709d241849a4",
            "level": {
              "value": 2
            },
            "description": {
              "value": "You choose to study or worship one type of dragon, and your focus grants you a measure of its power. You become trained in arcane spell DCs and arcane spell attack rolls. Choose one color of dragon when you select this feat; if you are a sorcerer with the Sorcerer bloodline, this must be the same type as your bloodline. You gain resistance equal to half your level against one type of damage determined by the chosen dragon type. The GM may allow you to choose a dragon type not listed below, and will determine the damage type appropriate for that dragon.\n\n- **Black, Brine1, or Copper** Acid\n- **Blue, Bronze, Cloud1, or Sky1** Electricity\n- **Brass, Gold, Magma1, Red, or Underworld1** Fire\n- **Crystal1 or Forest1** Piercing\n- **Green** Poison\n- **Sea1** Bludgeoning\n- **Silver or White** Cold\n- **Sovereign1** Mental\n- **Umbral1** Negative\n\n1Mwangi Expanse, p.76\n\nYou also gain a +1 circumstance bonus to saving throws against sleep effects and effects that would make you paralyzed."
            }
          }
        }
      ]
    },
