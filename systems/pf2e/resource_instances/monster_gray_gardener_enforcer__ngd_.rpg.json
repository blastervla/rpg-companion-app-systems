            "trait_name": {
              "value": "Anonymity The Gray"
            },
            "trait_description": {
              "value": "Gardener enforcer has a +2 circumstance bonus to Deception checks and saving throws to conceal their identity and a +2 circumstance bonus to their Deception DC against effects that ferret out information about the Gray Gardener's identity."
