        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Chain Garotte The Gray"
            },
            "trait_description": {
              "value": "Gardener enforcer's spiked chain Strike deals 2d8 persistent bleed damage, and they can use it to Grab up to two foes. The enforcer can still attack with their spiked chain if they Grab one creature, but not when they Grab two."
