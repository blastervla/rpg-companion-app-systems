    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_af7ae70aafa5",
            "level": {
              "value": 2
            },
            "description": {
              "value": "You've gained Isthralei's attention and can now offer stories up to him, either passing on your own stories or collecting those of travelers as he did. You become trained in Religion and Survival; for either of these skills in which you were already trained, you instead become trained in a skill of your choice. You gain the Offer Story action.\n\n**Offer Story**\n\n- **Activate:** 1 Action\n- **Traits:** auditory, concentrate, divine, linguistic, mental\n\nYou share a story of your travels with a creature within 30 feet. You gain the blessing of Isthralei as a +1 status bonus to AC and Will saves until the end of your next turn. On their next turn, the creature you shared a story with can take a single action, which has the auditory, concentrate, linguistic, and mental traits, to respond with their own story to gain the same benefits until the end of the following turn."
            }
          }
        }
      ]
    },
