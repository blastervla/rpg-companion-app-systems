        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Radiant Blow"
            },
            "trait_description": {
              "value": "When a creature is hit by the radiant warden's hammer Strike, a flash of radiant energy attempts to anchor the creature in place. The creature must attempt a 38 Will save; on a failure, the creature can't use any teleportation effects for 1 minute.\n\nOn a critical failure, the creature is also permanently blinded."
            },
            "id": "9281a0a2-eb53-48d3-9ac3-861160f8d17f",
