      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Darkvision Invisibility"
            },
            "trait_description": {
              "value": "The graul's rubbery flesh is saturated with a unique biochemical compound that renders it undetectable by any form of darkvision. In dim or bright light, the creature can be perceived normally by any kind of vision."
            },
            "id": "a006bd5e-7a3a-4449-9283-7ff441f4a77d",
            "updated_at": {
              "value": "2026-03-17T12:41:34.430005"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Odorless"
            },
            "trait_description": {
              "value": "The graul exudes no natural aroma, rendering it undetectable to creatures using the scent ability."
            },
            "id": "e3565ae0-36a4-444d-a232-3a6eae0a0356",
            "updated_at": {
              "value": "2026-03-17T12:41:34.430005"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(poison, incapacitation)\n\nA living creature struck by a graul's jaws attack must succeed at a DC 20 Fortitude save or become paralyzed. It can attempt a new check at the end of each of its turns, and the DC cumulatively decreases by 1 on each such check. A creature paralyzed by this ability is also affected by the graul's darkvision invisibility for as long as the effect persists."
            },
            "id": "af4de18f-b6ec-459e-a08d-aee637374a08",
            "updated_at": {
              "value": "2026-03-17T12:41:34.430005"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Tentacle Grab"
            },
            "trait_description": {
              "value": "A creature hit by the graul's tentacle becomes grabbed by the graul. The creature isn't immobilized, but it can't move beyond the reach of the graul's tentacle. A creature can sever the tentacle with a Strike against AC 18 that deals at least 10 slashing damage. This deals no damage to the graul but prevents it from using its tentacle Strike until it regrows the tentacle, which takes 1 round. The graul can move without ending the Grab as long as the creature remains within the tentacle's reach."
            },
            "id": "e8aef7e0-edb0-4f45-bb2e-e83c54e7d882",
            "updated_at": {
              "value": "2026-03-17T12:41:34.430005"
            }
          }
        }
      ]
