    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Hydration"
            },
            "trait_description": {
              "value": "Azarketi must regularly submerge themselves in water to rehydrate their water-acclimated skin. After the first 24 hours outside of water, they gain a \u20131 status penalty to Fortitude saves as their skin cracks and their gills become painful. After 48 hours, they struggle to breathe air and begin to suffocate until returned to water."
            },
            "id": "4357438c-59b3-48ef-af1a-2ad272942129",
            "updated_at": {
              "value": "2026-03-19T22:59:02.221173"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Speaker of the Oceans"
            },
            "trait_description": {
              "value": "An azarketi tide tamer can speak with animals that have the aquatic or amphibious trait."
            },
            "id": "c887f49f-5ae4-4a07-bfe9-5a9921705e83",
            "updated_at": {
              "value": "2026-03-19T22:59:02.221173"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Submerged Stealth"
            },
            "trait_description": {
              "value": "While submerged in water, an azarketi crab catcher gains a +2 circumstance bonus on their Stealth check, indicated above."
            },
            "id": "f61fae69-185e-4097-b172-dbc65abe773b",
            "updated_at": {
              "value": "2026-03-19T22:59:02.221173"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Aquatic Predator"
            },
            "trait_description": {
              "value": "While submerged in water, an azarketi tide tamer takes advantage of the shifting tides to increase the deadliness of their attacks.\n\nThey deal 2d8 additional damage on a successful weapon Strike while they are underwater."
            },
            "id": "6dcfdb90-16ea-4c2b-97c7-21106d76989e",
            "updated_at": {
              "value": "2026-03-19T22:59:02.221173"
