        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerable to Gentle Repose"
            },
            "trait_description": {
              "value": "Casting a gentle repose spell on a carrion golem causes it to grow stiff. The golem attempts a 19 Fortitude save. It's unaffected on a critical success, slowed 1 for 1d4 rounds on a success, and on a failure is immobilized and slowed for 1d4 rounds."
            },
            "id": "a8e0ea6b-0882-4c8e-9fbc-3a175bf9d55c",
