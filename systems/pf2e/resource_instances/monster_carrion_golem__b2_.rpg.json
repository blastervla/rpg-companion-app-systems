        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vulnerable to Gentle Repose"
            },
            "trait_description": {
              "value": "Casting a gentle repose spell on a carrion golem causes it to grow stiff. The golem attempts a DC 19 Fortitude save. It's unaffected on a critical success, slowed 1 for 1d4 rounds on a success, and on a failure is immobilized and slowed for 1d4 rounds."
            },
            "id": "948baeb8-65e9-452c-8ebd-7a5b76f01603",
