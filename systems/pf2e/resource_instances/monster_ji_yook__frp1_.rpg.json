        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Pinning Shot"
            },
            "action_description": {
              "value": "Ji-yook pins a foe's clothing to a wall or floor or the ground. Ji-yook makes a dart Strike. If the attack hits, it deals no damage and instead pins the target to an adjacent surface. The target is immobilized and must spend an Interact action to attempt a 10 Athletics check to pull the dart free; it can't move from its space until it succeeds. If Ji-yook's dart Strike was a critical hit, the target must succeed at two separate Athletics checks to pull the dart free. The target is flatfooted while it remains immobilized in this way."
            },
            "action_type": {
              "value": "none"
            },
