        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Poison Spray"
            },
            "action_description": {
              "value": "The Bonebleacher bugbear attaches the poison container to a nozzle on their mask, which then sprays the poison from the mask in a 15-foot cone. The bugbear isn't exposed to the poison. All creatures in the cone are immediately exposed to the poison, and each creature must attempt a Fortitude save against the poison."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
