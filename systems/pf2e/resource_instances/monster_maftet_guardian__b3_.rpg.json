            "action_name": {
              "value": "Paired Strike"
            },
            "action_description": {
              "value": "Requirements: The maftet is wielding two scimitars\n\nThe maftet makes two Strikes against the same target, one with each of their scimitars. The maftet combines the damage of any attacks that hit and applies resistances and weaknesses only once. This counts as one attack when calculating the maftet's multiple attack penalty."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
