        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Instant Opening"
            },
            "action_description": {
              "value": "(concentrate)\n\nThe Gray Gardener assassin distracts a creature within 30 feet, using a few choice words or gestures. The creature is flat-footed against the assassin's attacks until the end of the assassin's next turn.\n\nDepending on the distraction, this action gains either the auditory or the visual trait."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
