            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Mark for Death"
            },
            "action_description": {
              "value": "The Gray Gardener assassin designates a single creature they can see and hear as their mark. This effect lasts until the mark dies or the assassin uses Mark for Death again. The assassin gains a +2 circumstance bonus to Perception checks to Seek the mark and on Deception checks to Feint against the mark.\n\nThe assassin's melee and ranged Strikes gain the deadly d8 weapon traits when attacking the mark."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "three_actions"
            },
