      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Desecration Aura"
            },
            "trait_description": {
              "value": "(aura, abjuration, divine, evil)\n\n40 feet. Desecrated guardians exude a palpable malice that nauseates all but the most wicked passersby.\n\nNon-evil creatures that enter the aura must attempt a DC 37 Will save. On a failure, the creature becomes sickened 1 (sickened 2 on a critical failure). In addition, any non-evil creatures that attempt to Cast a Spell within the aura must succeed at a DC 5 flat check or the spell is lost."
            },
            "id": "8789928f-401c-473a-b2b8-2172dfe24ede",
