      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Desecration Aura"
            },
            "trait_description": {
              "value": "(aura, abjuration, divine, evil)\n\n40 feet. Desecrated guardians exude a palpable malice that nauseates all but the most wicked passersby.\n\nNon-evil creatures that enter the aura must attempt a 37 Will save. On a failure, the creature becomes sickened 1 (sickened 2 on a critical failure). In addition, any non-evil creatures that attempt to Cast a Spell within the aura must succeed at a DC 5 flat check or the spell is lost."
            },
            "id": "3a3f976e-1d1c-4d2c-aeed-5b41d2988df7",
            "updated_at": {
              "value": "2026-03-29T00:33:17.243395"
            }
          }
        },
        {
