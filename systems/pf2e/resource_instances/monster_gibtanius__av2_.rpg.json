        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Bouncing Crush"
            },
            "action_description": {
              "value": "The gibtanius Leaps and can end this Leap occupying the same space as other creatures. It deals 5d6 bludgeoning damage to each creature in the space it Leaps to (DC 26 basic Reflex save), then Shoves each of those creatures. If it fails to Shove any creature out of its space, it bounces to the closest available space of its choosing that does not contain any creatures. Bouncing Crush counts as one attack when determining the gibtanius's multiple attack penalty."
            },
