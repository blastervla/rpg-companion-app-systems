              "value": "2026-03-17T12:41:33.660551"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Snow Walker"
            },
            "trait_description": {
              "value": "The Ilverani sentry ignores the effects of difficult terrain from snowy environments. When moving through snow, an Ilverani sentry minimizes traces left behind and makes it harder for others to find them. The DC of checks to Track an Ilverani sentry through snowy terrain gains a +4 status bonus."
            },
            "id": "ae211137-5354-4bd1-8056-0547504d0397",
