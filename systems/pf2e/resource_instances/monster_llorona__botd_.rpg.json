    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rejuvenation"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nWhen a llorona is destroyed, they re-form after 1d6 days at the site of their death. Resolving the injustice that led to a llorona's death puts them to rest permanently. Alternatively, successfully performing a consecrate ritual at the site prevents them from re-forming."
            },
            "id": "afc87ccf-e5da-4d08-9bca-34a6053785e3",
            "updated_at": {
              "value": "2026-03-29T00:33:10.838404"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Funereal Touch"
            },
            "trait_description": {
              "value": "A creature touched by a llorona must attempt a 29 Fortitude save. On a failure, the creature becomes drained 1 (drained 2 on a critical failure) or increases their drained value by 1 (2 on a critical failure), up to a maximum of drained 4. Every time a creature becomes drained in this way, the llorona gains 10 temporary Hit Points for 1 hour."
            },
            "id": "2829a279-4d58-4ec2-a493-797da39c4abf",
            "updated_at": {
              "value": "2026-03-29T00:33:10.838404"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ghostly Grasp"
            },
            "trait_description": {
              "value": "A llorona can Grapple corporeal creatures despite being incorporeal.\n\nThe llorona uses their Athletics check to Grapple as normal but can't use Athletics for other actions that require corporeal contact, like Force Open or Trip."
            },
            "id": "80c054a9-4b2d-48ba-ad9a-7880005ea1e8",
            "updated_at": {
              "value": "2026-03-29T00:33:10.838404"
            }
          }
        }
