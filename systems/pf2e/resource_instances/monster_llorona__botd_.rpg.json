    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rejuvenation"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nWhen a llorona is destroyed, they re-form after 1d6 days at the site of their death. Resolving the injustice that led to a llorona's death puts them to rest permanently. Alternatively, successfully performing a consecrate ritual at the site prevents them from re-forming."
            },
            "id": "5c825f19-83ae-4e50-ab5c-76e2b541c763",
            "updated_at": {
              "value": "2026-03-17T12:41:28.527612"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Funereal Touch"
            },
            "trait_description": {
              "value": "A creature touched by a llorona must attempt a DC 29 Fortitude save. On a failure, the creature becomes drained 1 (drained 2 on a critical failure) or increases their drained value by 1 (2 on a critical failure), up to a maximum of drained 4. Every time a creature becomes drained in this way, the llorona gains 10 temporary Hit Points for 1 hour."
            },
            "id": "dbcb5ede-42e6-499c-837a-7c9dd3adb0cb",
            "updated_at": {
              "value": "2026-03-17T12:41:28.527612"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ghostly Grasp"
            },
            "trait_description": {
              "value": "A llorona can Grapple corporeal creatures despite being incorporeal.\n\nThe llorona uses their Athletics check to Grapple as normal but can't use Athletics for other actions that require corporeal contact, like Force Open or Trip."
            },
            "id": "3323e6bf-fe54-42b4-aa83-5a18f9c06dec",
            "updated_at": {
              "value": "2026-03-17T12:41:28.527612"
            }
          }
        }
