    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Gilded Fascination"
            },
            "trait_description": {
              "value": "When offered a gift worth at least 50 gp, the k'nonna must attempt a 20 Will saving throw; if the gift is worth at least 100 gp, the DC is instead 25. If they fail the save, the k'nonna accepts the gift, becomes fascinated until the end of their next turn, and cannot attack while fascinated. On a critical failure, the fascination lasts for 1 minute. Offering a gift is an Interact action, and offering multiple gifts in the same round has no additional effect."
            },
            "id": "4958cfa2-639d-4b2d-b9aa-2ead28990ec9",
            "updated_at": {
              "value": "2026-03-19T22:59:04.010973"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Half-Speaker"
            },
            "trait_description": {
              "value": "A k'nonna can communicate easily with other k'nonna, but when communicating with other creatures, only half of the spoken words make sense. In order to convey information to a k'nonna or understand what they're saying, a non-k'nonna must succeed at a 20 Perception check."
            },
            "id": "827c8d3b-7628-431a-8a5c-9172aa815fd8",
            "updated_at": {
              "value": "2026-03-19T22:59:04.010973"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Half Steps"
            },
            "trait_description": {
              "value": "Even though k'nonna are split in half, they still move and Stride as though they have two arms and legs. However, binding just one wrist or ankle leaves them incapable of using that limb, as if it were bound to another."
            },
            "id": "1954fa65-d60b-40b6-8259-e5057d4462b7",
            "updated_at": {
              "value": "2026-03-19T22:59:04.010973"
            }
          }
        }
      ]
