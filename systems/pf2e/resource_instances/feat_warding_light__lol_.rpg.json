            "level": {
              "value": 4
            },
            "description": {
              "value": "You gain a tattoo that serves as a special ward to defend you against Walkena's forces.\n\nThe tattoo allows you to cast the light cantrip as a divine innate spell at will. The cantrip is heightened to a spell level equal to half your level rounded up. If you die, the tattoo immediately casts gentle repose on your corpse, heightened to the same spell level."
            }
          }
        }
