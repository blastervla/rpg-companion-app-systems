        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Incendiary Spit"
            },
            "trait_description": {
              "value": "A creature hit by the eberark's spit becomes coated in a slippery, flammable oil. The creature must succeed at a 27 Reflex save or become clumsy 2 for as long as they are coated in incendiary spit. Creatures affected by incendiary spit that take fire damage catch fire, taking 3d6 persistent fire damage. Once this persistent fire damage ends, the spit has burned away.\n\nThe spit also wears off naturally after one hour or can be washed off with soap, water, and one minute of work."
            },
