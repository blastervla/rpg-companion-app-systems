        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Infectious Visions"
            },
            "trait_description": {
              "value": "(divine, enchantment, mental, poison)\n\nThe first time each round the gholdako damages a creature with a claw Strike, the creature must attempt a 27 Will save, as its mind is assaulted by horrifying visions. On a failure, the creature is confused until the end of its next turn. On a critical success, the creature is immune for 24 hours."
            },
