            "level": {
              "value": 7
            },
            "description": {
              "value": "You become a master in Society, and at 15th level, you become legendary in Society. You can use the Society skill instead of the Diplomacy skill when you attempt to Make an Impression on a non-elven intelligent humanoid creature."
