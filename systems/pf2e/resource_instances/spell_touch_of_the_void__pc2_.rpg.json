    "description": {
      "value": "You infuse the target with void energy, healing undead or damaging a living creature.\n\n- Willing Undead Creature The target regains 6 Hit Points. If the target is yourself, you also gain a +2 status bonus to damage rolls for 1 round.\n- Living Creature The target takes 1d6 void damage with a basic Fortitude save; on a failure, the target also takes a \u22122 status penalty to AC for 1 round."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The amount of healing increases by 6, and the damage to a living target increases by 1d6."
    },
