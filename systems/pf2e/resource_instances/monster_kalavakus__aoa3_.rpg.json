        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Enslave Soul"
            },
            "action_description": {
              "value": "(arcane, enchantment, mental)\n\nThe demon enslaves the soul of a living creature within 60 feet.\n\nThe target can attempt to resist this enslavement with a 29 Will save. A slaver demon can have only one living soul enslaved with this ability at a time, and no more than one slaver demon can enslave the same soul.\n\nIf a slaver demon kills a creature whose soul it has enslaved, the demon regains 20 HP and the soul is consigned to an eternity of toil in the Abyss, adding to the slaver demon's tally of souls and allowing the demon to enslave another.\n\n- **Success:** The target avoids being enslaved and is temporarily immune for 24 hours.\n- **Failure:** The target is enslaved and is enfeebled 2 for 24 hours or until the slaver demon is slain, whichever comes first.\n- **Critical Failure:** As failure, and the target also suffers the effects of a failed saving throw against dominate."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
