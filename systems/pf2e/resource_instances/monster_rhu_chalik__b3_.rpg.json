        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Excruciating Enzyme"
            },
            "trait_description": {
              "value": "(occult, poison)\n\nA rhu-chalik's tendrils secrete an enzyme that causes intense pain. A living creature hit by a tendril Strike must succeed at a DC 24 Fortitude save or become sickened 1 from the pain."
            },
            "id": "8b161a28-a15f-4ba2-b53f-a3981a657db2",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Void Transmission"
            },
            "trait_description": {
              "value": "(concentrate, enchantment, exploration, mental, occult)\n\nThe rhu-chalik spends 10 minutes copying the creature's entire consciousness and mentally sends this copied consciousness through the void of space to their waiting masters. The target creature is deeply disoriented by this procedure, becoming stupefied 2 for 1 day afterward. If the creature is revived or moved away from the rhu-chalik during the process, Void Transmission fails and the target is unaffected."
            },
            "id": "75b7cd74-cf2e-4d9f-8e5c-a04e6673456b",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        }
