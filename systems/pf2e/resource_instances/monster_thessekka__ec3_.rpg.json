    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Powerful Stench"
            },
            "trait_description": {
              "value": "(aura, olfactory)\n\n30 feet. A creature that enters the area must attempt a 34 Fortitude save. On a failure, the creature is sickened 2, and on a critical failure, the creature is also slowed 1 for as long as it is sickened.\n\nWhile within range of Thessekka's stench, the creature takes a \u20132 circumstance penalty to saves to recover from the sickened condition.\n\nA creature that succeeds at its save is temporarily immune to all xulgaths' stenches for 1 minute."
            },
            "id": "e5b9ddfc-e130-4cf9-af8e-1465439ebeea",
            "updated_at": {
              "value": "2026-04-15T14:13:03.806634"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Infused Items"
            },
            "trait_description": {
              "value": "Thessekka carries the following infused items: 1 greater acid flask, 2 greater alchemist's fires, 1 moderate bravo's brew, 2 greater frost vials, 1 greater quicksilver mutagen, 1 greater tanglefoot bag. These items last for 24 hours, or until the next time Thessekka makes her daily preparations."
            },
            "id": "b48aac7b-95b1-4e97-a4c4-a4c8d9ee41ff",
