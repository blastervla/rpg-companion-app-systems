        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Pike and Strike"
            },
            "action_description": {
              "value": "The bosun Strikes with their naval pike.\n\nIf this Strike hits, the bosun can either move the target 5 feet within the pike's reach or make a fist Strike against the target without increasing their multiple attack penalty until after the fist Strike."
