        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Mauling Rush"
            },
            "action_description": {
              "value": "The kokogiak Strides up to its Speed. It can make up to four claw Strikes at any point during this movement, each against a different target. These attacks count toward the kokogiak's multiple attack penalty, but the multiple attack penalty doesn't increase until after the kokogiak makes all of its attacks."
            },
