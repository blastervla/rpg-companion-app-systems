          "descriptions": {
            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_57be7212adab",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "You put your alchemical interest into practice. You become trained in alchemical bombs and Crafting; if you were already trained in Crafting, you instead become trained in a skill of your choice. You become trained in alchemist class DC.\n\nYou gain the alchemist's infused reagents class feature, gaining a number of reagents each day equal to your level.\n\nYou also gain the Alchemical Crafting feat and four additional formulas for 1st-level alchemical items, as well as the ability to create free items during your daily preparations. Your advanced alchemy level is 1 and doesn't increase on its own."
                  }
                }
              }
            ]
