          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_01a4d77aac80",
            "level": {
              "value": 1
            },
            "description": {
              "value": "You are so attuned to the land that you can call forth a bolt of energy from your surroundings. When you gain this feat, select acid, cold, electricity, or fire. You can call to the land to cast the acid splash cantrip as an innate primal spell at will, except the spell has only verbal components and deals the type of damage you chose instead of acid damage; the spell gains the trait appropriate to its damage instead of the acid trait. A cantrip is heightened to a spell level equal to half your level rounded up."
            }
          }
        }
      ]
