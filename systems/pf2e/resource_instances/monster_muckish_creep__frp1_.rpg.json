            "trait_name": {
              "value": "Compression"
            },
            "trait_description": {
              "value": "A muckish creep can move through a gap at least 6 inches wide without Squeezing and can Squeeze through any gap at least 1 inch wide."
            },
            "id": "558cc5c3-b252-4053-a38b-4e50c87859cd",
