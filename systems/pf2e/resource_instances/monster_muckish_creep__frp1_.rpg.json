          "stats": {
            "trait_name": {
              "value": "Slippery Body"
            },
            "trait_description": {
              "value": "A muckish creep's body allows it to slip away from most restraints. It gains a +4 status bonus to checks to Escape. On a success, it gets a critical success instead. On a critical failure, it gets a failure instead."
            },
