        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_f2d5a2cb7743",
            "level": {
              "value": 16
            },
            "description": {
              "value": "Inspired by the degenerate demiliches your kind sometimes devolves into, you've embedded a gem into your brow, fusing it to your necrotic flesh. This gem has been specially calibrated to hold one of the following spells: repulsion, scrying, or true seeing. You must decide which spell your gem contains when you take this feat; changing the spell requires retraining the feat. Once per day, you can drain the gem's magical energy to Cast the Spell without spending a spell slot."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_8128159a79d4",
            "level": {
              "value": 18
            },
            "description": {
              "value": "You can heighten whichever spell you chose to 7th level."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_aaed1339ea38",
            "level": {
              "value": 20
            },
            "description": {
              "value": "You can heighten whichever spell you chose to 8th level; regardless of which spell you chose, you can instead drain the gem's magical energy to cast an 8th-level spell turning without spending a spell slot."
            }
          }
        }
      ]
    },
