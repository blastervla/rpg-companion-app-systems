        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Aluum Antimagic"
            },
            "trait_description": {
              "value": "Guardian aluums are immune to spells and magical abilities, with two exceptions. A negative spell or magical ability grants an aluum the quickened condition until the end of its next turn instead of its normal effects. A positive spell or ability makes an aluum slowed 1 until the end of its next turn instead of its normal effects."
            },
