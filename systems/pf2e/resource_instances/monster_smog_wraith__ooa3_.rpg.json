          "stats": {
            "trait_name": {
              "value": "Sunlight Powerlessness"
            },
            "trait_description": {
              "value": "A smog wraith caught in sunlight is stunned 2 and clumsy 2."
            },
            "id": "9e50c280-2aa0-4b4c-aa29-f19d2cbf7c4e",
