        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Chain Shot"
            },
            "action_description": {
              "value": "The bone ship makes a special bone cannon Strike, firing a chain made of bones. A creature hit by this Strike is grabbed by the chain (Escape 41). The bone ship can use Interact actions to reel in a grabbed creature 50 feet per action spent, and when the ship moves, it pulls the grabbed creature along with it."
