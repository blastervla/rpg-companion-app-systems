        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Plaguesense"
            },
            "trait_description": {
              "value": "A leukodaemon senses any creature with a disease, and it knows the type and current stage of all diseases carried by any creature within range."
