        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Burning Touch"
            },
            "trait_description": {
              "value": "(evocation, fire, primal)\n\nThe azer's Strikes deal an extra 1d6 fire damage (included above). When the azer successfully performs a Grapple or Shove action, they also deal 1d6 fire damage to their target."
            },
