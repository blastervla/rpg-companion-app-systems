            "trait_name": {
              "value": "Infused Items"
            },
            "trait_description": {
              "value": "A ratfolk grenadier carries 2 infused moderate acid flasks, 2 infused moderate alchemist's fires, and 2 infused moderate frost vials. These items last for 24 hours, or until the next time they make their daily preparations."
            },
