          "stats": {
            "trait_name": {
              "value": "Cheek Pouches"
            },
            "trait_description": {
              "value": "A ratfolk grenadier has stretchy cheek pouches that can store up to 1 cubic foot of objects (though no more than 4 light items). The ratfolk can remove or store an item using the Interact action. As long as the ratfolk has at least one object in its cheek pouches, its speech is noticeably difficult to understand."
            },
            "id": "a0dec553-a377-4bc7-9241-3343967466bd",
            "updated_at": {
