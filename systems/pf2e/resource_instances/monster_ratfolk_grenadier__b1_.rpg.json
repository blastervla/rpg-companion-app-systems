        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Swarming"
            },
            "trait_description": {
              "value": "A ratfolk grenadier can end its movement in the same square as an ally that also has this ability. Only two such creatures can share the same space."
