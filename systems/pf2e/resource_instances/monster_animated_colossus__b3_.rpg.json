        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Colossus's Grasp"
            },
            "trait_description": {
              "value": "The colossus can Grab a creature using only one hand. It can move normally with a creature grabbed or restrained in its fist, carrying the creature along. If it has two creatures grabbed in this way, it can't use its fist Strike."
            },
