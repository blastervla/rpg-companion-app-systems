        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Shuffle Forces"
            },
            "trait_description": {
              "value": "The raised cavalry consists of skeletons, zombies, and other undead hastily bound to a shared cause. The cavalry has resistance 20 to physical damage, as it shuffles its weakest members to the front lines. When the cavalry is reduced to 12 squares or fewer, its resistance to physical drops to 10. Once the cavalry reaches the 2-segment threshold, it loses its resistance to physical damage."
            },
