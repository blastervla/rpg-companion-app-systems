    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Grasping Armor"
            },
            "trait_description": {
              "value": "A creature that Strikes Ruzadoya with a melee weapon must succeed at a DC 31 Reflex save or be disarmed of that weapon. If the creature critically fails, the weapon ends up in Ruzadoya's space. A creature that hits Ruzadoya with an unarmed attack must succeed at a DC 31 Reflex save or become grabbed by Ruzadoya until the end of her next turn, it Escapes, or Ruzadoya moves, whichever comes first."
            },
            "id": "44e0df28-741d-4459-b02f-b68f42c9e1c3",
            "updated_at": {
              "value": "2026-03-19T22:59:17.821401"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rejuvenation"
            },
            "trait_description": {
              "value": "(primal)\n\nWhen Ruzadoya is destroyed, her armor rebuilds her body over the course of 1d10 days. If her body is destroyed before then, the process restarts. Ruzadoya can only be permanently destroyed by obliterating her armor (such as with disintegrate), transporting it to the Plane of Fire, or throwing it into the heart of a volcano."
            },
            "id": "8664a9c0-c84e-4847-9b90-82d3692f0953",
            "updated_at": {
              "value": "2026-03-19T22:59:17.821401"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sapping Aura"
            },
            "trait_description": {
              "value": "(aura, primal, void)\n\n30 feet. When a creature in the aura uses a vitality spell or ability, Ruzadoya automatically attempts to counteract it, with a +23 counteract modifier."
            },
            "id": "a1d0307d-a94f-413b-a3cc-162b83a04efc",
            "updated_at": {
              "value": "2026-03-19T22:59:17.821401"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Graveknight's Curse"
            },
            "trait_description": {
              "value": "**Graveknight's Curse**\nDC: 39\nSaving Throw: Will\nOnset: 1 hour\n- Stage 1: doomed 1 and can't remove the armor (1 day)\n- Stage 2: doomed 2, \u221210-footstatus penalty to Speeds, and can't remove the armor (1 day)\n- Stage 3: dies and transforms into the armor's graveknight (1 day)"
            },
            "id": "68afcea7-24e4-4397-8ff2-7a383121df8c",
            "updated_at": {
              "value": "2026-03-19T22:59:17.821401"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rooting Strikes"
            },
            "trait_description": {
              "value": "On a critical hit with a melee weapon or unarmed attack, Ruzadoya's target is immobilized for 1 round (Escape DC 31) and clumsy 1 for as long as the immobilization lasts."
            },
            "id": "a1332fd9-5efc-4850-bf80-9f99341f0539",
            "updated_at": {
              "value": "2026-03-19T22:59:17.821401"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ruinous Weapons"
            },
            "trait_description": {
              "value": "Any weapon or unarmed attack Ruzadoya uses gains the effects of the +1 greater striking and wounding weapon runes."
            },
            "id": "7bad09cc-5782-4ee3-8130-a7f07e5807e1",
            "updated_at": {
              "value": "2026-03-19T22:59:17.821401"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Weapon Master"
            },
            "trait_description": {
              "value": "Ruzadoya has access to the critical specialization effects of any weapons she wields."
            },
