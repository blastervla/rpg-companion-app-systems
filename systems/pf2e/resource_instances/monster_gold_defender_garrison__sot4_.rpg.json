        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Death Throes"
            },
            "trait_description": {
              "value": "As the garrison's numbers dwindle, gold defenders melt away into worthless slag. Every time that the garrison is reduced to a threshold, it leaves behind a 10-foot radius cloud of fumes and a 10-foot radius puddle of molten metal. Creatures that breathe fumes are exposed to gold defender poison. Creatures that move through the puddle take 10d6 fire damage. The fumes dissipate after 1 round and the puddle completely evaporates after 1 minute."
            },
            "id": "c2e77ce0-fdfd-46e2-b05c-b27d9ad56f56",
            "updated_at": {
              "value": "2026-03-29T00:33:30.968085"
            }
          }
        },
        {
