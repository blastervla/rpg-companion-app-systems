        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Instinctual Tinker"
            },
            "action_description": {
              "value": "The morlock tinkers with an adjacent construct or mechanical hazard. They attempt a Crafting check against the construct's or hazard's Fortitude DC. The morlock can't succeed if the target's level is more than double the morlock's.\n\n- **Critical Success:** The target gains 4d6 HP and a +1 circumstance bonus to attack rolls for 1 minute.\n- **Success:** The target gains 2d6 HP.\n- **Critical Failure:** The morlock injures itself, taking 2d6 damage (typically bludgeoning, piercing, or slashing, but potentially a different type at the GM's discretion)."
            },
            "action_type": {
              "value": "none"
            },
