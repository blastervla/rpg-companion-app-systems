        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sea Legs"
            },
            "trait_description": {
              "value": "(fortune)\n\nAn azarketi sailor gains a +1 circumstance bonus to Acrobatics checks to Balance and can roll twice and take the better result on checks to Balance while aboard a ship."
            },
            "id": "4b980fe9-e1be-4706-a938-b988efd6e58d",
