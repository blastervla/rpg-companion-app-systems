        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Gasping Aura"
            },
            "trait_description": {
              "value": "(air, aura, divine, transmutation)\n\n100 feet.\n\nCreatures within the aura must succeed at a DC 37 Fortitude save. On a failure, they can't breathe and must hold their breath to avoid suffocation until they leave the aura. The tumblak can activate or deactivate the aura with a single free action, which has the concentrate trait."
            },
            "id": "6950ab40-49f1-48fd-984d-43f57a482eb9",
            "updated_at": {
              "value": "2026-03-17T12:41:36.576062"
            }
          }
        },
        {
