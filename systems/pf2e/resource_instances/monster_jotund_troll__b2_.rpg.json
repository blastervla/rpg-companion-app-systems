        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Cacophonous Roar"
            },
            "action_description": {
              "value": "(auditory, emotion, enchantment, incapacitation, mental, primal)\n\nThe jotund troll emits a cacophonous roar from all their heads with a mystical power that distorts the listener's mind. Each non-troll creature within 100 feet must attempt a DC 34 Will save. The jotund troll can't use Cacophonous Roar for 1d4 rounds.\n\nCritical Success: The creature is unaffected and is temporarily immune to Cacophonous Roar for 24 hours.\nSuccess: The creature is stupefied 1 for 1 round.\nFailure: The creature is confused for 1 round.\nCritical Failure: The creature is confused for 1d4 rounds."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
