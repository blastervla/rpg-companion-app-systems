          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Ravenous Jaws"
            },
            "action_description": {
              "value": "The jotund troll makes a number of jaws Strikes up to their number of heads, each against a different target. These attacks count toward the troll's multiple attack penalty, but the penalty doesn't increase until after the jotund troll makes all of these attacks."
