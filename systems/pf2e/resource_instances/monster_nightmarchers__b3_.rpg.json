        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Kinsense"
            },
            "trait_description": {
              "value": "(detection, divination, divine)\n\nNightmarchers can detect creatures who are their kin, whether by blood or bond, as an imprecise sense. If they focus their senses on a creature by Seeking, they learn whether they are related to that creature, and how."
            },
            "id": "5d770e9d-b6a2-456d-b2a7-2448eb243f1b",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Troop Movement"
            },
            "trait_description": {
              "value": "Whenever the nightmarchers Stride, they first Form Up as a free action to condense into a 20-foot-by-20-foot area (minus any missing squares), then move.\n\nThis works just like a Gargantuan creature moving; for instance, if any of the nightmarchers' squares enter 3, the extra movement cost applies to the whole group."
            },
            "id": "f141f8ae-ed94-4038-8ace-f8dda27290ca",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        }
      ]
