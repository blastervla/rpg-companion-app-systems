        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Aluum Antimagic"
            },
            "trait_description": {
              "value": "Aluum enforcers are immune to spells and magical abilities, with two exceptions. A negative spell or magical ability grants an aluum enforcer the quickened condition until the end of its next turn instead of its normal effects. A positive spell or ability makes an aluum enforcer slowed 1 until the end of its next turn instead of its normal effects."
            },
            "id": "22868bcc-739d-48e2-b7c5-aee821d2ee62",
