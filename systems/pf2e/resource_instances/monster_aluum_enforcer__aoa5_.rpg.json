        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralyzing Force"
            },
            "trait_description": {
              "value": "(arcane, incapacitation, necromancy)\n\nA creature damaged by the aluum enforcer's fist Strike must succeed at a DC 27 Fortitude save or become paralyzed for 1 round. On a critical failure, the creature is paralyzed for 1d4 minutes and falls prone."
            },
