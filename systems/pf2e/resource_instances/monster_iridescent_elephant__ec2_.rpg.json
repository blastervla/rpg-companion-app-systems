    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Glowing Bones"
            },
            "trait_description": {
              "value": "An iridescent animal emits phosphorescent bright light in a 15-foot aura.\n\nThe animal can suppress this display until the end of its next turn as a single action, which has the concentrate trait. The color of the light is determined by the iridescent animal's creator."
            },
            "id": "8fe2ceaa-d25a-4d19-8e41-d5489460a6fb",
            "updated_at": {
              "value": "2026-03-17T12:41:30.148797"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Color Splash"
            },
            "trait_description": {
              "value": "(visual)\n\nWhen the iridescent elephant stomps its foot, a bright, disorienting burst of light pulses through its leg. Each creatures adjacent to the iridescent elephant when it makes a foot Strike (regardless of whether or not it hit) must succeed at a DC 24 Will save or be flat-footed until the beginning of the elephant's next turn."
            },
            "id": "33bf74f6-3417-44d6-bcbd-bad08a030bda",
            "updated_at": {
              "value": "2026-03-17T12:41:30.148797"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Grabbing Trunk"
            },
            "trait_description": {
              "value": "A Medium or smaller creature hit by the elephant's trunk is grabbed. If the elephant moves, it can bring the grabbed creature along with it."
            },
            "id": "19a38c86-8a29-4f94-a1fb-3b128616e534",
            "updated_at": {
              "value": "2026-03-17T12:41:30.148797"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Trunk Beam"
            },
            "trait_description": {
              "value": "(light, visual)\n\nFrequency: 1/day\n\nThe iridescent elephant blasts a beam of light from its trunk in a 30-foot line. Each creature in the area must attempt a DC 22 Fortitude save.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature is dazzled for 1 round.\nFailure: The creature is blinded for 1 minute.\nCritical Failure: The creature is blinded permanently."
            },
            "id": "888541f9-3e74-4e7b-adca-2e0586d666a5",
            "updated_at": {
              "value": "2026-03-17T12:41:30.148797"
            }
          }
        }
      ]
