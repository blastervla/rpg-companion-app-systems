        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Two Heads"
            },
            "trait_description": {
              "value": "Any ability that would sever a baomal's head (such as a critical hit with a vorpal weapon) severs one head at random. Losing one head doesn't kill a baomal, but it does prevent the baomal from making Strikes with the lost head and from using Double Opportunity or Two-Headed Strike."
            },
            "id": "76f1c818-1125-4078-95be-4bab2774475a",
