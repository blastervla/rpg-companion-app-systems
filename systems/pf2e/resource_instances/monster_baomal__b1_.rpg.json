          "stats": {
            "trait_name": {
              "value": "Double Opportunity"
            },
            "trait_description": {
              "value": "A baomal gains an extra reaction each round that it can use only to make an Attack of Opportunity. It must use a different head for each one it attempts, and it can't make more than one Attack of Opportunity for the same triggering action."
            },
            "id": "5c7725d3-bfbb-4e26-adc8-159f31a0f449",
