        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Liberating Strike"
            },
            "action_description": {
              "value": "Trigger: A creature within Alyce's reach attempts to apply the grabbed, immobilized, or restrained condition to an ally\n\nRequirements: Alyce is wielding a melee weapon\n\nAlyce makes a melee Strike against the triggering creature. If the attack is a hit, the triggering ally can immediately use a reaction to Escape. If the attack is a critical hit, any grabbed, immobilized, or restrained conditions imposed by the triggering action are negated."
            },
