    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Malleable"
            },
            "trait_description": {
              "value": "The giant slug can fit through tight spaces as if it were a Large creature. While Squeezing, it can move at its full Speed. It can Squeeze through spaces that typically fit only a Medium creature, but it does so at the usual Speed for Squeezing."
            },
            "id": "bf7a3c5a-88a9-4b80-bb96-eead8ab4770a",
            "updated_at": {
              "value": "2026-03-29T00:33:08.154488"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mucus"
            },
            "trait_description": {
              "value": "Any creature hit by the giant slug or that moves into its mucus trail is coated in sticky, caustic mucus.\n\nIt takes 1d4 persistent acid damage and takes a \u20135-foot status penalty to its Speeds while the damage persists."
            },
            "id": "d0b2e728-ff5d-47f4-b9f4-8835cf8f673f",
            "updated_at": {
              "value": "2026-03-29T00:33:08.154488"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mucus Trail"
            },
            "trait_description": {
              "value": "Any square the giant slug moves into is coated in mucus. These spaces are difficult terrain, and any creature that moves into one or ends its turn in one is subjected to the slug's mucus. After an hour, the mucus dries and the area is no longer difficult terrain."
            },
            "id": "6aa11635-e028-46f8-9238-83bbf34b0abe",
            "updated_at": {
              "value": "2026-03-29T00:33:08.154488"
