    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Malleable"
            },
            "trait_description": {
              "value": "The giant slug can fit through tight spaces as if it were a Large creature. While Squeezing, it can move at its full Speed. It can Squeeze through spaces that typically fit only a Medium creature, but it does so at the usual Speed for Squeezing."
            },
            "id": "59e41c7d-d185-4fd4-bb2d-674a249f45be",
            "updated_at": {
              "value": "2026-03-17T12:41:26.736825"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mucus"
            },
            "trait_description": {
              "value": "Any creature hit by the giant slug or that moves into its mucus trail is coated in sticky, caustic mucus.\n\nIt takes 1d4 persistent acid damage and takes a \u20135-foot status penalty to its Speeds while the damage persists."
            },
            "id": "d4b0354a-1bef-408f-adc3-26bf869ac1af",
            "updated_at": {
              "value": "2026-03-17T12:41:26.736825"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mucus Trail"
            },
            "trait_description": {
              "value": "Any square the giant slug moves into is coated in mucus. These spaces are 3, and any creature that moves into one or ends its turn in one is subjected to the slug's mucus. After an hour, the mucus dries and the area is no longer 3."
            },
            "id": "e0d76831-ff39-434d-b267-b50135f65ef4",
            "updated_at": {
              "value": "2026-03-17T12:41:26.736825"
