    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Starvation Aura"
            },
            "trait_description": {
              "value": "(aura, divine, mental, necromancy)\n\n60 feet. Any creature that ends its turn in the aura feels the intense pain of starvation and must attempt a 30 Fortitude save. On a failure, the creature becomes fatigued and takes 6d6 damage. Damage and fatigue a creature takes from this aura can't be healed until the affected creature has eaten a full meal."
            },
            "id": "869cfe65-bf68-4b92-9eab-d7172cb57680",
            "updated_at": {
              "value": "2026-03-19T22:58:53.849899"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Corpse Consumption"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nIf the gashadokuro kills a creature with Swallow Whole, it immediately regains Hit Points equal to the swallowed creature's level. As long as the gashadokuro still exists, creatures consumed in this way can't be resurrected except by wish or a similarly powerful effect."
            },
            "id": "f5b2b185-bfe7-4999-b6ca-3928de61ace1",
