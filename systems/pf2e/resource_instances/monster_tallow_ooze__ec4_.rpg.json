        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Residual Grease"
            },
            "trait_description": {
              "value": "When the tallow ooze critically succeeds at an attack against a creature or a creature escapes from being engulfed by the ooze, that creature's hands and gear become slick with grease. For 1d4 rounds, the affected creature must attempt a 30 Reflex save whenever it uses any item (including weapons) that must be wielded or held. On a failure, the creature takes a \u20132 circumstance penalty to any attack roll or check to use the item; on a critical failure, the creature drops the item, which lands in a random adjacent square.\n\nThe creature (or an adjacent ally) can use 1 Interact action to wipe off the grease from an item or from its hands."
            },
            "id": "26ced51d-b752-4778-8630-ba76719bb71a",
            "updated_at": {
              "value": "2026-04-15T14:13:03.987259"
            }
          }
        }
