              "value": "2026-04-15T14:13:03.987259"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Greasy Seepage"
            },
            "trait_description": {
              "value": "(aura)\n\n10 feet. Any creature that starts its turn in or enters a square in the area must attempt a 30 Acrobatics check to Balance. A creature that takes a Step doesn't need to roll this check."
            },
            "id": "99f5582f-c5f8-4c2c-b207-63fd59658250",
            "updated_at": {
              "value": "2026-04-15T14:13:03.987259"
