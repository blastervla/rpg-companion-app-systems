          "stats": {
            "trait_name": {
              "value": "Camel Spit"
            },
            "trait_description": {
              "value": "To drive away enemies, the camel spits the partially digested contents of its stomach at a creature within 10 feet. On a hit, the target is dazzled for 1 round and must succeed at a 17 Fortitude save or become sickened 1. The camel can't use its camel spit Strike again for 1d4 rounds."
            },
