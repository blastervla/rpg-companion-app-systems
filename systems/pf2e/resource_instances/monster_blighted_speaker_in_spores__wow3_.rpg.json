    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Blight Walker"
            },
            "trait_description": {
              "value": "The speaker in spores recovers from the paralyzed, slowed, and stunned conditions at the end of their turn. They're also immune to penalties to their Speeds and ignore cover, concealment, difficult terrain, and greater difficult terrain resulting from plants or fungi."
            },
            "id": "ae6ce572-093d-4518-bc6b-63c979ccd843",
            "updated_at": {
              "value": "2026-03-29T00:33:34.780357"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Shaped Tongue"
            },
            "trait_description": {
              "value": "The speaker in spores can speak with all plants and the creature they resemble."
            },
            "id": "4a2b462f-f808-4a5a-be91-380f3a8764d1",
            "updated_at": {
              "value": "2026-03-29T00:33:34.780357"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Spore Matrix"
            },
            "trait_description": {
              "value": "(aura, mental, primal)\n\n60 feet. The speaker in spores is surrounded by a strong concentration of spores. The speaker can communicate telepathically to any creatures in the aura who have breathed in their spores. This communication always uses the listener's native language and can't be used with any creature that doesn't breathe."
            },
            "id": "2faac3e2-386b-47fe-a9ba-b4645fa416c4",
            "updated_at": {
              "value": "2026-03-29T00:33:34.780357"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sporesight"
            },
            "trait_description": {
              "value": "The speaker in spores can see through spores drifting in the air, ignoring cover. This is an imprecise sense and functions only in areas without strong wind currents. Sporesight doesn't function underwater."
            },
            "id": "bd4a5a03-dad9-411e-933a-57308f314c42",
            "updated_at": {
              "value": "2026-03-29T00:33:34.780357"
