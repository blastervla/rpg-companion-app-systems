        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Are You Sure About That?"
            },
            "action_description": {
              "value": "(emotion, mental, visual)\n\nTrigger: A creature within 30 feet who's visible to Granny Hu and who has been exposed to Want to Try Me? in the past week says or does something that would be against Granny Hu's interests\n\nGranny Hu makes a subtle gesture, reminding the triggering creature of their secret. The creature must succeed at a DC 22 Will Save or the triggering action is disrupted. Regardless of the outcome, the creature then becomes temporarily immune to this ability for 24 hours."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "reaction"
            },
