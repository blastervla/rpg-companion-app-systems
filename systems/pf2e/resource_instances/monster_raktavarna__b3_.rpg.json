        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Designate Master"
            },
            "trait_description": {
              "value": "A raktavarna can designate a creature as their master using a 10-minute invocation in which the master must participate. The raktavarna can revoke this status at any time."
            },
            "id": "69d84952-a65b-4856-9f06-2c7391b5db8d",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Master's Eyes"
            },
            "trait_description": {
              "value": "As a 3-action activity with the concentrate trait, a raktavarna's master can observe the world through the raktavarna's eyes, instead of their own. This uses the raktavarna's Perception and darkvision. Each round, the master must spend a single action, which also has the concentrate trait, to maintain the connection.\n\nThis ability functions at any range, even on different planes of existence. If the raktavarna dies while their master is using this ability, the master is stunned 5."
            },
            "id": "b2bfa014-a653-4783-9f87-753ccb6695ca",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
