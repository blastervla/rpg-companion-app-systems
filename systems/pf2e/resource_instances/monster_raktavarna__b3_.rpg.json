          "stats": {
            "trait_name": {
              "value": "Raktavarna Venom"
            },
            "trait_description": {
              "value": "(poison); DC 16 Fortitude; Maximum Duration 6 rounds; Stage 1: 1d4 poison damage and stupefied 1 (1 round); Stage 2: 1d4 poison damage and stupefied 2 (1 round)"
