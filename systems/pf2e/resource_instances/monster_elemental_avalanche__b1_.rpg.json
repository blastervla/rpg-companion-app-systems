        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Earth Glide"
            },
            "trait_description": {
              "value": "The elemental avalanche can Burrow through any earthen matter, including rock. When it does so, the elemental avalanche moves at its full burrow Speed, leaving no tunnels or signs of its passing."
