          "stats": {
            "trait_name": {
              "value": "Earthbound"
            },
            "trait_description": {
              "value": "When not touching solid ground, the elemental avalanche is slowed 1, can't use reactions, and can't Trample."
            },
            "id": "dc9d46a5-2dc6-4503-be1c-df090a7d465e",
