            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Energy Drain"
            },
            "trait_description": {
              "value": "When the grim reaper hits and deals damage with its scythe, it regains 20 Hit Points, and the target must succeed at a 43 Fortitude save or become doomed 1. If the target is already doomed, the doomed value increases by 1 (to a maximum of doomed 3)."
            },
            "id": "33e118ca-e46b-40f7-8047-1933a80248a4",
            "updated_at": {
              "value": "2026-03-29T00:33:31.890804"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Final Death"
            },
            "trait_description": {
              "value": "A creature killed by the grim reaper can't be brought back to life by any means short of divine intervention."
            },
            "id": "60fd3379-5fc2-4cd5-bdcc-b1218b2dcad4",
            "updated_at": {
              "value": "2026-03-29T00:33:31.890804"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Infuse Weapon"
            },
            "trait_description": {
              "value": "(divine, evocation)\n\nAny scythe gains the agile trait, can't be disarmed, and becomes a +3 major striking keen scythe while the grim reaper wields it. If the grim reaper Strikes a creature with a weakness to any specific type of damage, the scythe's damage counts as that type of damage, in addition to slashing."
            },
            "id": "62aaef4b-3a82-41b6-a9aa-dc652cf12125",
            "updated_at": {
              "value": "2026-03-29T00:33:31.890804"
            }
          }
