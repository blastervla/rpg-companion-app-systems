        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Aura of Misfortune"
            },
            "trait_description": {
              "value": "(aura, divination, divine, misfortune)\n\n20 feet. Living creatures in the aura must roll twice on all d20 rolls and use the lower result."
