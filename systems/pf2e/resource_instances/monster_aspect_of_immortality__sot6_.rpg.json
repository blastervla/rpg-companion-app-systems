        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Death Strike"
            },
            "trait_description": {
              "value": "(death)\n\nA creature critically hit by any of the grim reaper's attacks or that critically fails against any of its spells must succeed at a 47 Fortitude save or die."
            },
            "id": "3c69b355-cdc4-4dea-9f93-1ab07d94b56e",
