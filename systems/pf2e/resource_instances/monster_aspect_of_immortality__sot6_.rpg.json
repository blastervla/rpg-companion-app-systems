        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Death's Grace"
            },
            "trait_description": {
              "value": "The grim reaper can choose whether or not it counts as undead for effects that affect undead differently. Even if it does not count as undead, the grim reaper still never counts as a living creature."
