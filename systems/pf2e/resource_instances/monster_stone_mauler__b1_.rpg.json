          "stats": {
            "trait_name": {
              "value": "Earthbound"
            },
            "trait_description": {
              "value": "When not touching solid ground, a stone mauler is slowed 1 and can't use reactions."
            },
            "id": "26b1ba16-fe70-46be-b048-e2ee6c20e50b",
            "updated_at": {
