        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "General's Cry"
            },
            "trait_description": {
              "value": "When a hobgoblin general rolls initiative, as long as they can perceive at least one foe, they can yell a mighty battle cry. The hobgoblin general attempts an Intimidate check to Demoralize a single foe within 60 feet as a free action. If successful, any ally with the goblin trait can, as its first action on its first turn of the combat, Stride up to double its speed as a single action."
            },
            "id": "6f9140cb-f581-46b9-bd37-24771d4aba2c",
            "updated_at": {
              "value": "2026-03-19T22:58:50.064440"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Polearm Critical Specialization"
            },
            "trait_description": {
              "value": "On a critical hit, the target of the critical hit is moved 5 feet in a direction of the hobgoblin general's choice."
            },
            "id": "25add61d-b994-40b4-9ab4-6a4bae9a7462",
