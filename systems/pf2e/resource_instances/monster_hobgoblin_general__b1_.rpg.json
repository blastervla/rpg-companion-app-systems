        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Formation"
            },
            "trait_description": {
              "value": "When it's adjacent to at least two other allies, the hobgoblin general gains a +1 circumstance bonus to AC and saving throws. This bonus increases to +2 to Reflex saves against area effects."
            },
            "id": "7e5af05b-82c1-47c5-8534-e2d8391ed9b3",
