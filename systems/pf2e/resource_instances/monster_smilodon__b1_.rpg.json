            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Pounce"
            },
            "action_description": {
              "value": "The smilodon Strides and makes a Strike at the end of that movement. If the smilodon began this action hidden, it remains hidden until after this ability's Strike."
