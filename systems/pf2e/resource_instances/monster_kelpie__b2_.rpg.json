        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Change Shape"
            },
            "action_description": {
              "value": "(concentrate, polymorph, primal, transmutation)\n\nThe kelpie can take on the appearance of any Medium or Large animal of an equine nature (such as a horse, hippocampus, or pony), or any Small or Medium humanoid. This doesn't change its Speeds or its attack and damage modifiers with its Strikes."
            },
