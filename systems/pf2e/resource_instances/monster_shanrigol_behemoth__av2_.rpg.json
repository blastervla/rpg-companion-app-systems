        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Necrotic Decay"
            },
            "trait_description": {
              "value": "(divine, necromancy, negative)\n\nWhen the shanrigol behemoth dies, its flesh rots away and sublimates into a foul-smelling gas that fills a 5-foot emanation around the body. This gas deals 9d6 negative damage to creatures in this area as their flesh curdles and rots as well (DC 27 basic Fortitude save)."
            },
            "id": "eb303529-74e1-40ee-bd3b-62c7cbb11e25",
            "updated_at": {
              "value": "2026-03-17T12:41:25.308575"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Shred Flesh"
            },
            "trait_description": {
              "value": "A shanrigol behemoth's attacks brutally rend its foes. Creatures critically hit by the shanrigol's fleshy slap Strike take an additional 2d6 persistent bleed damage and are enfeebled 1 for as long as they are bleeding."
            },
            "id": "525dbf8d-d2a7-4f76-893b-fee1090fa3c5",
            "updated_at": {
              "value": "2026-03-17T12:41:25.308575"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Web Trap"
            },
            "trait_description": {
              "value": "A creature hit by the shanrigol behemoth's web attack is immobilized and stuck to the nearest surface until it can Escape (DC 25)."
            },
