              "value": []
            },
            "id": "ffabfe84-78bf-4e0f-adbf-9fd23ddea355",
            "updated_at": {
              "value": "2026-04-15T14:13:07.361623"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Tactical Gnaw"
            },
            "action_description": {
              "value": "The jiidon uses their nearly indestructible teeth to chew through even the toughest armor, leaving an opponent vulnerable. The jiidon makes a jaws Strike. On a successful attack, if the target is wearing armor with Hardness 10 or lower, the armor becomes broken. This Strike doesn't further damage armor that's already broken."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
