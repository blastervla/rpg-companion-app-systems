        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Improvised Projectile"
            },
            "action_description": {
              "value": "The morlock engineer quickly crafts an improvised projectile from objects it carries or that are readily accessible in adjacent squares. Where unusual materials are available, an improvised projectile might deal damage other than bludgeoning or piercing\u2014for example, a morlock engineer by a campfire could build a projectile that deals fire damage."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "cf59882e-f532-4b16-8e9f-a0a30e157b7a",
            "updated_at": {
              "value": "2026-04-15T14:13:00.362791"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Uncanny Tinker"
            },
            "action_description": {
              "value": "The morlock engineer tinkers with an adjacent construct or mechanical hazard. They attempt a Crafting check against the construct's or hazard's Fortitude DC. The morlock can't get an outcome better than failure if the target's level is more than double the morlock's. This ability reflects hasty battlefield repairs; once a construct or hazard regains Hit Points from this ability, it can't do so again until it's been Repaired.\n\n- **Critical Success:** The target regains 8d6 Hit Points and a +1 circumstance bonus to attack rolls for 1 minute. Alternately, the morlock can deal 8d6 damage (bludgeoning, piercing, or slashing, as chosen by the morlock engineer) to the construct or hazard.\n- **Success:** As critical success, but the target regains 4d6 Hit Points or the morlock deals 4d6 damage.\n- **Critical Failure:** The morlock injures themself, taking 3d6 damage (typically bludgeoning, piercing, or slashing, but potentially a different type at the GM's discretion)."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "4c25e683-e7db-4692-9b63-57dd409f37ee",
            "updated_at": {
