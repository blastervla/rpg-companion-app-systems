        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Inexorable"
            },
            "trait_description": {
              "value": "The purple worm recovers from the paralyzed, slowed, and stunned conditions at the end of its turn. It's also immune to penalties to its Speeds and the immobilized condition, and it ignores 3 and 3."
            },
