            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_e0ae011ad1d1",
                    "level": {
                      "value": 12
                    },
                    "description": {
                      "value": "You overcharge the triggering spell with magic. You expend a spell slot and attempt to counteract the triggering spell using the energy of the expended slot. If the triggering spell is in your repertoire and the spell slot you expended was a high enough level to cast it, you take no penalty. Otherwise, you take a \u20132 penalty to the counteract check if the triggering spell was cast using the same magical tradition you cast, or a \u20135 penalty if it was cast using a different tradition.\n\nIf the triggering spell is successfully counteracted, it creates a wellspring surge from its caster in addition to the normal effects of being counteracted. If it isn't counteracted, your expended spell slot creates a wellspring surge from you."
                    }
                  }
                }
              ]
