            },
            "description": {
              "value": "You can cast volcanic eruption as a 7th-level primal innate spell once per day, except that you can only evoke the volcano on the floor of a body of water, and the effects that normally happen to flying creatures happen to swimming creatures instead."
            }
          }
        }
