            "updated_at": {
              "value": "2026-03-17T12:41:30.439504"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Earthen Torrent"
            },
            "action_description": {
              "value": "(earth, transmutation)\n\nFrequency: 1/minute\n\nThe stoneliege creates a violent wave of roiling earth. Creatures in a 15-foot cone take 7d8 bludgeoning damage (DC 26 basic Reflex save; on a critical failure, creatures are also knocked prone)."
            },
