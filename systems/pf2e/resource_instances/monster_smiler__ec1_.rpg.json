    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Stench"
            },
            "trait_description": {
              "value": "(aura, olfactory)\n\n10 feet. A creature entering the aura or starting its turn in the aura must succeed at a 18 Fortitude save or become sickened 1 (plus slowed 1 as long as it\u02bcs sickened on a critical failure). While within the aura, the creature takes a \u20132 circumstance penalty to saves against disease and to recover from the sickened condition. A creature that succeeds at its save is temporarily immune for 1 minute."
            },
            "id": "9501112a-d1fb-4870-a989-31b497f28e88",
            "updated_at": {
              "value": "2026-03-29T00:33:13.108288"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ghast Fever"
            },
            "trait_description": {
              "value": "**Ghast Fever**\nDC: 18\nSaving Throw: Fortitude\n- Stage 1: carrier with no ill effect (1 day)\n- Stage 2: 3d8 negative damage and regains half as many Hit Points from all healing (1 day)\n- Stage 3: as stage 2 (1 day)\n- Stage 4: 3d8 negative damage and gains no benefit from healing (1 day)\n- Stage 5: as stage 4 (1 day)\n- Stage 6: dead, and rises as a ghast the next midnight."
            },
            "id": "0640eae7-8510-449c-8456-73f5d3a17f8f",
            "updated_at": {
              "value": "2026-03-29T00:33:13.108288"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation, occult, necromancy)\n\nAny living creature hit by Smiler's attack must succeed at a 18 Fortitude save or become paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
            },
            "id": "285c7a36-e147-430b-83dd-6a27febd156e",
            "updated_at": {
              "value": "2026-03-29T00:33:13.108288"
            }
          }
        }
