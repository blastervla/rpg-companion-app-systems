    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Calm Weather Aura"
            },
            "trait_description": {
              "value": "(air, aura, evocation, primal)\n\n1 mile. The ambient weather around a peng is always lightly cloudy with a pleasant breeze, and the temperature is pleasantly warm for the season. A creature that attempts to alter the weather within this aura (such as with a control weather ritual or localized effect like gust of wind) must succeed at a DC 33 Will save; otherwise the effect is disrupted. The peng can activate or deactivate this aura as a single action (this action has the concentrate trait)."
            },
            "id": "0e5d11a7-37e4-4282-9a9a-48f60f4b23e3",
            "updated_at": {
              "value": "2026-03-17T12:41:32.127455"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Heaven's View"
            },
            "trait_description": {
              "value": "Clouds don't impair a peng's vision."
            },
            "id": "6cafed7c-a03a-46f5-bc98-1785ea9cd4a0",
            "updated_at": {
              "value": "2026-03-17T12:41:32.127455"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Windslice"
            },
            "trait_description": {
              "value": "Pengs can move in any wind with easy grace. A peng ignores 3 caused by wind and doesn't need to Maneuver in Flight in high winds."
            },
            "id": "015bde83-5a24-4522-bd18-902aaf31c2c2",
