            "trait_name": {
              "value": "Forager"
            },
            "trait_description": {
              "value": "While using Survival to Subsist, if the hunter rolls a failure or a critical failure, they get a success instead. If the hunter rolls a success, they can provide food for 16 additional creatures that eat about as much as a human, or 32 creatures on a critical success."
