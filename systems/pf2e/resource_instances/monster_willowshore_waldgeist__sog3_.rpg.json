            "trait_name": {
              "value": "Fleeting Existence"
            },
            "trait_description": {
              "value": "These waldgeists are only fleeting manifestations of a failed exorcism. They vanish after 1 minute has passed from their first manifestation in the mindscape."
            },
            "id": "6f98918f-32fa-4af7-8692-2a30126624f5",
