        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_d78b33977a66",
            "level": {
              "value": 12
            },
            "description": {
              "value": "Your experience with a specific type of harmful magic makes you more resistant to it. Choose a magical tradition (arcane, divine, occult, or primal). You gain a +1 circumstance bonus to saving throws against spells and effects with that tradition's trait and resistance 5 to all damage from spells and effects with that tradition's trait. The effect must have actually been cast or created with that tradition, rather than simply being on that tradition's spell list."
            }
          }
        }
      ]
    },
