        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Spray Hot Wax"
            },
            "action_description": {
              "value": "Darius sprays hot wax from his improvised wax sprayer in a 15-foot cone. All creatures in the area must attempt a 20 Reflex save. Scented candle homunculi in the area take no damage, instead healing 2d6 damage. After using the hot wax cannon, Darius can't use it again until he takes two Interact actions while adjacent to the cauldron of bubbling wax to reload the sprayer.\n\n- **Critical Success:** The creature takes no damage.\n- **Success:** The creature takes 2d6 fire damage.\n- **Failure:** The creature takes 3d6 fire damage plus 1d6 persistent fire damage.\n- **Critical Failure:** The creature takes 5d6 fire damage plus 2d6 persistent fire damage."
            },
