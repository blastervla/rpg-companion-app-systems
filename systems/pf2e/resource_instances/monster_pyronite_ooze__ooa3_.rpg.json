        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Rejoin"
            },
            "trait_description": {
              "value": "If two or more Medium pyronite oozes end their turn in adjacent spaces, they merge into a Large pyronite ooze, combining their current Hit Points."
            },
            "id": "1b6eebd4-8bc1-410e-baa5-3c720d70ed9d",
