          "special": {
            "value": "Leads to: Basic Druid Spellcasting|PC1, Primal Breadth|PC1, Expert Druid Spellcasting|PC1, Master Druid Spellcasting|PC1, Basic Wilding|PC1, Advanced Wilding|PC1, Order Spell|PC1"
