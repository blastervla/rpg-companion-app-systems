        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Change Shape"
            },
            "action_description": {
              "value": "(concentrate, polymorph, primal, transmutation)\n\nThe wereant changes into their humanoid, hybrid, or animal shape. Each shape has a specific, persistent appearance. A true wereant's natural form is their hybrid shape. In humanoid shape, they use their original humanoid size, lose their jaws and claw Strikes, and gain a melee fist Strike that deals bludgeoning damage equal to the slashing damage dealt by their mandibles. In animal shape, they take the form of a Medium giant ant, gain a climb Speed of 20 feet, gain Grab on their mandibles Strike, and lose their weapon Strikes."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
