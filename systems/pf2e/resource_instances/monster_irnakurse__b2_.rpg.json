    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mind Lash"
            },
            "trait_description": {
              "value": "(emotion, enchantment, mental, occult)\n\nA non-evil creature hit by an irnakurse's tentacle is overwhelmed with corrupted images of a ruined life and must succeed at a 28 Will save or be stunned 2 (or stunned 4 on a critical failure). After attempting this save, a creature is temporarily immune to Mind Lash for 24 hours."
            },
            "id": "50d4837f-bfca-4a6a-9bdf-25ef6dce3812",
            "updated_at": {
              "value": "2026-03-29T00:33:08.154488"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sustain Soul"
            },
            "trait_description": {
              "value": "Scream for up to 6 rounds; each time it does, it repeats the effect.\n\n- **Critical Success:** The creature is unaffected, and is temporarily immune to Soul Scream for 24 hours.\n- **Success:** The creature is stupefied 1 for 1 round.\n- **Failure:** The creature is stupefied 1. Further failed saves against Soul Scream increase the condition value by 1, to a maximum of stupefied 4. Each time the character gets a full night's rest, the stupefied condition gained from Soul Scream decreases by 1.\n- **Critical Failure:** As failure, except the stupefied value increases by 2 instead of by 1."
            },
            "id": "94f33d33-2f6b-48ce-9b02-a8b7b72937a5",
            "updated_at": {
