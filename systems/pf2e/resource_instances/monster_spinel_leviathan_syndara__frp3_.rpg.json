        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Dimensional Flurry"
            },
            "action_description": {
              "value": "Syndara makes six Strikes. Any creature struck must succeed at a 46 Will save or be teleported to a location of Syndara's choice within 60 feet of him when the flurry is complete. The teleportation has the conjuration, divine, and teleportation traits."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "three_actions"
            },
            "action_attack_bonus": {
              "value": 0
