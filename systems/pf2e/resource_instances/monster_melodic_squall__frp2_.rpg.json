            "updated_at": {
              "value": "2026-03-19T22:58:59.453743"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Subsonic Burst"
            },
            "action_description": {
              "value": "(emotion, evocation, fear, mental, primal, sonic)\n\nThe melodic squall focuses intense sound at an inaudible frequency in a 100-foot line. Each creature in the line must attempt a 34 Fortitude save.\n\n- **Success:** The creature is unaffected.\n- **Failure:** The creature is frightened 1.\n- **Critical Failure:** The creature is frightened 2 and confused until the beginning of the melodic squall's next turn."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
