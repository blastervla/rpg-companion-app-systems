        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Mesmerizing Melody"
            },
            "action_description": {
              "value": "(auditory, concentrate, enchantment, mental, primal)\n\nThe melodic squall sings in a sonorous chorus. Any creature in a 30-foot emanation must attempt a 36 Will save to resist becoming fascinated by the melodic squall. A creature that succeeds at its save is temporarily immune for 24 hours.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature is fascinated for 1 round.\n- **Failure:** The creature is fascinated for 1d4 rounds."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
