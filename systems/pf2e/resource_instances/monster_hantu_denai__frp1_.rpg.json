        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Terrifying Cry"
            },
            "action_description": {
              "value": "(auditory, emotion, fear, mental)\n\nThe hantu denai unleashes a loud animal cry to scare off nearby creatures. Each creature in a 120-foot emanation must attempt a DC 27 Will save and is then immune to the hantu denai's Terrifying Cry for 1 minute.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature is frightened 1.\nFailure: The creature is fleeing for 1 round and frightened 2.\nCritical Failure: The creature is fleeing for 1 round and frightened 3."
            },
