          "stats": {
            "trait_name": {
              "value": "Bravery"
            },
            "trait_description": {
              "value": "When the captain of the guard rolls a success on a Will save against a fear effect, they get a critical success instead. In addition, any time they gain the frightened condition, reduce its value by 1."
            },
            "id": "66f19b64-faf3-4193-a15d-a8be84bbfaef",
