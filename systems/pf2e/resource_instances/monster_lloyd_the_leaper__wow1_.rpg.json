            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Change Shape"
            },
            "action_description": {
              "value": "(concentrate, polymorph, primal)\n\nLloyd takes on the appearance of a Small or Medium humanoid dressed in exquisite finery. This doesn't change his Speed or his attack and damage modifiers with his Strikes. When in this form, Lloyd gains a Diplomacy modifier equal to his Intimidation modifier."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "one_action"
            },
            "action_attack_bonus": {
              "value": 0
