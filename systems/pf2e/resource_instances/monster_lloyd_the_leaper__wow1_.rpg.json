            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Haze Of Dreams"
            },
            "action_description": {
              "value": "(incapacitation, mental, poison, primal, sleep)\n\nLloyd exhales a cloud of clammy gray fog. Each creature in the area must attempt a DC 23 Fortitude save.\n\n- **Critical Success:** The creature is unaffected and becomes temporarily immune for 24 hours.\n- **Success:** The creature is stupefied 1 for 1 round.\n- **Failure:** The creature falls unconscious. It wakes up automatically if it's still unconscious after 1 minute.\n- **Critical Failure:** The creature falls unconscious. It wakes up automatically if it's still unconscious after 1 hour."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
