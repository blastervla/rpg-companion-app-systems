        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Adhesive"
            },
            "trait_description": {
              "value": "Any creature that touches the mimic (usually from a fist Strike, the mimic's pseudopod, or a Grapple or Shove) must succeed at a DC 23 Reflex save or gain the grabbed condition. The DC to Escape is 23. A melee or thrown weapon that hits the mimic sticks to it. A character can spend an action to attempt a DC 23 Athletics check, removing the weapon on a success. The adhesive dissolves 1 minute after the mimic dies."
            },
