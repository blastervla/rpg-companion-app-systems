    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Mask of Power"
            },
            "trait_description": {
              "value": "A doprillu's unique wooden mask is the source of its power. A doprillu deprived of its mask loses its regeneration and its immunity to enfeebled and slowed, and it immediately becomes enfeebled 1. The enfeebled value increases by 1 at the start of each of the doprillu's turns, to a maximum of enfeebled 4. If the mask is put back on, the doprillu immediately regains its abilities and loses the enfeebled condition. A creature can pull off the mask with a successful 34 Athletics check to Force Open."
            },
            "id": "0240c860-67f2-4a49-86d1-f4e9089e5579",
            "updated_at": {
              "value": "2026-03-29T00:33:08.154488"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Volcanic Veins"
            },
            "trait_description": {
              "value": "(fire)\n\nFiery magma runs through the doprillu's veins.\n\nA creature that starts its turn grabbed by the doprillu takes 7d6 fire damage."
