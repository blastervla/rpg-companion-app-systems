    "description": {
      "value": "You throw a magically propelled and chilled ball of dense snow. The target takes 2d4 cold damage and potentially other effects, depending on the result of your spell attack roll.\n\nCritical Success: The target takes double damage and a -10-foot status penalty to its Speeds for 1 round.\nSuccess: The target takes full damage and a -5-foot status penalty to its Speeds for 1 round.\nFailure: No effect."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 2d4."
    },
