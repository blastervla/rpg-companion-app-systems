        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation, necromancy, occult)\n\nAny living creature hit by a ghastly bear's attack must succeed at a 26 Fortitude save or become paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
            },
            "id": "0b50ae56-a78f-4f7f-906d-f39a5f85f4ff",
