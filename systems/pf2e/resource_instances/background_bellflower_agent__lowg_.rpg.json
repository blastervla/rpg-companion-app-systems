                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_14adc1b7bf00",
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "You often smuggle things past the authorities. When the GM rolls your Stealth check to see if a passive observer notices a small item you've concealed, the GM uses the number rolled or 10\u2014whichever is higher\u2014as the result of your die roll, adding it to your Stealth modifier to determine your Stealth check result. If you're a master in Stealth, the GM uses the number rolled or 15, and if you're legendary in Stealth, you automatically succeed at hiding a small concealed item from passive observers. This provides no benefits when a creature attempts a Perception check while actively searching you for hidden items."
                    }
                  }
                }
              ]
