        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Memory Maelstrom"
            },
            "action_description": {
              "value": "(concentration, incapacitation, mental, nonlethal, primal)\n\nOld Thornbarker tries to overwhelm foes with a surge of information he has absorbed over his long life. This surge deals 5d6 mental damage to each enemy within 40 feet, who must attempt a DC 32 Will save.\n\n- **Critical Success:** The creature maintains its composure, takes no damage, and is temporarily immune to Memory Maelstrom for 1 minute.\n- **Success:** The creature is stunned 1 and takes half damage.\n- **Failure:** The creature takes full damage and is stunned 3.\n- **Critical Failure:** The creature takes double damage, is confused for 2d4 rounds, and is stunned 3."
            },
