    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Abeyance Rift"
            },
            "trait_description": {
              "value": "If Old Thornbarker dies unexpectedly before passing on their knowledge in a succession ritual, the amassed lore within his roots and boughs explodes out in a shock wave that deals 8d10 mental damage to creatures within 30 feet (DC 32 basic Will save) before dissipating; those who fail also fall prone."
            },
            "id": "760d4420-82b3-459f-9d26-60b320fc9e5f",
            "updated_at": {
              "value": "2026-03-19T22:59:17.821401"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sycophantic Scamps"
            },
            "trait_description": {
              "value": "See below."
            },
            "id": "c1ab3755-85dc-4dd7-9217-80b64146e992",
