        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sycophantic Scamps"
            },
            "trait_description": {
              "value": "Dozens of wood scamps clamber on, nest in, and flit around Old Thornbarker, feeding him their observations and gossip. The arboreal can grab a nearby scamp as if drawing a weapon, using it as a thrown weapon. The unlucky scamp impacts with a clatter of spines and toxic pollen, after which the dazed elemental scampers away to regain its senses.\n\nIf Old Thornbarker takes 40 or more damage from an area effect, the scamps scatter and seek cover for 1d6 rounds, during which time Old Thornbarker can't make scamp Strikes and loses all-around vision."
            },
            "id": "95b235a9-11b6-47a0-8c8a-92480c4aa47f",
            "updated_at": {
              "value": "2026-03-17T12:41:44.056477"
            }
          }
        }
