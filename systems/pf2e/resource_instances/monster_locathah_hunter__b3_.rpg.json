        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Cooperative Hunting"
            },
            "trait_description": {
              "value": "After the hunter attempts a Strike at a Large or larger target (regardless of success or failure), the next Strike one of the hunter's allies makes against the same target gains a +2 circumstance bonus to the attack roll."
            },
