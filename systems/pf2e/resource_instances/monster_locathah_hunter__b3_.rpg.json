        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Pack Attack"
            },
            "trait_description": {
              "value": "The hunter's Strikes deal an additional 1d8 damage to creatures within reach of at least two of the hunter's allies."
