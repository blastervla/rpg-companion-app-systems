        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Luring Cry"
            },
            "action_description": {
              "value": "(aura, enchantment, incapacitation, linguistic, mental, primal)\n\nRequirements: The leucrotta's last action was Sound Mimicry\n\n60 feet; The leucrotta utters a plaintive cry to draw its prey closer. Each creature within the emanation that was deceived by Sound Mimicry must succeed at a 19 Will save or become fascinated and compelled to move toward the sound of the leucrotta's voice on their turn. Fascinated creatures are also flat-footed. If the attacks, the fascinated condition ends only for the creature that is attacked.\n\nIf the leucrotta speaks a creature's name while using its Luring Cry, that creature takes a \u20132 circumstance penalty to their saving throw to resist the ability. On a successful save, a creature is temporarily immune to Luring Cry for 24 hours."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "0f99971d-80b0-440a-91e8-bafeb246e5de",
            "updated_at": {
              "value": "2026-03-19T22:58:51.312291"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Sound Mimicry"
            },
            "action_description": {
              "value": "The leucrotta perfectly imitates voices and speech and attempts a Deception check against listeners' Will DC to fool them. The leucrotta gains a +4 bonus to this Deception check if it has listened to the creature it's imitating for at least 10 minutes at any point in the last 24 hours. The leucrotta can't duplicate voice-based abilities or spells, though it can perfectly mimic the sound of verbal spellcasting and can attempt to deceive constructs or undead that respond to voice commands. The leucrotta can't imitate speech in languages it doesn't know."
            },
            "action_type": {
              "value": "none"
            },
