    "description": {
      "value": "A cone of icy shards bursts from your spread hands and coats the targets in a layer of frost. You deal 2d4 cold damage to creatures in the area; they must each attempt a Reflex save.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature takes half damage.\nFailure: The creature takes full damage and takes a -5-foot status penalty to its Speeds for 2 rounds.\nCritical Failure: The creature takes double damage and takes a -10-foot status penalty to its Speeds for 2 rounds."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 2d4."
    },
