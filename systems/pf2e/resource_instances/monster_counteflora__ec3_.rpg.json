        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Tighten Bracts"
            },
            "action_description": {
              "value": "The counteflora stiffens the specialized leaves around its flower head, protecting its sensitive seedpods. While its bracts are tightened, a counteflora gains a +2 circumstance bonus to AC and can use its head Strike and Furious Swing abilities, but it cannot use its Black Seed Cloud ability and it loses its sense of sight (so it must rely on its imprecise tremorsense when targeting other creatures). The counteflora can't use its head Strike of Furious Swing ability unless its bracts are tightened. The counteflora can loosen its bracts as a free action (this action has the concentrate trait)."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "2a78e6a3-7782-4b79-87b1-a5bd5b74ab75",
            "updated_at": {
              "value": "2026-03-17T12:41:30.439504"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Black Seed Cloud"
            },
            "action_description": {
              "value": "The counteflora releases a cloud of black seedpods in a 15-foot-radius emanation. Non-counteflora creatures in the area must succeed at a Fortitude save or breathe in the toxic seeds. (Against plants and fungi, the seeds burrow into the creatures' flesh rather than infiltrate their lungs.)"
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "b58a831a-0f02-4f00-b6c1-9eda3f0c52a5",
            "updated_at": {
              "value": "2026-03-17T12:41:30.439504"
            }
          }
        },
