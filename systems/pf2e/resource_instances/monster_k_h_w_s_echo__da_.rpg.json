        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Contingency Oathday-nine-rova"
            },
            "action_description": {
              "value": "Trigger: The Echo's turn begins and he's stunned, slowed, confused, controlled, immobilized, grabbed, paralyzed, restrained, or otherwise can't act\n\nFrequency: 1/day\n\nThe Echo has set up numerous contingencies in the event he's compromised.\n\nTalismans on his body shatter, counteracting the triggering effect. The Echo can use this free action even if he can't act."
            },
