          "special": {
            "value": "You can't select another dedication feat until you've gained two other feats from the ritualist archetype. If you retrain out of this feat, you lose the rituals learned from it.\nLeads to: Efficient Rituals|APG, Speedy Rituals|APG, Flexible Ritualist|APG, Assured Ritualist|APG, Resourceful Ritualist|APG"
          },
          "descriptions": {
            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_19da157973b4",
                  "level": {
                    "value": 4
                  },
                  "description": {
                    "value": "You have begun to master the difficult art of casting rituals.\n\nYou gain a +2 circumstance bonus to all primary checks to perform a ritual. You learn two uncommon rituals with a level no higher than half your level; you must meet all prerequisites for casting the ritual to choose it."
                  }
                }
              },
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_5b3083766441",
                  "level": {
                    "value": 8
                  },
                  "description": {
                    "value": "Every 4 levels thereafter, you learn another uncommon ritual with a level no higher than half your level and for which you meet the prerequisites. You can cast these as the primary caster, but you can't teach them to anyone else or allow someone else to serve as primary caster unless they know the ritual as well."
                  }
                }
              }
            ]
          },
