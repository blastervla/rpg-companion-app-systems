        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Create Spawn"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nAny humanoid creature killed by a trailgaunt and left unburied out of sight of a well-maintained road rises as a free-willed trailgaunt at the next sunset."
            },
            "id": "9d518532-bef5-41c6-a729-38c2515493ba",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Dromophobia"
            },
            "trait_description": {
              "value": "The trailgaunt can't willingly walk on or across a well-maintained road, though it can Burrow under one. If forced onto the surface of such a road, the trailgaunt is fleeing until it's no longer on the road."
            },
            "id": "ea13b390-8b65-4ada-a60e-0bbd2f3ff256",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Share Pain"
            },
            "trait_description": {
              "value": "A living creature hit by a trailgaunt's jaws Strike must succeed at a DC 20 Fortitude save or suffer intense pain in its legs and feet, taking a \u201310-foot status penalty to its Speeds, or a \u201320-foot status penalty on a critical failure."
            },
            "id": "2bd318d2-e62a-4482-95a3-84d0adbc1124",
