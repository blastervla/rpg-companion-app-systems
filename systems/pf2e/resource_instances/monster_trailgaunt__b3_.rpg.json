        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Create Spawn"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nAny humanoid creature killed by a trailgaunt and left unburied out of sight of a well-maintained road rises as a free-willed trailgaunt at the next sunset."
            },
            "id": "27dbaf5f-1daa-4d34-8aba-880c952bb821",
            "updated_at": {
              "value": "2026-04-15T14:13:01.886886"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Dromophobia"
            },
            "trait_description": {
              "value": "The trailgaunt can't willingly walk on or across a well-maintained road, though it can Burrow under one. If forced onto the surface of such a road, the trailgaunt is fleeing until it's no longer on the road."
            },
            "id": "531ec243-f3c8-451a-bfb2-3ae0532d2465",
            "updated_at": {
              "value": "2026-04-15T14:13:01.886886"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Share Pain"
            },
            "trait_description": {
              "value": "A living creature hit by a trailgaunt's jaws Strike must succeed at a 20 Fortitude save or suffer intense pain in its legs and feet, taking a \u201310-foot status penalty to its Speeds, or a \u201320-foot status penalty on a critical failure."
            },
            "id": "8a4b2887-580f-4eef-8f5e-a8f6acd0a8ab",
            "updated_at": {
              "value": "2026-04-15T14:13:01.886886"
            }
          }
        },
        {
