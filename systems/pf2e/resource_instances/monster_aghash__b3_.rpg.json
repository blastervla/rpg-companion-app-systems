        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Cursed Gaze"
            },
            "action_description": {
              "value": "(divine, concentrate, curse, fear, emotion, enchantment, mental, visual)\n\nThe aghash fixes their gaze on one creature they can see within 20 feet. The creature must attempt a 21 Will save.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature takes 2d6 mental damage and becomes frightened 1.\n- **Failure:** The creature takes 4d6 mental damage and becomes either frightened 2 or stunned 1 (the aghash's choice).\n- **Critical Failure:** The creature takes 8d6 mental damage and becomes frightened 2 and stunned 2."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
