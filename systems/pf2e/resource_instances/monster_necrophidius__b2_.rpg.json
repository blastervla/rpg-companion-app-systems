          "stats": {
            "trait_name": {
              "value": "Necrophidic Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation, occult, necromancy)\n\nA living creature bitten by a necrophidius must succeed at a 20 Fortitude save or become paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 for each save attempted. A creature that succeeds at this save is temporarily immune to necrophidic paralysis for 24 hours."
            },
