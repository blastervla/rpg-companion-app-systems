        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Dance of Death"
            },
            "action_description": {
              "value": "(enchantment, mental, occult, visual)\n\nThe necrophidius sways, its serpentine form undulating and clattering in a hypnotic rhythm. Each creature that witnesses the dance must attempt a DC 18 Will save.\n\nCritical Success: The creature is unaffected and is temporarily immune for 24 hours.\nSuccess: The creature is unnerved by the swaying and becomes flat-footed until the end of the necrophidius's next turn.\nFailure: The creature is distracted by the swaying, becoming stunned 1. After it recovers, it is flat-footed until the end of the necrophidius's next turn.\nCritical Failure: As failure, but stunned 3."
            },
