          "stats": {
            "trait_name": {
              "value": "Incorporeal"
            },
            "trait_description": {
              "value": "A ghost has no body and can pass through physical objects, though it can't end its turn inside one. Most checks that use Strength and require a body, such as Grapple and Shove, don't work against a ghost, and a ghost can't attempt such checks."
            },
            "id": "3ac7ae65-e7f3-429a-8b06-d7aabfd7051f",
