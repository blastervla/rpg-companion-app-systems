          "stats": {
            "trait_name": {
              "value": "Rejuvenation"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nSetting right the injustice that led to the ghost's death allows it to move on to the afterlife. Otherwise, when destroyed, the ghost re-forms after 2d4 days within the location it's bound to, fully healed."
            },
            "id": "93ae37f6-5b42-4e7d-ada7-8b8ca243927b",
