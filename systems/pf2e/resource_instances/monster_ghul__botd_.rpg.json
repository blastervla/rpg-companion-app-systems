            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Devour Flesh"
            },
            "action_description": {
              "value": "(manipulate)\n\nRequirements: The ghul has a creature grabbed or restrained\n\nThe ghul attempts to eat a portion of the grabbed creature's flesh. It makes a jaws Strike against the grabbed creature. On a success, the ghul successfully devours some of the flesh and regains 3d6 Hit Points. The grabbed creature becomes drained 1 (or drained 2 if the jaws Strike was a critical success). The violent consumption requires the ghul to release the creature as it feasts.\n\nA ghul can regain Hit Points from consuming the flesh of a given creature only once per hour; it must consume the flesh of a different creature to gain additional Hit Points during this time."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
