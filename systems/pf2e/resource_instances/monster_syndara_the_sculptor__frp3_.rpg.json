            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Keeper of the Lighthouse"
            },
            "trait_description": {
              "value": "Syndara can choose whether he is affected by his worldspheres (page 57)."
            },
            "id": "82032eda-8bae-448b-8559-39f0736a40c1",
            "updated_at": {
