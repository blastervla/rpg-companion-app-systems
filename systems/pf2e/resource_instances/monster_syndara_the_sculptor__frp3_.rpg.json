        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Walk the Spiral"
            },
            "action_description": {
              "value": "Trigger: Syndara Strikes a creature on his own turn\n\nSyndara rotates the space of the Glass Lighthouse around himself to carry him to a distant location in an instant. He Strides twice. This movement doesn't trigger reactions. If his next action is to attack a different target than the triggering creature, he gains a +1 circumstance bonus to that attack; each time he Walks the Spiral in a turn, this bonus increases by 1, to a maximum of +3."
            },
