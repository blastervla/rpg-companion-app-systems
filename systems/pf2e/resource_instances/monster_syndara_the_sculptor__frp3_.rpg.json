        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Extradimensional Immunity"
            },
            "trait_description": {
              "value": "Syndara can foil any attempts to use planar powers against him. He is immune to all extradimensional effects, such as maze, but can choose to be affected by such effects normally."
            },
            "id": "7256a0db-dc15-4199-90dc-ceb8d886e708",
            "updated_at": {
