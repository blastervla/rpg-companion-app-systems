    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Cat at Heart"
            },
            "trait_description": {
              "value": "When a bakeneko is killed, they immediately reincarnate into a normal house cat who can never again become a bakeneko."
            },
            "id": "bd4fb1fe-ec57-48d6-9cfa-d3ac45a974f7",
            "updated_at": {
              "value": "2026-04-15T14:13:10.291231"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Feel the Beat"
            },
            "trait_description": {
              "value": "Bakenekos love to dance. If a bakeneko begins their turn within 30 feet of a source of music, they become slowed 1 until the start of their next turn as they follow their compulsion to move to the rhythm of the tune by swishing their tail in time, stomping from one hind leg to the other, or clapping their front paws."
            },
            "id": "c4c60a78-902c-4c82-9bfb-d2522a0958e7",
            "updated_at": {
              "value": "2026-04-15T14:13:10.291231"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Flammable"
            },
            "trait_description": {
              "value": "Thanks to their high-fat diets, bakenekos secrete flammable oils from their skin that coats their fur. If a bakeneko takes any fire damage, their entire body lights up in flame, turning them into a furry fireball until the end of their next turn. While burning in this way, a bakeneko's Strikes inflict an additional 1d6 fire damage."
            },
            "id": "b3e5b9a5-2e4f-470a-9e12-c2c79ae99db3",
            "updated_at": {
              "value": "2026-04-15T14:13:10.291231"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Skilled Ritualist"
            },
            "trait_description": {
              "value": "Bakenekos can only create zombies with create undead but can perform the ritual without secondary casters and lower the casting time to 4 hours."
            },
            "id": "4415cd6f-c161-4dfe-bf3a-7b3e0c684690",
            "updated_at": {
              "value": "2026-04-15T14:13:10.291231"
