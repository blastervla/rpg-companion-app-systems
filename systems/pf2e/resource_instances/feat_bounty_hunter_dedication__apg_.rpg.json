        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_15b5ad02ec9d",
            "level": {
              "value": 2
            },
            "description": {
              "value": "When focused on finding your quarry, you're relentless. You gain the Hunt Prey action. You can use Hunt Prey to designate only a creature that you've seen, heard about, or learned about through some other means, such as a bounty board or wanted poster. In addition to the other benefits of Hunt Prey, you gain a +2 circumstance bonus to checks to Gather Information regarding your prey.\n\nIf you already have Hunt Prey, you become an expert in Survival and gain the circumstance bonus to Gather Information about your prey; you can still designate a creature you're tracking during exploration, in addition to the conditions above."
            }
          }
        }
      ]
    },
