        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Flurry of Blows"
            },
            "action_description": {
              "value": "Frequency: 1/round\n\nThe Rai Sho disciple makes two Strikes, each of which must be an unarmed Strike or temple bell Strike. If both hit the same creature, combine their damage for the purpose of resistances and weaknesses."
