        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Crying Bell Stance"
            },
            "action_description": {
              "value": "(stance)\n\nThe disciple cups one hand and poses the other to strike it, like the Rai Sho Monastery's central bell. In this stance, they can make temple bell Strikes. While in this stance, a disciple gains a +2 status bonus to AC against ranged attacks."
            },
