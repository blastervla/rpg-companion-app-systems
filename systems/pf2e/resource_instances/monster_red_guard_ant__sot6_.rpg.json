        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Swarming Flank"
            },
            "trait_description": {
              "value": "If at least three red guard ants have a creature within their reach, they flank the creature, even if they can't draw a line to each other that passes through opposite sides of the creature's space."
