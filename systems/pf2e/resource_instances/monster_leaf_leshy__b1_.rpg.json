        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Verdant Burst"
            },
            "trait_description": {
              "value": "(healing)\n\nWhen a leaf leshy dies, a burst of primal energy explodes from its body, restoring 1d4 Hit Points to each plant creature in a 30-foot emanation. This area is filled with tree saplings, becoming difficult terrain. If the terrain is not a viable environment for these trees, they wither after 24 hours."
            },
            "id": "3587b5df-d2ab-4d4b-9b5c-5ff6ba44a779",
            "updated_at": {
              "value": "2026-03-29T00:33:07.115375"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Deafening Blow"
            },
            "trait_description": {
              "value": "When a leaf leshy hits with its seedpod Strike, the target must attempt a 16 Fortitude save.\n\n- **Critical Success:** The target is unaffected and temporarily immune for 24 hours.\n- **Success:** The target is unaffected.\n- **Failure:** The target is deafened for 1 round.\n- **Critical Failure:** The target is deafened for 1 minute."
            },
            "id": "be9797ad-e602-40df-b8b8-6e56fc3e4069",
            "updated_at": {
