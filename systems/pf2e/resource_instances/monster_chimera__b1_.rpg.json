              "value": []
            },
            "id": "136b897e-a4d6-43d3-9bbe-a8ac019de3f2",
            "updated_at": {
              "value": "2026-03-17T12:41:25.944969"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Three-Headed Strike"
            },
            "action_description": {
              "value": "The chimera makes a Strike with its dragon jaws, lion jaws, and goat horns, each at a \u20132 penalty and targeting a different creature. These Strikes count as only one attack for the chimera's multiple attack penalty, and the penalty doesn't increase until after it has made all three attacks."
            },
