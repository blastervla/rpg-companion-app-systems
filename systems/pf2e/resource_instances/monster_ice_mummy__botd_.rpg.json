        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Channel Rot"
            },
            "trait_description": {
              "value": "(occult, necromancy)\n\nThe ice mummy can deliver cold rot through melee weapons they wield."
            },
            "id": "89a514ec-d06c-47cd-b416-cdce0d11a11c",
            "updated_at": {
              "value": "2026-03-19T22:58:53.849899"
            }
