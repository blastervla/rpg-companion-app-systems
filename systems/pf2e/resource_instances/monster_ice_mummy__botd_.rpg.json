            "trait_name": {
              "value": "Channel Rot"
            },
            "trait_description": {
              "value": "(occult, necromancy)\n\nThe ice mummy can deliver cold rot through melee weapons they wield."
            },
            "id": "52a8fe42-0609-40c5-9242-fc628d37e019",
