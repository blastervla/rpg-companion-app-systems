        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Water Sprint"
            },
            "action_description": {
              "value": "The bog strider Strides up to three times in a straight line across smooth water. They can make a single Strike against a creature at the end of this movement."
