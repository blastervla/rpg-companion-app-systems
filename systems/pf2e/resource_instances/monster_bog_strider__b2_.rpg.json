        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Hurl Net"
            },
            "action_description": {
              "value": "The bog strider hurls their net to hamper a foe. They make a ranged Strike (with a +10 modifier) against a Medium or smaller creature within 20 feet. On a hit, the target is flat-footed and takes a \u201310-foot circumstance penalty to its Speeds. On a critical hit, the creature is instead restrained. The DC to Escape the net is 16. A creature adjacent to the target can Interact with the net to remove it from the target."
            },
