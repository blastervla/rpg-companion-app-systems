            "trait_name": {
              "value": "Sensitive Hearing"
            },
            "trait_description": {
              "value": "As long as a noppera-bo is deafened, they're slowed 1."
            },
            "id": "e60ba6aa-740b-4431-bf73-cbfd0b85d3d5",
