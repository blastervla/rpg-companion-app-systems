          "stats": {
            "action_name": {
              "value": "Smear Text"
            },
            "action_description": {
              "value": "The scrit rubs its fingers against one page of writing, smearing the text and rendering it unreadable. The scrit can smear and destroy magical writing such as a glyph of warding or a sigil by succeeding at a counteract check (using the scrit's spell attack modifier) against the caster's DC."
            },
