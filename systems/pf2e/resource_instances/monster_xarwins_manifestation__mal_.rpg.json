          "stats": {
            "trait_name": {
              "value": "Manor Bound"
            },
            "trait_description": {
              "value": "The manifestation can't leave Xarwin Manor or the dungeons below."
            },
            "id": "bd0ae0b7-c2be-4b40-98d8-b372e7e399b7",
