          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Drain Memory"
            },
            "trait_description": {
              "value": "(necromancy, occult)\n\nWhen the manifestation damages a living creature with its spectral hand Strike, the manifestation gains 5 temporary Hit Points, and the target must succeed at a DC 23 Fortitude save or become stupefied 1. Each time it deals damage to a creature, that creature's stupefied condition increases by 1 on a failed save, to a maximum of stupefied 4."
            },
            "id": "aa6ed298-1946-402f-88d7-7e2344ce16bf",
