        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Brainlash"
            },
            "action_description": {
              "value": "(mental, necromancy, occult)\n\nThe undead brain collector extrudes a writhing tangle of ectoplasm from its bursted brain blisters. These ectoplasmic strands lash out at all living targets within 30 feet. Targets in this area must attempt a DC 25 Will save. After the undead brain collector uses this ability, seven phantom brains glow and shimmer where its brain blisters once were. It can't use Brainlash again until all seven phantom brains are Absorbed.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature takes 4d6 mental damage.\n- **Failure:** The creature takes 8d6 mental damage.\n- **Critical Failure:** The creature takes 8d6 mental damage and is confused."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
