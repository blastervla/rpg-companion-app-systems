        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Lightning Crash"
            },
            "action_description": {
              "value": "(electricity, incapacitation, sonic)\n\nThe uthul unleashes a powerful bolt of lightning and a stunning thunderclap. The bolt deals 6d12 electricity damage to all creatures in a 30-foot line, with a DC 34 basic Reflex save, and every creature in a 20-foot emanation must attempt a DC 34 Fortitude save. The uthul can't use Lightning Crash again for 1d4 rounds.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature is stunned 1.\nFailure: The creature is stunned for 1 round.\nCritical Failure: The creature is stunned for 1d4 rounds."
            },
            "action_type": {
              "value": "none"
            },
