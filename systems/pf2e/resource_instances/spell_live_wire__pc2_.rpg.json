    "description": {
      "value": "You conjure up a length of sharp copper filament humming with electrical current that strikes out at your foe. The wire deals 1d4 slashing damage and 1d4 electricity damage, depending on your spell attack roll against the target's AC.\n\nCritical Success: The target takes double damage and 1d4 persistent electricity damage.\nSuccess: The target takes full damage.\nFailure: The target takes the electricity damage, but not the slashing damage.\nCritical Failure: The target is unaffected."
    },
    "higher_level_description": {
      "value": "Heightened (+2): The slashing damage, initial electricity damage, and persistent electricity damage on a critical hit each increase by 1d4."
    },
