    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Stench"
            },
            "trait_description": {
              "value": "(aura, olfactory)\n\n10 feet. A creature entering the aura or starting its turn in the aura must succeed at a 16 Fortitude save or become sickened 1 (plus slowed 1 as long as it's sickened on a critical failure). While within the aura, the creature takes a \u20132 circumstance penalty to saves against disease and to recover from the sickened condition. A creature that succeeds at its save is temporarily immune for 1 minute."
            },
            "id": "41766234-c0d4-40fd-ba61-37a68b334ea3",
            "updated_at": {
              "value": "2026-03-23T01:11:48.023497"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Ghast Fever"
            },
            "trait_description": {
              "value": "**Ghast Fever**\nDC: 16\nSaving Throw: Fortitude\n- Stage 1: carrier with no ill effect (1 day)\n- Stage 2: 3d8 negative damage and regains half as many Hit Points from all healing (1 day)\n- Stage 3: as stage 2 (1 day)\n- Stage 4: 3d8 negative damage and gains no benefit from healing (1 day)\n- Stage 5: as stage 4 (1 day)\n- Stage 6: dead, and rises as a ghast the next midnight"
            },
            "id": "9d31ed35-1d0c-4d1a-9018-7e36f25ddd40",
            "updated_at": {
              "value": "2026-03-23T01:11:48.023497"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Paralysis"
            },
            "trait_description": {
              "value": "(incapacitation, occult, necromancy)\n\nAny living creature hit by a ghast's attack must succeed at a 15 Fortitude save or become paralyzed. It can attempt a new save at the end of each of its turns, and the DC cumulatively decreases by 1 on each such save."
            },
            "id": "82025294-6590-4fe3-8eb5-c816041b0937",
            "updated_at": {
              "value": "2026-03-23T01:11:48.023497"
            }
          }
        }
