          "stats": {
            "trait_name": {
              "value": "Ghast Fever"
            },
            "trait_description": {
              "value": "DC 16 Fortitude; Stage 1: carrier with no ill effect (1 day); Stage 2: 3d8 negative damage and regains half as many Hit Points from all healing (1 day); Stage 3: as stage 2 (1 day); Stage 4: 3d8 negative damage and gains no benefit from healing (1 day); Stage 5: as stage 4 (1 day); Stage 6: dead, and rises as a ghast the next midnight ()"
            },
            "id": "973b50b2-e6ec-4aa6-b770-d5393f4cd88f",
