        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_5be37e07c053",
            "level": {
              "value": 14
            },
            "description": {
              "value": "Divine power is always at your fingertips, swiftly responding to your call. When you cast harm or heal by spending 2 actions, you can get the effects of the 3-action version instead of the 2-action version.\n\nYou can do this with harm if you have harmful font or heal if you have healing font (or both if you have Versatile Font)."
            }
          }
        }
