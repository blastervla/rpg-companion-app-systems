    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Fence's Eye"
            },
            "trait_description": {
              "value": "Fences live by their ability to recognize a viable trade. They can use Underworld Lore to identify an item's value and Identify Magic on an item.\n\nThey gain a +2 circumstance bonus to Underworld Lore checks when doing so, and to Underworld Lore checks to determine whether an item was stolen, whether a stolen item would be too recognizable to easily move, and who would be interested in purchasing such an item."
            },
            "id": "1846af43-7260-4a1d-86ef-d99ae040c0a2",
            "updated_at": {
              "value": "2026-03-19T22:59:00.326184"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Scoundrel's Feint"
            },
            "trait_description": {
              "value": "When the fence successfully Feints, their target is flat-footed against the fence's attacks until the end of the fence's next turn. On a critical success, the target is flat-footed against all attacks until the end of the fence's next turn."
            },
            "id": "632e21cf-30a2-4fab-bf9f-715019eab4aa",
            "updated_at": {
              "value": "2026-03-19T22:59:00.326184"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sneak Attack"
            },
            "trait_description": {
              "value": "The fence deals an extra 2d6 precision damage to flat-footed creatures."
            },
            "id": "5cca1123-822e-4751-ab5c-0d3f803b52d8",
