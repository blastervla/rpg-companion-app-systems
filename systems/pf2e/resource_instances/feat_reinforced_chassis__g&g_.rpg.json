      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_fb5c2526316b",
            "level": {
              "value": 1
            },
            "description": {
              "value": "Your body is designed to be particularly resilient. Your chassis is medium armor in the plate armor group that grants a +4 item bonus to AC, a Dex cap of +1, a check penalty of –2, a speed penalty of –5 feet, and a Strength value of 16. You can never wear other armor or remove your chassis; however, you still don't become fatigued from sleeping. Finally, you can etch armor runes onto your chassis as normal.\n\n**Chassis Deflection**\n\n- **Activate:** Reaction\n- **Trigger:** A critical hit deals physical damage to you\n\nAttempt a DC 17 flat check. If you are successful, the attack becomes a normal hit.\n\n**Enhancement** Your chassis becomes difficult to overcome. You gain the Chassis Deflection reaction."
            }
          }
        }
      ]
    },
