    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Starvation Aura"
            },
            "trait_description": {
              "value": "(aura, divine, mental, necromancy)\n\n60 feet. Any creature that ends its turn in the aura feels the intense pain of starvation and must attempt a DC 32 Fortitude save. On a failure, the creature becomes fatigued and takes 7d6 damage. The damage and fatigue a creature takes from this aura can't be healed until the affected creature has eaten a full meal."
            },
            "id": "5fabb10b-00ef-4e10-8df4-4f8dd0c79eb0",
            "updated_at": {
              "value": "2026-03-17T12:41:30.714507"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Corpse Consumption"
            },
            "trait_description": {
              "value": "(divine, necromancy)\n\nIf the gashadokuro kills a creature with Swallow Whole, it immediately regains Hit Points equal to the swallowed creature's level. As long as the gashadokuro still exists, creatures consumed in this way can't be resurrected except by wish or a similarly powerful effect."
            },
            "id": "c3953ad7-9006-4a04-bb13-3c3393c4dc0c",
            "updated_at": {
              "value": "2026-03-17T12:41:30.714507"
