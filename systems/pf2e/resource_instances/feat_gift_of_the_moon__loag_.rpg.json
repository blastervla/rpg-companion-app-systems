            },
            "description": {
              "value": "You can share your power with others, but they can't escape the werecreature's curse as easily as you can. You can cast a 5th-level moon frenzy as a primal innate spell once per day."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_91e916d0608d",
            "level": {
              "value": 15
            },
            "description": {
              "value": "You cast a 6th-level moon frenzy instead."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_1b69cae19c94",
            "level": {
              "value": 17
            },
            "description": {
              "value": "Your 6th-level moon frenzy grants its standard effects, except the temporary Hit Points increase to 15 and the silver weakness increases to 15."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_229b8aa7fe5a",
            "level": {
              "value": 20
            },
            "description": {
              "value": "You cast a 10th-level moon frenzy instead.\n\nThe spell uses your class DC or spell DC, whichever is higher."
            }
          }
        }
      ]
