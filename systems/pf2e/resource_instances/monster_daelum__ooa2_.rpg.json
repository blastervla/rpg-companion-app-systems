        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Shift Form"
            },
            "action_description": {
              "value": "The daelum transforms into a quadruped. While in this form, their Speed increases by 10 feet and they don't count the contents of their belly hatch against the total amount they can carry. The daelum can make hoof Strikes in quadruped form, but not pick or claw Strikes. Using this ability again returns the daelum to their bipedal form."
            },
