              "value": "Sin Scent"
            },
            "trait_description": {
              "value": "A sinspawn can smell creatures that reflect its sin, as the scent ability. The GM determines which creatures are appropriately sinful."
            },
            "id": "5a2e4d33-bd65-4eaf-95ed-ee22b440ca4e",
