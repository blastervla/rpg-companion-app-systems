        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sinful Bite"
            },
            "trait_description": {
              "value": "(arcane, emotion, mental)\n\nA creature hit by the jaws of a sinspawn must attempt a DC 18 Will save as it is assailed by sinful thoughts.\n\nSuccess: Sickened 1.\nCritical Success: Unaffected.\nFailure: Sickened 2.\nCritical Failure: Sickened 2 plus an additional penalty, determined by the sinspawn's sin, while it remains sickened."
            },
            "id": "d13626f9-98f8-4206-be47-c00a62567956",
            "updated_at": {
              "value": "2026-03-17T12:41:25.944969"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sin"
            },
            "trait_description": {
              "value": "A sinspawn gains an additional skill based on its sin, as well as a weapon that reflects the preferences of its kinds' ancient creators. The seven sins and the benefits they confer upon a sinspawn are noted in the Sinspawn Sins section."
            },
            "id": "48767e46-ac7e-4075-8f7c-f0b201b5b4b3",
            "updated_at": {
              "value": "2026-03-17T12:41:25.944969"
