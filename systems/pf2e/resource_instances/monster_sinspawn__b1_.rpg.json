        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sinful Bite"
            },
            "trait_description": {
              "value": "(arcane, emotion, mental)\n\nA creature hit by the jaws of a sinspawn must attempt a 18 Will save as it is assailed by sinful thoughts.\n\n- **Critical Success:** Unaffected.\n- **Success:** Sickened 1.\n- **Failure:** Sickened 2.\n- **Critical Failure:** Sickened 2 plus an additional penalty, determined by the sinspawn's sin, while it remains sickened."
            },
            "id": "cf4db060-f3ae-49f4-b7d2-8f721e6ec417",
            "updated_at": {
              "value": "2026-03-23T01:11:48.023497"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Sin"
            },
            "trait_description": {
              "value": "A sinspawn gains an additional skill based on its sin, as well as a weapon that reflects the preferences of its kinds' ancient creators. The seven sins and the benefits they confer upon a sinspawn are noted in the Sinspawn Sins section."
            },
            "id": "af3020f1-21c5-4bee-bf28-2d40996609e9",
            "updated_at": {
