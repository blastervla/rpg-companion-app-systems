        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Impaling Strike"
            },
            "action_description": {
              "value": "Frequency: 1/round\n\nThe Jackal Guard lunges forward with their spear and delivers a piercing blow. The Jackal Guard Steps and then makes a melee spear Strike. On a hit, the target also takes 1d6 persistent bleed damage."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
