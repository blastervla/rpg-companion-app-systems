              "value": []
            },
            "id": "fa67d4b5-0d48-4fcb-9596-a4042828ff17",
            "updated_at": {
              "value": "2026-03-29T00:33:21.437399"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Yank"
            },
            "action_description": {
              "value": "Requirements: Kuworsys is Reared Back\n\nKuworsys makes a melee limb Strike against a creature and, on a success, attempts to steal the creature's weapon from its hands. Kuworsys attempts a Thievery check against the target's Reflex DC.\n\n- **Critical Success:** The creature's weapon falls to the floor in the creature's space.\n- **Success:** Until the start of that creature's turn, attempts to Disarm the creature of its weapon gain a +2 circumstance bonus, and the target takes a \u20132 circumstance penalty to attacks with the weapon or other checks requiring a firm grasp on the weapon.\n- **Failure:** The creature is unaffected.\n- **Critical Failure:** The creature can use a reaction to attempt a melee Strike against Kuworsys with the weapon Kuworsys attempted to grab."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
