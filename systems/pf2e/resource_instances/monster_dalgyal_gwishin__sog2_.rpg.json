            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Peel Face"
            },
            "action_description": {
              "value": "(divine, necromancy)\n\nTrigger: The dalgyal gwishin critically hits a creature or reduces a creature to 0 Hit Points while in a Jealous Frenzy\n\nThe dalgyal gwishin presses its stony face to the creature's face, causing a ghostly imprint of that face to peel away and duplicate onto its head. The triggering creature must succeed at a 22 Will save or become stupefied 1 (stupefied 2 on a critical failure). The dalgyal gwishin's Jealous Frenzy ends, and it doesn't become slowed."
            },
            "action_type": {
