        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Jealous Frenzy"
            },
            "action_description": {
              "value": "(divine, enchantment, mental)\n\nTrigger: The dalgyal gwishin Strikes a creature that has a higher Charisma modifier than itself\n\nFrequency: 1/day\n\nThe dalgyal gwishin enters an envious frenzy as it senses strong ties of friendship and personality within the creature it struck. The dalgyal gwishin becomes quickened but can only use its quickened action to Strike the triggering creature. If the dalgyal gwishin fails to Strike the triggering creature at least once during its turn, Jealous Frenzy ends. It also ends after 1 minute. After Jealous Frenzy ends, the dalgyal gwishin is slowed 1 for 1 minute."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "reaction"
            },
            "action_attack_bonus": {
              "value": 0
            },
