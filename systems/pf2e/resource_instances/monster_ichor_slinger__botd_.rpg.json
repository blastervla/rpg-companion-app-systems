            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Exhume"
            },
            "action_description": {
              "value": "(manipulate)\n\nRequirements: The ichor slinger is adjacent to a dead creature that hasn't already been affected by Exhume\n\nThe ichor slinger harvests portions of the corpse to gain 1 dose of infused reagents, or 2 infused reagents if the creature was undead."
            },
