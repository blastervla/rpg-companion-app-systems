              "value": []
            },
            "id": "40ceebc8-ebfe-4f69-908b-6ce93ed81397",
            "updated_at": {
              "value": "2026-04-15T14:13:01.456335"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Swear"
            },
            "action_description": {
              "value": "(auditory, curse, enchantment, primal)\n\nThe culdewen unleashes a string of invectives. Each creature that hears them must attempt a 25 Will save, with the effects of mariner's curse and is then temporarily immune for 24 hours. Even on a failed save, the curse ends automatically after 1 day."
            },
