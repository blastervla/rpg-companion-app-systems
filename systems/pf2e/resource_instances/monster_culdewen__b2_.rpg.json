    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Culdewen's Curse"
            },
            "trait_description": {
              "value": "(curse, enchantment, primal)\n\nA culdewen that captures a creature is compelled to immediately retreat to a secluded place to eat, typically journeying by boat. The travel to the secluded place always takes at least 1 day. Their captive is cursed to vanish on the journey\u2014typically being lost in the water or consumed by aquatic creatures\u2014and can be recovered only by a wish spell or similarly powerful magic."
            },
            "id": "08a246d8-9e28-4175-b744-2ea9b01cd5cf",
            "updated_at": {
              "value": "2026-04-15T14:13:01.456335"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Hooked"
            },
            "trait_description": {
              "value": "A creature struck by the culdewen's fish hook is skewered, taking 1d4 persistent bleed damage as long as the hook remains stuck in it. The fish hook can be removed only if a creature spends an Interact action and succeeds at a 25 Athletics check to pull it free."
            },
            "id": "4a421ca1-dc70-4313-b822-56063f11a6c9",
            "updated_at": {
              "value": "2026-04-15T14:13:01.456335"
