            "trait_name": {
              "value": "Skeleton Sense"
            },
            "trait_description": {
              "value": "A ba'aupa mdoudu can sense the presence of bones and skeletons within 60 feet; this is a precise sense when detecting dead bones but an imprecise one when detecting living bones."
