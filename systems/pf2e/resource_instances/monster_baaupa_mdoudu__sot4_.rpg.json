        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Caustic Acid"
            },
            "trait_description": {
              "value": "Whenever a creature takes acid damage from any of a ba'aupa mdoudu's abilities or Strikes, it must succeed at a 30 Fortitude save or become drained 1 (drained 2 on a critical failure). On each subsequent failure, the drained condition value increases by 1 (or by 2 on a critical failure), to a maximum of drained 4."
            },
            "id": "816675bd-6d69-4be6-bfcc-a76fdfcb0d04",
            "updated_at": {
              "value": "2026-03-19T22:59:13.992409"
            }
