          "stats": {
            "trait_name": {
              "value": "Caustic Acid"
            },
            "trait_description": {
              "value": "Whenever a creature takes acid damage from any of a ba'aupa mdoudu's abilities or Strikes, it must succeed at a DC 30 Fortitude save or become drained 1 (drained 2 on a critical failure). On each subsequent failure, the drained condition value increases by 1 (or by 2 on a critical failure), to a maximum of drained 4."
            },
            "id": "2428151d-485d-41cc-b91e-5c8809b8dd6b",
            "updated_at": {
