        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Draconic Frenzy"
            },
            "trait_description": {
              "value": "[Symbiosis] Your eidolon can make a furious assault, potentially recovering the use of their Breath Weapon. They gain the Draconic Frenzy activity."
            },
