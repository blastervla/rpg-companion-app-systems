          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Drain Life"
            },
            "trait_description": {
              "value": "(divine)\n\nWhen the caustic wraith damages a living creature with its caustic touch Strike, the wraith gains 10 temporary Hit Points, and the target must succeed at a DC 28 Fortitude save or become drained 1. Further damage dealt by the caustic wraith increases the drained condition value by 1 on a failed save, to a maximum of drained 4."
            },
            "id": "dcc8b674-ce7b-4424-a928-720b317831a9",
