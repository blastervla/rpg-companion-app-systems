        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Wraith Spawn"
            },
            "trait_description": {
              "value": "(divine, unholy)\n\nA living humanoid slain by a caustic wraith rises as a wraith spawn after 1d4 rounds. This wraith spawn is under the command of the wraith that killed it. It doesn't have drain life or wraith spawn and becomes clumsy 2. After 24 hours, the wraith spawn dissipates and is destroyed."
            },
            "id": "c125b625-7ec7-41b4-9187-6c1fe6e21952",
