        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Punishing Momentum"
            },
            "action_description": {
              "value": "Requirements: The wyvern grabbed a creature this turn using Powerful Dive.\n\nThe wyvern can Fly at half Speed while holding the creature in its claws, carrying that creature along with it and dropping it at the end of its movement. Alternatively, the wyvern can Strike the creature with its stinger with a +2 circumstance bonus."
            },
