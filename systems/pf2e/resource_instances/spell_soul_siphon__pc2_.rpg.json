    "description": {
      "value": "You siphon off a portion of the target's soul to bolster your own vitality. The target must attempt a Fortitude save or take 1d4 void damage. You gain temporary Hit Points equal to the total amount of HP the target loses, including the HP lost from becoming drained.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature takes half damage.\nFailure: The creature takes full damage and becomes drained 1.\nCritical Failure: The creature takes double damage and becomes drained 2."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d4."
    },
