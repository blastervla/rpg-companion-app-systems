    "attached_runes": {
      "value": [
        {
          "resource_id": "item",
          "stats": {
            "id": "2_armor_potency__crb_",
            "updated_at": {
              "value": "2026-04-03T23:51:01.015164+00:00"
            },
            "name": {
              "value": "+2 Armor Potency"
            },
            "source": {
              "value": "crb"
            },
            "description": {
              "value": "Magic wards deflect attacks. Increase the armor's item bonus to AC by 1. The armor can be etched with one property rune.\n\nYou can upgrade the armor potency rune already etched on a suit of armor to a stronger version, increasing the values of the existing rune to those of the new rune. You must have the formula of the stronger rune to do so, and the Price of the upgrade is the difference between the two runes' Prices.\n\nIncrease the armor's item bonus to AC by 2, and the armor can be etched with two property runes.\n\n**Craft Requirements:** You are a master in Crafting."
            },
            "type": {
              "value": "rune"
            },
