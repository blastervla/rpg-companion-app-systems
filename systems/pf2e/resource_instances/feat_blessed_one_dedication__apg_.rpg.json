                        "description": {
                          "value": "Your hands become infused with powerful vitality, capable of healing a living creature or damaging an undead creature with a touch.\n\n- Willing Living Creature The target regains 6 Hit Points. If the target is someone other than yourself, it also gains a +2 status bonus to AC for 1 round.\n- Undead Creature The target takes 1d6 vitality damage with a basic Fortitude save; on a failure, the target also takes a −2 status penalty to AC for 1 round."
                        },
                        "higher_level_description": {
                          "value": "Heightened (+1): The amount of healing increases by 6, and the damage to an undead target increases by 1d6."
                        },
