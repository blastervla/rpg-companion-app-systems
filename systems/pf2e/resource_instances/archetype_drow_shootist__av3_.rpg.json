            "value": [
              {
                "resource_id": "levelled_description",
                "stats": {
                  "id": "levelled_description_c9f68c41359f",
                  "level": {
                    "value": 2
                  },
                  "description": {
                    "value": "Every chance you get, you practice with the hand crossbow to increase your draw speed and accuracy. Whenever you gain a class feature that grants you expert or greater proficiency in a given weapon or weapons, you also gain that proficiency in the hand crossbow. If you're at least an expert in a hand crossbow you're using, you gain access to its critical specialization effect. You also gain the Shootist's Draw action.\n\n**Shootist's Draw**\nActivate (1 Action)\nFrequency: once per round\nYou Interact to draw a hand crossbow and Strike with it, or you Strike with a loaded hand crossbow you're already holding and then Interact to stow it."
                  }
                }
              }
            ]
          },
