            "trait_name": {
              "value": "Construct Armor"
            },
            "trait_description": {
              "value": "Like normal objects, an animated broom has Hardness. This Hardness reduces any damage it takes by an amount equal to the Hardness. Once an animated broom is reduced to less than half its Hit Points, or immediately upon being damaged by a critical hit, its construct armor breaks and its Armor Class is reduced to 14."
            },
            "id": "9afcd6ef-a2b0-471b-b3ab-eda35411b573",
