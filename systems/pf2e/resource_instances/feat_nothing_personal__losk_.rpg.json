            "level": {
              "value": 8
            },
            "description": {
              "value": "When you're on a job, you can't allow anyone to stop you. Designate a single creature you can see as being an impediment to your active course of action. The first time you Strike your impediment in a round, you deal an extra die of weapon damage."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_dc42cf4b9849",
            "level": {
              "value": 14
            },
            "description": {
              "value": "This increases to two extra dice, and at 20th level, this increases to three extra dice.\n\nYou can have only one creature designated as an impediment at a time. If you use Nothing Personal against a creature when you already have a creature designated, the prior creature loses the designation, and the new impediment gains the designation. Otherwise, your designation lasts for 1 hour."
            }
          }
        }
      ]
