        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Shield Shove"
            },
            "action_description": {
              "value": "The Promise guard makes a Strike with their longsword, then attempts to push the target back. If the Strike hits, the target is flat-footed until the start of the guard's next turn, and the guard can automatically Shove the target, with the same benefits as the Shove action (including the critical success effect if the Strike was a critical hit). If the guard moves to follow the target, this movement doesn't trigger reactions. In addition, if the target has to stop moving because it would hit an object, it takes damage equal to the guard's Strength modifier."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
            "action_damage_variants": {
              "value": []
            },
            "id": "6348dd97-5a8d-463c-89d2-acf7c3ef9f80",
            "updated_at": {
              "value": "2026-03-17T12:41:22.996267"
            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Sudden Charge"
            },
            "action_description": {
              "value": "The Promise guard Strides up to double their Speed. If the guard ends their movement within melee reach of at least one enemy, they can make a melee Strike against that enemy."
            },
