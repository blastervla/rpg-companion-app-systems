    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_8a979a16c465",
            "level": {
              "value": 6
            },
            "description": {
              "value": "You manifest a ghostly deck of harrow cards. Draw a card from a harrow deck, then select a target within 60 feet. The card flies through the air to strike at that target, inflicting 4d6 damage, with a basic saving throw against your class DC. The type of damage inflicted is determined by your active harrow omen; if the card drawn is in the same suit as your active harrow omen, the target takes a \u20132 status penalty to its saving throw. The damage increases to 6d6 if you're 10th level and 8d6 if you're 15th level. You can continue to throw cards at targets on your turn as long as you Sustain the Vengeful Spirit Deck\u2014throwing a card takes two actions. This effect lasts as long as you Sustain it, up to 1 minute, or until you no longer have an active harrow omen. Once the effect ends, you lose your active harrow omen.\n\n- **Hammers:** cold damage\n- **Keys:** fire damage\n- **Shields:** poison damage\n- **Books:** electricity damage\n- **Stars:** mental damage\n- **Crowns:** acid damage"
            }
          }
        }
      ]
    },
