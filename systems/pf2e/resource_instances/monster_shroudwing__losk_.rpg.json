          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Death Rattle"
            },
            "action_description": {
              "value": "(concentrate, emotion, fear, mental)\n\nThe shroudwing emits a guttural, haunting call that instills a sense of fear almost impossible to shake. Each non-shroudwing creature within a 30-foot emanation must attempt a DC 18 Will save. Regardless of the result, creatures are then temporarily immune to Death Rattle for 1 minute.\n\n- **Critical Success:** The creature is unaffected.\n- **Success:** The creature is off-guard until the start of the shroudwing's next turn.\n- **Failure:** The creature is frightened 1.\n- **Critical Failure:** The creature is frightened 2."
            },
            "action_type": {
              "value": "none"
            },
