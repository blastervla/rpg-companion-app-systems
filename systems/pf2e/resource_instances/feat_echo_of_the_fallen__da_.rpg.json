    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_4db907204aca",
            "level": {
              "value": 4
            },
            "description": {
              "value": "With the utmost gratitude for your help in releasing them from their unearthly coil, a tiny sliver of a ghostly entity has remained attached to you. This manifests as an echo of their former self that follows you around and that you and anyone capable of casting divine or occult spells can see and speak with. When you take this feat, work with your GM to choose one martial weapon and one skill (or an advanced weapon if you're trained in all martial weapons) that are appropriate for the spirit; once you've chosen the weapon and skill, you can't change them. You gain the Accept Echo action.\n\n**Accept Echo [1 action]**\nYou allow the echo to inhabit your body, gaining a glowing aura around you, shining pale-green irises, a resonating voice, and the silhouette of the spirit around your own body, all of which can be seen clearly by others. While in this state, you become trained in the weapon you chose and an expert in the skill you chose. Additionally, while you're in this state, the echo can speak and interact with the Material Plane using your body, and you gain a +4 status bonus to all saves against possession effects, as the possessing spirit protects you from other possessions.\nThis state lasts for 10 minutes, after which the echo disappears completely until the next time you make your daily preparations. You can Dismiss this effect."
            }
          }
        },
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_59fa78033f64",
            "level": {
              "value": 7
            },
            "description": {
              "value": "You become a master of the skill you chose, at 13th level you become an expert with the weapon you chose, and at 15th level you become legendary with the skill you chose."
            }
          }
        }
      ]
    },
