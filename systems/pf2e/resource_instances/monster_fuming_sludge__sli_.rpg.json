    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Chemical Sense"
            },
            "trait_description": {
              "value": "A fuming sludge detects nearby living and undead creatures by their complex chemical compositions, but it can't detect elementals or other creatures composed of a single element."
            },
            "id": "9fd4b0b8-47f1-4dda-8d61-6174690afda2",
            "updated_at": {
              "value": "2026-03-19T22:59:10.685070"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Smoldering Haze"
            },
            "trait_description": {
              "value": "(aura, fire)\n\n15 feet. The fuming sludge constantly emits incendiary smoke that creates concealment around it. The smoke doesn't impair the fuming sludge's chemical sense. A creature that enters the aura or begins its turn in the aura becomes sickened 1 (25 Fortitude negates) and cannot recover from persistent fire damage for 1 round. It is then temporarily immune to the sickening effect of the smoldering haze for 1 minute. A creature that is currently holding its breath, that doesn't need to breathe, or that's immune to poison is immune to the aura's sickened effect but not the concealment or inability to recover from persistent fire damage."
            },
            "id": "792f48a5-430d-4910-b138-e2a71f6eacf6",
            "updated_at": {
              "value": "2026-03-19T22:59:10.685070"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Cooling Glob"
            },
            "trait_description": {
              "value": "A fuming sludge's ejected globs cling to targets.\n\nA creature hit by an ejected glob Strike is encumbered for 1 round. If the attack was a critical hit, the creature is instead restrained for 1 round (Escape 24)."
            },
            "id": "67d0bf78-f404-4ecf-9ba0-34d4383a3132",
            "updated_at": {
              "value": "2026-03-19T22:59:10.685070"
            }
          }
        }
      ]
