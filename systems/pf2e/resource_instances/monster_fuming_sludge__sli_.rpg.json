    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Chemical Sense"
            },
            "trait_description": {
              "value": "A fuming sludge detects nearby living and undead creatures by their complex chemical compositions, but it can't detect elementals or other creatures composed of a single element."
            },
            "id": "ea02dc53-c958-4c02-b176-5c0a3f2c19aa",
            "updated_at": {
              "value": "2026-03-17T12:41:39.415482"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Smoldering Haze"
            },
            "trait_description": {
              "value": "(aura, fire)\n\n15 feet. The fuming sludge constantly emits incendiary smoke that creates concealment around it. The smoke doesn't impair the fuming sludge's chemical sense. A creature that enters the aura or begins its turn in the aura becomes sickened 1 (DC 25 Fortitude negates) and cannot recover from persistent fire damage for 1 round. It is then temporarily immune to the sickening effect of the smoldering haze for 1 minute. A creature that is currently holding its breath, that doesn't need to breathe, or that's immune to poison is immune to the aura's sickened effect but not the concealment or inability to recover from persistent fire damage."
            },
            "id": "78d568db-7e5e-480e-b3be-d8c21b19014f",
            "updated_at": {
              "value": "2026-03-17T12:41:39.415482"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Cooling Glob"
            },
            "trait_description": {
              "value": "A fuming sludge's ejected globs cling to targets.\n\nA creature hit by an ejected glob Strike is encumbered for 1 round. If the attack was a critical hit, the creature is instead restrained for 1 round (Escape DC 24)."
            },
            "id": "2f048ca3-6f36-4102-a006-59d306a284c6",
            "updated_at": {
              "value": "2026-03-17T12:41:39.415482"
            }
          }
        }
      ]
