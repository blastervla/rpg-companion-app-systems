            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_859165eb5491",
                    "level": {
                      "value": 6
                    },
                    "description": {
                      "value": "During your daily preparations, you find medicinal plants endemic to your location. Until your next preparations, you can spend an additional batch of herbs to add a benefit to an item you create with your herbalism. The benefit of the special herbs affects the creature that the item is applied to; if the benefit is not immediate, it lasts for 1 minute unless otherwise stated. This adjustment counts as an additive (Core Rulebook 75), so you can't include another additive without spoiling the item.\n\n- **Aquatic** Gain a +1 circumstance bonus to Fortitude saves.\n- **Arctic** For 1 hour, treat environmental cold effects as if they were one step less severe.\n- **Desert** For 1 hour, treat environmental heat effects as if they were one step less severe.\n- **Forest** Gain a +2 circumstance bonus to saves against disease and poison effects.\n- **Mountain** Gain a +1 circumstance bonus to Reflex saves.\n- **Plains** Gain a +1 circumstance bonus to Will saves.\n- **Swamp** Remove one source of persistent bleed damage.\n- **Underground** Gain a +1 circumstance bonus to Perception."
                    }
                  }
                }
              ]
            },
