                  "stats": {
                    "id": "levelled_description_7f62e1f50ed3",
                    "level": {
                      "value": 6
                    },
                    "description": {
                      "value": "You've bridged a connection between the runes on your body and the magic of runestones, allowing you to place an armor rune on your living flesh. Your body can hold a single property rune; you can't etch a property rune on your body if it has requirements on the type or category of armor or if the property would affect the armor instead of its wearer. If you wear armor, you gain the property rune's effects in addition to any effects of that armor."
                    }
                  }
                }
