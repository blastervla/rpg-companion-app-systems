            "trait_name": {
              "value": "Host Scent"
            },
            "trait_description": {
              "value": "An isqulug can precisely sense any creature infected with isqulugia within 30 feet, and knows the current stage of the disease."
            },
            "id": "04bccbff-2224-44c6-9cc7-f694cfb2ef2f",
