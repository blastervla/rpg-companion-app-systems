        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Blinding Flare"
            },
            "action_description": {
              "value": "(occult, visual)\n\nThe zuipnyrn's eye produces a bright flash of light. Each creature in a 30-foot cone must attempt a DC 22 Fortitude save. The zuipnyrn can't use Blinding Flare again for 1 minute.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature is dazzled for 1 round.\nFailure: The creature is blinded for 1 round and dazzled for 1 minute.\nCritical Failure: The creature is blinded for 1 minute."
            },
