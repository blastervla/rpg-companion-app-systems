        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Light Blindness"
            },
            "trait_description": {
              "value": "When first exposed to bright light, the drow can't see until the end of their next turn. All squares are difficult terrain for them, and they take a \u20134 status penalty to Perception. If they try to attack a creature, the attack fails unless they succeed at a 11 flat check. Light doesn't blind them again for 1 hour."
