        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Tendril Strike"
            },
            "action_description": {
              "value": "(eidolon)\n\nStretching to extend its body to its limits, your eidolon attacks a foe that would normally be beyond its reach. Your eidolon makes a melee unarmed Strike, increasing its reach by 5 feet for that Strike. If the unarmed attack has the disarm, shove, or trip trait, the eidolon can use the corresponding action instead of a Strike."
            },
            "action_type": {
              "value": "none"
