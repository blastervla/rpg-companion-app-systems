      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_1dc6b1dc6e1f",
            "level": {
              "value": 2
            },
            "description": {
              "value": "You're primed to face off against threats from the Outer Rifts. You gain the Additional Lore skill feat for Demon Lore. If you were already trained in Demon Lore, you also become trained in a Lore skill of your choice. You gain a +1 circumstance bonus to initiative rolls in encounters against fiends, and if you tie with a fiend's initiative roll, you go first.\n\nCertain wylderheart feats give you focus spells. When you gain your first wylderheart focus spell, you become trained in the spell attack modifier and spell DC statistics. Your key spellcasting attribute for the wylderheart archetype spells is Wisdom, and they're primal spells. You can Refocus by celebrating life or spending time in nature."
            }
          }
        }
      ]
