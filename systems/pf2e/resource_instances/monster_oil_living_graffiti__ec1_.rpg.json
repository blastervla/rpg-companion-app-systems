          "stats": {
            "trait_name": {
              "value": "Surface-Bound"
            },
            "trait_description": {
              "value": "A living graffiti can move only along flat surfaces such as floors and walls. If the surface it's on is destroyed (such as a portrait hit by a fireball spell or a puddle being splashed), the graffiti takes 2d6 damage and is shunted to the nearest flat surface.\n\nIf there is no flat surface within 5 feet, the living graffiti is destroyed."
            },
