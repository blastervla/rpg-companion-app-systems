              "value": {
                "resource_id": "spell",
                "stats": {
                  "id": "aerial_form__crb_",
                  "name": {
                    "value": "Aerial Form"
                  },
                  "source": {
                    "value": "crb"
                  },
                  "level": {
                    "value": "spell_level_4"
                  },
                  "school": {
                    "value": "spell_school_transmutation"
