        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Muse Possession"
            },
            "action_description": {
              "value": "The phantom muse attempts to possess an adjacent corporeal creature. This has the same effect as the possession spell (20), except the duration is 1d4 hours, and since the phantom muse doesn't have a physical body, it is unaffected by that restriction of the spell. If the target is at least trained in Performance, the DC of this ability is 24."
            },
