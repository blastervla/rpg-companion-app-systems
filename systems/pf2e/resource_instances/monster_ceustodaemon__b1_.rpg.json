        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Vicious Wounds"
            },
            "trait_description": {
              "value": "On a successful jaws or claw Strike, the ceustodaemon viciously tears into its victim as similar wounds appear on its own body. The target takes an extra 1d6 amount of damage, and the ceustodaemon takes the same extra damage. If this extra damage to the target is doubled, due to a critical hit, the ceustodaemon takes double damage as well."
            },
