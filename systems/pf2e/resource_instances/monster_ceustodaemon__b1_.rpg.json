          "stats": {
            "trait_name": {
              "value": "Drawn to Service"
            },
            "trait_description": {
              "value": "When bringing a ceustodaemon to another plane with effects like a planar binding or planar ally ritual, the primary and secondary skill DCs are reduced by 5, and the ceustodaemon demands only half the normal cost for its service."
