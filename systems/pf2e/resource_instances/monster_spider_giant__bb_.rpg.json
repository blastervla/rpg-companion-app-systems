        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Web Trap"
            },
            "trait_description": {
              "value": "A creature hit by the giant spider's web Strike gets stuck to the nearest surface. It can't move until it successfully Escapes (17)."
            },
