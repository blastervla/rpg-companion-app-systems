        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Descend on a Web"
            },
            "trait_description": {
              "value": "(move)\n\nThe giant spider moves straight down up to 40 feet, suspended by a web line. It can hang from the web or drop off. The distance it Descends on a Web doesn't count for falling damage. A creature can Strike the web, which has AC 20 and 8 HP. If the web is reduced to 0 HP, the spider falls."
            },
            "id": "7640c73d-c34a-410b-a98b-38a50cea2556",
            "updated_at": {
              "value": "2026-04-15T14:13:02.319033"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Giant Spider Venom"
            },
            "trait_description": {
              "value": "(poison)\n\nA target damaged by the spider's fangs must succeed at a 16 Fortitude save or take 1d12 poison damage and gain the flat-footed condition for 1 round."
            },
            "id": "b72464a2-7bf7-4627-b5f7-a3719c578c0d",
            "updated_at": {
              "value": "2026-04-15T14:13:02.319033"
