    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Descend on a Web"
            },
            "trait_description": {
              "value": "(move)\n\nThe giant spider moves straight down up to 40 feet, suspended by a web line. It can hang from the web or drop off. The distance it Descends on a Web doesn't count for falling damage. A creature can Strike the web, which has AC 20 and 8 HP. If the web is reduced to 0 HP, the spider falls."
            },
            "id": "9f962a74-25e4-4dee-89ce-72e302553da2",
            "updated_at": {
              "value": "2026-03-17T12:41:28.238636"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Giant Spider Venom"
            },
            "trait_description": {
              "value": "(poison)\n\nA target damaged by the spider's fangs must succeed at a DC 16 Fortitude save or take 1d12 poison damage and gain the flat-footed condition for 1 round."
            },
            "id": "76359154-392c-4b3e-a208-cdccd3a883c0",
            "updated_at": {
              "value": "2026-03-17T12:41:28.238636"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Web Trap"
            },
            "trait_description": {
              "value": "A creature hit by the giant spider's web Strike gets stuck to the nearest surface. It can't move until it successfully Escapes (DC 17)."
            },
