        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Grave Tide"
            },
            "trait_description": {
              "value": "The shambler troop is less organized than most troops. It can move into other creatures' spaces, and other creatures can move into its spaces. Its spaces are difficult terrain to other creatures."
            },
            "id": "2b4334c4-2477-4b5d-a8dc-aead979c321d",
            "updated_at": {
