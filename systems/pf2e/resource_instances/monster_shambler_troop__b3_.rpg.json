        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Troop Movement"
            },
            "trait_description": {
              "value": "Whenever a troop Strides, it first Forms Up as a free action to condense into a 20-foot-by \u201320-foot area (minus any missing squares), then moves up to its Speed. This works just like a Gargantuan creature moving; for instance, if any square of the troop enters difficult terrain, the extra movement cost applies to the whole troop."
            },
            "id": "d792d124-cd33-47ee-99ba-77c3184c3d69",
            "updated_at": {
              "value": "2026-04-15T14:13:01.886886"
            }
          }
        }
