        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Troop Movement"
            },
            "trait_description": {
              "value": "Whenever a troop Strides, it first Forms Up as a free action to condense into a 20-foot-by \u201320-foot area (minus any missing squares), then moves up to its Speed. This works just like a Gargantuan creature moving; for instance, if any square of the troop enters 3, the extra movement cost applies to the whole troop."
            },
            "id": "0ba2b4e1-0cfc-41d0-a28d-52de9378c67c",
            "updated_at": {
