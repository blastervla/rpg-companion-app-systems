            "trait_name": {
              "value": "Grave Tide"
            },
            "trait_description": {
              "value": "The shambler troop is less organized than most troops. It can move into other creatures' spaces, and other creatures can move into its spaces. Its spaces are 3 to other creatures."
            },
            "id": "c605e6c0-ee5c-49ae-94f6-2da5280a9b92",
