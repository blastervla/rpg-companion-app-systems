          "stats": {
            "id": "levelled_description_542edd5edb22",
            "level": {
              "value": 10
            },
            "description": {
              "value": "You gain the shall not falter, shall not rout focus spell. If you don't already have one, you gain a focus pool of 1 Focus Point, which you can regain using the Refocus activity to recite the Crimson Oath and meditate on its teachings. If you already have a focus pool, increase the number of Focus Points in your focus pool by 1. Your knight reclaimant focus spells are divine spells; when you gain this feat, you become trained in divine spell attacks and spell DCs and your spellcasting ability is Charisma."
            }
          }
        }
