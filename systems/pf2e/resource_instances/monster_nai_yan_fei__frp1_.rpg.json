    "reactions": {
      "value": [
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Master Strike"
            },
            "action_description": {
              "value": "(incapacitation)\n\nTrigger: Nai Yan Fei hits a flat-footed creature and deals damage\n\nThe target attempts a DC 39 Fortitude save. It then becomes immune to Nai Yan Fei's Master Strike for 1 day.\n\nCritical Success: The target is unaffected.\nSuccess: The target is enfeebled 2 until the end of Nai Yan Fei's next turn.\nFailure: The target is paralyzed for 4 rounds.\nCritical Failure: The target is paralyzed for 4 rounds, knocked unconscious for 2 hours, or killed (Nai Yan Fei's choice)."
            },
