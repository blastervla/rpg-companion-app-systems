        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Death Light"
            },
            "action_description": {
              "value": "(emotion, fear, mental, necromancy, occult)\n\nThe corpselight emits a sickly blue beam of light from its mouth and eyes in a 20-foot cone. All living creatures in this area must attempt a DC 18 Fortitude saving throw. If at least 1 creature fails its save, the corpselight regains 2d6 Hit Points, gaining any that exceed its maximum as temporary Hit Points that last for 1 minute. The corpselight can't use Death Light again for 1d4 rounds.\n\nCritical Success: The creature is unaffected.\nSuccess: The creature takes 1d6 negative damage.\nFailure: The creature takes 2d6 negative damage and is frightened 1.\nCritical Failure: The creature takes 4d6 negative damage and is frightened 3."
            },
