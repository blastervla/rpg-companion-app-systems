    "descriptions": {
      "value": [
        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_247011b6d624",
            "level": {
              "value": 1
            },
            "description": {
              "value": "You have an eye for detail and a mouth for pointing out flaws, which makes it all the easier to convince the merchants and crafters of King's Heart to help you. You quickly analyze the triggering creature's wares in hopes of finding something useful in your coercion and attempt a Crafting check.\n\n- **Critical Success:** You have plenty to work with and can leave your target shocked with your analysis. If you a roll a success on your Intimidation check, you get a critical success instead. If you roll a critical failure, you get a failure instead.\n- **Success:** As critical success, but you only gain the benefits when rolling a success on your Intimidation check.\n- **Failure:** You misjudge the wares, which makes you come across as unknowledgeable and less intimidating. You take a –1 circumstance penalty to your Intimidation check to Coerce.\n- **Critical Failure:** As failure, but the penalty is –2."
            }
          }
        }
      ]
    },
