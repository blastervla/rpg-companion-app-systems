        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Hellstrider"
            },
            "trait_description": {
              "value": "A levaloch ignores the effects of non-magical 3. They take no damage from caltrops or from damaging terrain that deals physical, acid, or cold damage. A levaloch can move through liquids up to 5 feet deep at their full Speed."
            },
            "id": "f6e181c8-cfec-468a-82cd-43831415ec8c",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Barbed Net"
            },
            "trait_description": {
              "value": "When a levaloch hits a creature with their barbed net, the net wraps around the target, which becomes clumsy 1 and takes a \u201310-foot circumstance penalty to its Speeds. If the Strike was a critical success, the target is also immobilized.\n\nWhen a creature Escapes (DC 22), or if the Strike misses, the net crumbles into rust. Each time a creature attempts to Escape, it takes 1d6 slashing damage from the net's barbs, regardless of whether the attempt succeeds."
            },
            "id": "32d707a9-2ad5-48af-81b8-c4bd5c0efd7a",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Merciless Thrust"
            },
            "trait_description": {
              "value": "When a levaloch hits a creature that has the clumsy, enfeebled, immobilized, or restrained conditions with a melee trident Strike, the Strike deals an additional 2d6 damage."
            },
            "id": "48620c7d-df86-4ca4-af2e-fc0927bb4123",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        }
