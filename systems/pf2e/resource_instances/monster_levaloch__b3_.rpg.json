            "trait_name": {
              "value": "Stable Stance"
            },
            "trait_description": {
              "value": "A levaloch gains a +2 circumstance bonus to their Fortitude DC against being Shoved and to other saving throws to resist being moved against their will."
            },
            "id": "a2352775-e72f-44ec-8644-396f09a346ca",
