            "trait_name": {
              "value": "Crowns)."
            },
            "trait_description": {
              "value": "If the suit of its latest harrow reading is unknown, roll 1d6 at the beginning of combat to randomly determine it."
            },
            "id": "e0234ae5-3163-4c0a-9886-5efa0bcf9034",
