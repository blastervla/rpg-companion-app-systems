    "description": {
      "value": "You attack the target's life force with undeath, dealing 1d6 negative damage. The target must attempt a Fortitude save.\n\n- **Critical Success:** The target is unaffected.\n- **Success:** The target takes half damage.\n- **Failure:** The target takes full damage, and positive effects heal it only half as much as normal for 1 round.\n- **Critical Failure:** The target takes double damage, and positive effects heal it only half as much as normal for 1 minute."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d6."
    },
