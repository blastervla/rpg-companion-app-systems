        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Enticing Invitation"
            },
            "action_description": {
              "value": "(enchantment, incapacitation, mental, primal)\n\nThe alapolo whispers an invitation to a creature within 30 feet. The creature must attempt a 38 Will save.\n\n- **Critical Success:** The target is unaffected and temporarily immune to all Enticing Invitations for 24 hours.\n- **Success:** The target must spend 1 action on its next turn dancing in place.\n- **Failure:** The target becomes drained 1. It is also fascinated by the alapolo for 1 minute and can't attack the alapolo as long as it's fascinated. While fascinated, the target must spend 2 actions on each of its turns dancing in place.\n- **Critical Failure:** As failure, except the target is drained 3 and must spend 3 actions on each of its turns dancing in place."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
