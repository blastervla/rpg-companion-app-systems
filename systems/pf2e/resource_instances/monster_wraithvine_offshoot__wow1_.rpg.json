            "trait_name": {
              "value": "Mandragora Venom"
            },
            "trait_description": {
              "value": "**Mandragora Venom**\nDC: 21\nSaving Throw: Fortitude\nMaximum Duration: 6 rounds\n- Stage 1: 1d6 poison damage and stupefied 1 (1 round)\n- Stage 2: 1d6 poison damage, confused, and stupefied 1 (1 round)\n- Stage 3: 2d6 poison damage, confused, and stupefied 1 (1 round)"
            },
