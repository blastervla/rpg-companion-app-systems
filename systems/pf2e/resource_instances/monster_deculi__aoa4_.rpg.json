            }
          }
        },
        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Shadow Strike"
            },
            "action_description": {
              "value": "Requirements: The deculi is in its shadow sanctuary.\n\nThe deculi Dismisses its shadow sanctuary. It Strides, Climbs, or Flies up to its Speed, then makes a fangs Strike that deals an additional 4d6 precision damage."
            },
