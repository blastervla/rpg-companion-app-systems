            "descriptions": {
              "value": [
                {
                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_185f5c145094",
                    "level": {
                      "value": 6
                    },
                    "description": {
                      "value": "You focus your attention on a single creature within 30 feet. That creature must attempt a Will save against your Perception DC. On a failure, the creature finds itself unable to speak any deliberate and intentional lies and takes a –2 penalty to Deception checks. On a critical failure, the penalty to Deception checks is –4. This effect lasts for 10 minutes as long as you are within 30 feet of the target and the target is aware that you are using the ability against it.\n\nIf you begin a new interrogation, this effect ends for any previous target. After your interrogation ends, the target is immune to this ability for 24 hours."
                    }
                  }
                }
              ]
            },
