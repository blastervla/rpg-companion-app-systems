        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Ravenous Attack"
            },
            "action_description": {
              "value": "The urdefhan makes one rhoka sword Strike and one jaws Strike against a single creature. Its multiple attack penalty doesn't increase until after both attacks."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
            },
            "action_attack_bonus": {
              "value": 0
