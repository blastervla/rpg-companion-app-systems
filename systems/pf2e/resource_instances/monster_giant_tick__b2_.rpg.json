    "traits": {
      "value": [
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Attach"
            },
            "trait_description": {
              "value": "When the giant tick Strikes a creature larger than itself, its barbed hypostome attaches it to that creature. This is similar to Grabbing the creature, but the giant tick moves with that creature rather than holding it in place. The giant tick is flat-footed while attached. If the giant tick is killed or pushed away while attached to a creature on which it has used Blood Drain, that creature takes 1 persistent bleed damage. Escaping the attachment or removing the giant tick in other ways doesn't cause bleed damage."
            },
            "id": "b91d072e-83ea-4379-96bf-3492d09ce720",
