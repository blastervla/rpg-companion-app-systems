    "description": {
      "value": "You attack the target's life force with undeath, dealing 1d6 void damage. The target must attempt a Fortitude save.\n\nCritical Success: The target is unaffected.\nSuccess: The target takes half damage.\nFailure: The target takes full damage, and vitality effects heal it only half as much as normal for 1 round.\nCritical Failure: The target takes double damage, and vitality effects heal it only half as much as normal for 1 minute."
    },
    "higher_level_description": {
      "value": "Heightened (+1): The damage increases by 1d6."
    },
