        {
          "resource_id": "levelled_description",
          "stats": {
            "id": "levelled_description_9d81cb53eba8",
            "level": {
              "value": 6
            },
            "description": {
              "value": "Artokus developed a mixture of volatile materials that burns hotter and longer than typical alchemist's fire. You include this additive mixture when crafting your alchemist's fire. The alchemist's fire deals 1d4 persistent fire damage in addition to what the alchemist fire would normally cause (for instance, a moderate alchemist's fire deals 1d4+2 persistent fire damage)\n\nA creature taking persistent fire damage from the alchemist's fire requires two successful flat checks to end the persistent damage, or one check if the creature had an assisted recovery that reduces the flat check to DC 10. The enhanced alchemist's fire burns even underwater, and any attempts to end the persistent damage by using water have no effect."
            }
          }
        }
      ]
    },
