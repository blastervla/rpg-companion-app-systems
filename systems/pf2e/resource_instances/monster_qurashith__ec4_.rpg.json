          "stats": {
            "trait_name": {
              "value": "Paralytic Saliva"
            },
            "trait_description": {
              "value": "A creature that takes damage from a qurashith's jaws or spittle must succeed at a 39 Fortitude save or be slowed 1 for 1d4 rounds (slowed 2 on a critical failure). If a creature is already slowed when it fails its save, it becomes paralyzed for 1 round."
