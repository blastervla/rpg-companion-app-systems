            "level": {
              "value": 8
            },
            "description": {
              "value": "You touch a weapon and bring it into concordance with your deity. For 1 round, that weapon gains your holy or unholy trait. It also deals an additional 2d6 spirit damage to creatures of the opposed trait. For example, if you are holy, the weapon would deal an extra 2d6 spirit damage to unholy creatures.\n\nIf you use Sanctify Armament again, any previous use of it expires."
            }
          }
        }
