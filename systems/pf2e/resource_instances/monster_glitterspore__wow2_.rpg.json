          "stats": {
            "trait_name": {
              "value": "Spore Rot"
            },
            "trait_description": {
              "value": "**Spore Rot**\nDC: 26\nSaving Throw: Fortitude\nMaximum Duration: 6 rounds\n- Stage 1: 1d6 poison damage plus clumsy 1 and \u20135-foot status penalty to Speed (1 round)\n- Stage 2: 2d6 poison damage plus clumsy 2 and \u201310-foot status penalty to Speed (1 round)\n- Stage 3: 3d8 poison damage plus clumsy 3 and paralyzed (1d4 rounds)"
            },
