        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Seek Quarry"
            },
            "trait_description": {
              "value": "City guards can spend 1 minute to designate a single creature for whom they have a physical description as their quarry. They gain a +2 circumstance bonus to Perception against their quarry."
            },
            "id": "e08abda3-ff74-4ef0-9be3-9c3ca400cf7b",
            "updated_at": {
              "value": "2026-03-29T00:33:09.132201"
