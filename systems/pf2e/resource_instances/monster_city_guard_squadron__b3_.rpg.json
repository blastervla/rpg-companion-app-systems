        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Troop Movement"
            },
            "trait_description": {
              "value": "Whenever the city guards Stride, they first Form Up as a free action to condense into a 20-foot-by-20-foot area (minus any missing squares), then move up to their Speed. This works just like a Gargantuan creature moving; for instance, if any square of the guards enters 3, the extra movement cost applies to all the guards."
            },
            "id": "7b03177e-111d-4bca-bfbe-b068bf289a29",
            "updated_at": {
              "value": "2026-03-17T12:41:27.494111"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Urban Chasers"
            },
            "trait_description": {
              "value": "City guards ignore 3 (but not 3) caused by crowds or from movement through narrow spaces such as alleyways."
            },
            "id": "0cb83d78-393b-455d-9c2d-73d9d60b26ff",
            "updated_at": {
