        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Troop Movement"
            },
            "trait_description": {
              "value": "Whenever the city guards Stride, they first Form Up as a free action to condense into a 20-foot-by-20-foot area (minus any missing squares), then move up to their Speed. This works just like a Gargantuan creature moving; for instance, if any square of the guards enters difficult terrain, the extra movement cost applies to all the guards."
            },
            "id": "0061e2e0-4e71-4bae-8410-eb8d1c07e455",
            "updated_at": {
              "value": "2026-03-29T00:33:09.132201"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Urban Chasers"
            },
            "trait_description": {
              "value": "City guards ignore difficult terrain (but not greater difficult terrain) caused by crowds or from movement through narrow spaces such as alleyways."
            },
            "id": "685aca88-e9e0-48de-8e31-bb40b71db667",
            "updated_at": {
              "value": "2026-03-29T00:33:09.132201"
            }
          }
        }
