        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Designate Bellflower Crop"
            },
            "action_description": {
              "value": "Nolly designates an ally within 30 feet as a member of her Bellflower crop. Nolly can have up to 10 members in her crop at once; any member added in excess of this number automatically removes a crop member of Nolly's choice. When Nolly or a member of her crop Aids a crop member and rolls a success, they get a critical success to Aid instead.\n\nWhen a crop member within 60 feet of Nolly fails a saving throw against an effect that would impose the confused or paralyzed condition, the crop member can use a reaction to reroll the saving throw and use the better of the two results. This is a fortune effect."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "three_actions"
            },
            "action_attack_bonus": {
              "value": 0
            },
