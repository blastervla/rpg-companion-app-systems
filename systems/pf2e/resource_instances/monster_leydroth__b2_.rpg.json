        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Dispelling Roar"
            },
            "action_description": {
              "value": "(abjuration, auditory, emotion, fear, mental, primal)\n\nThe leydroth unleashes a bestial roar that reverberates within a 30-foot emanation. It rolls an Intimidation check and compares the result to the Will DC of each creature in the area, with the effects of Demoralize. It also uses this result to attempt to counteract each spell or magical effect in the area, plus one item or effect on each creature in the area, with the effects of dispel magic. The leydroth can't use Dispelling Roar again for 1d4 rounds."
            },
            "action_type": {
              "value": "none"
            },
            "action_cost": {
              "value": "two_actions"
