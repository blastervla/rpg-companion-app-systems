        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "Hibernation"
            },
            "trait_description": {
              "value": "After 3 or more days without eating, an akata can secrete resin that encases it in a noqual cocoon. The cocoon has Hardness 9, 40 HP, and a Broken Threshold of 18. It has resistance 5 to damage from magical sources. As long as the cocoon remains intact, the akata can't be harmed, and it doesn't need to eat or drink. While inside the cocoon, the akata gains lifesense 30 feet. The akata remains in a state of hibernation until it is exposed to extreme heat or senses a living creature, at which point it can burst free of its cocoon in 1d4 minutes."
            },
            "id": "41656de3-1415-4b9c-80b0-ae20a0993517",
            "updated_at": {
              "value": "2026-04-15T14:13:01.456335"
            }
          }
        },
        {
          "resource_id": "monster_trait",
          "stats": {
            "trait_name": {
              "value": "No Hearing"
            },
            "trait_description": {
              "value": "An akata has no auditory senses. It is immune to auditory effects, automatically critically fails Perception checks that require it to hear, and takes a \u20132 status penalty to Perception checks (but not initiative rolls) that involve sound but also rely on other senses."
            },
            "id": "f8af8d79-c2c3-4c6c-9f46-ba2842e03dce",
            "updated_at": {
              "value": "2026-04-15T14:13:01.456335"
            }
          }
        },
