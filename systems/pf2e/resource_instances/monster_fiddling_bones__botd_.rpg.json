        {
          "resource_id": "monster_action",
          "stats": {
            "action_name": {
              "value": "Rhapsodic Flourish"
            },
            "action_description": {
              "value": "(abjuration, occult, sonic)\n\nTrigger: The fiddling bones would roll a saving throw against an auditory or sonic effect\n\nThe fiddling bones performs a refrain that deflects sonic vibrations. They roll a Performance check in place of the triggering saving throw. Sonic feedback rebounds from the effect, dealing 1d6 sonic damage to the source of the triggering effect if the Performance check succeeded or 2d6 sonic damage to the fiddling bones on a failure."
            },
