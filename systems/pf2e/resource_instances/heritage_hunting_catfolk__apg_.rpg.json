                  "resource_id": "levelled_description",
                  "stats": {
                    "id": "levelled_description_03379afc9725",
                    "level": {
                      "value": 1
                    },
                    "description": {
                      "value": "You come from a long line of skilled hunters and trackers and have a particularly keen sense of smell. You gain imprecise scent with a range of 30 feet. This means you can use your sense of smell to determine a creature's location, as explained on page 465 of the Core Rulebook. The GM will usually double the range if you're downwind from the creature or halve the range if you're upwind.\n\nIn addition, you gain a +2 circumstance bonus to Track a creature or object if you've smelled it before."
                    }
                  }
                }
