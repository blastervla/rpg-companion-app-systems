character_creation_page edit_feats_title() =
  characterCreationPage(
    title = displayableData(id = "edit_feats_title", name = "Feats & Archetypes"),
    view = list(
      id = "edit_character_feats",
      padding = 32,
      subviews = [
        text(
          id = "edit_character_feats_subheader",
          text = "Select your feats and archetypes",
          style = "subhead",
        ),
        text(
          id = "edit_character_feats_pending_summary",
          text = progression_pending_slots_summary_text,
          style = "caption",
          color = "accent",
          is_visible = !isEmpty(progression_pending_slots_summary_text),
        ),
        text(
          id = "edit_character_feats_level_restriction_warning",
          text = class_like_feats_level_restriction_warning_text,
          style = "caption",
          color = "accent",
          is_visible = class_like_feats_violate_level_restrictions,
        ),
        text(
          id = "edit_character_feats_class_feats_header",
          text = "Class feat slots",
          style = "subhead",
        ),
        text(
          id = "edit_character_feats_class_feats_pending",
          text = concat(["Pending: ", pending_class_like_feat_slots]),
          style = "caption",
          color = "accent",
          is_visible = pending_class_like_feat_slots > 0,
        ),
        selectResources(
          id = "edit_character_feats_class_feats_add",
          stat = "feats",
          resource_id = "feat",
          should_append = true,
          should_save_on_selection = true,
          filters = dict(
            type = "class",
            available_at_character_levels = level_singleton,
          ),
          validation_message = if class_like_feats_violate_level_restrictions
          then class_like_feats_level_restriction_warning_text
          else null,
        ),
        resourceSection(
          id = "edit_character_feats_class_feats_list",
          resource_stat = "class_feats",
          read_only = false,
          resource_id = "feat",
        ),
        text(
          id = "edit_character_feats_archetype_feats_header",
          text = "Archetype feats",
          style = "subhead",
          is_visible = !isEmpty(selected_multiclass_archetype_ids),
        ),
        text(
          id = "edit_character_feats_archetype_feats_info",
          text = "Dedication feats from selected archetypes are auto-included.",
          style = "caption",
          is_visible = !isEmpty(selected_multiclass_archetype_ids),
        ),
        selectResources(
          id = "edit_character_feats_archetype_feats_add",
          stat = "feats",
          resource_id = "feat",
          should_append = true,
          should_save_on_selection = true,
          filters = dict(
            type = "archetype",
            archetypes = selected_multiclass_archetype_names,
            available_at_character_levels = level_singleton,
          ),
          is_visible = !isEmpty(selected_multiclass_archetype_ids),
        ),
        resourceSection(
          id = "edit_character_feats_archetype_feats_list",
          resource_stat = "multiclass_archetype_feats",
          read_only = false,
          resource_id = "feat",
          is_visible = !isEmpty(selected_multiclass_archetype_ids),
        ),
        text(
          id = "edit_character_feats_skill_feats_header",
          text = "Skill feats",
          style = "subhead",
        ),
        text(
          id = "edit_character_feats_skill_feats_pending",
          text = concat(["Pending: ", pending_skill_feat_slots]),
          style = "caption",
          color = "accent",
          is_visible = pending_skill_feat_slots > 0,
        ),
        selectResources(
          id = "edit_character_feats_skill_feats_add",
          stat = "feats",
          resource_id = "feat",
          should_append = true,
          should_save_on_selection = true,
          filters = dict(
            type = "skill",
            available_at_character_levels = level_singleton,
          ),
        ),
        resourceSection(
          id = "edit_character_feats_skill_feats_list",
          resource_stat = "skill_feats",
          read_only = false,
          resource_id = "feat",
        ),
        text(
          id = "edit_character_feats_ancestry_feats_header",
          text = "Ancestry feats",
          style = "subhead",
          is_visible = notNull(ancestry),
        ),
        text(
          id = "edit_character_feats_ancestry_feats_pending",
          text = concat(["Pending: ", pending_ancestry_feat_slots]),
          style = "caption",
          color = "accent",
          is_visible = notNull(ancestry) && pending_ancestry_feat_slots > 0,
        ),
        selectResources(
          id = "edit_character_feats_ancestry_feats_add",
          stat = "feats",
          resource_id = "feat",
          should_append = true,
          should_save_on_selection = true,
          filters = dict(
            type = "ancestry",
            ancestry = filter([
                ancestry?.name?
              ],
              filter = ($filterValue) => $filterValue != null
            ),
            heritage = filter([
                heritage?.name?
              ],
              filter = ($filterValue) => $filterValue != null
            ),
            available_at_character_levels = level_singleton,
          ),
          is_visible = notNull(ancestry),
        ),
        resourceSection(
          id = "edit_character_feats_ancestry_feats_list",
          resource_stat = "ancestry_feats",
          read_only = false,
          resource_id = "feat",
          is_visible = notNull(ancestry),
        ),
        text(
          id = "edit_character_feats_general_feats_header",
          text = "General feats",
          style = "subhead",
          is_visible = granted_general_feat_slots > 0,
        ),
        text(
          id = "edit_character_feats_general_feats_pending",
          text = concat(["Pending: ", pending_general_feat_slots]),
          style = "caption",
          color = "accent",
          is_visible = granted_general_feat_slots > 0 && pending_general_feat_slots > 0,
        ),
        selectResources(
          id = "edit_character_feats_general_feats_add",
          stat = "feats",
          resource_id = "feat",
          should_append = true,
          should_save_on_selection = true,
          filters = dict(
            type = "general",
            available_at_character_levels = level_singleton,
          ),
          is_visible = granted_general_feat_slots > 0,
        ),
        resourceSection(
          id = "edit_character_feats_general_feats_list",
          resource_stat = "general_feats",
          read_only = false,
          resource_id = "feat",
          is_visible = granted_general_feat_slots > 0,
        ),
        text(
          id = "edit_character_feats_archetypes_header",
          text = "Archetypes",
          style = "subhead",
        ),
        text(
          id = "edit_character_feats_multiclass_subheader",
          text = "Multiclass archetypes",
          style = "caption",
          bold = true,
        ),
        text(
          id = "edit_character_feats_multiclass_hint",
          text = "No multiclass archetypes selected.",
          style = "caption",
          is_visible = isEmpty(selected_multiclass_archetype_ids),
        ),
        selectResources(
          id = "edit_character_feats_multiclass_add",
          stat = "archetypes",
          resource_id = "archetype",
          should_append = true,
          should_save_on_selection = true,
          filters = dict(is_class_archetype = false),
        ),
        resourceSection(
          id = "edit_character_feats_multiclass_list",
          resource_stat = "multiclass_archetypes",
          read_only = false,
          resource_id = "archetype",
        ),
        text(
          id = "edit_character_feats_class_archetype_subheader",
          text = "Class archetypes",
          style = "caption",
          bold = true,
        ),
        text(
          id = "edit_character_feats_class_archetype_hint",
          text = "No class archetypes selected.",
          style = "caption",
          is_visible = isEmpty(class_archetype_ids),
        ),
        selectResources(
          id = "edit_character_feats_class_archetype_add",
          stat = "archetypes",
          resource_id = "archetype",
          should_append = true,
          should_save_on_selection = true,
          filters = dict(is_class_archetype = true),
        ),
        resourceSection(
          id = "edit_character_feats_class_archetype_list",
          resource_stat = "class_archetypes",
          read_only = false,
          resource_id = "archetype",
          is_visible = !isEmpty(class_archetype_ids),
        ),
        text(
          id = "edit_character_feats_class_auto_feats_header",
          text = "Class archetype feats (auto-granted)",
          style = "caption",
          bold = true,
          is_visible = !isEmpty(class_archetype_ids),
        ),
        resourceSection(
          id = "edit_character_feats_class_auto_feats_list",
          resource_stat = "class_archetype_auto_feats",
          read_only = true,
          resource_id = "feat",
          is_visible = !isEmpty(class_archetype_ids),
        ),
      ],
    ),
  );
