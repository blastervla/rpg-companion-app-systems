mechanic edit_save_proficiency(event_names = "editSaveProficiency") =
  showPopUp(
    pop_up_view = select(
      id = "edit_save_proficiency_select",
      meta_stat = $event?.proficiency_stat? ?? "",
      options = "skill_proficiency_types",
      style = "list",
    ),
    pop_up_title = $event?.proficiency_name? ?? "Save proficiency",
    display_cancel_button = true,
    display_save_button = true,
    should_persist_on_save = true,
  );
