mechanic toggle_spells_hide_fully_expended_prepared(event_names = "toggle_spells_hide_fully_expended_prepared_deselected,toggle_spells_hide_fully_expended_prepared_selected") =
  setStat(
    stat = "spells_hide_fully_expended_prepared",
    new_value = !spells_hide_fully_expended_prepared,
    aggregation_type = "set",
  );
