mechanic recovery_check(event_names = "recovery_check") =
  when {
    dying > 0 && !is_dead -> roll(
      rolls = [
        rollable(
          formulas = [concat(["1d20", toSignedString(recovery_check_bonus + fortitude)])],
          text = "recovery check",
        ),
      ],
      on_result_effect = when {
        $event.result >= 20 + dying -> when {
          dying <= 2 -> sequence(
            effects = [
              setStat(
                stat = "dying",
                new_value = 0,
                aggregation_type = "set",
              ),
              addToStat(
                stat = "wounded",
                value = 1,
                aggregation_type = "set",
              ),
            ],
          ),
          else -> setStat(
            stat = "dying",
            new_value = dying - 2,
            aggregation_type = "set",
          ),
        },
        $event.result >= 10 + dying -> when {
          dying <= 1 -> sequence(
            effects = [
              setStat(
                stat = "dying",
                new_value = 0,
                aggregation_type = "set",
              ),
              addToStat(
                stat = "wounded",
                value = 1,
                aggregation_type = "set",
              ),
            ],
          ),
          else -> setStat(
            stat = "dying",
            new_value = dying - 1,
            aggregation_type = "set",
          ),
        },
        $event.result <= dying -> setStat(
          stat = "dying",
          new_value = dying + 2,
          aggregation_type = "set",
        ),
        else -> setStat(
          stat = "dying",
          new_value = dying + 1,
          aggregation_type = "set",
        ),
      },
    ),
    is_dead -> showMessage(
      message = "Character is dead and can't attempt recovery checks.",
      message_type = "info",
    ),
    dying <= 0 && !is_dead -> showMessage(
      message = "Your character isn't dying.",
      message_type = "info",
    ),
  };
