mechanic trigger_refocus(event_names = "trigger_refocus") =
  showPopUp(
    pop_up_view = list(
      id = "refocus_content",
      padding = 16,
      subviews = [
        text(
          id = "refocus_description",
          text = "Spend 10 minutes to regain 1 Focus Point (up to maximum).",
          style = "text",
        ),
      ],
    ),
    pop_up_title = "Refocus",
    display_cancel_button = true,
    extra_buttons = [
      rPGViewBottomSheetExtraButton(
        text = "REFOCUS",
        event = event(name = "refocus", payload = payload()),
      ),
    ],
    in_edit_mode = true,
  );
