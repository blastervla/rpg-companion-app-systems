        ),
      )
      + length(filter(creator_step_2_assigned_ability_boosts, filter = ($v) => $v == "charisma"));

calc integer creator_preview_strength_score(name = "Creator preview STR score") =
  strength_score + when {
    creator_preview_strength_total_boosts <= 0 -> 0,
    strength_score >= 18 -> creator_preview_strength_total_boosts,
    creator_preview_strength_total_boosts <= divide([(18 - strength_score), 2], rounding_method = "up")
      -> creator_preview_strength_total_boosts * 2,
    else
      -> divide([(18 - strength_score), 2], rounding_method = "up") * 2
      + (creator_preview_strength_total_boosts
          - divide([(18 - strength_score), 2], rounding_method = "up")),
  };

calc integer creator_preview_dexterity_score(name = "Creator preview DEX score") =
  dexterity_score + when {
    creator_preview_dexterity_total_boosts <= 0 -> 0,
    dexterity_score >= 18 -> creator_preview_dexterity_total_boosts,
    creator_preview_dexterity_total_boosts <= divide([(18 - dexterity_score), 2], rounding_method = "up")
      -> creator_preview_dexterity_total_boosts * 2,
    else
      -> divide([(18 - dexterity_score), 2], rounding_method = "up") * 2
      + (creator_preview_dexterity_total_boosts
          - divide([(18 - dexterity_score), 2], rounding_method = "up")),
  };

calc integer creator_preview_constitution_score(name = "Creator preview CON score") =
  constitution_score + when {
