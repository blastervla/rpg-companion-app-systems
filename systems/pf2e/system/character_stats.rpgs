calc integer creator_preview_charisma_modifier(name = "Creator preview CHA modifier") =
  abilityModifier(score = creator_preview_charisma_score);

calc string creator_ability_modifiers_row_1(name = "Creator ability modifiers row 1") =
  concat(
    [
      "STR ",
      (signedDisplay(value = creator_preview_strength_modifier)),
      "  ·  DEX ",
      (signedDisplay(value = creator_preview_dexterity_modifier)),
      "  ·  CON ",
      (signedDisplay(value = creator_preview_constitution_modifier)),
    ],
  );

calc string creator_ability_modifiers_row_2(name = "Creator ability modifiers row 2") =
