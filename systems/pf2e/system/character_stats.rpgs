calc resource<ancestry> creator_selected_ancestry(name = "Selected creator ancestry") =
  $view?.edit_character_basics_ancestry_select? ?? ancestry;

calc resource<heritage> creator_selected_heritage(name = "Selected creator heritage") =
  $view?.edit_character_basics_heritage_select? ?? heritage;

calc resource<background> creator_selected_background(name = "Selected creator background") =
  $view?.edit_character_basics_background_select? ?? background;

calc resource<class_progression>[] creator_selected_classes(name = "Selected creator classes") =
  $view?.edit_character_basics_classes? ?? classes;

calc resource<ability_score_increase>[] creator_ability_score_increases(name = "Creator ability score increases") =
  flatAppend(
    [
      creator_selected_ancestry?.ability_score_increases ?? [],
      creator_selected_heritage?.ability_score_increases ?? [],
      creator_selected_background?.ability_score_increases ?? [],
      flatMap(
        creator_selected_classes,
        mapper = ($mapValue) => $mapValue.class?.ability_score_increases ?? [],
      ),
    ],
  );

base resource<ability_score_increase>[] old_creator_ability_score_increases(name = "Old creator ability score increases") =
  [];

calc resource<levelled_choice_text>[] creator_language_proficiency_choices(name = "Creator language proficiency choices") =
  flatAppend(
    [
      (creator_selected_ancestry?.language_proficiencies_for_current_level ?? []),
      flatMap(
        creator_selected_classes,
        mapper = ($mapValue) => ($mapValue.class?.language_proficiencies_for_current_level ?? []),
      ),
      (creator_selected_background?.language_proficiencies_for_current_level ?? []),
    ],
  );

calc resource<levelled_skill_proficiency>[] creator_skill_proficiency_choices(name = "Creator skill proficiency choices") =
  flatAppend(
    [
      (creator_selected_ancestry?.skill_proficiencies_for_current_level ?? []),
      flatMap(
        creator_selected_classes,
        mapper = ($mapValue) => ($mapValue.class?.skill_proficiencies_for_current_level ?? []),
      ),
      (creator_selected_background?.skill_proficiencies_for_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.skill_proficiencies_for_current_level ?? []),
      ),
    ],
  );

base string[] creator_additional_class_skill_choices(name = "Creator additional class skill choices") =
  [];

calc string[] creator_selected_skill_choices(name = "Creator selected skill choices") =
  map(
    filter(
      creator_skill_proficiency_choices,
      filter = ($filterValue) => !isEmpty($filterValue.selected_option),
    ),
    mapper = ($mapValue) => $mapValue.selected_option,
  );

calc integer creator_additional_class_skill_choices_required(name = "Creator additional class skill choices required") =
  max(
    [
      0,
      add(
        flatMap(
          creator_selected_classes,
          mapper = ($classProgression) => [
            max(
              [
                0,
                ($classProgression.class?.additional_trained_skills_base_count ?? 0)
                  + when {
                    ($classProgression.class?.additional_trained_skills_ability ?? "intelligence") == "strength" -> creator_preview_strength_modifier,
                    ($classProgression.class?.additional_trained_skills_ability ?? "intelligence") == "dexterity" -> creator_preview_dexterity_modifier,
                    ($classProgression.class?.additional_trained_skills_ability ?? "intelligence") == "constitution" -> creator_preview_constitution_modifier,
                    ($classProgression.class?.additional_trained_skills_ability ?? "intelligence") == "wisdom" -> creator_preview_wisdom_modifier,
                    ($classProgression.class?.additional_trained_skills_ability ?? "intelligence") == "charisma" -> creator_preview_charisma_modifier,
                    else -> creator_preview_intelligence_modifier,
                  },
              ],
            ),
          ],
        ),
      ),
    ],
  );

calc string[] creator_additional_class_skill_choices_allowed_options(name = "Creator additional class skill choices allowed options") =
  filter(
    [
      "acrobatics",
      "arcana",
      "athletics",
      "crafting",
      "deception",
      "diplomacy",
      "intimidation",
      "medicine",
      "nature",
      "occultism",
      "performance",
      "religion",
      "society",
      "stealth",
      "survival",
      "thievery",
    ],
    filter = ($filterValue) => (metaStat(meta_stat = concat([$filterValue, "_proficiency"])) == "none"
      || contains(
          haystack = creator_additional_class_skill_choices,
          needle = $filterValue,
        ))
      && !contains(
        haystack = creator_selected_skill_choices,
        needle = $filterValue,
      ),
  );

calc string creator_additional_class_skill_choices_help_text(name = "Creator additional class skill choices help text") =
  concat(
    [
      "Choose ",
      creator_additional_class_skill_choices_required,
      " additional trained class skills.",
    ],
  );

calc bool has_pending_proficiency_choices(name = "Has pending proficiency choices") =
  !isEmpty(filter(
    creator_skill_proficiency_choices,
    filter = ($c) => isEmpty($c.selected_option) && !isEmpty($c.options),
  )) || length(creator_additional_class_skill_choices) < creator_additional_class_skill_choices_required;

calc resource<levelled_skill_proficiency>[] pending_creator_skill_proficiency_choices(name = "Pending creator skill proficiency choices") =
  filter(
    creator_skill_proficiency_choices,
    filter = ($choice) => isEmpty($choice.selected_option) && !isEmpty($choice.options),
  );

calc integer pending_additional_class_skill_choices_count(name = "Pending additional class skill choices count") =
  max(
    [
      0,
      creator_additional_class_skill_choices_required - length(creator_additional_class_skill_choices),
    ],
  );

calc string pending_proficiency_choices_warning_text(name = "Pending proficiency choices warning text") =
  joinToString(
    flatAppend(
      [
        map(
          pending_creator_skill_proficiency_choices,
          mapper = ($choice) => concat(["- ", $choice.description]),
        ),
        (if pending_additional_class_skill_choices_count > 0
          then [
              concat(
                [
                  "- Additional trained class skills pending: choose ",
                  pending_additional_class_skill_choices_count,
                  " more.",
                ],
              ),
            ]
          else []),
      ],
    ),
    separator = "\n",
  );

calc resource<levelled_armor_proficiency>[] creator_armor_proficiency_choices(name = "Creator armor proficiency choices") =
  flatAppend(
    [
      (creator_selected_ancestry?.armor_proficiencies_for_current_level ?? []),
      flatMap(
        creator_selected_classes,
        mapper = ($mapValue) => ($mapValue.class?.armor_proficiencies_for_current_level ?? []),
      ),
      (creator_selected_background?.armor_proficiencies_for_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.armor_proficiencies_for_current_level ?? []),
      ),
    ],
  );

calc resource<levelled_weapon_proficiency>[] creator_weapon_proficiency_choices(name = "Creator weapon proficiency choices") =
  flatAppend(
    [
      (creator_selected_ancestry?.weapon_proficiencies_for_current_level ?? []),
      flatMap(
        creator_selected_classes,
        mapper = ($mapValue) => ($mapValue.class?.weapon_proficiencies_for_current_level ?? []),
      ),
      (creator_selected_background?.weapon_proficiencies_for_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.weapon_proficiencies_for_current_level ?? []),
      ),
    ],
  );

calc resource<lore_skill>[] creator_lore_skill_choices(name = "Creator lore skill choices") =
  flatAppend(
    [
      (creator_selected_ancestry?.lore_skills_for_current_level ?? []),
      flatMap(
        creator_selected_classes,
        mapper = ($mapValue) => ($mapValue.class?.lore_skills_for_current_level ?? []),
      ),
      (creator_selected_background?.lore_skills_for_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.lore_skills_for_current_level ?? []),
      ),
    ],
  );

calc resource<selectable_items>[] creator_starting_equipment_choices(name = "Creator starting equipment choices") =
  flatAppend(
    [
      flatMap(creator_selected_classes, mapper = ($mapValue) => ($mapValue.class?.selectable_equipments ?? [])),
      (background?.selectable_equipments ?? []),
    ],
  );

calc resource<selectable_armors>[] creator_starting_armor_choices(name = "Creator starting armor choices") =
  flatAppend(
    [
      flatMap(creator_selected_classes, mapper = ($mapValue) => ($mapValue.class?.selectable_armors ?? [])),
      (background?.selectable_armors ?? []),
    ],
  );

calc resource<selectable_weapons>[] creator_starting_weapon_choices(name = "Creator starting weapon choices") =
  flatAppend(
    [
      flatMap(creator_selected_classes, mapper = ($mapValue) => ($mapValue.class?.selectable_weapons ?? [])),
      (background?.selectable_weapons ?? []),
    ],
  );

base integer spell_attack_extra_bonus(name = "Extra spell attack bonus") = 0;

base integer spell_attack_status_bonus(name = "Spell attack status bonus") = 0;

base integer spell_attack_status_penalty(name = "Spell attack status penalty") = 0;

base integer spell_attack_circumstance_bonus(name = "Spell attack circumstance bonus") = 0;

base integer spell_attack_circumstance_penalty(name = "Spell attack circumstance penalty") = 0;

base integer spell_attack_item_bonus(name = "Spell attack item bonus") = 0;

base integer spell_attack_item_penalty(name = "Spell attack item penalty") = 0;

calc integer spell_attack_typed_modifier_total(name = "Spell attack typed modifier total") =
  spell_attack_extra_bonus
    + spell_attack_status_bonus
    + spell_attack_status_penalty
    + spell_attack_circumstance_bonus
    + spell_attack_circumstance_penalty
    + spell_attack_item_bonus
    + spell_attack_item_penalty;

base integer spell_dc_extra_bonus(name = "Extra spell save DC bonus") = 0;

base integer spell_dc_status_bonus(name = "Spell DC status bonus") = 0;

base integer spell_dc_status_penalty(name = "Spell DC status penalty") = 0;

base integer spell_dc_circumstance_bonus(name = "Spell DC circumstance bonus") = 0;

base integer spell_dc_circumstance_penalty(name = "Spell DC circumstance penalty") = 0;

base integer spell_dc_item_bonus(name = "Spell DC item bonus") = 0;

base integer spell_dc_item_penalty(name = "Spell DC item penalty") = 0;

calc integer spell_dc_typed_modifier_total(name = "Spell DC typed modifier total") =
  spell_dc_extra_bonus
    + spell_dc_status_bonus
    + spell_dc_status_penalty
    + spell_dc_circumstance_bonus
    + spell_dc_circumstance_penalty
    + spell_dc_item_bonus
    + spell_dc_item_penalty;

base string[] selected_selectable_feature_ids(name = "Selected selectable feature ids") =
  [];

calc resource<feat>[] ancestry_traits(name = "Ancestry traits") =
  sortBy(
    (ancestry?.current_level_traits ?? []),
    sort_by_selector = ($sortByValue) => $sortByValue.min_level,
  );

calc resource<feat>[] background_features(name = "Background features") =
  sortBy(
    (background?.current_level_features ?? []),
    sort_by_selector = ($sortByValue) => $sortByValue.min_level,
  );

base resource<feat>[] feats(name = "Feats") = [];

base resource<archetype>[] archetypes(name = "Archetypes") = [];

base bool enable_optional_class_archetypes(name = "Enable optional class archetypes") = false;

base resource<archetype> class_archetype(name = "Class archetype") = null;

calc resource<archetype>[] class_archetypes(name = "Class archetypes") =
  if enable_optional_class_archetypes && notNull(class_archetype) then [class_archetype] else [];

calc resource<archetype>[] slot_assigned_archetypes(name = "Archetypes assigned to slots") =
  filter(
    flatAppend([
      flatMap(
        (if creation_feats_page_open then creator_selected_classes else classes),
        mapper = ($c) => map(
          filter(
            (if creation_feats_page_open
                then ($c.class_effective?.progression_grants ?? [])
                else ($c.class?.progression_grants ?? [])),
            filter = ($g) => $g.bucket == "class_like_feat"
              && $g.slot_mode_effective == "archetype_new"
              && notNull($g.assigned_archetype_effective),
          ),
          mapper = ($g) => $g.assigned_archetype_effective,
        ),
      ),
      map(
        filter(
          (if creation_feats_page_open
              then creator_selected_ancestry?.progression_grants
              else ancestry?.progression_grants) ?? [],
          filter = ($g) => $g.bucket == "class_like_feat"
            && $g.slot_mode_effective == "archetype_new"
            && notNull($g.assigned_archetype_effective),
        ),
        mapper = ($g) => $g.assigned_archetype_effective,
      ),
      map(
        filter(
          (if creation_feats_page_open
              then creator_selected_heritage?.progression_grants
              else heritage?.progression_grants) ?? [],
          filter = ($g) => $g.bucket == "class_like_feat"
            && $g.slot_mode_effective == "archetype_new"
            && notNull($g.assigned_archetype_effective),
        ),
        mapper = ($g) => $g.assigned_archetype_effective,
      ),
    ]),
    filter = ($a) => notNull($a),
  );

calc resource<archetype>[] multiclass_archetypes(name = "Multiclass archetypes") =
  flatAppend([
    slot_assigned_archetypes,
    filter(archetypes, filter = ($a) => !$a.is_class_archetype),
  ]);

calc resource<feat>[] slot_assigned_feats(name = "Feats assigned to slots") =
  filter(
    flatAppend([
      flatMap(
        (if creation_feats_page_open then creator_selected_classes else classes),
        mapper = ($c) => map(
          filter(
            (if creation_feats_page_open
                then ($c.class_effective?.progression_grants ?? [])
                else ($c.class?.progression_grants ?? [])),
            filter = ($g) => $g.is_feat_slot && notNull($g.assigned_feat_effective),
          ),
          mapper = ($g) => $g.assigned_feat_effective,
        ),
      ),
      map(
        filter(
          (if creation_feats_page_open
              then creator_selected_ancestry?.progression_grants
              else ancestry?.progression_grants) ?? [],
          filter = ($g) => $g.is_feat_slot && notNull($g.assigned_feat_effective),
        ),
        mapper = ($g) => $g.assigned_feat_effective,
      ),
      map(
        filter(
          (if creation_feats_page_open
              then creator_selected_heritage?.progression_grants
              else heritage?.progression_grants) ?? [],
          filter = ($g) => $g.is_feat_slot && notNull($g.assigned_feat_effective),
        ),
        mapper = ($g) => $g.assigned_feat_effective,
      ),
      flatMap(
        multiclass_archetypes,
        mapper = ($arch) => map(
          filter(
            $arch.progression_grants ?? [],
            filter = ($g) => $g.is_feat_slot && notNull($g.assigned_feat_effective),
          ),
          mapper = ($g) => $g.assigned_feat_effective,
        ),
      ),
    ]),
    filter = ($f) => notNull($f),
  );

calc string[] selected_archetype_ids(name = "Selected archetype ids") =
  map(
    flatAppend([class_archetypes, archetypes, slot_assigned_archetypes]),
    mapper = ($a) => $a.id,
  );

calc string[] selected_multiclass_archetype_ids(name = "Selected multiclass archetype ids") =
  map(
    multiclass_archetypes,
    mapper = ($arch) => $arch.id,
  );

calc string[] selected_multiclass_archetype_names(name = "Selected multiclass archetype names") =
  map(
    multiclass_archetypes,
    mapper = ($arch) => $arch.name,
  );

calc resource<archetype>[] class_archetypes_with_class_mismatch(name = "Class archetypes with class mismatch") =
  filter(
    class_archetypes,
    filter = ($arch) => ($arch.is_class_archetype && !isEmpty($arch.required_class_id)
      && !contains(
          haystack = map(classes, mapper = ($c) => $c.class?.id ?? ""),
          needle = $arch.required_class_id,
        )),
  );

calc string class_archetypes_with_class_mismatch_names(name = "Class archetypes with class mismatch names") =
  joinToString(
    map(
      class_archetypes_with_class_mismatch,
      mapper = ($mapValue) => $mapValue.name,
    ),
    separator = ", ",
  );

calc string class_archetype_mismatch_warning_text(name = "Class archetype mismatch warning text") =
  if isEmpty(class_archetypes_with_class_mismatch_names)
    then ""
    else concat(
        [
          "Class archetype/class mismatch: ",
          class_archetypes_with_class_mismatch_names,
          ". Keeping this is a GM override.",
        ],
      );

calc resource<archetype>[] spellcasting_archetypes(name = "Spellcasting archetypes") =
  filter(flatAppend([class_archetypes, multiclass_archetypes]), filter = ($a) => $a.grants_spellcasting);

calc resource<archetype> spellcasting_archetype_1(name = "Spellcasting archetype 1") =
  findFirst(spellcasting_archetypes, filter = ($a) => true);

calc resource<archetype> spellcasting_archetype_2(name = "Spellcasting archetype 2") =
  findFirst(
    filter(spellcasting_archetypes, filter = ($a) => $a.id != (spellcasting_archetype_1?.id ?? "")),
    filter = ($a) => true,
  );

calc resource<archetype> spellcasting_archetype_3(name = "Spellcasting archetype 3") =
  findFirst(
    filter(
      spellcasting_archetypes,
      filter = ($a) => $a.id != (spellcasting_archetype_1?.id ?? "")
        && $a.id != (spellcasting_archetype_2?.id ?? ""),
    ),
    filter = ($a) => true,
  );

calc resource<feat>[] dedication_feats(name = "Dedication feats from archetypes") =
  filter(
    map(flatAppend([class_archetypes, multiclass_archetypes]), mapper = ($arch) => $arch.dedication_feat),
    filter = ($filterValue) => notNull($filterValue),
  );

calc resource<feat>[] class_archetype_dedication_feats(name = "Dedication feats from class archetypes") =
  filter(
    map(class_archetypes, mapper = ($arch) => $arch.dedication_feat),
    filter = ($f) => notNull($f),
  );

calc string[] class_archetype_dedication_feat_ids(name = "Dedication feat ids from class archetypes") =
  map(class_archetype_dedication_feats, mapper = ($f) => $f.id);

calc resource<feat>[] non_duplicate_dedication_feats(name = "Dedication feats not already in feats") =
  filter(
    dedication_feats,
    filter = ($filterValue) => !contains(
      haystack = map(flatAppend([feats, slot_assigned_feats]), mapper = ($feat) => $feat.id),
      needle = $filterValue.id,
    ),
  );

calc resource<feat>[] class_archetype_auto_feats(name = "Auto-granted feats from class archetypes") =
  flatMap(
    class_archetypes,
    mapper = ($arch) => $arch.auto_feats_for_current_level,
  );

calc resource<feat>[] non_duplicate_class_archetype_auto_feats(name = "Class archetype auto-feats not already in feats or dedication feats") =
  filter(
    class_archetype_auto_feats,
    filter = ($f) => !contains(
      haystack = map(flatAppend([feats, slot_assigned_feats]), mapper = ($feat) => $feat.id),
      needle = $f.id,
    ) && !contains(
      haystack = map(dedication_feats, mapper = ($feat) => $feat.id),
      needle = $f.id,
    ),
  );

calc resource<feat>[] all_selected_and_dedication_feats(name = "All selected feats and missing dedication feats") =
  flatAppend([feats, slot_assigned_feats, non_duplicate_dedication_feats, non_duplicate_class_archetype_auto_feats]);

calc string[] all_selected_and_dedication_feat_ids(name = "All selected feat ids (with auto-included dedication feats)") =
  map(all_selected_and_dedication_feats, mapper = ($f) => $f.id);

calc resource<archetype>[] all_selected_archetypes(name = "All selected archetypes") =
  flatAppend([class_archetypes, multiclass_archetypes]);

calc resource<feat>[] archetype_feats_without_selected_archetype(name = "Archetype feats without selected archetype") =
  filter(
    all_selected_and_dedication_feats,
    filter = ($feat) => ($feat.type == "archetype"
      && (
        !isEmpty($feat.archetypes)
        || length(
            filter(
              all_selected_archetypes,
              filter = ($arch) => contains(
                haystack = map($arch.feats ?? [], mapper = ($f) => $f.id),
                needle = $feat.id,
              ),
            ),
          ) > 0
      )
      && !contains(
          haystack = class_archetype_dedication_feat_ids,
          needle = $feat.id,
        )
      && length(
          filter(
            $feat.archetypes,
            filter = ($archetypeId) => contains(
              haystack = selected_archetype_ids,
              needle = $archetypeId,
            ),
          ),
        ) == 0
      && length(
          filter(
            all_selected_archetypes,
            filter = ($arch) => contains(
              haystack = map($arch.feats ?? [], mapper = ($f) => $f.id),
              needle = $feat.id,
            ),
          ),
        ) == 0),
  );

calc string archetype_feats_without_selected_archetype_names(name = "Archetype feats without selected archetype names") =
  joinToString(
    map(
      archetype_feats_without_selected_archetype,
      mapper = ($mapValue) => $mapValue.name,
    ),
    separator = ", ",
  );

calc string archetype_feats_warning_text(name = "Archetype feats warning text") =
  if isEmpty(archetype_feats_without_selected_archetype_names)
    then ""
    else concat(
        [
          "Archetype feats missing a selected archetype: ",
          archetype_feats_without_selected_archetype_names,
          ". Add the archetype first (dedication auto-adds) or keep as GM override.",
        ],
      );

calc string[] selected_dedication_archetype_ids(name = "Selected dedication archetype ids") =
  map(
    filter(
      all_selected_archetypes,
      filter = ($arch) => notNull($arch.dedication_feat) && contains(
        haystack = all_selected_and_dedication_feat_ids,
        needle = $arch.dedication_feat.id,
      ),
    ),
    mapper = ($arch) => $arch.id,
  );

calc resource<feat>[] archetype_feats_without_dedication(name = "Archetype feats without dedication") =
  filter(
    archetype_feats,
    filter = ($feat) => (!contains(
      haystack = toLowerCase($feat.traits),
      needle = "dedication",
    )
      && (
          length(
            filter(
              $feat.archetypes,
              filter = ($id) => contains(
                haystack = selected_archetype_ids,
                needle = $id,
              ),
            ),
          ) > 0
          || length(
              filter(
                all_selected_archetypes,
                filter = ($arch) => contains(
                  haystack = map($arch.feats ?? [], mapper = ($f) => $f.id),
                  needle = $feat.id,
                ),
              ),
            ) > 0
        )
      && length(
          filter(
            all_selected_archetypes,
            filter = ($arch) => contains(
              haystack = selected_dedication_archetype_ids,
              needle = $arch.id,
            ) && (
              contains(
                haystack = map($arch.feats ?? [], mapper = ($f) => $f.id),
                needle = $feat.id,
              )
              || contains(
                haystack = $feat.archetypes,
                needle = $arch.id,
              )
            ),
          ),
        ) == 0),
  );

calc string archetype_feats_without_dedication_names(name = "Archetype feats without dedication names") =
  joinToString(
    map(
      archetype_feats_without_dedication,
      mapper = ($mapValue) => $mapValue.name,
    ),
    separator = ", ",
  );

calc string archetype_dedication_missing_warning_text(name = "Archetype dedication missing warning text") =
  if isEmpty(archetype_feats_without_dedication_names)
    then ""
    else concat(
        [
          "Archetype feats without a matching dedication feat: ",
          archetype_feats_without_dedication_names,
          ". This is allowed as a GM override.",
        ],
      );

calc resource<archetype>[] selected_dedication_archetypes(name = "Selected dedication archetypes") =
  filter(
    flatAppend([class_archetypes, multiclass_archetypes]),
    filter = ($arch) => contains(
      haystack = selected_dedication_archetype_ids,
      needle = $arch.id,
    ),
  );

calc resource<archetype>[] selected_dedication_archetypes_missing_two_non_dedication_feats(name = "Selected dedication archetypes missing two non-dedication feats") =
  filter(
    selected_dedication_archetypes,
    filter = ($arch) => length(
      filter(
        archetype_feats,
        filter = ($feat) => (!contains(
            haystack = toLowerCase($feat.traits),
            needle = "dedication",
          )
          && (
            contains(
              haystack = $feat.archetypes,
              needle = $arch.id,
            )
            || contains(
                haystack = map($arch.feats ?? [], mapper = ($f) => $f.id),
                needle = $feat.id,
              )
          )),
      ),
    ) < 2,
  );

calc string selected_dedication_archetypes_missing_two_non_dedication_feats_names(name = "Selected dedication archetypes missing two non-dedication feats names") =
  joinToString(
    map(
      selected_dedication_archetypes_missing_two_non_dedication_feats,
      mapper = ($mapValue) => $mapValue.name,
    ),
    separator = ", ",
  );

calc string archetype_multiple_dedications_warning_text(name = "Archetype multiple dedications warning text") =
  if length(selected_dedication_archetypes) <= 1 || isEmpty(selected_dedication_archetypes_missing_two_non_dedication_feats_names)
    then ""
    else concat(
        [
          "Multiple dedications selected before two non-dedication archetype feats: ",
          selected_dedication_archetypes_missing_two_non_dedication_feats_names,
          ". This is allowed as a GM override.",
        ],
      );

calc resource<feat>[] feats_above_current_level(name = "Feats above current level") =
  filter(
    feats,
    filter = ($feat) => ($feat.min_level > level),
  );

calc string feats_above_current_level_names(name = "Feats above current level names") =
  joinToString(
    map(
      feats_above_current_level,
      mapper = ($mapValue) => $mapValue.name,
    ),
    separator = ", ",
  );

calc string feats_above_current_level_warning_text(name = "Feats above current level warning text") =
  if isEmpty(feats_above_current_level_names)
    then ""
    else concat(
        [
          "Feats above current level: ",
          feats_above_current_level_names,
          ". Keeping these is a GM override.",
        ],
      );

calc resource<feat> improved_flexibility_feature(name = "Improved Flexibility feature (if present)") =
  findFirst(
    all_features,
    filter = ($feature) => (toLowerCase(trim($feature.name)) == "improved flexibility"),
  );

calc resource<feat>[] improved_flexibility_chosen_features(name = "Chosen Improved Flexibility selectable feats") =
  improved_flexibility_feature?.selected_selectable_features ?? [];

calc integer improved_flexibility_chosen_features_count(name = "Chosen Improved Flexibility selectable feat count") =
  length(improved_flexibility_chosen_features);

calc integer improved_flexibility_chosen_up_to_level_8_count(name = "Chosen Improved Flexibility selectable feats up to level 8") =
  length(
    filter(
      improved_flexibility_chosen_features,
      filter = ($feat) => ($feat.min_level <= 8),
    ),
  );

calc string improved_flexibility_warning_text(name = "Improved Flexibility warning text") =
  when {
    isNull(improved_flexibility_feature) -> "",
    improved_flexibility_feature.current_allowed_amount_of_selectable_features <= 1 -> "",
    improved_flexibility_chosen_features_count == 0 -> "",
    improved_flexibility_chosen_features_count < improved_flexibility_feature.current_allowed_amount_of_selectable_features -> concat(
        [
          "Improved Flexibility pending choices: select ",
          improved_flexibility_feature.current_allowed_amount_of_selectable_features,
          " total options, with at least one 8th-level-or-lower class feat.",
        ],
      ),
    improved_flexibility_chosen_up_to_level_8_count > 0 -> "",
    else -> "Improved Flexibility warning: at least one chosen option should be 8th level or lower (GM override allowed).",
  };

calc resource<feat> unified_magical_theory_feature(name = "Unified Magical Theory feature (if present)") =
  findFirst(
    flatMap(
      all_features,
      mapper = ($feature) => (if defined(stat = "$feature.selected_selectable_features")
        then $feature.selected_selectable_features
        else []),
    ),
    filter = ($feature) => (toLowerCase(trim($feature.name)) == "unified magical theory: arcane school"
      || contains(
          haystack = toLowerCase($feature.id),
          needle = "feat_unified_magical_theory_",
        )),
  );

calc resource<feat>[] unified_magical_theory_selected_options(name = "Chosen Unified Magical Theory options") =
  unified_magical_theory_feature?.selected_selectable_features ?? [];

calc integer unified_magical_theory_selected_option_count(name = "Chosen Unified Magical Theory option count") =
  length(unified_magical_theory_selected_options);

calc integer unified_magical_theory_spell_choice_count(name = "Chosen Unified Magical Theory spell options") =
  length(
    filter(
      unified_magical_theory_selected_options,
      filter = ($feat) => ($feat.is_spellbook_choice_option),
    ),
  );

calc integer unified_magical_theory_feat_choice_count(name = "Chosen Unified Magical Theory feat options") =
  max([0, unified_magical_theory_selected_option_count - unified_magical_theory_spell_choice_count]);

calc string unified_magical_theory_warning_text(name = "Unified Magical Theory warning text") =
  when {
    isNull(unified_magical_theory_feature) -> "",
    unified_magical_theory_feature.current_allowed_amount_of_selectable_features <= 1 -> "",
    unified_magical_theory_selected_option_count == 0 -> "",
    unified_magical_theory_spell_choice_count == 1
      && unified_magical_theory_feat_choice_count == 1 -> "",
    else -> concat(
        [
          "Unified Magical Theory pick mix: choose 1 wizard class feat and 1 spellbook spell (current: ",
          unified_magical_theory_feat_choice_count,
          " feat, ",
          unified_magical_theory_spell_choice_count,
          " spell). GM override allowed.",
        ],
      ),
  };

calc resource<feat>[] ancestry_feats(name = "Ancestry feats") =
  filter(
    feats,
    filter = ($feat) => ($feat.type == "ancestry"),
  );

calc resource<feat>[] ancestry_feats_for_display(name = "Ancestry feats (display)") =
  filter(
    all_selected_and_dedication_feats,
    filter = ($feat) => ($feat.type == "ancestry"),
  );

calc resource<feat>[] class_feats(name = "Class feats") =
  filter(
    feats,
    filter = ($feat) => ($feat.type == "class"),
  );

calc resource<feat>[] class_feats_for_display(name = "Class feats (display)") =
  filter(
    all_selected_and_dedication_feats,
    filter = ($feat) => ($feat.type == "class"),
  );

calc resource<feat>[] skill_feats(name = "Skill feats") =
  filter(
    feats,
    filter = ($feat) => ($feat.type == "skill"),
  );

calc resource<feat>[] skill_feats_for_display(name = "Skill feats (display)") =
  filter(
    all_selected_and_dedication_feats,
    filter = ($feat) => ($feat.type == "skill"),
  );

calc resource<feat>[] general_feats(name = "General feats") =
  filter(
    feats,
    filter = ($feat) => ($feat.type == "general"),
  );

calc resource<feat>[] general_feats_for_display(name = "General feats (display)") =
  filter(
    all_selected_and_dedication_feats,
    filter = ($feat) => ($feat.type == "general"),
  );

calc resource<feat>[] archetype_feats(name = "Archetype feats") =
  filter(
    all_selected_and_dedication_feats,
    filter = ($feat) => ($feat.type == "archetype"),
  );

calc resource<feat>[] archetype_feats_for_display(name = "Archetype feats (display)") =
  archetype_feats;

calc resource<feat>[] multiclass_archetype_feats(name = "Multiclass archetype feats (excluding class archetype auto-grants)") =
  filter(
    archetype_feats,
    filter = ($feat) => !contains(
      haystack = map(non_duplicate_class_archetype_auto_feats, mapper = ($f) => $f.id),
      needle = $feat.id,
    ),
  );

calc resource<feat>[] bonus_feats(name = "Bonus feats") =
  filter(
    feats,
    filter = ($feat) => ($feat.type == "bonus"),
  );

calc resource<feat>[] other_typed_feats(name = "Other typed feats") =
  filter(
    feats,
    filter = ($feat) => !contains(
      haystack = [
        "ancestry",
        "class",
        "skill",
        "general",
        "archetype",
        "bonus",
      ],
      needle = $feat.type,
    ),
  );

calc resource<feat>[] selected_selectable_feats(name = "Selected selectable feats") =
  flatMap(
    feats,
    mapper = ($mapValue) => flatAppend(
      [
        (if $mapValue.has_selectable_features
          then filter(
              $mapValue.selectable_features,
              filter = ($filterValue) => contains(haystack = selected_selectable_feature_ids, needle = $filterValue.id),
            )
          else []),
      ],
    ),
  );

calc resource<feat>[] selectable_features_with_pending_choices(name = "Selectable features with pending choices") =
  filter(
    flatAppend(
      [
        (if creation_feats_page_open
          then creator_selected_ancestry?.current_level_traits
          else ancestry?.current_level_traits) ?? [],
        flatMap(
          (if creation_feats_page_open then creator_selected_classes else classes),
          mapper = ($classProgression) => (if creation_feats_page_open
              then $classProgression.class_effective?.current_level_features
              else $classProgression.class?.current_level_features) ?? [],
        ),
        (if creation_feats_page_open
          then creator_selected_background?.current_level_features
          else background?.current_level_features) ?? [],
        all_selected_and_dedication_feats,
      ],
      treat_as_set = true,
    ),
    filter = ($feature) => ($feature.has_selectable_features
      && $feature.current_allowed_amount_of_selectable_features > 0
      && !isEmpty($feature.available_selectable_features_for_current_level)
      && length($feature.chosen_selectable_features) < $feature.current_allowed_amount_of_selectable_features),
  );

calc string pending_selectable_feature_choices_warning_text(name = "Pending selectable feature choices warning text") =
  joinToString(
    map(
      selectable_features_with_pending_choices,
      mapper = ($feature) => concat(
        [
          "- ",
          $feature.name,
          ": choose ",
          max([0, $feature.current_allowed_amount_of_selectable_features - length($feature.chosen_selectable_features)]),
          " more.",
        ],
      ),
    ),
    separator = "\n",
  );

calc resource<feat>[] all_feats(name = "All feats (with selectable features included)") =
  flatMap(
    all_selected_and_dedication_feats,
    mapper = ($mapValue) => flatAppend(
      [
        [$mapValue],
        (if $mapValue.has_selectable_features
          then filter(
              $mapValue.selectable_features,
              filter = ($filterValue) => contains(haystack = selected_selectable_feature_ids, needle = $filterValue.id),
            )
          else []),
      ],
    ),
  );

calc resource<progression_grant>[] class_progression_grants_for_current_level(name = "Class progression grants for current level") =
  flatMap(
    (if creation_feats_page_open then creator_selected_classes else classes),
    mapper = ($classProgression) => filter(
      ((if creation_feats_page_open
          then ($classProgression.class_effective?.progression_grants ?? [])
          else ($classProgression.class?.progression_grants ?? []))),
      filter = ($grant) => ($grant.level <= (if creation_feats_page_open
        then $classProgression.class_level_effective
        else $classProgression.class_level)),
    ),
  );

calc resource<progression_grant>[] ancestry_progression_grants_for_current_level(name = "Ancestry progression grants for current level") =
  if isNull(if creation_feats_page_open then creator_selected_ancestry else ancestry)
    then []
    else filter(
        (if creation_feats_page_open then creator_selected_ancestry?.progression_grants else ancestry.progression_grants),
        filter = ($grant) => ($grant.level <= (if !isEmpty(if creation_feats_page_open then creator_selected_classes else classes)
          then max(
              map(
                (if creation_feats_page_open then creator_selected_classes else classes),
                mapper = ($cp) => (if creation_feats_page_open
                  then $cp.class_level_effective
                  else $cp.class_level),
              ),
            )
          else level)),
      );

calc resource<progression_grant>[] heritage_progression_grants_for_current_level(name = "Heritage progression grants for current level") =
  if isNull(if creation_feats_page_open then creator_selected_heritage else heritage)
    then []
    else filter(
        (if creation_feats_page_open then creator_selected_heritage?.progression_grants else heritage.progression_grants),
        filter = ($grant) => ($grant.level <= (if !isEmpty(if creation_feats_page_open then creator_selected_classes else classes)
          then max(
              map(
                (if creation_feats_page_open then creator_selected_classes else classes),
                mapper = ($cp) => (if creation_feats_page_open
                  then $cp.class_level_effective
                  else $cp.class_level),
              ),
            )
          else level)),
      );

calc resource<progression_grant>[] archetype_progression_grants_for_current_level(name = "Archetype progression grants for current level") =
  flatMap(
    multiclass_archetypes,
    mapper = ($arch) => filter(
      $arch.progression_grants,
      filter = ($grant) => ($grant.level <= level),
    ),
  );

calc resource<progression_grant>[] all_progression_grants_for_current_level(name = "All progression grants for current level") =
  flatAppend(
    [
      class_progression_grants_for_current_level,
      ancestry_progression_grants_for_current_level,
      heritage_progression_grants_for_current_level,
      archetype_progression_grants_for_current_level,
    ],
  );

calc resource<progression_grant>[] feat_grant_slots_for_current_level(name = "Feat grant slots for current level") =
  filter(
    all_progression_grants_for_current_level,
    filter = ($g) => $g.is_feat_slot,
  );

calc resource<progression_grant>[] all_interactive_progression_grants_for_current_level(name = "All interactive progression grants for current level") =
  filter(
    all_progression_grants_for_current_level,
    filter = ($g) => $g.is_interactive_slot,
  );

calc bool has_pending_interactive_slots(name = "Has pending interactive slots") =
  !isEmpty(filter(
    all_interactive_progression_grants_for_current_level,
    filter = ($g) =>
      ($g.is_feat_slot && isNull($g.assigned_feat_effective) && isNull($g.assigned_archetype_effective))
      || ($g.bucket == "ability_boost" && length($g.assigned_ability_boosts) < $g.amount)
      || ($g.bucket == "skill_increase" && isEmpty($g.committed_skill_increase_skill)),
  ));

calc integer granted_class_like_feat_slots(name = "Granted class-like feat slots") =
  add(
    map(
      filter(
        all_progression_grants_for_current_level,
        filter = ($grant) => $grant.bucket == "class_like_feat",
      ),
      mapper = ($grant) => max([0, $grant.amount]),
    ),
  );

calc integer granted_skill_feat_slots(name = "Granted skill feat slots") =
  add(
    map(
      filter(
        all_progression_grants_for_current_level,
        filter = ($grant) => $grant.bucket == "skill_feat",
      ),
      mapper = ($grant) => max([0, $grant.amount]),
    ),
  );

calc integer granted_general_feat_slots(name = "Granted general feat slots") =
  add(
    map(
      filter(
        all_progression_grants_for_current_level,
        filter = ($grant) => $grant.bucket == "general_feat",
      ),
      mapper = ($grant) => max([0, $grant.amount]),
    ),
  );

calc integer granted_ancestry_feat_slots(name = "Granted ancestry feat slots") =
  add(
    map(
      filter(
        all_progression_grants_for_current_level,
        filter = ($grant) => $grant.bucket == "ancestry_feat",
      ),
      mapper = ($grant) => max([0, $grant.amount]),
    ),
  );

calc integer granted_bonus_feat_slots(name = "Granted bonus feat slots") =
  add(
    map(
      filter(
        all_progression_grants_for_current_level,
        filter = ($grant) => $grant.bucket == "bonus_feat",
      ),
      mapper = ($grant) => max([0, $grant.amount]),
    ),
  );

calc integer granted_skill_increase_grants(name = "Granted skill increase grants") =
  add(
    map(
      filter(
        all_progression_grants_for_current_level,
        filter = ($grant) => $grant.bucket == "skill_increase",
      ),
      mapper = ($grant) => max([0, $grant.amount]),
    ),
  );

calc integer granted_ability_boost_grants(name = "Granted ability boost grants") =
  add(
    map(
      filter(
        all_progression_grants_for_current_level,
        filter = ($grant) => $grant.bucket == "ability_boost",
      ),
      mapper = ($grant) => max([0, $grant.amount]),
    ),
  );

calc integer spent_class_like_feat_slots(name = "Spent class-like feat slots") =
  length(
    filter(
      all_selected_and_dedication_feats,
      filter = ($feat) => ($feat.type == "class" || $feat.type == "archetype")
        && !contains(
            haystack = class_archetype_dedication_feat_ids,
            needle = $feat.id,
          )
        && !contains(
            haystack = map(non_duplicate_class_archetype_auto_feats, mapper = ($f) => $f.id),
            needle = $feat.id,
          ),
    ),
  );

calc resource<feat>[] class_like_feats_for_restriction_check(name = "Class-like feats for level restriction check") =
  filter(
    all_selected_and_dedication_feats,
    filter = ($feat) => ($feat.type == "class" || $feat.type == "archetype")
      && !contains(
          haystack = class_archetype_dedication_feat_ids,
          needle = $feat.id,
        )
      && !contains(
          haystack = map(non_duplicate_class_archetype_auto_feats, mapper = ($f) => $f.id),
          needle = $feat.id,
        ),
  );

calc bool class_like_feats_violate_level_restrictions(name = "Class feat level restrictions violated") =
  !isEmpty(
    filter(
      filter(
        all_progression_grants_for_current_level,
        filter = ($g) => $g.bucket == "class_like_feat",
      ),
      filter = ($grant) =>
        length(filter(class_like_feats_for_restriction_check, filter = ($f) => $f.min_level > $grant.level))
        > add(
            map(
              filter(
                all_progression_grants_for_current_level,
                filter = ($g) => $g.bucket == "class_like_feat" && $g.level > $grant.level,
              ),
              mapper = ($g) => $g.amount,
            ),
          ),
    ),
  );

calc string class_like_feats_above_level_names(name = "Class-like feats above current level names") =
  joinToString(
    map(
      filter(
        class_like_feats_for_restriction_check,
        filter = ($f) => $f.min_level > level,
      ),
      mapper = ($f) => $f.name,
    ),
    separator = ", ",
  );

calc string class_like_feats_level_restriction_warning_text(name = "Class feat level restriction warning") =
  if class_like_feats_violate_level_restrictions
    then concat(
        [
          "Some selected feats have level requirements that exceed the level at which their slots were available.",
          (if isEmpty(class_like_feats_above_level_names)
            then ""
            else concat([" Likely offenders: ", class_like_feats_above_level_names, "."])),
          " Please review your class feat selections.",
        ],
      )
    else "";

calc integer spent_skill_feat_slots(name = "Spent skill feat slots") =
  length(skill_feats)
  + length(filter(feat_grant_slots_for_current_level, filter = ($g) => $g.bucket == "skill_feat" && notNull($g.assigned_feat_effective)));

calc integer spent_general_feat_slots(name = "Spent general feat slots") =
  length(general_feats)
  + length(filter(feat_grant_slots_for_current_level, filter = ($g) => $g.bucket == "general_feat" && notNull($g.assigned_feat_effective)));

calc integer spent_ancestry_feat_slots(name = "Spent ancestry feat slots") =
  length(ancestry_feats)
  + length(filter(feat_grant_slots_for_current_level, filter = ($g) => $g.bucket == "ancestry_feat" && notNull($g.assigned_feat_effective)));

calc integer spent_bonus_feat_slots(name = "Spent bonus feat slots") = length(bonus_feats);

calc integer pending_class_like_feat_slots(name = "Pending class-like feat slots") =
  granted_class_like_feat_slots - spent_class_like_feat_slots;

calc integer pending_skill_feat_slots(name = "Pending skill feat slots") =
  granted_skill_feat_slots - spent_skill_feat_slots;

calc integer pending_general_feat_slots(name = "Pending general feat slots") =
  granted_general_feat_slots - spent_general_feat_slots;

calc integer pending_ancestry_feat_slots(name = "Pending ancestry feat slots") =
  granted_ancestry_feat_slots - spent_ancestry_feat_slots;

calc integer pending_bonus_feat_slots(name = "Pending bonus feat slots") =
  granted_bonus_feat_slots - spent_bonus_feat_slots;

calc integer overspent_class_like_feat_slots(name = "Overspent class-like feat slots") =
  max([0, -1 * pending_class_like_feat_slots]);

calc integer overspent_skill_feat_slots(name = "Overspent skill feat slots") =
  max([0, -1 * pending_skill_feat_slots]);

calc integer overspent_general_feat_slots(name = "Overspent general feat slots") =
  max([0, -1 * pending_general_feat_slots]);

calc integer overspent_ancestry_feat_slots(name = "Overspent ancestry feat slots") =
  max([0, -1 * pending_ancestry_feat_slots]);

calc integer overspent_bonus_feat_slots(name = "Overspent bonus feat slots") =
  max([0, -1 * pending_bonus_feat_slots]);

calc string progression_pending_slots_summary_text(name = "Progression pending slots summary text") =
  joinToString(
    flatAppend(
      [
        (if pending_class_like_feat_slots > 0
          then [concat(["Class-like feat slots pending: ", pending_class_like_feat_slots])]
          else []),
        (if pending_skill_feat_slots > 0
          then [concat(["Skill feat slots pending: ", pending_skill_feat_slots])]
          else []),
        (if pending_general_feat_slots > 0
          then [concat(["General feat slots pending: ", pending_general_feat_slots])]
          else []),
        (if pending_ancestry_feat_slots > 0
          then [concat(["Ancestry feat slots pending: ", pending_ancestry_feat_slots])]
          else []),
        (if pending_bonus_feat_slots > 0
          then [concat(["Bonus feat slots pending: ", pending_bonus_feat_slots])]
          else []),
      ],
    ),
    separator = "\n",
  );

calc string progression_overspent_slots_warning_text(name = "Progression overspent slots warning text") =
  joinToString(
    flatAppend(
      [
        (if overspent_class_like_feat_slots > 0
          then [concat(["Class-like feat slots overspent: ", overspent_class_like_feat_slots])]
          else []),
        (if overspent_skill_feat_slots > 0
          then [concat(["Skill feat slots overspent: ", overspent_skill_feat_slots])]
          else []),
        (if overspent_general_feat_slots > 0
          then [concat(["General feat slots overspent: ", overspent_general_feat_slots])]
          else []),
        (if overspent_ancestry_feat_slots > 0
          then [concat(["Ancestry feat slots overspent: ", overspent_ancestry_feat_slots])]
          else []),
        (if overspent_bonus_feat_slots > 0
          then [concat(["Bonus feat slots overspent: ", overspent_bonus_feat_slots])]
          else []),
      ],
    ),
    separator = "\n",
  );

base bool blinded(name = "Blinded") = false;

base bool deafened(name = "Deafened") = false;

base bool grappled(name = "Grappled") = false;

base bool invisible(name = "Invisible") = false;

base bool paralyzed(name = "Paralyzed") = false;

base bool petrified(name = "Petrified") = false;

base bool prone(name = "Prone") = false;

base bool unconscious(name = "Unconscious") = false;

calc bool is_single_third_level_caster(name = "Is single third level caster") =
  length(classes) == 1 && findFirst(
    map(
      classes,
      mapper = ($class) => ($class.class.actual_effective_caster_level == "third"),
    ),
    filter = ($findFirstValue) => true,
  );

calc resource<class_progression> first_third_level_caster_class(name = "First third level caster class") =
  if is_single_third_level_caster
    then findFirst(classes, filter = ($findFirstValue) => true)
    else null;

calc integer spellcaster_level(name = "Spellcaster level") =
  add(
    map(
      classes,
      mapper = ($class) => when {
        $class.class.actual_effective_caster_level == "full" -> $class.class_level,
        $class.class.actual_effective_caster_level == "half" -> divide([$class.class_level, 2], rounding_method = "up"),
        $class.class.actual_effective_caster_level == "third" -> divide([$class.class_level, 3], rounding_method = "down"),
        else -> 0,
      },
    ),
  );

calc resource<class_progression>[] custom_spell_slot_classes(name = "Custom spell slot classes") =
  filter(
    classes,
    filter = ($class) => ($class.class.actual_effective_caster_level == "custom"),
  );

base integer copper_pieces(name = "CP") = 0;

base integer silver_pieces(name = "SP") = 0;

base integer electrum_pieces(name = "EP") = 0;

base integer gold_pieces(name = "GP") = 0;

base integer platinum_pieces(name = "PP") = 0;

calc resource<class_progression> level_up_selected_class_progression(name = "Selected existing class when levelling up") =
  findFirst(
    classes,
    filter = ($findFirstValue) => ($findFirstValue.class?.id == $view.level_up_select_class?),
  );

base string temp_level_up_class(name = "Temporary variable for selecting among existing classes") =
  null;

calc resource<feat>[] level_up_selected_grant_feats(name = "Level up selected grant feats") =
  map(
    filter(
      level_up_interactive_progression_grants_in_new_level,
      filter = ($grant) => notNull($grant.assigned_feat_effective),
    ),
    mapper = ($grant) => $grant.assigned_feat_effective,
  );

calc resource<levelled_choice_text>[] level_up_language_proficiency_choices(name = "Level up language proficiency choices") =
  flatAppend(
    [
      (ancestry?.language_proficiencies_choices_in_current_level ?? []),
      flatMap(
        classes,
        mapper = ($mapValue) => (if $mapValue.should_select_on_level_up
          then ($mapValue.class?.language_proficiencies_choices_in_current_level ?? [])
          else []),
      ),
      (background?.language_proficiencies_choices_in_current_level ?? []),
      flatMap(
        level_up_selected_grant_feats,
        mapper = ($feat) => if defined(stat = "$feat.language_proficiencies_choices_in_current_level")
          then ($feat.language_proficiencies_choices_in_current_level ?? [])
          else [],
      ),
    ],
  );

calc resource<levelled_choice_text>[] level_up_language_proficiency_choices_effective(name = "Level up language proficiency choices (effective)") =
  filter(
    level_up_language_proficiency_choices,
    filter = ($choice) => !isEmpty(trim($choice.options)),
  );

calc resource<levelled_skill_proficiency>[] level_up_skill_proficiency_choices(name = "Level up skill proficiency choices") =
  flatAppend(
    [
      (ancestry?.skill_proficiencies_choices_in_current_level ?? []),
      flatMap(
        classes,
        mapper = ($mapValue) => (if $mapValue.should_select_on_level_up
          then ($mapValue.class?.skill_proficiencies_choices_in_current_level ?? [])
          else []),
      ),
      (background?.skill_proficiencies_choices_in_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.skill_proficiencies_choices_in_current_level ?? []),
      ),
      flatMap(
        level_up_selected_grant_feats,
        mapper = ($feat) => if defined(stat = "$feat.skill_proficiencies_choices_in_current_level")
          then ($feat.skill_proficiencies_choices_in_current_level ?? [])
          else [],
      ),
    ],
  );

calc resource<levelled_skill_proficiency>[] level_up_skill_proficiency_choices_effective(name = "Level up skill proficiency choices (effective)") =
  filter(
    level_up_skill_proficiency_choices,
    filter = ($choice) => !isEmpty($choice.options),
  );

calc resource<levelled_armor_proficiency>[] level_up_armor_proficiency_choices(name = "Level up armor proficiency choices") =
  flatAppend(
    [
      (ancestry?.armor_proficiencies_choices_in_current_level ?? []),
      flatMap(
        classes,
        mapper = ($mapValue) => (if $mapValue.should_select_on_level_up
          then ($mapValue.class?.armor_proficiencies_choices_in_current_level ?? [])
          else []),
      ),
      (background?.armor_proficiencies_choices_in_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.armor_proficiencies_choices_in_current_level ?? []),
      ),
      flatMap(
        level_up_selected_grant_feats,
        mapper = ($feat) => if defined(stat = "$feat.armor_proficiencies_choices_in_current_level")
          then ($feat.armor_proficiencies_choices_in_current_level ?? [])
          else [],
      ),
    ],
  );

calc resource<levelled_armor_proficiency>[] level_up_armor_proficiency_choices_effective(name = "Level up armor proficiency choices (effective)") =
  filter(
    level_up_armor_proficiency_choices,
    filter = ($choice) => !isEmpty($choice.options),
  );

calc resource<levelled_weapon_proficiency>[] level_up_weapon_proficiency_choices(name = "Level up weapon proficiency choices") =
  flatAppend(
    [
      (ancestry?.weapon_proficiencies_choices_in_current_level ?? []),
      flatMap(
        classes,
        mapper = ($mapValue) => (if $mapValue.should_select_on_level_up
          then ($mapValue.class?.weapon_proficiencies_choices_in_current_level ?? [])
          else []),
      ),
      (background?.weapon_proficiencies_choices_in_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.weapon_proficiencies_choices_in_current_level ?? []),
      ),
      flatMap(
        level_up_selected_grant_feats,
        mapper = ($feat) => if defined(stat = "$feat.weapon_proficiencies_choices_in_current_level")
          then ($feat.weapon_proficiencies_choices_in_current_level ?? [])
          else [],
      ),
    ],
  );

calc resource<levelled_weapon_proficiency>[] level_up_weapon_proficiency_choices_effective(name = "Level up weapon proficiency choices (effective)") =
  filter(
    level_up_weapon_proficiency_choices,
    filter = ($choice) => !isEmpty($choice.options),
  );

calc resource<lore_skill>[] level_up_lore_skill_choices(name = "Level up lore skill choices") =
  flatAppend(
    [
      (ancestry?.lore_skills_choices_in_current_level ?? []),
      flatMap(
        classes,
        mapper = ($mapValue) => (if $mapValue.should_select_on_level_up
          then ($mapValue.class?.lore_skills_choices_in_current_level ?? [])
          else []),
      ),
      (background?.lore_skills_choices_in_current_level ?? []),
      flatMap(
        all_features,
        mapper = ($mapValue) => ($mapValue.lore_skills_choices_in_current_level ?? []),
      ),
      flatMap(
        level_up_selected_grant_feats,
        mapper = ($feat) => if defined(stat = "$feat.lore_skills_choices_in_current_level")
          then ($feat.lore_skills_choices_in_current_level ?? [])
          else [],
      ),
    ],
  );

calc resource<levelled_skill_proficiency>[] level_up_pending_skill_proficiency_choices(name = "Level up pending skill proficiency choices") =
  filter(
    level_up_skill_proficiency_choices_effective,
    filter = ($choice) => isEmpty($choice.selected_option),
  );

calc resource<levelled_armor_proficiency>[] level_up_pending_armor_proficiency_choices(name = "Level up pending armor proficiency choices") =
  filter(
    level_up_armor_proficiency_choices_effective,
    filter = ($choice) => isEmpty($choice.selected_option),
  );

calc resource<levelled_weapon_proficiency>[] level_up_pending_weapon_proficiency_choices(name = "Level up pending weapon proficiency choices") =
  filter(
    level_up_weapon_proficiency_choices_effective,
    filter = ($choice) => isEmpty($choice.selected_option),
  );

calc resource<lore_skill>[] level_up_pending_lore_skill_choices(name = "Level up pending lore skill choices") =
  filter(
    level_up_lore_skill_choices,
    filter = ($choice) => !isEmpty(trim($choice.options)) && isEmpty(trim($choice.selected_option)),
  );

calc bool has_pending_sheet_proficiency_choices(name = "Has pending proficiency choices for character sheet") =
  currently_levelling_up
    && (
      !isEmpty(level_up_pending_skill_proficiency_choices)
      || !isEmpty(level_up_pending_armor_proficiency_choices)
      || !isEmpty(level_up_pending_weapon_proficiency_choices)
      || !isEmpty(level_up_pending_lore_skill_choices)
    );

calc string pending_sheet_proficiency_choices_warning_text(name = "Pending proficiency choices warning text for character sheet") =
  joinToString(
    flatAppend(
      [
        map(
          level_up_pending_skill_proficiency_choices,
          mapper = ($choice) => concat(["- ", $choice.description]),
        ),
        map(
          level_up_pending_armor_proficiency_choices,
          mapper = ($choice) => concat(["- ", $choice.description]),
        ),
        map(
          level_up_pending_weapon_proficiency_choices,
          mapper = ($choice) => concat(["- ", $choice.description]),
        ),
        map(
          level_up_pending_lore_skill_choices,
          mapper = ($choice) => concat(["- ", $choice.description]),
        ),
      ],
    ),
    separator = "\n",
  );

base string temp_last_level_up_class_id(name = "Last level up class ID") = null;

calc resource<class_progression> last_level_up_class_progression(name = "Last level up class") =
  findFirst(
    classes,
    filter = ($findFirstValue) => ($findFirstValue.class?.id == temp_last_level_up_class_id),
  );

base integer spent_skill_increase_grants_level_up(name = "Spent skill increase grants (level-up)") = 0;

base integer spent_ability_boost_grants_level_up(name = "Spent ability boost grants (level-up)") = 0;

calc integer spent_skill_increase_grants(name = "Spent skill increase grants") =
  spent_skill_increase_grants_level_up
    + length(
        filter(
          filter(
            all_progression_grants_for_current_level,
            filter = ($g) => $g.bucket == "skill_increase",
          ),
          filter = ($g) => !isEmpty($g.committed_skill_increase_skill),
        ),
      );

calc integer spent_ability_boost_grants(name = "Spent ability boost grants") =
  spent_ability_boost_grants_level_up
    + add(
        map(
          filter(
            all_progression_grants_for_current_level,
            filter = ($g) => $g.bucket == "ability_boost",
          ),
          mapper = ($g) => length($g.committed_ability_boosts),
        ),
      );

calc integer pending_skill_increase_grants(name = "Pending skill increase grants") =
  granted_skill_increase_grants - spent_skill_increase_grants;

calc integer pending_ability_boost_grants(name = "Pending ability boost grants") =
  granted_ability_boost_grants - spent_ability_boost_grants;

calc resource<levelled_rank_cap>[] class_skill_increase_rank_caps_for_current_level(name = "Class skill increase rank caps for current level") =
  flatMap(
    classes,
    mapper = ($classProgression) => filter(
      ($classProgression.class?.skill_increase_rank_caps ?? []),
      filter = ($rankCap) => ($rankCap.level <= $classProgression.class_level),
    ),
  );

calc resource<levelled_rank_cap> current_skill_increase_rank_cap_row(name = "Current skill increase rank cap row") =
  findFirst(
    sortBy(
      class_skill_increase_rank_caps_for_current_level,
      order = "desc",
      sort_by_selector = ($sortByValue) => $sortByValue.level,
    ),
    filter = ($findFirstValue) => true,
  );

calc string current_skill_increase_rank_cap(name = "Current skill increase rank cap") =
  when {
    notNull(current_skill_increase_rank_cap_row) -> current_skill_increase_rank_cap_row.proficiency,
    level >= 15 -> "legendary",
    level >= 7 -> "master",
    else -> "expert",
  };

calc integer current_skill_increase_rank_cap_value(name = "Current skill increase rank cap value") =
  when {
    current_skill_increase_rank_cap == "trained" -> 1,
    current_skill_increase_rank_cap == "expert" -> 2,
    current_skill_increase_rank_cap == "master" -> 3,
    current_skill_increase_rank_cap == "legendary" -> 4,
    else -> 0,
  };

base string temp_skill_increase_skill(name = "Temp skill increase skill") = "";

base string temp_skill_increase_target_rank(name = "Temp skill increase target rank") = "";

calc string temp_skill_increase_skill_effective(name = "Temp skill increase selected skill (effective)") =
  when {
    defined(stat = "$view.level_up_skill_increase_skill_select") -> if isEmpty($view.level_up_skill_increase_skill_select)
        then temp_skill_increase_skill
        else $view.level_up_skill_increase_skill_select,
    else -> temp_skill_increase_skill,
  };

calc string[] temp_skill_increase_skill_options(name = "Temp skill increase eligible skills") =
  filter(
    [
      "acrobatics",
      "arcana",
      "athletics",
      "crafting",
      "deception",
      "diplomacy",
      "intimidation",
      "medicine",
      "nature",
      "occultism",
      "performance",
      "religion",
      "society",
      "stealth",
      "survival",
      "thievery",
    ],
    filter = ($filterValue) => when {
      (metaStat(meta_stat = concat([$filterValue, "_proficiency"])) ?? "none") == "trained" -> 1,
      (metaStat(meta_stat = concat([$filterValue, "_proficiency"])) ?? "none") == "expert" -> 2,
      (metaStat(meta_stat = concat([$filterValue, "_proficiency"])) ?? "none") == "master" -> 3,
      (metaStat(meta_stat = concat([$filterValue, "_proficiency"])) ?? "none") == "legendary" -> 4,
      else -> 0,
    } < current_skill_increase_rank_cap_value,
  );

calc string temp_skill_increase_current_rank(name = "Temp skill increase current rank") =
  if isEmpty(temp_skill_increase_skill_effective)
    then "none"
    else (metaStat(meta_stat = concat([temp_skill_increase_skill_effective, "_proficiency"])) ?? "none");

calc integer temp_skill_increase_current_rank_value(name = "Temp skill increase current rank value") =
  when {
    temp_skill_increase_current_rank == "trained" -> 1,
    temp_skill_increase_current_rank == "expert" -> 2,
    temp_skill_increase_current_rank == "master" -> 3,
    temp_skill_increase_current_rank == "legendary" -> 4,
    else -> 0,
  };

calc string temp_skill_increase_next_rank(name = "Temp skill increase next rank") =
  when {
    temp_skill_increase_current_rank == "none" -> "trained",
    temp_skill_increase_current_rank == "trained" -> "expert",
    temp_skill_increase_current_rank == "expert" -> "master",
    temp_skill_increase_current_rank == "master" -> "legendary",
    else -> "",
  };

calc string temp_skill_increase_target_rank_auto(name = "Temp skill increase target rank auto") =
  if isEmpty(temp_skill_increase_skill_effective)
    then ""
    else if temp_skill_increase_current_rank_value >= current_skill_increase_rank_cap_value
      then ""
      else temp_skill_increase_next_rank;

calc string[] temp_skill_increase_target_rank_options(name = "Temp skill increase target rank options") =
  if isEmpty(temp_skill_increase_skill_effective)
    then []
    else if temp_skill_increase_current_rank_value >= current_skill_increase_rank_cap_value
      then []
      else if isEmpty(temp_skill_increase_next_rank)
        then []
        else [temp_skill_increase_next_rank];

calc integer temp_skill_increase_target_rank_value(name = "Temp skill increase target rank value") =
  when {
    temp_skill_increase_target_rank == "trained" -> 1,
    temp_skill_increase_target_rank == "expert" -> 2,
    temp_skill_increase_target_rank == "master" -> 3,
    temp_skill_increase_target_rank == "legendary" -> 4,
    else -> 0,
  };

calc bool is_temp_skill_increase_selection_valid(name = "Is temp skill increase selection valid") =
  !isEmpty(temp_skill_increase_skill_effective)
    && !isEmpty(temp_skill_increase_target_rank_auto)
    && pending_skill_increase_grants > 0
    && temp_skill_increase_target_rank_auto == temp_skill_increase_next_rank
    && temp_skill_increase_current_rank_value < current_skill_increase_rank_cap_value;

calc string temp_skill_increase_validation_message(name = "Temp skill increase validation message") =
  when {
    is_temp_skill_increase_selection_valid -> "",
    isEmpty(temp_skill_increase_skill_options) -> concat(
      [
        "No eligible skills can be increased at this level (cap: ",
        enumeratedName(
          enumerated_type = "skill_proficiency_types",
          id = current_skill_increase_rank_cap,
        ),
        ").",
      ],
    ),
    isEmpty(temp_skill_increase_skill_effective) -> "Choose a skill to increase.",
    pending_skill_increase_grants <= 0 -> "No pending skill increase grants.",
    temp_skill_increase_current_rank_value >= current_skill_increase_rank_cap_value -> concat(
      [
        "Selected skill is already at the current cap (",
        enumeratedName(
          enumerated_type = "skill_proficiency_types",
          id = current_skill_increase_rank_cap,
        ),
        ").",
      ],
    ),
    else -> "Invalid skill increase selection.",
  };

calc string temp_skill_increase_summary_text(name = "Temp skill increase summary text") =
  if isEmpty(temp_skill_increase_skill_effective)
    then concat(
        [
          "Select a skill to preview rank increase. Cap: ",
          enumeratedName(
            enumerated_type = "skill_proficiency_types",
            id = current_skill_increase_rank_cap,
          ),
          ".",
        ],
      )
    else concat(
        [
          "Current: ",
          enumeratedName(
            enumerated_type = "skill_proficiency_types",
            id = temp_skill_increase_current_rank,
          ),
          " -> ",
          (if isEmpty(temp_skill_increase_target_rank_auto)
            then "No increase available"
            else enumeratedName(
                enumerated_type = "skill_proficiency_types",
                id = temp_skill_increase_target_rank_auto,
              )),
          " | Cap: ",
          enumeratedName(
            enumerated_type = "skill_proficiency_types",
            id = current_skill_increase_rank_cap,
          ),
        ],
      );

calc resource<progression_grant>[] level_up_progression_grants_in_new_level(name = "Level up progression grants in new level") =
  flatAppend(
    [
      (last_level_up_class_progression?.progression_grants_gained_in_level ?? []),
      (if notNull(ancestry)
        then filter(
            ancestry.progression_grants,
            filter = ($grant) => ($grant.level == level),
          )
        else []),
      (if notNull(heritage)
        then filter(
            heritage.progression_grants,
            filter = ($grant) => ($grant.level == level),
          )
        else []),
      flatMap(
        archetypes,
        mapper = ($arch) => filter(
          $arch.progression_grants,
          filter = ($grant) => ($grant.level == level),
        ),
      ),
    ],
  );

calc resource<progression_grant>[] level_up_interactive_progression_grants_in_new_level(name = "Level up interactive progression grants in new level") =
  filter(
    level_up_progression_grants_in_new_level,
    filter = ($grant) => $grant.is_feat_slot,
  );

calc bool should_show_progression_summary_popup(name = "Should show progression summary popup") =
  !isEmpty(level_up_interactive_progression_grants_in_new_level);

calc string level_up_progression_grants_summary_text(name = "Level up progression grants summary text") =
  joinToString(
    map(
      level_up_progression_grants_in_new_level,
      mapper = ($grant) => $grant.display_description,
    ),
    separator = "\n",
  );

calc bool should_show_skill_increase(name = "Should show skill increase popup") =
  pending_skill_increase_grants > 0;

calc bool should_show_asi(name = "Should show ASI") =
  pending_ability_boost_grants > 0;

calc integer asi_selection_count_required(name = "ASI selection count required") =
  min([4, max([0, pending_ability_boost_grants])]);

calc bool should_show_asi_selection_2(name = "Should show ASI selection 2") =
  asi_selection_count_required >= 2;

calc bool should_show_asi_selection_3(name = "Should show ASI selection 3") =
  asi_selection_count_required >= 3;

calc bool should_show_asi_selection_4(name = "Should show ASI selection 4") =
  asi_selection_count_required >= 4;

calc string asi_selection_help_text(name = "ASI selection help text") =
  concat(["Choose ", asi_selection_count_required, " ability boosts."]);

base string temp_asi_selection_1(name = "Temp ASI selection") = null;

base string temp_asi_selection_2(name = "Temp ASI selection") = null;

base string temp_asi_selection_3(name = "Temp ASI selection") = null;

base string temp_asi_selection_4(name = "Temp ASI selection") = null;

base string temp_spell_cast_spell_id(name = "Temp spell cast spell ID") = "";

base integer temp_spell_cast_rank(name = "Temp spell cast rank") = 0;

calc integer temp_asi_selection_count(name = "Temp ASI selection count") =
  length(
    filter(
      [
        temp_asi_selection_1,
        temp_asi_selection_2,
        temp_asi_selection_3,
        temp_asi_selection_4,
      ],
      filter = ($filterValue) => $filterValue != null,
    ),
  );

calc integer temp_asi_unique_selection_count(name = "Temp ASI unique selection count") =
  length(
    flatAppend(
      [
        filter(
          [
            temp_asi_selection_1,
            temp_asi_selection_2,
            temp_asi_selection_3,
            temp_asi_selection_4,
          ],
          filter = ($filterValue) => $filterValue != null,
        ),
      ],
      treat_as_set = true,
    ),
  );

calc bool is_temp_asi_selection_valid(name = "Is temp ASI selection valid") =
  temp_asi_selection_count == asi_selection_count_required;

calc string temp_asi_validation_message(name = "Temp ASI validation message") =
  when {
    asi_selection_count_required <= 0 -> "No ability boosts are pending.",
    temp_asi_selection_count != asi_selection_count_required -> concat(
      [
        "Choose exactly ",
        asi_selection_count_required,
        " ability boosts.",
      ],
    ),
    else -> "Invalid ability boost selection.",
  };

calc resource<feat>[] features_with_new_descriptions_in_new_level(name = "Features with new descriptions in new level") =
  filter(
    flatAppend(
      [
        (ancestry?.traits_with_updates_in_current_level ?? []),
        flatMap(
          filter(
            classes,
            filter = ($filterValue) => (last_level_up_class_progression?.class?.id == $filterValue.class?.id),
          ),
          mapper = ($mapValue) => ($mapValue.class?.features_with_updates_in_current_level ?? []),
        ),
        (background?.features_with_updates_in_current_level ?? []),
      ],
    ),
    filter = ($filterValue) => (!isEmpty($filterValue.current_level_levelled_description?.description ?? "")),
  );

base bool currently_levelling_up(name = "Currently levelling up") = false;

calc resource<feat>[] selectable_features_with_new_amounts_in_new_level(name = "Selectable features with new amounts in the new level") =
  filter(
    flatAppend(
        [
          (ancestry?.current_level_traits ?? []),
          (last_level_up_class_progression?.class.current_level_features ?? []),
          (background?.current_level_features ?? []),
        ],
      ),
    filter = ($filterValue) => $filterValue.can_choose_new_selectable_features_in_current_level
      && $filterValue.has_selectable_features
      && $filterValue.current_allowed_amount_of_selectable_features > 0
      && !isEmpty($filterValue.available_selectable_features_for_current_level),
  );

base string hair_color(name = "Hair color") = "";

base string eye_color(name = "Eye color") = "";

base string outfit(name = "Outfit") = "";

base string appearance_weapon(name = "Appearance weapon") = "";

base string sex(name = "Sex") = "";

calc string photo_prompt(name = "Photo prompt") =
  joinToString(
    flatAppend(
      [
        (if (ancestry?.actual_hair_color_selectable ?? false)
          then [concat(["(", hair_color, ":1.6)"])]
          else []),
        (if (ancestry?.actual_eye_color_selectable ?? false)
          then [concat(["(", eye_color, ":1.3)"])]
          else []),
        (if (ancestry?.actual_outfit_selectable ?? false) then [concat(["(", outfit, ":1.3)"])] else []),
        (if (ancestry?.actual_appearance_weapon_selectable ?? false)
          then [concat(["(", appearance_weapon, ":1.6)"])]
          else []),
        (if (ancestry?.actual_sex_selectable ?? false) then [concat(["(", sex, ":1.3)"])] else []),
        map(
          (ancestry?.actual_visual_traits ?? []),
          mapper = ($mapValue) => concat(
            [
              "(",
              $mapValue.selected_option,
              ":1.",
              $mapValue.importance,
              ")",
            ],
          ),
        ),
      ],
    ),
    separator = ",",
  );

calc resource<armor>[] invested_armors(name = "Invested armors") =
  filter(
    armors,
    filter = ($filterValue) => (
      defined(stat = "$filterValue.requires_investment")
        && defined(stat = "$filterValue.is_invested")
        && $filterValue.requires_investment
        && $filterValue.is_invested
    ),
  );

calc resource<weapon>[] invested_weapons(name = "Invested weapons") = [];

calc resource<item>[] invested_items(name = "Invested items") =
  filter(
    equipment,
    filter = ($filterValue) => (
      defined(stat = "$filterValue.requires_investment")
        && defined(stat = "$filterValue.is_invested")
        && $filterValue.requires_investment
        && $filterValue.is_invested
    ),
  );

calc resource<armor | weapon | item>[] invested_resources(name = "Invested resources") =
  flatAppend([invested_armors, invested_weapons, invested_items]);

calc string invested_resources_count_message(name = "Invested resources count message") =
  concat(["Invested items: ", length(invested_resources), " / 10"]);

base bool selecting(name = "Player is selecting things for this character") =
  false;

base bool creation_feats_page_open(name = "Character creation Feats & Archetypes page is open") =
  false;

calc bool should_show_controls_for_choices(name = "Should show controls for choices (for ancestry, background, etc choices like equipments or proficiencies)") =
  selecting || currently_levelling_up;

calc resource<feat>[] all_features(name = "All features") =
  flatAppend(
    [
      flatMap(
        classes,
        mapper = ($class) => ($class.class?.all_features ?? []),
      ),
      all_feats,
      ancestry_traits,
      background_features,
    ],
  );

calc resource<feat>[] daily_preparations_reselectable_features(name = "Features that require selectable-feature refresh on daily preparations") =
  filter(
    all_features,
    filter = ($feature) => ($feature.has_selectable_features
      && $feature.refresh_selectable_features_on_daily_preparations
      && $feature.current_allowed_amount_of_selectable_features > 0
      && !isEmpty($feature.available_selectable_features_for_current_level)),
  );

calc integer daily_preparations_reselectable_features_count(name = "Count of features that require selectable-feature refresh on daily preparations") =
  length(daily_preparations_reselectable_features);

calc string[] daily_preparations_reselectable_option_ids(name = "Selectable feature option IDs to clear on daily preparations") =
  flatAppend(
    map(
      daily_preparations_reselectable_features,
      mapper = ($feature) => $feature.selectable_feature_ids,
    ),
    treat_as_set = true,
  );

calc resource<feat>[] daily_preparations_pending_reselectable_features(name = "Features pending selectable-feature re-selection for daily preparations") =
  filter(
    daily_preparations_reselectable_features,
    filter = ($feature) => (length($feature.chosen_selectable_features)
      < $feature.current_allowed_amount_of_selectable_features),
  );

calc integer daily_preparations_pending_reselectable_features_count(name = "Count of features pending selectable-feature re-selection for daily preparations") =
  length(daily_preparations_pending_reselectable_features);

calc resource<feat> next_daily_preparations_pending_reselectable_feature(name = "Next feature pending selectable-feature re-selection for daily preparations") =
  findFirst(
    sortBy(
      daily_preparations_pending_reselectable_features,
      sort_by_selector = ($sortByValue) => $sortByValue.name,
    ),
    filter = ($findFirstValue) => true,
  );

base bool daily_preparations_reselection_in_progress(name = "Daily preparations selectable-feature re-selection in progress") =
  false;

calc bool has_jack_of_all_trades(name = "Has jack of all trades") =
  or(
    map(
      all_features,
      mapper = ($mapValue) => (toLowerCase($mapValue.name) == "jack of all trades"),
    ),
  );

base bool is_new_and_should_daily_preparations(name = "Is new and should run daily preparations?") =
  true;

base resource<companion>[] companions(name = "Companions") = [];

calc string companion_section_title(name = "Companion section title") =
  if contains(
    haystack = map(classes, mapper = ($mapValue) => toLowerCase(trim($mapValue.class?.name ?? ""))),
    needle = "druid",
  )
    then "Wild shape"
    else "Companions / familiars";

calc integer class_fortitude_proficiency_rank(name = "Class fortitude proficiency rank") =
  if isEmpty(classes)
    then 0
    else max(
        map(
          classes,
          mapper = ($class) =>
            when {
              $class.class.current_level_fortitude_proficiency == "trained" -> 1,
              $class.class.current_level_fortitude_proficiency == "expert" -> 2,
              $class.class.current_level_fortitude_proficiency == "master" -> 3,
              $class.class.current_level_fortitude_proficiency == "legendary" -> 4,
              else -> 0,
            },
        ),
      );

calc integer class_reflex_proficiency_rank(name = "Class reflex proficiency rank") =
  if isEmpty(classes)
    then 0
    else max(
        map(
          classes,
          mapper = ($class) =>
            when {
              $class.class.current_level_reflex_proficiency == "trained" -> 1,
              $class.class.current_level_reflex_proficiency == "expert" -> 2,
              $class.class.current_level_reflex_proficiency == "master" -> 3,
              $class.class.current_level_reflex_proficiency == "legendary" -> 4,
              else -> 0,
            },
        ),
      );

calc integer class_will_proficiency_rank(name = "Class will proficiency rank") =
  if isEmpty(classes)
    then 0
    else max(
        map(
          classes,
          mapper = ($class) =>
            when {
              $class.class.current_level_will_proficiency == "trained" -> 1,
              $class.class.current_level_will_proficiency == "expert" -> 2,
              $class.class.current_level_will_proficiency == "master" -> 3,
              $class.class.current_level_will_proficiency == "legendary" -> 4,
              else -> 0,
            },
        ),
      );

calc string fortitude_proficiency_override(name = "Fortitude proficiency override") =
  when {
    class_fortitude_proficiency_rank == 4 -> "legendary",
    class_fortitude_proficiency_rank == 3 -> "master",
    class_fortitude_proficiency_rank == 2 -> "expert",
    class_fortitude_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

calc string reflex_proficiency_override(name = "Reflex proficiency override") =
  when {
    class_reflex_proficiency_rank == 4 -> "legendary",
    class_reflex_proficiency_rank == 3 -> "master",
    class_reflex_proficiency_rank == 2 -> "expert",
    class_reflex_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

calc string will_proficiency_override(name = "Will proficiency override") =
  when {
    class_will_proficiency_rank == 4 -> "legendary",
    class_will_proficiency_rank == 3 -> "master",
    class_will_proficiency_rank == 2 -> "expert",
    class_will_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

calc integer fortitude_proficiency_rank(name = "Fortitude proficiency rank") =
  if isEmpty(fortitude_proficiency_override)
    then class_fortitude_proficiency_rank
    else when {
        fortitude_proficiency_override == "trained" -> 1,
        fortitude_proficiency_override == "expert" -> 2,
        fortitude_proficiency_override == "master" -> 3,
        fortitude_proficiency_override == "legendary" -> 4,
        else -> 0,
      };

calc integer reflex_proficiency_rank(name = "Reflex proficiency rank") =
  if isEmpty(reflex_proficiency_override)
    then class_reflex_proficiency_rank
    else when {
        reflex_proficiency_override == "trained" -> 1,
        reflex_proficiency_override == "expert" -> 2,
        reflex_proficiency_override == "master" -> 3,
        reflex_proficiency_override == "legendary" -> 4,
        else -> 0,
      };

calc integer will_proficiency_rank(name = "Will proficiency rank") =
  if isEmpty(will_proficiency_override)
    then class_will_proficiency_rank
    else when {
        will_proficiency_override == "trained" -> 1,
        will_proficiency_override == "expert" -> 2,
        will_proficiency_override == "master" -> 3,
        will_proficiency_override == "legendary" -> 4,
        else -> 0,
      };

calc string fortitude_proficiency(name = "Fortitude proficiency") =
  when {
    fortitude_proficiency_rank == 4 -> "legendary",
    fortitude_proficiency_rank == 3 -> "master",
    fortitude_proficiency_rank == 2 -> "expert",
    fortitude_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

calc string reflex_proficiency(name = "Reflex proficiency") =
  when {
    reflex_proficiency_rank == 4 -> "legendary",
    reflex_proficiency_rank == 3 -> "master",
    reflex_proficiency_rank == 2 -> "expert",
    reflex_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

calc string will_proficiency(name = "Will proficiency") =
  when {
    will_proficiency_rank == 4 -> "legendary",
    will_proficiency_rank == 3 -> "master",
    will_proficiency_rank == 2 -> "expert",
    will_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

calc integer fortitude_proficiency_bonus(name = "Fortitude proficiency bonus") =
  when {
    fortitude_proficiency == "trained" -> level_bonus + 2,
    fortitude_proficiency == "expert" -> level_bonus + 4,
    fortitude_proficiency == "master" -> level_bonus + 6,
    fortitude_proficiency == "legendary" -> level_bonus + 8,
    else -> 0,
  };

calc integer reflex_proficiency_bonus(name = "Reflex proficiency bonus") =
  when {
    reflex_proficiency == "trained" -> level_bonus + 2,
    reflex_proficiency == "expert" -> level_bonus + 4,
    reflex_proficiency == "master" -> level_bonus + 6,
    reflex_proficiency == "legendary" -> level_bonus + 8,
    else -> 0,
  };

calc integer will_proficiency_bonus(name = "Will proficiency bonus") =
  when {
    will_proficiency == "trained" -> level_bonus + 2,
    will_proficiency == "expert" -> level_bonus + 4,
    will_proficiency == "master" -> level_bonus + 6,
    will_proficiency == "legendary" -> level_bonus + 8,
    else -> 0,
  };

calc integer fortitude(name = "Fortitude") =
  constitution_modifier + fortitude_proficiency_bonus + (equipped_armor?.total_rune_save_bonus ?? 0) + fortitude_typed_modifier_total;

calc integer reflex(name = "Reflex") =
  dexterity_modifier + reflex_proficiency_bonus + (equipped_armor?.total_rune_save_bonus ?? 0) + reflex_typed_modifier_total;

calc integer will(name = "Will") =
  wisdom_modifier + will_proficiency_bonus + (equipped_armor?.total_rune_save_bonus ?? 0) + will_typed_modifier_total;

calc resource<class_progression> primary_class_progression(name = "Primary class progression") =
  findFirst(classes, filter = ($findFirstValue) => true);

calc string class_dc_proficiency(name = "Class DC proficiency") =
  primary_class_progression?.class.current_level_class_dc_proficiency ?? "none";

calc string class_key_ability(name = "Class key ability") =
  primary_class_progression?.class.actual_class_key_ability ?? "strength";

calc integer class_key_ability_modifier(name = "Class key ability modifier") =
  metaStat(meta_stat = concat([class_key_ability, "_modifier"]));

calc integer class_dc_proficiency_bonus(name = "Class DC proficiency bonus") =
  when {
    class_dc_proficiency == "trained" -> level_bonus + 2,
    class_dc_proficiency == "expert" -> level_bonus + 4,
    class_dc_proficiency == "master" -> level_bonus + 6,
    class_dc_proficiency == "legendary" -> level_bonus + 8,
    else -> 0,
  };

@party_visible
calc integer class_dc(name = "Class DC") =
  10 + class_key_ability_modifier + class_dc_proficiency_bonus + class_dc_typed_modifier_total;

base integer max_actions_per_turn(name = "Max Actions Per Turn") = 3;

@party_visible
base integer actions_remaining(name = "Actions Remaining") = 3;

base integer max_reactions_per_round(name = "Max Reactions Per Round") = 1;

@party_visible
base integer reaction_available(name = "Reaction Available") = 1;

calc string actions_remaining_display(name = "Actions remaining display") =
  concat([actions_remaining, " / ", max_actions_per_turn]);

calc string reaction_available_display(name = "Reaction availability display") =
  if reaction_available > 0 then "Available" else "Spent";

base integer hero_points(name = "Hero Points") = 1;

base integer max_hero_points(name = "Max Hero Points") = 3;

base integer focus_points(name = "Focus Points") = 0;

base integer max_focus_points(name = "Max Focus Points") = 0;

calc integer focus_points_from_class_capacity_grants(name = "Focus points from class capacity grants") =
  add(
    map(
      flatMap(
        classes,
        mapper = ($classProgression) => filter(
          $classProgression.active_spell_capacity_grants,
          filter = ($grant) => ($grant.capacity_type == "focus"),
        ),
      ),
      mapper = ($grant) => $grant.current_quantity,
    ),
  );

calc integer focus_points_from_archetype_capacity_grants(name = "Focus points from archetype capacity grants") =
  add(
    map(
      flatMap(
        spellcasting_archetypes,
        mapper = ($archetype) => filter(
          $archetype.active_spell_capacity_grants,
          filter = ($grant) => ($grant.capacity_type == "focus"),
        ),
      ),
      mapper = ($grant) => $grant.current_quantity,
    ),
  );

calc integer effective_max_focus_points(name = "Effective max focus points") =
  max_focus_points + focus_points_from_class_capacity_grants + focus_points_from_archetype_capacity_grants;

calc integer hero_points_pip_slots(name = "Hero points pip slots") =
  max([max_hero_points, hero_points]);

calc integer focus_points_pip_slots(name = "Focus points pip slots") =
  max([effective_max_focus_points, focus_points]);

calc string hero_points_pips(name = "Hero points pips") =
  concat(
    [
      (if hero_points_pip_slots >= 1 then (if hero_points >= 1 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 2 then (if hero_points >= 2 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 3 then (if hero_points >= 3 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 4 then (if hero_points >= 4 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 5 then (if hero_points >= 5 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 6 then (if hero_points >= 6 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 7 then (if hero_points >= 7 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 8 then (if hero_points >= 8 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 9 then (if hero_points >= 9 then "●" else "○") else ""),
      (if hero_points_pip_slots >= 10 then (if hero_points >= 10 then "●" else "○") else ""),
      (if hero_points_pip_slots > 10 then concat([" +", hero_points_pip_slots - 10]) else ""),
    ],
  );

calc string focus_points_pips(name = "Focus points pips") =
  concat(
    [
      (if focus_points_pip_slots >= 1 then (if focus_points >= 1 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 2 then (if focus_points >= 2 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 3 then (if focus_points >= 3 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 4 then (if focus_points >= 4 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 5 then (if focus_points >= 5 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 6 then (if focus_points >= 6 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 7 then (if focus_points >= 7 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 8 then (if focus_points >= 8 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 9 then (if focus_points >= 9 then "●" else "○") else ""),
      (if focus_points_pip_slots >= 10 then (if focus_points >= 10 then "●" else "○") else ""),
      (if focus_points_pip_slots > 10 then concat([" +", focus_points_pip_slots - 10]) else ""),
    ],
  );

base integer dying(name = "Dying") = 0;

base integer wounded(name = "Wounded") = 0;

base integer doomed(name = "Doomed") = 0;

base integer recovery_check_bonus(name = "Recovery Check Bonus") = 0;

calc bool is_dead(name = "Is Dead") = dying >= (4 - min([doomed, 3]));

base integer frightened_value(name = "Frightened") = 0;

base integer sickened_value(name = "Sickened") = 0;

base integer clumsy_value(name = "Clumsy") = 0;

base integer enfeebled_value(name = "Enfeebled") = 0;

base integer stupefied_value(name = "Stupefied") = 0;

base integer drained_value(name = "Drained") = 0;

base integer slowed_value(name = "Slowed") = 0;

base integer stunned_value(name = "Stunned Value") = 0;

base integer archetype_slot_target_rank(name = "Archetype slot target rank") = 0;
