calc integer strike_attack_typed_modifier_total(name = "Strike attack typed modifier total") =
  strike_attack_untyped_modifier + strike_attack_status_bonus + strike_attack_status_penalty + strike_attack_circumstance_bonus + strike_attack_circumstance_penalty + strike_attack_item_bonus + strike_attack_item_penalty;

base integer strike_damage_untyped_modifier(name = "Strike damage untyped modifier") = 0;
base integer strike_damage_status_bonus(name = "Strike damage status bonus") = 0;
base integer strike_damage_status_penalty(name = "Strike damage status penalty") = 0;
base integer strike_damage_circumstance_bonus(name = "Strike damage circumstance bonus") = 0;
base integer strike_damage_circumstance_penalty(name = "Strike damage circumstance penalty") = 0;
base integer strike_damage_item_bonus(name = "Strike damage item bonus") = 0;
base integer strike_damage_item_penalty(name = "Strike damage item penalty") = 0;
calc integer strike_damage_typed_modifier_total(name = "Strike damage typed modifier total") =
  strike_damage_untyped_modifier + strike_damage_status_bonus + strike_damage_status_penalty + strike_damage_circumstance_bonus + strike_damage_circumstance_penalty + strike_damage_item_bonus + strike_damage_item_penalty;

base string acrobatics_proficiency(name = "Acrobatics proficiency (none, trained, expert, master, legendary)") =
  "none";

calc integer acrobatics(name = "Acrobatics") =
  dexterity_modifier + when {
    acrobatics_proficiency == "trained" -> level_bonus + 2,
    acrobatics_proficiency == "expert" -> level_bonus + 4,
    acrobatics_proficiency == "master" -> level_bonus + 6,
    acrobatics_proficiency == "legendary" -> level_bonus + 8,
    else -> 0,
  } + armor_check_penalty
  + acrobatics_typed_modifier_total;

calc string acrobatics_formatted(name = "Acrobatics formatted") =
  if acrobatics > 0 then concat(["+", acrobatics]) else concat([acrobatics]);

calc string acrobatics_color(name = "Acrobatics number color") =
  if acrobatics_proficiency == "trained" || acrobatics_proficiency == "expert"
    then "accent"
    else "text";

calc string acrobatics_label_color(name = "Acrobatics label color") =
  if acrobatics_proficiency == "expert" || acrobatics_proficiency == "master" || acrobatics_proficiency == "legendary" then "accent" else "hint";

