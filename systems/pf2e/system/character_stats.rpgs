import "macros/system_common.rpgs";

calc string created_at_display(name = "Created at display") =
  if isNull(created_at)
    then ""
    else concat(["Created ", date(created_at)]);

@party_visible
base photo photo(name = "Photo") = null;

@party_visible
base string name(name = "Name") = "";

base string alignment(name = "Alignment") = "true_neutral";

base string personality_traits(name = "Personality traits") = "";

base string ideals(name = "Ideals") = "";

base string bonds(name = "Bonds") = "";

base string flaws(name = "Flaws") = "";

base string about(name = "About") = "";

base resource<note>[] notes(name = "Notes") = [];

base integer base_hp(name = "Base HP") = 1;

@party_visible
base integer current_hp(name = "Current HP") = 1;

@party_visible
calc integer max_hp(name = "Maximum HP") = base_hp + classes_hp_mods;

calc integer classes_hp_mods(name = "Classes HP mods") =
  add(
    map(
      classes,
      mapper = ($class) => ($class.class_level * (
        ($class.class.actual_class_hp_per_level ?? 0) + add(
          map(
            $class.class.actual_hp_modifiers,
            mapper = ($mapValue) => metaStat(meta_stat = concat([$mapValue, "_modifier"])),
          ),
        )
      )),
    ),
  );

calc string description(name = "Description") =
  concat(
    [
      (if notNull(ancestry) then (heritage?.name ?? ancestry.name) else ""),
      (if isEmpty(classes)
        then ""
        else concat(
            [
              " ",
              joinToString(
                map(
                  classes,
                  mapper = ($class) => concat([$class.class.name, " ", $class.class_level]),
                ),
                separator = " / ",
              ),
            ],
          )),
    ],
  );

base resource<class_progression>[] classes(name = "Classes") = [];

base resource<background> background(name = "Background") = null;

base resource<ancestry> ancestry(name = "Ancestry") = null;

base resource<heritage> heritage(name = "Heritage") = null;

calc resource<feat>[] racial_traits(name = "Ancestry traits") =
  sortBy(
    filter(
      flatAppend([(ancestry?.traits ?? []), (heritage?.traits ?? [])]),
      filter = ($filterValue) => ($filterValue.min_level <= level),
    ),
    order = "asc",
    sort_by_selector = ($sortByValue) => $sortByValue.min_level,
  );

base string[] advantages(name = "Advantages") = [];

base string[] disadvantages(name = "Disadvantages") = [];

calc bool is_not_wearing_inproficient_armor(name = "Character is not currently wearing a piece of armor its not proficient with") =
  isNull(equipped_armor) || equipped_armor?.is_proficient? ?? true;

calc string[] armor_disadvantages(name = "Armor disadvantages") =
  if is_not_wearing_inproficient_armor
    then []
    else [
        "strength_modifier",
        "dexterity_modifier",
        "reflex",
        "athletics",
        "acrobatics",
        "thievery",
        "stealth",
      ];

calc integer armor_check_penalty(name = "Armor check penalty") =
  equipped_armor?.check_penalty ?? 0;

calc string[] all_disadvantages(name = "Disadvantages") =
  flatAppend(
    [
      disadvantages,
      armor_disadvantages,
    ],
    treat_as_set = true,
  );

base string[] language_proficiencies(name = "Language proficiencies") = [];

base string[] armor_proficiencies(name = "Armor proficiencies") = [];

base string[] weapon_proficiencies(name = "Weapon proficiencies") = [];


base resource<lore_skill>[] lore_skills(name = "Lore skills") = [];

base string spellcasting_proficiency(name = "Global spellcasting proficiency (none, trained, expert, master, legendary)") =
  "none";

base string arcane_spellcasting_proficiency(name = "Arcane spellcasting proficiency (none, trained, expert, master, legendary)") =
  "none";

base string divine_spellcasting_proficiency(name = "Divine spellcasting proficiency (none, trained, expert, master, legendary)") =
  "none";

base string occult_spellcasting_proficiency(name = "Occult spellcasting proficiency (none, trained, expert, master, legendary)") =
  "none";

base string primal_spellcasting_proficiency(name = "Primal spellcasting proficiency (none, trained, expert, master, legendary)") =
  "none";

calc resource<lore_skill>[] granted_lore_skills(name = "Granted lore skills") =
  flatAppend(
    [
      (ancestry?.lore_skills_for_current_level ?? []),
      (background?.lore_skills_for_current_level ?? []),
      flatMap(
        classes,
        mapper = ($class) => ($class.class?.lore_skills_for_current_level ?? []),
      ),
      flatMap(
        all_features,
        mapper = ($feature) => ($feature.lore_skills_for_current_level ?? []),
      ),
    ],
  );

calc resource<lore_skill>[] all_lore_skills(name = "All lore skills") =
  map(
    flatAppend(
      [
        map(
          filter(
            flatAppend(
              [
                granted_lore_skills,
                lore_skills,
              ],
            ),
            filter = ($filterValue) => !isEmpty($filterValue.lore_name),
          ),
          mapper = ($mapValue) => $mapValue.lore_name,
        ),
      ],
      treat_as_set = true,
    ),
    mapper = ($mapValue) =>
      findFirst(
        flatAppend(
          [
            granted_lore_skills,
            lore_skills,
          ],
        ),
        filter = ($findFirstValue) => $findFirstValue.lore_name == $mapValue,
      ),
  );

calc string[] lore_skill_names(name = "Lore skill names") =
  map(
    filter(
      all_lore_skills,
      filter = ($filterValue) => !isEmpty($filterValue.lore_name),
    ),
    mapper = ($mapValue) => $mapValue.lore_name,
  );
base integer acrobatics_untyped_modifier(name = "Acrobatics untyped modifier") = 0;
base integer acrobatics_status_bonus(name = "Acrobatics status bonus") = 0;
base integer acrobatics_status_penalty(name = "Acrobatics status penalty") = 0;
base integer acrobatics_circumstance_bonus(name = "Acrobatics circumstance bonus") = 0;
base integer acrobatics_circumstance_penalty(name = "Acrobatics circumstance penalty") = 0;
base integer acrobatics_item_bonus(name = "Acrobatics item bonus") = 0;
base integer acrobatics_item_penalty(name = "Acrobatics item penalty") = 0;
calc integer acrobatics_typed_modifier_total(name = "Acrobatics typed modifier total") =
  acrobatics_untyped_modifier + acrobatics_status_bonus + acrobatics_status_penalty + acrobatics_circumstance_bonus + acrobatics_circumstance_penalty + acrobatics_item_bonus + acrobatics_item_penalty;

