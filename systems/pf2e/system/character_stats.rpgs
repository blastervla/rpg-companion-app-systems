calc integer perception_class_proficiency_rank(name = "Perception class proficiency rank") =
  if isEmpty(classes)
    then 0
    else max(
        map(
          classes,
          mapper = ($class) =>
            when {
              $class.class.current_level_perception_proficiency == "trained" -> 1,
              $class.class.current_level_perception_proficiency == "expert" -> 2,
              $class.class.current_level_perception_proficiency == "master" -> 3,
              $class.class.current_level_perception_proficiency == "legendary" -> 4,
              else -> 0,
            },
        ),
      );

calc string perception_proficiency(name = "Perception proficiency (none, trained, expert, master, legendary)") =
  when {
    perception_class_proficiency_rank == 4 -> "legendary",
    perception_class_proficiency_rank == 3 -> "master",
    perception_class_proficiency_rank == 2 -> "expert",
    perception_class_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

calc integer perception_manual_proficiency_rank(name = "Perception manual proficiency rank") =
  when {
    perception_proficiency == "trained" -> 1,
    perception_proficiency == "expert" -> 2,
    perception_proficiency == "master" -> 3,
    perception_proficiency == "legendary" -> 4,
    else -> 0,
  };

calc integer effective_perception_proficiency_rank(name = "Effective perception proficiency rank") =
  max(
    [
      perception_manual_proficiency_rank,
      perception_class_proficiency_rank,
    ],
  );

calc string effective_perception_proficiency(name = "Effective perception proficiency") =
  when {
    effective_perception_proficiency_rank == 4 -> "legendary",
    effective_perception_proficiency_rank == 3 -> "master",
    effective_perception_proficiency_rank == 2 -> "expert",
    effective_perception_proficiency_rank == 1 -> "trained",
    else -> "none",
  };

@party_visible
calc integer perception(name = "Perception") =
  wisdom_modifier + when {
    effective_perception_proficiency == "trained" -> level_bonus + 2,
    effective_perception_proficiency == "expert" -> level_bonus + 4,
    effective_perception_proficiency == "master" -> level_bonus + 6,
    effective_perception_proficiency == "legendary" -> level_bonus + 8,
    else -> 0,
