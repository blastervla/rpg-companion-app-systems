base bool sort_skills_by_name(name = "Should sort skills by name") = true;

base string equipped_armor_id(name = "Equipped armor ID") = "";

base string equipped_shield_id(name = "Equipped shield ID") = "";

@party_visible
calc integer speed(name = "Speed") =
  (ancestry?.current_speed ?? 0) + worn_armor_speed_modifier;

@party_visible
calc integer burrow_speed(name = "Burrow speed") =
  (ancestry?.current_burrow_speed ?? 0) + worn_armor_speed_modifier;

@party_visible
calc integer climb_speed(name = "Climb speed") =
  (ancestry?.current_climb_speed ?? 0) + worn_armor_speed_modifier;

@party_visible
calc integer fly_speed(name = "Fly speed") =
  (ancestry?.current_fly_speed ?? 0) + worn_armor_speed_modifier;

@party_visible
calc integer swim_speed(name = "Swim speed") =
  (ancestry?.current_swim_speed ?? 0) + worn_armor_speed_modifier;

calc integer worn_armor_speed_modifier(name = "Worn armor speed modifier (penalty)") =
  if equipped_armor != null
    then (if strength_score >= equipped_armor.required_strength
        then 0
        else (equipped_armor.speed_penalty * -1))
    else 0;

calc integer level(name = "Level", abbreviation = "Lvl.") =
  add(map(classes, mapper = ($class) => $class.class_level));

calc string[] level_singleton(name = "Level as singleton array") = ["" + level];

@party_visible
calc integer armor_class(name = "Armor Class", abbreviation = "AC") =
  (if wearing_body_armor then equipped_armor_ac else unarmored_ac) + shield_ac_bonus + armor_class_typed_modifier_total;

calc integer shield_ac_bonus(name = "Shield AC bonus") =
  if contains(
    haystack = map(armors, mapper = ($mapValue) => $mapValue.id),
    needle = equipped_shield_id,
  )
    then (if equipped_shield?.is_proficient? ?? false
        then (equipped_shield?.base_ac? ?? 0) + (equipped_shield?.total_rune_ac_bonus? ?? 0)
        else 0)
    else 0;

calc bool wearing_body_armor(name = "Wearing body armor") =
  if notNull(equipped_armor)
    then contains(
        haystack = map(armors, mapper = ($mapValue) => $mapValue.id),
        needle = equipped_armor_id,
      ) && equipped_armor.type != "shield"
    else false;

calc integer unarmored_ac(name = "Unarmored AC") =
  10 + dexterity_modifier + unarmored_proficiency_bonus + legacy_unarmored_ac_adjustment;

calc integer unarmored_proficiency_bonus(name = "Unarmored proficiency bonus") =
  max(
    [
      unarmored_proficiency_bonus_from_rows,
      legacy_unarmored_proficiency_bonus,
    ],
  );

calc integer unarmored_proficiency_bonus_from_rows(name = "Unarmored proficiency bonus from rows") =
  if isEmpty(unarmored_proficiency_rows)
    then 0
    else max(
        map(
          unarmored_proficiency_rows,
          mapper = ($mapValue) => when {
            $mapValue.proficiency == "trained" -> level_bonus + 2,
            $mapValue.proficiency == "expert" -> level_bonus + 4,
            $mapValue.proficiency == "master" -> level_bonus + 6,
            $mapValue.proficiency == "legendary" -> level_bonus + 8,
            else -> 0,
          },
        ),
      );

calc integer legacy_unarmored_proficiency_bonus(name = "Legacy unarmored proficiency bonus") =
  if contains(haystack = armor_proficiencies, needle = "unarmored")
    then level_bonus + 2
    else 0;

calc resource<levelled_armor_proficiency>[] unarmored_proficiency_rows(name = "Unarmored proficiency rows") =
  flatAppend(
    [
      filter(
        flatMap(
          classes,
          mapper = ($class) => $class.class.armor_proficiencies_for_current_level,
        ),
        filter = ($filterValue) => contains(
          haystack = $filterValue.resolved_options,
          needle = "unarmored",
        ),
      ),
      filter(
        ancestry?.armor_proficiencies_for_current_level ?? [],
        filter = ($filterValue) => contains(
          haystack = $filterValue.resolved_options,
          needle = "unarmored",
        ),
      ),
    ],
  );

calc integer ancestry_ac(name = "Ancestry AC") =
  if isNull(ancestry)
    then 0
    else ancestry.actual_base_ac + add(
        map(
          ancestry.actual_ac_modifiers,
          mapper = ($mapValue) => metaStat(meta_stat = concat([$mapValue, "_modifier"])),
        ),
      );

calc integer classes_ac(name = "Classes AC") =
  if isEmpty(classes)
    then 0
    else max(
        map(
          classes,
          mapper = ($class) => ($class.class.actual_base_ac + add(
            map(
              $class.class.actual_ac_modifiers,
              mapper = ($mapValue) => metaStat(meta_stat = concat([$mapValue, "_modifier"])),
            ),
          )),
        ),
      );

calc integer legacy_unarmored_ac_adjustment(name = "Legacy unarmored AC adjustment") =
  max(
    [
      0,
      ancestry_ac - (10 + dexterity_modifier),
      classes_ac - (10 + dexterity_modifier),
    ],
  );

calc integer equipped_armor_ac(name = "Equipped armor AC") =
  if wearing_body_armor
    then 10 + (equipped_armor.armor_proficiency_bonus ?? 0) + (equipped_armor.base_ac + (equipped_armor.total_rune_ac_bonus ?? 0)) + min(
        [
          (if "none" != equipped_armor.modifier
            then metaStat(meta_stat = concat([equipped_armor.modifier, "_modifier"]))
            else 0),
          (if equipped_armor.has_max_bonus then equipped_armor.max_bonus else 10000),
        ],
      )
    else 0;

calc resource<armor> equipped_armor(name = "Equipped armor") =
  findFirst(
    armors,
    filter = ($findFirstValue) => ($findFirstValue.id == equipped_armor_id),
  );

calc resource<armor> equipped_shield(name = "Equipped shield") =
  findFirst(
    armors,
    filter = ($findFirstValue) => ($findFirstValue.id == equipped_shield_id),
  );

calc integer perception_dc(name = "Perception DC", abbreviation = "PDC") =
  10 + perception + perception_dc_typed_modifier_total;

base string initiative_stat(name = "Initiative source stat override") = "";

calc string default_initiative_stat(name = "Default initiative source stat") =
  if stealth > perception then "stealth" else "perception";

calc string effective_initiative_stat(name = "Effective initiative source stat") =
  if isEmpty(initiative_stat) then default_initiative_stat else initiative_stat;

calc string initiative_stat_display(name = "Initiative source stat display") =
  enumeratedName(
    enumerated_type = "initiative_sources",
    id = effective_initiative_stat,
  );

calc integer initiative(name = "Initiative", abbreviation = "Ini.") =
  when {
    effective_initiative_stat == "perception" -> perception,
    else -> metaStat(meta_stat = effective_initiative_stat),
  }
  + initiative_typed_modifier_total;

calc integer level_bonus(name = "Level Bonus", abbreviation = "LVL") =
  level;

calc string display_level_bonus(name = "Display level bonus") =
  signedDisplay(value = level_bonus);

base integer strength_score(name = "Strength", abbreviation = "STR") = 8;

base integer dexterity_score(name = "Dexterity", abbreviation = "DEX") = 8;

base integer constitution_score(name = "Constitution", abbreviation = "CON") =
  8;

base integer intelligence_score(name = "Intelligence", abbreviation = "INT") =
  8;

base integer wisdom_score(name = "Wisdom", abbreviation = "WIS") = 8;

base integer charisma_score(name = "Charisma", abbreviation = "CHA") = 8;

calc integer strength_modifier(name = "Strength", abbreviation = "STR") =
  abilityModifier(score = strength_score);

calc integer dexterity_modifier(name = "Dexterity", abbreviation = "DEX") =
  abilityModifier(score = dexterity_score);

calc integer constitution_modifier(name = "Constitution", abbreviation = "CON") =
  abilityModifier(score = constitution_score);

calc integer intelligence_modifier(name = "Intelligence", abbreviation = "INT") =
  abilityModifier(score = intelligence_score);

calc integer wisdom_modifier(name = "Wisdom", abbreviation = "WIS") =
  abilityModifier(score = wisdom_score);

calc integer charisma_modifier(name = "Charisma", abbreviation = "CHA") =
  abilityModifier(score = charisma_score);

calc string[] creator_step_2_assigned_ability_boosts(name = "Creator step 2 assigned ability boosts") =
  flatMap(
    filter(
      all_interactive_progression_grants_for_current_level,
      filter = ($grant) => $grant.bucket == "ability_boost",
    ),
    mapper = ($grant) => $grant.assigned_ability_boosts_effective,
  );

calc string[] creator_step_2_level_1_assigned_ability_boosts(name = "Creator step 2 level-1 assigned ability boosts") =
  flatMap(
    filter(
      all_interactive_progression_grants_for_current_level,
      filter = ($grant) => $grant.bucket == "ability_boost" && $grant.level == 1,
    ),
    mapper = ($grant) => $grant.assigned_ability_boosts_effective,
  );

calc integer creator_step_2_level_1_strength_boost_count(name = "Creator step 2 level-1 STR boost count") =
  length(filter(creator_step_2_level_1_assigned_ability_boosts, filter = ($v) => $v == "strength"));

calc integer creator_step_2_level_1_dexterity_boost_count(name = "Creator step 2 level-1 DEX boost count") =
  length(filter(creator_step_2_level_1_assigned_ability_boosts, filter = ($v) => $v == "dexterity"));

calc integer creator_step_2_level_1_constitution_boost_count(name = "Creator step 2 level-1 CON boost count") =
  length(filter(creator_step_2_level_1_assigned_ability_boosts, filter = ($v) => $v == "constitution"));

calc integer creator_step_2_level_1_intelligence_boost_count(name = "Creator step 2 level-1 INT boost count") =
  length(filter(creator_step_2_level_1_assigned_ability_boosts, filter = ($v) => $v == "intelligence"));

calc integer creator_step_2_level_1_wisdom_boost_count(name = "Creator step 2 level-1 WIS boost count") =
  length(filter(creator_step_2_level_1_assigned_ability_boosts, filter = ($v) => $v == "wisdom"));

calc integer creator_step_2_level_1_charisma_boost_count(name = "Creator step 2 level-1 CHA boost count") =
  length(filter(creator_step_2_level_1_assigned_ability_boosts, filter = ($v) => $v == "charisma"));

calc bool creator_has_duplicate_level_1_ability_boost_selection(name = "Creator has duplicate level-1 ability boost selection") =
  creator_step_2_level_1_strength_boost_count > 1
    || creator_step_2_level_1_dexterity_boost_count > 1
    || creator_step_2_level_1_constitution_boost_count > 1
    || creator_step_2_level_1_intelligence_boost_count > 1
    || creator_step_2_level_1_wisdom_boost_count > 1
    || creator_step_2_level_1_charisma_boost_count > 1;

calc integer creator_preview_strength_total_boosts(name = "Creator preview STR total boosts") =
  if !($character?.$is_new? ?? false)
    then 0
    else add(
        map(
          filter(
            creator_ability_score_increases,
            filter = ($asi) => $asi.selected_modifier_effective == "strength",
          ),
          mapper = ($asi) => $asi.value,
        ),
      )
      + length(filter(creator_step_2_assigned_ability_boosts, filter = ($v) => $v == "strength"));

calc integer creator_preview_dexterity_total_boosts(name = "Creator preview DEX total boosts") =
