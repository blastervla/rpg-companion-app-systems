import "../macros/system_common.rpgs";

character_sheet_section conditions() =
  section(
    id = "conditions",
    header = [
      icon(
        id = "conditions_section_icon",
        name = "ic_conditions",
        size = "medium",
        color = "accent",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "conditions_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Conditions",
        style = "title",
      ),
      spacer(id = "conditions_header_spacer"),
      persistentEditIconPopUpButton(
        button_id = "conditions_edit_button",
        icon_id = "conditions_edit_icon",
        pop_up_view = section(
          id = "conditions_edit_bottom_sheet",
          header = [],
          content = [
            ticker(
              id = "frightened_value",
              stat = "frightened_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Frightened",
              label_alignment = "right",
            ),
            ticker(
              id = "sickened_value",
              stat = "sickened_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Sickened",
              label_alignment = "right",
            ),
            ticker(
              id = "clumsy_value",
              stat = "clumsy_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Clumsy",
              label_alignment = "right",
            ),
            ticker(
              id = "enfeebled_value",
              stat = "enfeebled_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Enfeebled",
              label_alignment = "right",
            ),
            ticker(
              id = "stupefied_value",
              stat = "stupefied_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Stupefied",
              label_alignment = "right",
            ),
            ticker(
              id = "drained_value",
              stat = "drained_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Drained",
              label_alignment = "right",
            ),
            ticker(
              id = "slowed_value",
              stat = "slowed_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Slowed",
              label_alignment = "right",
            ),
            ticker(
              id = "stunned_value",
              stat = "stunned_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Stunned",
              label_alignment = "right",
            ),
            checkbox(id = "blinded_check", stat = "blinded", label = "Blinded", label_alignment = "right", style = "checkbox"),
            checkbox(id = "deafened_check", stat = "deafened", label = "Deafened", label_alignment = "right", style = "checkbox"),
            checkbox(id = "grabbed_check", stat = "grappled", label = "Grabbed", label_alignment = "right", style = "checkbox"),
            checkbox(id = "invisible_check", stat = "invisible", label = "Invisible", label_alignment = "right", style = "checkbox"),
            checkbox(id = "paralyzed_check", stat = "paralyzed", label = "Paralyzed", label_alignment = "right", style = "checkbox"),
            checkbox(id = "petrified_check", stat = "petrified", label = "Petrified", label_alignment = "right", style = "checkbox"),
            checkbox(id = "prone_check", stat = "prone", label = "Prone", label_alignment = "right", style = "checkbox"),
            checkbox(id = "unconscious_check", stat = "unconscious", label = "Unconscious", label_alignment = "right", style = "checkbox"),
          ],
          show_divider = false,
          content_item_min_width = 0.5,
        ),
        pop_up_title = "Manage conditions",
      ),
    ],
    content = [
      removableConditionChip(chip_id = "frightened_chip", chip_text = concat(["Frightened ", frightened_value]), condition_id = "frightened_value", is_visible = frightened_value > 0),
      removableConditionChip(chip_id = "sickened_chip", chip_text = concat(["Sickened ", sickened_value]), condition_id = "sickened_value", is_visible = sickened_value > 0),
      removableConditionChip(chip_id = "clumsy_chip", chip_text = concat(["Clumsy ", clumsy_value]), condition_id = "clumsy_value", is_visible = clumsy_value > 0),
