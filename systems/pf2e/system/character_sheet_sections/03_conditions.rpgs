      removableConditionChip(chip_id = "drained_chip", chip_text = concat(["Drained ", drained_value]), condition_id = "drained_value", is_visible = drained_value > 0),
      removableConditionChip(chip_id = "slowed_chip", chip_text = concat(["Slowed ", slowed_value]), condition_id = "slowed_value", is_visible = slowed_value > 0),
      removableConditionChip(chip_id = "stunned_chip", chip_text = concat(["Stunned ", stunned_value]), condition_id = "stunned_value", is_visible = stunned_value > 0),
      removableConditionChip(chip_id = "blinded_chip", chip_text = "Blinded", condition_id = "blinded", is_visible = blinded),
      removableConditionChip(chip_id = "deafened_chip", chip_text = "Deafened", condition_id = "deafened", is_visible = deafened),
      removableConditionChip(chip_id = "grabbed_chip", chip_text = "Grabbed", condition_id = "grappled", is_visible = grappled),
      removableConditionChip(chip_id = "invisible_chip", chip_text = "Invisible", condition_id = "invisible", is_visible = invisible),
      removableConditionChip(chip_id = "paralyzed_chip", chip_text = "Paralyzed", condition_id = "paralyzed", is_visible = paralyzed),
      removableConditionChip(chip_id = "petrified_chip", chip_text = "Petrified", condition_id = "petrified", is_visible = petrified),
      removableConditionChip(chip_id = "prone_chip", chip_text = "Prone", condition_id = "prone", is_visible = prone),
      removableConditionChip(chip_id = "unconscious_chip", chip_text = "Unconscious", condition_id = "unconscious", is_visible = unconscious),
    ],
    show_divider = true,
    collapsible = true,
    start_collapsed = false,
    alignment = "start",
  );
