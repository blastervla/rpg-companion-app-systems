character_sheet_section conditions() =
  section(
    id = "conditions",
    header = [
      icon(
        id = "conditions_section_icon",
        name = "ic_conditions",
        size = "medium",
        color = "accent",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "conditions_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Conditions",
        style = "title",
      ),
      spacer(id = "conditions_header_spacer"),
      popUpButton(
        id = "conditions_edit_button",
        margin_right = 8,
        icon = icon(
          id = "conditions_edit_icon",
          name = "ic_edit",
          size = "small",
          color = "text",
        ),
        pop_up_view = section(
          id = "conditions_edit_bottom_sheet",
          header = [],
          content = [
            ticker(
              id = "frightened_value",
              stat = "frightened_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Frightened",
              label_alignment = "right",
            ),
            ticker(
              id = "sickened_value",
              stat = "sickened_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Sickened",
              label_alignment = "right",
            ),
            ticker(
              id = "clumsy_value",
              stat = "clumsy_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Clumsy",
              label_alignment = "right",
            ),
            ticker(
              id = "enfeebled_value",
              stat = "enfeebled_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Enfeebled",
              label_alignment = "right",
            ),
            ticker(
              id = "stupefied_value",
              stat = "stupefied_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Stupefied",
              label_alignment = "right",
            ),
            ticker(
              id = "drained_value",
              stat = "drained_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Drained",
              label_alignment = "right",
            ),
            ticker(
              id = "slowed_value",
              stat = "slowed_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Slowed",
              label_alignment = "right",
            ),
            ticker(
              id = "stunned_value",
              stat = "stunned_value",
              style = "text",
              button_location = "right",
              button_look = "plusMinus",
              change_amount = 1,
              min_value_allowed = 0,
              label = "Stunned",
              label_alignment = "right",
            ),
            checkbox(id = "blinded_check", stat = "blinded", label = "Blinded", label_alignment = "right", style = "checkbox"),
            checkbox(id = "deafened_check", stat = "deafened", label = "Deafened", label_alignment = "right", style = "checkbox"),
            checkbox(id = "grabbed_check", stat = "grappled", label = "Grabbed", label_alignment = "right", style = "checkbox"),
            checkbox(id = "invisible_check", stat = "invisible", label = "Invisible", label_alignment = "right", style = "checkbox"),
            checkbox(id = "paralyzed_check", stat = "paralyzed", label = "Paralyzed", label_alignment = "right", style = "checkbox"),
            checkbox(id = "petrified_check", stat = "petrified", label = "Petrified", label_alignment = "right", style = "checkbox"),
            checkbox(id = "prone_check", stat = "prone", label = "Prone", label_alignment = "right", style = "checkbox"),
            checkbox(id = "unconscious_check", stat = "unconscious", label = "Unconscious", label_alignment = "right", style = "checkbox"),
          ],
          show_divider = false,
          content_item_min_width = 0.5,
        ),
        pop_up_title = "Manage conditions",
        display_cancel_button = true,
        display_save_button = true,
        should_persist_on_save = true,
      ),
    ],
    content = [
      chip(id = "frightened_chip", text = concat(["Frightened ", frightened_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "frightened_value")), background_color = "buttonSurface", is_visible = frightened_value > 0),
      chip(id = "sickened_chip", text = concat(["Sickened ", sickened_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "sickened_value")), background_color = "buttonSurface", is_visible = sickened_value > 0),
      chip(id = "clumsy_chip", text = concat(["Clumsy ", clumsy_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "clumsy_value")), background_color = "buttonSurface", is_visible = clumsy_value > 0),
      chip(id = "enfeebled_chip", text = concat(["Enfeebled ", enfeebled_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "enfeebled_value")), background_color = "buttonSurface", is_visible = enfeebled_value > 0),
      chip(id = "stupefied_chip", text = concat(["Stupefied ", stupefied_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "stupefied_value")), background_color = "buttonSurface", is_visible = stupefied_value > 0),
      chip(id = "drained_chip", text = concat(["Drained ", drained_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "drained_value")), background_color = "buttonSurface", is_visible = drained_value > 0),
      chip(id = "slowed_chip", text = concat(["Slowed ", slowed_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "slowed_value")), background_color = "buttonSurface", is_visible = slowed_value > 0),
      chip(id = "stunned_chip", text = concat(["Stunned ", stunned_value]), on_tap_event = event(name = "remove_condition", payload = payload(condition = "stunned_value")), background_color = "buttonSurface", is_visible = stunned_value > 0),
      chip(id = "blinded_chip", text = "Blinded", on_tap_event = event(name = "remove_condition", payload = payload(condition = "blinded")), background_color = "buttonSurface", is_visible = blinded),
      chip(id = "deafened_chip", text = "Deafened", on_tap_event = event(name = "remove_condition", payload = payload(condition = "deafened")), background_color = "buttonSurface", is_visible = deafened),
      chip(id = "grabbed_chip", text = "Grabbed", on_tap_event = event(name = "remove_condition", payload = payload(condition = "grappled")), background_color = "buttonSurface", is_visible = grappled),
      chip(id = "invisible_chip", text = "Invisible", on_tap_event = event(name = "remove_condition", payload = payload(condition = "invisible")), background_color = "buttonSurface", is_visible = invisible),
      chip(id = "paralyzed_chip", text = "Paralyzed", on_tap_event = event(name = "remove_condition", payload = payload(condition = "paralyzed")), background_color = "buttonSurface", is_visible = paralyzed),
      chip(id = "petrified_chip", text = "Petrified", on_tap_event = event(name = "remove_condition", payload = payload(condition = "petrified")), background_color = "buttonSurface", is_visible = petrified),
      chip(id = "prone_chip", text = "Prone", on_tap_event = event(name = "remove_condition", payload = payload(condition = "prone")), background_color = "buttonSurface", is_visible = prone),
      chip(id = "unconscious_chip", text = "Unconscious", on_tap_event = event(name = "remove_condition", payload = payload(condition = "unconscious")), background_color = "buttonSurface", is_visible = unconscious),
    ],
    show_divider = true,
    collapsible = true,
    start_collapsed = false,
    alignment = "start",
  );
