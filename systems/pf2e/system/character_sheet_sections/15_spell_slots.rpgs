            id = "spell_slots_10",
            stat = "spell_slots_10",
            min_value_allowed = 0,
            max_value_allowed = 99,
          ),
        ]
      ),
      // Archetype spellcasting blocks (read-only, up to 3 archetypes)
      section(
        id = "spell_slots_archetype_1_section",
        content_item_min_width = 1,
        show_divider = false,
        header = [],
        is_visible = notNull(spellcasting_archetype_1),
        content = [
          list(
            id = "archetype_spell_slots_1_block",
            subviews = [
              text(
                id = "archetype_spell_slots_1_title",
                margin_top = 8,
                margin_left = 16,
                text = spellcasting_archetype_1?.spellcasting_entry_name ?? "",
                style = "section",
              ),
              text(
                id = "archetype_1_slots_display",
                margin_bottom = 8,
                margin_left = 16,
                style = "text",
                text = concat(
                  [
                    (if (spellcasting_archetype_1?.max_archetype_cantrip_quantity ?? 0) > 0 then concat(["Cantrips: ", spellcasting_archetype_1?.max_archetype_cantrip_quantity ?? 0, "  "]) else ""),
                    (if (spellcasting_archetype_1?.max_spell_slots_1_total ?? 0) > 0 then concat(["Rank 1: ", spellcasting_archetype_1?.spell_slots_1 ?? 0, "  "]) else ""),
                    (if (spellcasting_archetype_1?.max_spell_slots_2_total ?? 0) > 0 then concat(["Rank 2: ", spellcasting_archetype_1?.spell_slots_2 ?? 0, "  "]) else ""),
                    (if (spellcasting_archetype_1?.max_spell_slots_3_total ?? 0) > 0 then concat(["Rank 3: ", spellcasting_archetype_1?.spell_slots_3 ?? 0, "  "]) else ""),
