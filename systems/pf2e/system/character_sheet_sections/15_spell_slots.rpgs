                    (if (spellcasting_archetype_1?.max_spell_slots_6_total ?? 0) > 0 then concat(["Rank 6: ", spellcasting_archetype_1?.spell_slots_6 ?? 0, "  "]) else ""),
                    (if (spellcasting_archetype_1?.max_spell_slots_7_total ?? 0) > 0 then concat(["Rank 7: ", spellcasting_archetype_1?.spell_slots_7 ?? 0]) else ""),
                  ],
                ),
              ),
            ],
          ),
        ],
      ),
