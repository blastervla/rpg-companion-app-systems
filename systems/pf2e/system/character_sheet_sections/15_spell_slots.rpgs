            margin_left = 16,
            margin_bottom = 8,
            style = "text",
            text = concat(
              [
                (if (spellcasting_archetype_1?.max_spell_slots_1 ?? 0) > 0 then concat(["Rank 1: ", spellcasting_archetype_1?.spell_slots_1 ?? 0, "  "]) else ""),
                (if (spellcasting_archetype_1?.max_spell_slots_2 ?? 0) > 0 then concat(["Rank 2: ", spellcasting_archetype_1?.spell_slots_2 ?? 0, "  "]) else ""),
