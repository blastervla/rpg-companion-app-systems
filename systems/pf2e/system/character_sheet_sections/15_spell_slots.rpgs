        size = "medium",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "spell_slots_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Spell Ranks",
        style = "title",
      ),
    ],
    content = [
      section(
        id = "spell_slots_class_section",
        content_item_min_width = 75,
        show_divider = false,
        header = [],
        content = [
          stat(
            id = "spell_slots_1",
            stat = "spell_slots_1",
            min_value_allowed = 0,
