character_sheet_section status() =
  section(
    id = "status_section",
    show_divider = true,
    content_item_min_width = 125,
    collapsible = false,
    header = [
      avatar(
        id = "avatar_view",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
        photo_stat = "photo",
        name_stat = "name",
        size = "small",
      ),
      ticker(
        id = "status_hp",
        margin_left = 16,
        stat = "current_hp",
        style = "title",
        button_location = "right",
        button_look = "plusMinus",
        should_auto_save = true,
        change_amount = 1,
        min_value_allowed = 0,
        label = concat(["/ ", max_hp, " HP"]),
        label_alignment = "right",
        edit_bottom_sheet_title = "Hit points",
        is_visible = !$edit_mode,
      ),
      ticker(
        id = "status_max_hp",
        margin_left = 16,
        stat = "base_hp",
        style = "title",
        button_location = "right",
        button_look = "plusMinus",
        should_auto_save = true,
        change_amount = 1,
        min_value_allowed = 1,
        label = concat(["Base HP + ", classes_hp_mods, " mods"]),
        label_alignment = "right",
        edit_bottom_sheet_title = "Max hit points",
        is_visible = $edit_mode,
      ),
    ],
    content = [
      stat(
        id = "armor_class",
        stat = "armor_class",
        change_amount = 1,
        min_value_allowed = 0,
      ),
      stat(
        id = "initiative",
        stat = "initiative",
        change_amount = 1,
        on_tap_event = event(
          name = "rollStat",
          payload = payload(stat = "initiative", statName = "Initiative"),
        ),
        bottom_sheet_in_edit_mode = true,
        bottom_sheet_view = section(
          id = "initiative_source_section",
          header = [],
          show_divider = false,
          collapsible = false,
          content_item_min_width = 1,
          content = [
            text(
              id = "initiative_source_help_text",
              text = "Choose which stat is used for initiative rolls.",
              style = "text",
            ),
            select(
              id = "initiative_source_select",
              stat = "initiative_stat",
              options = "initiative_sources",
              should_auto_save = true,
            ),
          ],
        ),
        sheet_title = "Set initiative source",
      ),
      stat(
        id = "perception",
        stat = "perception",
        change_amount = 1,
      ),
      stat(
        id = "class_dc",
        stat = "class_dc",
        change_amount = 1,
      ),
      stat(
        id = "level_bonus",
        stat = "level_bonus",
        change_amount = 1,
        always_show_sign = true,
      ),
      stat(
        id = "actions_remaining",
        stat = "actions_remaining",
        change_amount = 1,
        min_value_allowed = 0,
      ),
      stat(
        id = "reaction_available",
        stat = "reaction_available",
        change_amount = 1,
        min_value_allowed = 0,
      ),
      button(
        id = "reset_actions",
        text = "RESET ACTIONS",
        event = event(name = "refresh_actions", payload = payload()),
      ),
      stat(
        id = "hero_points",
        stat = "hero_points",
        change_amount = 1,
        min_value_allowed = 0,
      ),
      stat(
        id = "focus_points",
        stat = "focus_points",
        change_amount = 1,
        min_value_allowed = 0,
      ),
      stat(
        id = "speed",
        stat = "speed",
        change_amount = 5,
        min_value_allowed = 0,
      ),
    ],
  );
