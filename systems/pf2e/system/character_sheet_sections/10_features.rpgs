character_sheet_section features() =
  section(
    id = "features_section",
    show_divider = true,
    content_item_min_width = 1,
    collapsible = true,
    header = [
      icon(
        id = "features_section_icon",
        name = "ic_star",
        size = "medium",
        margin_left = 16,
      ),
      text(
        id = "features_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Traits & Features",
        style = "title",
      ),
      spacer(id = "features_section_header_spacer"),
    ],
    content = [
      resourceArray(
        id = "class_features_subsection",
        resource_id = "class_progression",
        stat = "classes",
        view_type = "display",
        hide_line = true,
      ),
      text(
        id = "features_class_archetype_mismatch_warning",
        margin_left = 16,
        margin_bottom = 6,
        text = class_archetype_mismatch_warning_text,
        style = "caption",
        color = "accent",
        is_visible = !isEmpty(class_archetype_mismatch_warning_text),
      ),
      text(
        id = "features_archetype_feat_warning",
        margin_left = 16,
        margin_bottom = 6,
        text = archetype_feats_warning_text,
        style = "caption",
        color = "accent",
        is_visible = !isEmpty(archetype_feats_warning_text),
      ),
      text(
        id = "features_archetype_dedication_missing_warning",
        margin_left = 16,
        margin_bottom = 6,
        text = archetype_dedication_missing_warning_text,
        style = "caption",
        color = "accent",
        is_visible = !isEmpty(archetype_dedication_missing_warning_text),
      ),
      text(
        id = "features_archetype_multiple_dedications_warning",
        margin_left = 16,
        margin_bottom = 6,
