                filter = ($filterValue) => $filterValue != null
              ),
              heritage = filter([
                  heritage?.name?
                ],
                filter = ($filterValue) => $filterValue != null
              ),
              available_at_character_levels = level_singleton,
            ),
            is_visible = notNull(ancestry),
          ),
        ],
        content = [
          text(
            id = "ancestry_feats_no_ancestry_hint",
            text = "Choose an ancestry first to pick ancestry feats.",
