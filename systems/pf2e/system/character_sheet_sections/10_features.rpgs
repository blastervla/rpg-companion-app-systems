          spacer(id = "ancestry_feats_header_spacer"),
          selectResources(
            id = "ancestry_feats_add_feat",
            stat = "feats",
            resource_id = "feat",
            view_type = "icon",
            should_append = true,
            should_save_on_selection = true,
            filters = dict(
              type = "ancestry",
              ancestry = filter([
                  ancestry?.name?
