character_sheet_section saving_throws() =
  section(
    id = "saving_throws_section",
    show_divider = true,
    content_item_min_width = 125,
    collapsible = false,
    header = [
      icon(
        id = "saving_throws_section_icon",
        name = "ic_d20",
        size = "medium",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "saving_throws_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Saving Throws",
        style = "title",
      ),
    ],
    content = [
      stat(
        id = "fortitude",
        stat = "fortitude",
        on_tap_event = event(
          name = "rollStat",
          payload = payload(stat = "fortitude", statName = "Fortitude save"),
        ),
      ),
      stat(
        id = "reflex",
        stat = "reflex",
        on_tap_event = event(
          name = "rollStat",
          payload = payload(stat = "reflex", statName = "Reflex save"),
        ),
      ),
      stat(
        id = "will",
        stat = "will",
        on_tap_event = event(
          name = "rollStat",
          payload = payload(stat = "will", statName = "Will save"),
        ),
      ),
    ],
  );
