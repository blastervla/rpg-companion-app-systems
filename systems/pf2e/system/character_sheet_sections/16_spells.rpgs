character_sheet_section spells() =
  section(
    id = "spells_section",
    show_divider = true,
    content_item_min_width = 1,
    collapsible = true,
    header = [
      icon(
        id = "spells_section_icon",
        name = "ic_whatshot",
        color = "#7b1fa2",
        size = "medium",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "spells_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Spells",
        style = "title",
      ),
      spacer(id = "spells_section_header_spacer"),
      menuButton(
        id = "spells_section_menu",
        margin_right = 8,
        icon_name = "ic_sort",
        icon_size = "small",
        icon_color = "accent",
        options = "spells_section_menu",
        allowed_options = [
          (if spells_show_prepared_only then "toggle_spells_show_prepared_only_selected" else "toggle_spells_show_prepared_only_deselected"),
          (if spells_hide_fully_expended_prepared then "toggle_spells_hide_fully_expended_prepared_selected" else "toggle_spells_hide_fully_expended_prepared_deselected"),
        ],
      ),
      selectResources(
        id = "spells_section_add_spell",
        stat = "spells",
        resource_id = "spell",
        view_type = "icon",
        should_append = true,
        should_save_on_selection = true,
        filters = dict(
          traditions = flatAppend(
            [
              map(
                filter(
                  classes,
                  filter = ($classProgression) => ($classProgression.show_spellcasting_details
                    && !isEmpty($classProgression.class.actual_spellcasting_tradition)),
                ),
                mapper = ($classProgression) => [$classProgression.class.actual_spellcasting_tradition],
              ),
              map(
                filter(
                  spellcasting_archetypes,
                  filter = ($archetype) => !isEmpty($archetype.actual_spellcasting_tradition),
                ),
                mapper = ($archetype) => [$archetype.actual_spellcasting_tradition],
              ),
            ],
            treat_as_set = true,
          ),
        ),
      ),
    ],
    content = [
      resourceSection(
        id = "spellcasting_abilities_list",
        resource_stat = "classes",
        resource_id = "class_progression",
        read_only = true,
        tap_displays_resource = false,
      ),
      resourceSection(
        id = "cantrips_list",
        resource_stat = "cantrips",
        resource_set_stat = "spells",
        resource_id = "spell",
        header_view = text(
          id = "cantrips_title",
          margin_left = 12,
          text = "Cantrips",
          style = "subhead",
          is_visible = !isEmpty(cantrips),
        ),
      ),
      resourceSection(
        id = "level_1_spells_list",
        resource_stat = "level_1_spells",
        resource_set_stat = "spells",
        resource_id = "spell",
        header_view = text(
          id = "level_1_title",
          margin_left = 12,
          text = "Rank 1",
          style = "subhead",
          is_visible = !isEmpty(level_1_spells),
        ),
      ),
      resourceSection(
        id = "level_2_spells_list",
        resource_stat = "level_2_spells",
        resource_set_stat = "spells",
        resource_id = "spell",
        header_view = text(
