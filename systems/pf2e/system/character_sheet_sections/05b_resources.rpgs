character_sheet_section resources() =
  section(
    id = "resources_section",
    show_divider = true,
    content_item_min_width = 0.5,
    collapsible = false,
    header = [
      icon(
        id = "resources_section_icon",
        name = "ic_stars",
        size = "medium",
        color = "accent",
        margin_top = 8,
        margin_right = 8,
        margin_left = 16,
      ),
      text(
        id = "resources_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Resources",
        style = "title",
      ),
    ],
    content = [
      stat(
        id = "resources_hero_points",
        stat = "hero_points_pips",
        edit_stat = "hero_points",
        override_label = "Hero Points",
        margin_top = 8,
        margin_bottom = 8,
        margin_left = 8,
        margin_right = 8,
        should_auto_save = true,
        always_in_edit_mode = true,
        change_amount = 1,
        min_value_allowed = 0,
      ),
      stat(
        id = "resources_focus_points",
        stat = "focus_points_pips",
        edit_stat = "focus_points",
        override_label = "Focus Points",
        margin_top = 8,
        margin_bottom = 8,
        margin_left = 8,
        margin_right = 8,
        should_auto_save = true,
        always_in_edit_mode = true,
        change_amount = 1,
        min_value_allowed = 0,
      ),
    ],
  );
