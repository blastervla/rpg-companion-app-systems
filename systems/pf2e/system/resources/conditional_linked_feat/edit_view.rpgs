view conditional_linked_feat_edit() =
  composite(
    id = "conditional_linked_feat_edit",
    subviews = [
      text(
        id = "conditional_linked_feat_edit_level",
        edit_stat = "level",
        style = "text",
        hint = "Lvl",
        max_length = 3,
        signed = false,
      ),
      selectResources(
        id = "conditional_linked_feat_edit_feat_select",
        resource_id = "feat",
        stat = "feat",
      ),
      popUpButton(
        id = "conditional_linked_feat_edit_trigger_condition_button",
        margin_top = 8,
        text = if trigger_condition == null then "ADD TRIGGER CONDITION" else "EDIT TRIGGER CONDITION",
        pop_up_view = resource(
          id = "conditional_linked_feat_edit_trigger_condition_resource",
          view_type = "edit",
          resource_id = "trigger_condition_or",
          stat = "trigger_condition",
          create_if_empty = true,
        ),
        pop_up_title = "Trigger condition",
        display_cancel_button = true,
        display_save_button = true,
        should_persist_on_save = false,
      ),
      text(
        id = "conditional_linked_feat_edit_notes",
        margin_top = 8,
        edit_stat = "notes",
        style = "text",
        label = "Notes",
      ),
    ],
  );
