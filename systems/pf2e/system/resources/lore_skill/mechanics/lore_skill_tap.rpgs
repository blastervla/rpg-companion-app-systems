mechanic lore_skill_tap(event_names = "loreSkillTap") =
  when {
    $edit_mode -> showPopUp(
      pop_up_view = list(
        id = "lore_skill_tap_edit_view",
        padding = 8,
        subviews = [
          text(
            id = "lore_skill_tap_name",
            edit_stat = "selected_option",
            style = "text",
            label = "Lore skill",
            hint = options,
            max_length = 80,
          ),
          select(
            id = "lore_skill_tap_proficiency",
            stat = "proficiency",
            options = "skill_proficiency_types",
          ),
          select(
            id = "lore_skill_tap_ability",
            stat = "ability",
            options = "ability",
          ),
          ticker(
            id = "lore_skill_tap_untyped_modifier",
            stat = "untyped_modifier",
            style = "title",
            button_look = "plusMinus",
            button_location = "right",
            should_auto_save = true,
            change_amount = 1,
            label = "Misc modifier",
            label_alignment = "right",
          ),
        ],
      ),
      pop_up_title = if isEmpty(lore_name) then "Lore" else lore_name,
      display_cancel_button = true,
      display_save_button = true,
      should_persist_on_save = true,
    ),
    !$edit_mode -> roll(
      rolls = [
        rollable(
          formulas = [concat(["1d20 + ", total_bonus])],
          text = if isEmpty(lore_name) then "Lore" else lore_name,
        ),
      ],
    ),
  };
