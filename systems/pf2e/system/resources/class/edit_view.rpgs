view class_edit() =
  viewPager(
    id = "class_edit",
    names = [
      "Basic information",
      "Features",
      "Spellcasting",
      "Weapons & Equipment",
      "Proficiencies",
    ],
    color = "#016157",
    subviews = [
      list(
        id = "class_edit_basics",
        padding = 16,
        subviews = [
          text(
            id = "class_edit_name",
            edit_stat = "name",
            style = "text",
            label = "Name",
            max_length = 140,
            validation_message = if isEmpty($view.class_edit_name)
              then "Please add a name to your class"
              else null,
          ),
          composite(
            id = "class_edit_source",
            margin_top = 4,
            subviews = [
              text(id = "class_edit_source_label", text = "Source: ", style = "text"),
              select(
                id = "class_edit_source_select",
                options = "source",
                options_display_stat = "abbreviation",
                stat = "source",
              ),
            ],
          ),
          text(
            id = "class_edit_description",
            edit_stat = "description",
            label = "Description",
            style = "text",
          ),
          resourceArray(
            id = "class_edit_ability_score_increases",
            resource_id = "ability_score_increase",
            stat = "ability_score_increases",
            view_type = "edit",
            left_view = text(
              id = "class_edit_ability_boosts_label",
              text = "Ability boosts: ",
              style = "text",
              bold = true,
            ),
            pop_up_type = "bottomSheet",
            pop_up_button_text = description,
          ),
          composite(
            id = "class_edit_hp_composite",
            margin_top = 4,
            subviews = [
              text(
                id = "class_edit_hp_per_level_label",
                text = "HP per level: ",
                style = "text",
                bold = true,
              ),
              text(
                id = "class_edit_hp_per_level",
                edit_stat = "class_hp_per_level",
                style = "text",
                max_length = 3,
                signed = false,
                hint = "8",
              ),
              text(id = "class_edit_hp_plus_label", text = " + ", style = "text"),
              select(
                id = "class_edit_hp_modifiers",
                stat = "hp_modifiers",
                options = "ability",
                multi_select = true,
              ),
            ],
          ),
          composite(
            id = "class_edit_armor_composite",
            margin_top = 4,
            subviews = [
              text(id = "class_edit_base_ac", text = "Base AC: ", style = "text", bold = true),
              text(
                id = "class_edit_base_ac",
                edit_stat = "base_ac",
                style = "text",
                max_length = 2,
                signed = false,
                hint = "0",
              ),
              text(id = "class_edit_ac_plus_label", text = " + ", style = "text"),
              select(
                id = "class_edit_ac_modifiers",
                stat = "ac_modifiers",
                options = "ability",
                multi_select = true,
              ),
            ],
          ),
          text(
            id = "class_edit_saving_throw_proficiencies_label",
            margin_top = 4,
            text = "Saving proficiencies:",
            style = "text",
            bold = true,
          ),
          composite(
            id = "class_edit_saving_throws_composite",
            margin_top = 4,
            subviews = [
              text(
                id = "class_edit_fortitude_saving_throw_proficiency_label",
                text = "Fortitude: ",
                style = "text",
                bold = true,
              ),
              select(
                id = "class_edit_fortitude_saving_throw_proficiency_select",
                stat = "fortitude_proficiency",
                options = "skill_proficiency_types",
              ),
              text(
                id = "class_edit_reflex_saving_throw_proficiency_label",
                margin_left = 8,
                text = "Reflex: ",
                style = "text",
                bold = true,
              ),
              select(
                id = "class_edit_reflex_saving_throw_proficiency_select",
                stat = "reflex_proficiency",
                options = "skill_proficiency_types",
              ),
              text(
                id = "class_edit_will_saving_throw_proficiency_label",
                margin_left = 8,
                text = "Will: ",
                style = "text",
                bold = true,
              ),
              select(
                id = "class_edit_will_saving_throw_proficiency_select",
                stat = "will_proficiency",
                options = "skill_proficiency_types",
              ),
              text(
                id = "class_edit_perception_proficiency_label",
                margin_left = 8,
                text = "Perception: ",
                style = "text",
                bold = true,
              ),
              select(
                id = "class_edit_perception_proficiency_select",
                stat = "perception_proficiency",
                options = "skill_proficiency_types",
              ),
            ],
          ),
          resourceArray(
            id = "class_edit_fortitude_saving_throw_by_level",
            margin_top = 4,
            resource_id = "levelled_save_proficiency",
            stat = "fortitude_proficiency_per_level",
            view_type = "edit",
            left_view = text(
              id = "class_edit_fortitude_saving_throw_by_level_label",
