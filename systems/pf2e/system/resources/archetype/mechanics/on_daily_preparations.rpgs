mechanic on_daily_preparations(event_names = "daily_preparations") =
  when {
    grants_spellcasting -> sequence(
      effects = [
        setStat(stat = "spell_slots_1", new_value = max_spell_slots_1, aggregation_type = "set"),
        setStat(stat = "spell_slots_2", new_value = max_spell_slots_2, aggregation_type = "set"),
        setStat(stat = "spell_slots_3", new_value = max_spell_slots_3, aggregation_type = "set"),
        setStat(stat = "spell_slots_4", new_value = max_spell_slots_4, aggregation_type = "set"),
        setStat(stat = "spell_slots_5", new_value = max_spell_slots_5, aggregation_type = "set"),
        setStat(stat = "spell_slots_6", new_value = max_spell_slots_6, aggregation_type = "set"),
        setStat(stat = "spell_slots_7", new_value = max_spell_slots_7, aggregation_type = "set"),
        setStat(stat = "spell_slots_8", new_value = max_spell_slots_8, aggregation_type = "set"),
        setStat(stat = "spell_slots_9", new_value = max_spell_slots_9, aggregation_type = "set"),
      ],
    ),
  };
