define itemWithAmountDisplayView() =
  list(
    id = "item_with_amount_display",
    subviews = [
      text(
        id = "item_with_amount_display_out_of_character",
        margin_left = 4,
        text = display_description,
        style = "text",
        is_visible = !defined(stat = "$character"),
      ),
      checkbox(
        id = "item_with_amount_display_in_character",
        stat = "selected",
        label = display_description,
        enabled = can_toggle_selection,
        label_alignment = "right",
        style = "checkbox",
        is_visible = defined(stat = "$character"),
      ),
    ],
  );

define itemWithAmountEditView() =
  composite(
    id = "item_with_amount_edit",
    subviews = [
      text(
        id = "item_with_amount_edit_amount",
        edit_stat = "amount",
        style = "text",
        hint = "Amnt.",
        max_length = 6,
      ),
      selectResources(
        id = "item_with_amount_edit_item",
        stat = "item",
        resource_id = "item",
        validation_message = if !notNull($view.item_with_amount_edit_item)
          then "You have an empty item. Please select an item or remove it."
          else null,
      ),
    ],
  );

define itemWithAmountDisplayDescription() =
  concat([amount, " ", (item?.name ?? "nothing")]);

define itemWithAmountCanToggleSelection() =
  $parent?.can_select_more ?? true
    || $view?.item_with_amount_display_in_character ?? false;

define armorWithAmountDisplayView() =
  list(
    id = "armor_with_amount_display",
    subviews = [
      text(
        id = "armor_with_amount_display_out_of_character",
        margin_left = 4,
        text = display_description,
        style = "text",
        is_visible = !defined(stat = "$character"),
      ),
      checkbox(
        id = "armor_with_amount_display_in_character",
        stat = "selected",
        label = display_description,
        enabled = can_toggle_selection,
        label_alignment = "right",
        style = "checkbox",
        is_visible = defined(stat = "$character"),
      ),
    ],
  );

define armorWithAmountEditView() =
  composite(
    id = "armor_with_amount_edit",
    subviews = [
      text(
        id = "armor_with_amount_edit_amount",
        edit_stat = "amount",
        style = "text",
        hint = "Amnt.",
        max_length = 6,
      ),
      selectResources(
        id = "armor_with_amount_edit_armor",
        stat = "armor",
        resource_id = "armor",
        validation_message = if !notNull($view.armor_with_amount_edit_armor)
          then "You have an empty armor. Please select an armor or remove it."
          else null,
      ),
    ],
  );

define armorWithAmountDisplayDescription() =
  concat([amount, " ", (armor?.name ?? "nothing")]);

define armorWithAmountCanToggleSelection() =
  $parent?.can_select_more ?? true || selected;
