define selectableItemsDisplayView() =
  list(
    id = "selectable_items_display",
    subviews = [
      text(
        id = "selectable_items_display_out_of_character",
        margin_left = 4,
        text = display_description,
        style = "text",
        is_visible = !($character?.should_show_controls_for_choices ?? false),
      ),
      composite(
        id = "selectable_items_display_in_character",
        subviews = [
          text(
            id = "selectable_items_display_choose_label",
            text = choose_label_text,
            style = "text",
          ),
          select(
            id = "selectable_items_display_choose",
            stat = "selected_options_string",
            resource_options = options,
            max_selection_amount = amount,
            options_display_stat = "display_description",
            multi_select = true,
          ),
        ],
        is_visible = $character?.should_show_controls_for_choices ?? false,
      ),
    ],
  );

define selectableItemsEditView() =
  list(
    id = "selectable_items_edit",
    subviews = [
      composite(
        id = "selectable_items_edit_amount_composite",
        subviews = [
          text(
            id = "selectable_items_edit_amount_label",
            text = "Amount to choose: ",
            style = "text",
          ),
          text(
            id = "selectable_items_edit_amount",
            edit_stat = "amount",
            style = "text",
            hint = "1",
            max_length = 2,
          ),
        ],
      ),
      resourceArray(
        id = "selectable_items_edit_options",
        resource_id = "item_with_amount",
        stat = "options",
        view_type = "edit",
        left_view = text(
          id = "selectable_items_edit_options_label",
          text = "Options: ",
          style = "text",
        ),
        validation_message = if isEmpty($view.selectable_items_edit_options)
          then "You have empty item options. Please select some items or remove it."
          else null,
      ),
    ],
  );

define selectableItemsSelectedOptions() =
  selectableSelectedOptions(options = options, selected_ids = selected_options_string);

