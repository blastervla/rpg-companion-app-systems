define dnd5eArmorsSection() =
  section(
    id = "armors_section",
    show_divider = true,
    content_item_min_width = 1,
    collapsible = true,
    header = [
      icon(
        id = "armors_section_icon",
        name = "ic_armor",
        size = "medium",
        margin_left = 16,
      ),
      text(
        id = "armors_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Armor",
        style = "title",
      ),
      spacer(id = "armors_section_header_spacer"),
      selectResources(
        id = "armors_section_add_armor",
        stat = "armors",
        resource_id = "armor",
        view_type = "icon",
        should_append = true,
        should_save_on_selection = true,
      ),
    ],
    content = [
      resourceSection(
        id = "armors_list",
        resource_stat = "armors",
        resource_id = "armor",
      ),
    ],
  );

define dnd5eWeaponsSection() =
  section(
    id = "weapons_section",
    show_divider = true,
    content_item_min_width = 1,
    collapsible = true,
    header = [
      icon(
        id = "weapons_section_icon",
        name = "ic_weapon",
        size = "medium",
        margin_left = 16,
      ),
      text(
        id = "weapons_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Weapons",
        style = "title",
      ),
      spacer(id = "weapons_section_header_spacer"),
      selectResources(
        id = "weapons_section_add_weapon",
        stat = "weapons",
        resource_id = "weapon",
        view_type = "icon",
        should_append = true,
        should_save_on_selection = true,
      ),
    ],
    content = [
      resourceSection(
        id = "weapons_list",
        resource_stat = "all_weapons",
        resource_set_stat = "weapons",
        resource_id = "weapon",
        header_view = composite(
          id = "weapons_list_attacks_per_action_composite",
          margin_left = 16,
          margin_bottom = 16,
          subviews = [
            text(
              id = "weapons_list_attacks_per_action_label",
              text = "Attacks per action: ",
              style = "text",
              bold = true,
            ),
            text(
              id = "weapons_list_attacks_per_action",
              text = attacks_per_action,
              style = "text",
              bold = true,
            ),
          ],
        ),
      ),
    ],
  );

define dnd5eEquipmentSection() =
  section(
    id = "equipment_section",
    show_divider = true,
    content_item_min_width = 1,
    collapsible = true,
    header = [
      icon(
        id = "equipment_section_icon",
        name = "ic_backpack",
        size = "medium",
        margin_left = 16,
      ),
      text(
        id = "equipment_section_title",
        margin_right = 16,
        margin_left = 16,
        text = "Equipment",
        style = "title",
      ),
      spacer(id = "equipment_section_header_spacer"),
      selectResources(
        id = "equipment_section_add_equipment",
        stat = "equipment",
        resource_id = "item",
        view_type = "icon",
        should_append = true,
        should_save_on_selection = true,
        inline_creation_mode = "optional",
      ),
    ],
    content = [
      section(
        id = "equipment_currency",
        header = [],
        content = [
          stat(
            id = "equipment_currency_cp",
            stat = "copper_pieces",
            min_value_allowed = 0,
            edit_bottom_sheet_title = "Copper",
          ),
          stat(
            id = "equipment_currency_sp",
            stat = "silver_pieces",
            min_value_allowed = 0,
            edit_bottom_sheet_title = "Silver",
          ),
          stat(
            id = "equipment_currency_ep",
            stat = "electrum_pieces",
            min_value_allowed = 0,
            edit_bottom_sheet_title = "Electrum",
          ),
          stat(
            id = "equipment_currency_gp",
            stat = "gold_pieces",
            min_value_allowed = 0,
            edit_bottom_sheet_title = "Gold",
          ),
          stat(
            id = "equipment_currency_pp",
            stat = "platinum_pieces",
            min_value_allowed = 0,
            edit_bottom_sheet_title = "Platinum",
          ),
        ],
        show_divider = false,
        content_item_min_width = 75,
        alignment = "center",
      ),
      resourceSection(
        id = "equipment_list",
        resource_stat = "equipment",
        resource_id = "item",
        max_items_in_preview = 5,
      ),
    ],
  );
