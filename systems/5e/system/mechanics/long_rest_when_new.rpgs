import "../macros/system_common.rpgs";

mechanic long_rest_when_new(event_names = "characterLoaded") =
  when {
    is_new_and_should_long_rest -> sequence(
      effects = [
        fireEventName(event_name = "long_rest"),
        setStatFalse(stat_id = "is_new_and_should_long_rest"),
      ],
    ),
  };
