import "../macros/system_common.rpgs";

character_sheet_section saving_throws() =
  section(
    id = "saving_throws_section",
    show_divider = true,
    content_item_min_width = 125,
    collapsible = false,
    header = defaultSectionHeader(
      icon_id = "saving_throws_section_icon",
      icon_name = "ic_d20",
      title_id = "saving_throws_section_title",
      title_text = "Saving Throws",
    ),
    content = [
      rollStatRow(id = "strength", stat_id = "strength_saving_throw", edit_stat_id = "strength_saving_throw_proficiency", stat_name = "Strength saving throw"),
      rollStatRow(id = "dexterity", stat_id = "dexterity_saving_throw", edit_stat_id = "dexterity_saving_throw_proficiency", stat_name = "Dexterity saving throw"),
      rollStatRow(id = "constitution", stat_id = "constitution_saving_throw", edit_stat_id = "constitution_saving_throw_proficiency", stat_name = "Constitution saving throw"),
      rollStatRow(id = "intelligence", stat_id = "intelligence_saving_throw", edit_stat_id = "intelligence_saving_throw_proficiency", stat_name = "Intelligence saving throw"),
      rollStatRow(id = "wisdom", stat_id = "wisdom_saving_throw", edit_stat_id = "wisdom_saving_throw_proficiency", stat_name = "Wisdom saving throw"),
      rollStatRow(id = "charisma", stat_id = "charisma_saving_throw", edit_stat_id = "charisma_saving_throw_proficiency", stat_name = "Charisma saving throw"),
    ],
  );
